Vagrant.configure("2") do |config|
  config.vm.box = "centos/stream8"
  
  config.vm.network "forwarded_port", guest: 80, host: 8080
  config.vm.network "forwarded_port", guest: 3306, host: 3307

  config.vm.provider "libvirt" do |libvirt|
    libvirt.driver = "kvm"
    libvirt.memory = "1024"
    libvirt.cpus = 1
    libvirt.storage_pool_name = "default"
  end

  config.vm.provision "shell", privileged: true, inline: <<-SHELL
    yum install -y epel-release
    yum update -y
    yum install -y firewalld mariadb-server httpd php php-mysqlnd git

    systemctl start firewalld
    systemctl enable firewalld
    firewall-cmd --permanent --zone=public --add-port=80/tcp
    firewall-cmd --permanent --zone=public --add-port=3306/tcp
    firewall-cmd --reload

    systemctl start mariadb
    systemctl enable mariadb
    mysql_secure_installation <<EOF
y
ecompassword
ecompassword
y
y
y
y
Vagrant.configure("2") do |config|
  config.vm.box = "centos/stream8"
  
  config.vm.network "forwarded_port", guest: 80, host: 8080
  config.vm.network "forwarded_port", guest: 3306, host: 3307

  config.vm.provider "libvirt" do |libvirt|
    libvirt.driver = "kvm"
    libvirt.memory = "1024"
    libvirt.cpus = 1
    libvirt.storage_pool_name = "default"
  end

  config.vm.provision "shell", privileged: true, inline: <<-SHELL
    # Instalación de paquetes
    yum install -y epel-release
    yum update -y
    yum install -y firewalld mariadb-server httpd php php-mysqlnd git

    # Configuración de Firewall
    systemctl start firewalld
    systemctl enable firewalld
    firewall-cmd --permanent --zone=public --add-port=80/tcp
    firewall-cmd --permanent --zone=public --add-port=3306/tcp
    firewall-cmd --reload

    # Configuración de MariaDB
    systemctl start mariadb
    systemctl enable mariadb

    # Instalación segura de MySQL (automatizada)
    mysql_secure_installation <<EOF
y
ecompassword
ecompassword
y
y
y
y
EOF

    # Creación de base de datos y usuario
    mysql -u root -pecompassword <<EOF
CREATE DATABASE IF NOT EXISTS ecomdb;
CREATE USER IF NOT EXISTS 'ecomuser'@'localhost' IDENTIFIED BY 'ecompassword';
GRANT ALL PRIVILEGES ON *.* TO 'ecomuser'@'localhost';
FLUSH PRIVILEGES;
EOF

    # Carga de datos iniciales
    cat > /tmp/db-load.sql <<DBEOF
USE ecomdb;
CREATE TABLE IF NOT EXISTS products (
  id mediumint(8) unsigned NOT NULL auto_increment,
  Name varchar(255),
  Price varchar(255),
  ImageUrl varchar(255),
  PRIMARY KEY (id)
);
INSERT IGNORE INTO products (Name,Price,ImageUrl) VALUES 
("Laptop","100","c-1.png"),
("Drone","200","c-2.png"),
("VR","300","c-3.png"),
("Tablet","50","c-5.png"),
("Watch","90","c-6.png"),
("Phone Covers","20","c-7.png"),
("Phone","80","c-8.png"),
("Laptop","150","c-4.png");
DBEOF

    mysql -u root -pecompassword < /tmp/db-load.sql
    rm -f /tmp/db-load.sql

    # Configuración de Apache y PHP
    sed -i 's/index.html/index.php/g' /etc/httpd/conf/httpd.conf
    systemctl restart httpd
    systemctl enable httpd

    # Despliegue de la Aplicación
    rm -rf /var/www/html/*
    git clone https://github.com/kodekloudhub/learning-app-ecommerce.git /var/www/html/
    chown -R apache:apache /var/www/html
    restorecon -Rv /var/www/html 2>/dev/null || true

    # Configuración de variables de entorno para la App
    cat > /var/www/html/.env <<ENVEOF
DB_HOST=localhost
DB_USER=ecomuser
DB_PASSWORD=ecompassword
DB_NAME=ecomdb
ENVEOF

    echo "✅ E-commerce levantado!"
    curl -s http://localhost || echo "Web OK"
  SHELL
end