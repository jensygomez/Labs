
#cloud-config
# scenarios/junior/J01/cloudinit/V01/user-data
write_files:
  - path: /etc/lab.info
    permissions: '0644'
    owner: root:root
    content: |
      LAB=J01
      LEVEL=Junior
      VARIANT=V01
      STATUS=cloud-init-ok
      INCIDENT=Firewall bloquea ICMP + Rutas

  - path: /etc/motd
    permissions: '0644'
    owner: root:root
    content: |
      ============================================================================
                       🎫 INCIDENT RESPONSE LAB J01-V01
      ============================================================================
      🚨 INCIDENTE: FIREWALL BLOQUEA ICMP + RUTAS
      🎯 OBJETIVO: Restaurar conectividad completa
      📍 student@RHCSA Labs - lab-j01-v01
      ============================================================================

runcmd:
  # 🔥 FIREWALL V01 - ICMP + RUTAS BLOQUEADAS
  - firewall-cmd --permanent --zone=public --add-rich-rule='rule family="ipv4" source address="192.168.122.1" protocol="icmp" drop'
  - firewall-cmd --permanent --zone=public --add-rich-rule='rule family="ipv4" destination address="8.8.8.8" drop'
  - firewall-cmd --reload
  - hostnamectl set-hostname lab-j01-v01
