
#cloud-config
# scenarios/junior/J01/cloudinit/V01/user-data
write_files:
  - path: /etc/lab.info
    permissions: '0644'
    owner: root:root
    content: |
      LAB=J01
      LEVEL=Junior
      VARIANT=V01
      STATUS=cloud-init-ok

  - path: /etc/motd
    permissions: '0644'
    owner: root:root
    content: |
      ============================================================================
                       🎫 INCIDENT RESPONSE LAB J01-V01
      ============================================================================
      🚨 INCIDENTE: $(hostname)
      📍 student@RHCSA Labs
      ============================================================================

runcmd:
  - systemctl restart cloud-init
