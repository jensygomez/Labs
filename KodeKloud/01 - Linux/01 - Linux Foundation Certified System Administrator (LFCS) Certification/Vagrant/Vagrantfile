# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "generic/rocky9"

  config.vm.provider :libvirt do |libvirt|
    libvirt.memory = 1024
    libvirt.cpus   = 1
  end

  # ==============================================================
  # dns01
  # ==============================================================
  config.vm.define "dns01" do |dns|
    dns.vm.hostname = "dns01.corp.internal"
    dns.vm.network "private_network", ip: "192.168.100.53"

    dns.vm.provision "shell", inline: <<-SHELL
      set -e
      echo "=== Configurando dns01 ==="
      dnf install -y bind bind-utils chrony net-tools

      tee /var/named/corp.internal.db > /dev/null << 'ENDZONE'
$TTL 86400
@   IN  SOA dns01.corp.internal. admin.corp.internal. (2026060801 3600 1800 604800 86400)
        IN  NS   dns01.corp.internal.
dns01   IN  A    192.168.100.53
web01   IN  A    192.168.100.20
ENDZONE

      tee /var/named/100.168.192.in-addr.arpa.db > /dev/null << 'ENDRZONE'
$TTL 86400
@   IN  SOA dns01.corp.internal. admin.corp.internal. (2026060801 3600 1800 604800 86400)
        IN  NS  dns01.corp.internal.
20  IN  PTR web01.corp.internal.
53  IN  PTR dns01.corp.internal.
ENDRZONE

      chown named:named /var/named/*.db
      chmod 640 /var/named/*.db

      tee /etc/named.conf > /dev/null << 'ENDNAMED'
options {
    listen-on port 53 { 127.0.0.1; 192.168.100.53; };
    listen-on-v6 { none; };
    directory "/var/named";
    allow-query { any; };
    recursion no;
};
zone "corp.internal" { type master; file "corp.internal.db"; };
zone "100.168.192.in-addr.arpa" { type master; file "100.168.192.in-addr.arpa.db"; };
ENDNAMED

      systemctl enable named --now
      iptables -A INPUT -p tcp --dport 53 -j ACCEPT
      iptables -A INPUT -p udp --dport 53 -j ACCEPT

      echo "=== dns01 listo ==="
    SHELL
  end

  # ==============================================================
  # web01
  # ==============================================================
  config.vm.define "web01" do |web|              # <-- esto faltaba
    web.vm.hostname = "web01.corp.internal"
    web.vm.network "private_network", ip: "192.168.100.20"

    web.vm.provision "shell", inline: <<-SHELL
      set -e
      echo "=== Configurando web01 ==="

      dnf install -y nginx

      tee /etc/nginx/nginx.conf > /dev/null << 'ENDNGINX'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /run/nginx.pid;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;
    server {
        listen 80;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;
    }
}
ENDNGINX

      nginx -t
      echo "<h1>Web01</h1><p>IP: 192.168.100.20</p>" > /usr/share/nginx/html/index.html

      systemctl enable nginx --now

      firewall-cmd --add-port=80/tcp --permanent 2>/dev/null || true
      firewall-cmd --reload 2>/dev/null || true

      echo "Esperando dns01..."
      timeout 30 bash -c 'until nc -z 192.168.100.53 53; do sleep 2; done' || echo "DNS timeout, continuando..."

      echo "nameserver 192.168.100.53" > /etc/resolv.conf

      echo "=== web01 listo ==="
    SHELL
  end

  # ==============================================================
  # admin
  # ==============================================================
  config.vm.define "admin" do |admin|
    admin.vm.hostname = "admin-client"
    admin.vm.network "private_network", ip: "192.168.100.10"

    admin.vm.provision "shell", inline: <<-SHELL
      set -e
      echo "=== Configurando admin-client ==="

      dnf install -y curl bind-utils vim net-tools

      until nc -z 192.168.100.53 53 2>/dev/null; do sleep 2; done

      echo "nameserver 192.168.100.53" > /etc/resolv.conf
      echo "192.168.100.20 web01.corp.internal web01" >> /etc/hosts

      echo "Prueba de resolución:"
      dig +short web01.corp.internal

      echo "=== admin-client listo ==="
    SHELL
  end
end
