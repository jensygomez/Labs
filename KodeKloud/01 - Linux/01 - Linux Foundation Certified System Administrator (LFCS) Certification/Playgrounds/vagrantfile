# -*- mode: ruby -*-

# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"

  nodes = [
    { name: "node01", ip: "192.168.122.11", extra_disks: [] },
    { name: "node02", ip: "192.168.122.12", extra_disks: [] },
    { name: "node03", ip: "192.168.122.13", extra_disks: [] }
  ]

  nodes.each do |node|
    config.vm.define node[:name] do |node_config|
      node_config.vm.hostname = node[:name]

      # Interfaz principal de gestión (acceso SSH)
      node_config.vm.network "private_network",
        ip: node[:ip],
        libvirt__network_name: "mgmt",
        libvirt__dhcp_enabled: false

      # Interfaz secundaria para comunicación interna (red aislada)
      if node[:name] == "node02" || node[:name] == "node03"
        node_config.vm.network "private_network",
          ip: (node[:name] == "node02" ? "10.99.99.2" : "10.99.99.3"),
          libvirt__network_name: "cluster-internal",
          libvirt__dhcp_enabled: false
      end

      node_config.vm.provider "libvirt" do |lv|
        lv.memory = 1024
        lv.cpus = 1
        lv.driver = "kvm"
        node[:extra_disks].each do |size|
          lv.storage :file, size: size, type: "qcow2"
        end
      end

      # ── PROVISIONADO GENERAL (Todos los nodos) ──
      node_config.vm.provision "shell", inline: <<-SHELL
        echo "🔧 Configurando #{node[:name]}..."

        # 1. Resolver nombres de host localmente
        cat << 'HOSTS' >> /etc/hosts
192.168.122.11 node01
192.168.122.12 node02
192.168.122.13 node03
10.99.99.2 node02-internal
10.99.99.3 node03-internal
HOSTS

        # 2. Crear usuario bob y dar permisos
        useradd -m -s /bin/bash bob
        echo 'bob:caleston123' | chpasswd
        echo 'bob ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/bob
        chmod 0440 /etc/sudoers.d/bob

        # 3. Instalar herramientas esenciales
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq
        apt-get install -y -qq sshpass net-tools iproute2 iptables-persistent
        echo "iptables-persistent iptables-persistent/autosave_v4 boolean false" | debconf-set-selections
        echo "iptables-persistent iptables-persistent/autosave_v6 boolean false" | debconf-set-selections
      SHELL

      # ── PROVISIONADO ESPECÍFICO: TICKET EN NODE01 ──
      if node[:name] == "node01"
        node_config.vm.provision "shell", privileged: false, inline: <<-SHELL
          echo "🎫 Generando Ticket de Incidente para node01..."

          cat << 'TICKET' > /home/vagrant/TICKET_NET-005.txt
================================================================================
  TICKET NET-005  │  Severidad: CRÍTICA  │  Ambiente: RED SEGMENTADA
================================================================================
  🧠 NET-005-MN — El Túnel Torcido: Fallo en DNAT y SNAT (Masquerade)
  Módulo: Networking  │  Dificultad: 6/10  │  Nivel: L2
--------------------------------------------------------------------------------
  Ubicación de Control:  node01  (Estación del Administrador — bob)
  Nodo Router/Gateway:   node02  (Doble homing: mgmt + cluster-internal)
  Nodo Aislado:          node03  (Red interna, sin salida directa a internet)
  Contraseña del Clúster: caleston123
--------------------------------------------------------------------------------
  REPORTE DE INCIDENTE:
  El equipo de desarrollo desplegó una base de datos PostgreSQL en node03
  (puerto 5432) dentro de la red interna del clúster (10.99.99.0/24). Por
  política de seguridad, node03 NO tiene IP pública ni salida directa a
  internet. Se requiere que:

    (a) El tráfico externo que llegue al puerto 8080 de node02 sea redirigido
        de forma transparente al puerto 5432 de node03 (port forwarding / DNAT).
    (b) node03 tenga salida a internet a través de node02 para descargar
        actualizaciones de paquetes (SNAT / Masquerade).

  Sin embargo, tras la migración, los desarrolladores reportan dos fallos:
    - Las conexiones al puerto 8080 de node02 son rechazadas (connection refused).
    - node03 no puede hacer ping a 8.8.8.8 ni resolver DNS.

  Como Ingeniero de Sistemas L2, su misión es diagnosticar y corregir la
  cadena completa de NAT: habilitar el reenvío IP, configurar DNAT en
  PREROUTING, SNAT/Masquerade en POSTROUTING, y asegurar que node03 tenga
  gateway correcto apuntando a node02.

  ARQUITECTURA DE RED
  --------------------------------------------------------------------------------
  Red de Gestión (SSH):      192.168.122.0/24
  Red Interna del Clúster:   10.99.99.0/24
  Interfaz mgmt node02:      192.168.122.12
  Interfaz interna node02:   10.99.99.2   <-- Gateway esperado para node03
  Interfaz interna node03:   10.99.99.3   <-- Sin IP pública
  Servicio destino:          PostgreSQL en node03:5432
  Puerto expuesto:           node02:8080  --> node03:5432
  Herramientas Requeridas:   iptables, sysctl, ip route, tcpdump, ss, nc

  PROCEDIMIENTO REQUERIDO
  --------------------------------------------------------------------------------
  1. Diagnóstico Inicial:
     - Verificar el estado de ip_forward en node02 (sysctl net.ipv4.ip_forward).
     - Verificar la tabla de enrutamiento de node03 (ip route show).
     - Inspeccionar la tabla NAT de node02 (iptables -t nat -L -n -v).

  2. Habilitar Reenvío IP (IP Forwarding):
     - Activar net.ipv4.ip_forward=1 en node02 de forma temporal y persistente.

  3. Configurar DNAT (Port Forwarding):
     - En node02, cadena PREROUTING de la tabla nat, redirigir tcp/8080
       hacia 10.99.99.3:5432.

  4. Configurar SNAT / Masquerade:
     - En node02, cadena POSTROUTING de la tabla nat, enmascarar el tráfico
       saliente desde 10.99.99.0/24 a través de la interfaz de gestión
       (o la interfaz de salida hacia internet).

  5. Corregir Enrutamiento en node03:
     - Asegurar que node03 tenga una ruta por defecto apuntando a 10.99.99.2
       (node02-internal), de forma persistente.

  6. Persistencia:
     - Asegurar que ip_forward, reglas iptables y rutas sobrevivan al reinicio.

  7. Pipeline de Evidencia a node03:
     - Destino: /opt/ops-compliance/net-005/nat_evidence.txt
     - Desde node01, construya un pipeline SSH que entregue evidencia de:
       a) Salida de `iptables -t nat -L -n -v` en node02 mostrando las reglas
          DNAT y MASQUERADE activas.
       b) Salida de `sysctl net.ipv4.ip_forward` en node02 (debe ser = 1).
       c) Prueba de DNAT: conexión exitosa desde node01 a node02:8080 que
          llegue al PostgreSQL de node03 (p.ej. nc -zv node02 8080 o similar).
       d) Prueba de SNAT: ping exitoso desde node03 hacia 8.8.8.8.
     - CERO archivos temporales en node01.

  CRITERIOS DE ACEPTACIÓN
  --------------------------------------------------------------------------------
   [ ] ip_forward = 1 en node02 (persistente)                            --> 15%
   [ ] Regla DNAT funcional: node02:8080 → node03:5432                   --> 25%
   [ ] Regla SNAT/MASQUERADE funcional para 10.99.99.0/24                --> 25%
   [ ] node03 con gateway correcto y salida a internet (ping 8.8.8.8)    --> 15%
   [ ] Evidencia enviada a node03:/opt/ops-compliance/net-005/           --> 15%
   [ ] CERO archivos de resultados almacenados en node01  (DESCALIFICA)  -->  5%

  REGLA DE ORO: No deshabilite el firewall completamente. La solución debe
  ser quirúrgica sobre la tabla NAT. La evidencia debe fluir por pipeline SSH
  sin dejar rastros en node01.
================================================================================
TICKET

          # ── SCRIPT DE VERIFICACIÓN CORREGIDO ──
          cat << 'VERIFY' > /home/vagrant/verify_scenario.sh
#!/bin/bash

echo "🔍 Verificando estado del escenario NET-005..."
echo "================================================================"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

remote_exec() {
    local node="$1"
    local cmd="$2"
    sshpass -p 'caleston123' ssh -o StrictHostKeyChecking=no -o ConnectTimeout=2 bob@"$node" "$cmd" 2>/dev/null
}

check_status() {
    if [ $1 -eq 0 ]; then
        echo -e "${GREEN}✓${NC} $2"
    else
        echo -e "${RED}✗${NC} $2"
    fi
}

echo ""
echo "📡 Verificando conectividad básica..."
ping -c 1 -W 1 192.168.122.12 > /dev/null 2>&1
check_status $? "node02 (mgmt) accesible"

ping -c 1 -W 1 192.168.122.13 > /dev/null 2>&1
check_status $? "node03 (mgmt) accesible"

echo ""
echo "🖥️  Verificando estado de node02 (Router/Gateway)..."

IP_FORWARD=$(remote_exec "node02" "sysctl -n net.ipv4.ip_forward")
if [ -z "$IP_FORWARD" ]; then
    echo -e "${RED}✗${NC} No se pudo obtener ip_forward"
else
    if [ "$IP_FORWARD" = "0" ]; then
        echo -e "${GREEN}✓${NC} ip_forward = 0 (DESHABILITADO como esperado)"
    else
        echo -e "${RED}✗${NC} ip_forward = $IP_FORWARD (debería ser 0)"
    fi
fi

NAT_RULES=$(remote_exec "node02" "iptables -t nat -L -n | grep -E '(DNAT|MASQUERADE|SNAT)' | wc -l")
if [ -z "$NAT_RULES" ]; then
    echo -e "${RED}✗${NC} No se pudo obtener reglas NAT"
else
    if [ "$NAT_RULES" -eq 0 ]; then
        echo -e "${GREEN}✓${NC} Tabla NAT vacía (sin reglas DNAT/SNAT)"
    else
        echo -e "${RED}✗${NC} Tabla NAT tiene $NAT_RULES reglas (debería estar vacía)"
    fi
fi

echo ""
echo "🗄️  Verificando estado de node03 (Servidor Aislado)..."

PG_STATUS=$(remote_exec "node03" "systemctl is-active postgresql")
if [ -z "$PG_STATUS" ]; then
    echo -e "${RED}✗${NC} No se pudo obtener estado de PostgreSQL"
else
    if [ "$PG_STATUS" = "active" ]; then
        echo -e "${GREEN}✓${NC} PostgreSQL activo en node03"
    else
        echo -e "${RED}✗${NC} PostgreSQL no está activo (estado: $PG_STATUS)"
    fi
fi

PORT_CHECK=$(remote_exec "node03" "ss -tlnp | grep ':5432' | wc -l")
if [ -z "$PORT_CHECK" ]; then
    echo -e "${RED}✗${NC} No se pudo verificar puerto 5432"
else
    if [ "$PORT_CHECK" -gt 0 ]; then
        echo -e "${GREEN}✓${NC} Puerto 5432 escuchando en node03"
    else
        echo -e "${RED}✗${NC} Puerto 5432 NO está escuchando"
    fi
fi

GATEWAY=$(remote_exec "node03" "ip route show default | wc -l")
if [ -z "$GATEWAY" ]; then
    echo -e "${RED}✗${NC} No se pudo verificar gateway"
else
    if [ "$GATEWAY" -eq 0 ]; then
        echo -e "${GREEN}✓${NC} node03 SIN gateway por defecto (aislado)"
    else
        echo -e "${RED}✗${NC} node03 tiene gateway configurado (debería estar aislado)"
    fi
fi

INTERNET_CHECK=$(remote_exec "node03" "timeout 2 ping -c 1 8.8.8.8 > /dev/null 2>&1; echo \$?")
if [ -z "$INTERNET_CHECK" ]; then
    echo -e "${RED}✗${NC} No se pudo verificar salida a internet"
else
    if [ "$INTERNET_CHECK" != "0" ]; then
        echo -e "${GREEN}✓${NC} node03 NO tiene salida a internet (como esperado)"
    else
        echo -e "${RED}✗${NC} node03 SÍ puede salir a internet (no debería)"
    fi
fi

echo ""
echo "🔌 Verificando el problema de DNAT..."
timeout 3 bash -c "echo > /dev/tcp/node02/8080" 2>/dev/null
if [ $? -ne 0 ]; then
    echo -e "${GREEN}✓${NC} Puerto 8080 en node02 NO redirige a node03 (fallo esperado)"
else
    echo -e "${YELLOW}!${NC} Puerto 8080 en node02 responde (DNAT podría estar funcionando)"
fi

echo ""
echo "================================================================"
echo -e "${GREEN}✅ Escenario NET-005 verificado y listo para resolver${NC}"
echo ""
echo "Resumen del estado:"
echo "  • node02: ip_forward=0, tabla NAT vacía"
echo "  • node03: PostgreSQL en 5432, sin gateway, aislado"
echo "  • Problema: DNAT 8080→5432 no funciona, node03 sin internet"
echo ""
echo "Tu misión: Configurar NAT completo para que:"
echo "  1) node02:8080 redirija a node03:5432 (DNAT)"
echo "  2) node03 tenga salida a internet via node02 (SNAT/Masquerade)"
echo "================================================================"
VERIFY

          chmod +x /home/vagrant/verify_scenario.sh
          chown vagrant:vagrant /home/vagrant/verify_scenario.sh

          # Mostrar ticket y verificación al hacer login
          sed -i '/TICKET/d' /home/vagrant/.bashrc 2>/dev/null || true
          sed -i '/# Mostrar/d' /home/vagrant/.bashrc 2>/dev/null || true
          sed -i '/verify_scenario/d' /home/vagrant/.bashrc 2>/dev/null || true
          cat << 'EOF' >> /home/vagrant/.bashrc
clear
cat /home/vagrant/TICKET_NET-005.txt
echo ""
echo "Ejecutando verificación automática del escenario..."
echo ""
/home/vagrant/verify_scenario.sh
EOF
        SHELL
      end

      # ── PROVISIONADO ESPECÍFICO: INYECCIÓN DE FALLOS EN NODE02 ──
      if node[:name] == "node02"
        node_config.vm.provision "shell", privileged: true, inline: <<-SHELL
          echo "🧩 Inyectando escenario 'Túnel Torcido' en #{node[:name]}..."
          bash << 'INNEREOF'
            set -e
            sysctl -w net.ipv4.ip_forward=0
            sed -i 's/^net.ipv4.ip_forward.*/# net.ipv4.ip_forward=0/' /etc/sysctl.conf 2>/dev/null || true
            rm -f /etc/sysctl.d/99-ipforward.conf 2>/dev/null || true

            iptables -t nat -F
            iptables -t nat -X
            iptables -F
            iptables -X
            iptables -P INPUT ACCEPT
            iptables -P FORWARD ACCEPT
            iptables -P OUTPUT ACCEPT
            iptables -A INPUT -p tcp -s 192.168.122.0/24 --dport 22 -j ACCEPT

            if command -v netfilter-persistent &> /dev/null; then
               netfilter-persistent save
            elif command -v iptables-save &> /dev/null; then
               iptables-save > /etc/iptables/rules.v4
            fi
            echo "✅ Escenario inyectado en node02."
          INNEREOF
        SHELL
      end

      # ── PROVISIONADO ESPECÍFICO: NODE03 (SERVIDOR AISLADO + SIN GATEWAY) ──
      if node[:name] == "node03"
        node_config.vm.provision "shell", privileged: true, inline: <<-SHELL
          echo "🗄️  Configurando node03 como servidor aislado con PostgreSQL..."
          bash << 'INNEREOF'
            set -e
            export DEBIAN_FRONTEND=noninteractive

            apt-get update -qq
            apt-get install -y -qq postgresql postgresql-client curl netcat-openbsd iproute2

            PG_HBA=$(find /etc/postgresql -name pg_hba.conf 2>/dev/null | head -n1)
            PG_CONF=$(find /etc/postgresql -name postgresql.conf 2>/dev/null | head -n1)
            if [ -n "$PG_CONF" ]; then
              sed -i "s/^#*listen_addresses.*/listen_addresses = '*'/" "$PG_CONF"
            fi
            if [ -n "$PG_HBA" ]; then
              echo "host    all    all    10.99.99.0/24    trust" >> "$PG_HBA"
              echo "host    all    all    192.168.122.0/24 trust" >> "$PG_HBA"
            fi
            systemctl enable postgresql
            systemctl restart postgresql

            # ── ELIMINAR GATEWAY POR DEFECTO (persistente) ──
            # 1. Eliminar ruta actual de TODAS las interfaces
            ip route del default via 192.168.121.1 dev eth0 2>/dev/null || true
            ip route del default 2>/dev/null || true

            # 2. Configurar Netplan para la interfaz mgmt (la que tiene 192.168.122.13) SIN gateway
            MGMT_IFACE=$(ip -o -4 addr show | grep 192.168.122.13 | awk '{print $2}')
            if [ -n "$MGMT_IFACE" ]; then
              cat << EOF > /etc/netplan/99-custom.yaml
network:
  version: 2
  ethernets:
    $MGMT_IFACE:
      dhcp4: false
      addresses: [192.168.122.13/24]
      # sin gateway4
EOF
            fi

            # 3. Neutralizar DHCP de eth0 (para que no añada ruta por defecto)
            PHANTOM_IFACE="eth0"
            cat << EOF > /etc/netplan/98-no-default-route.yaml
network:
  version: 2
  ethernets:
    $PHANTOM_IFACE:
      dhcp4: true
      dhcp4-overrides:
        use-routes: false
EOF

            netplan apply

            # 4. Asegurar que no quede ruta por defecto tras netplan
            ip route del default via 192.168.121.1 dev eth0 2>/dev/null || true
            ip route del default 2>/dev/null || true

            # Crear bóveda de auditoría
            mkdir -p /opt/ops-compliance/net-005/
            chown -R bob:bob /opt/ops-compliance/net-005/
            chmod 750 /opt/ops-compliance/net-005/

            echo "✅ node03 listo:"
            echo "   - PostgreSQL escuchando en 0.0.0.0:5432"
            echo "   - SIN gateway por defecto (aislado de internet)"
            echo "   - Bóveda de evidencia: /opt/ops-compliance/net-005/"
          INNEREOF
        SHELL
      end
    end
  end
end
