# Sistema:       Ubuntu 24.04.4 LTS
# Kernel:        6.8.0-100-generic
# Working Dir:   /home/student/Labs
# GitHub:        https://github.com/jensygomez/Labs
# ================================================================================

# ================================================================================
#        TOPOLOGÍA FINAL DEL LABORATORIO (Namespaces + NAT)
# ================================================================================
#
#                                     Internet
#                                        ^
#                                        | (NAT / Masquerade)
#                               ┌─────────────────┐
#                               │  Host Interface │
#                               │    (enp1s0)     │
#                               └────────┬────────┘
#                                        |
#                               ┌─────────────────┐
#                               │     CORE-GW     │
#                               │  (IP: 10.0.0.1) │
#                               │  [ Bridge br0 ] │
#                               └────────┬────────┘
#                                        │
#          ┌─────────────────────────────┼─────────────────────────────┐
#          │                             │                             │
#       v-srv-gw                      v-rh-gw                       v-sys-gw
#          │                             │                             │
#          │ (Cable Veth)                │ (Cable Veth)                │ (Cable Veth)
#          │                             │                             │
#        v-srv                         v-rh                          v-sys
#    ┌─────┴─────┐                 ┌─────┴─────┐                 ┌─────┴─────┐
#    │  NS-SRV   │                 │   NS-RH   │                 │   NS-SYS  │
#    │ 10.0.0.10 │                 │ 10.0.0.20 │                 │ 10.0.0.30 │
#    └───────────┘                 └───────────┘                 └───────────┘
#
# ================================================================================

# ================================================================================
# FILOSOFÍA DE UN ARQUITECTO DE SISTEMAS: DOMINANDO EL STACK
# ================================================================================
#
# # En Linux, si no entiendes la base, eres un pasajero. Pero hoy, yo soy 
# # el que está manejando el bus. Esto no es "magia", es pura lógica UNIX.
#
# 1. EL ZEN DE LA MODULARIDAD:
#    Separé el mundo en Namespaces porque "hacer una sola cosa y hacerla bien" 
#    es el primer mandamiento. SRV, RH y SYS son piezas pequeñas que juntas 
#    arman un sistema robusto. Si uno falla, el resto ni se entera.
#
# 2. EL KERNEL COMO ÚNICA FUENTE DE VERDAD:
#    El bridge no es un aparato, es una instrucción en memoria. Entendí que 
#    en Linux la red es software. Al levantar br0, no puse un switch, 
#    creé un punto de encuentro donde yo dicto las leyes de tránsito.
#
# 3. LA ABSTRACCIÓN DEL CABLE:
#    Los veth pairs son la elegancia pura. Es entender que no necesito 
#    hardware para crear conexiones. Si el Kernel dice que esos dos puntos 
#    están unidos, entonces el universo de ese Namespace se conecta con el mío.
#
# 4. EL PODER DEL REENVÍO (FORWARDING):
#    Activar el ip_forward fue el momento clave. Es decirle al sistema: 
#    "No seas egoísta, deja que el tráfico fluya". Es la transición de 
#    ser un simple nodo a ser el eje central de la red.
#
# 5. EL ARTE DE LA TRANSPARENCIA (NAT):
#    Con el MASQUERADE apliqué la filosofía de ocultar la complejidad. 
#    El mundo afuera solo ve una IP, pero yo sé que detrás hay un diseño 
#    pensado, segmentado y eficiente. La simplicidad hacia afuera, 
#    la potencia hacia adentro.
#
# # Profundizar en Linux es darse cuenta de que la terminal es un pincel. 
# # No estoy configurando una red, estoy escribiendo el comportamiento de 
# # los paquetes. Si el ping responde, es porque mi lógica es impecable.
#
# ================================================================================

# --- PASO 1: Creación de Namespaces y Bridge ---
sudo ip netns add NS-SRV
sudo ip netns add NS-RH
sudo ip netns add NS-SYS

sudo ip link add br0 type bridge
sudo ip link set br0 up

sudo ip netns exec NS-SRV ip link set lo up
sudo ip netns exec NS-RH ip link set lo up
sudo ip netns exec NS-SYS ip link set lo up

# --- PASO 2: Cableado Veth ---
sudo ip link add v-srv type veth peer name v-srv-gw
sudo ip link add v-rh type veth peer name v-rh-gw
sudo ip link add v-sys type veth peer name v-sys-gw

sudo ip link set v-srv netns NS-SRV
sudo ip link set v-rh netns NS-RH
sudo ip link set v-sys netns NS-SYS

sudo ip link set v-srv-gw master br0
sudo ip link set v-rh-gw master br0
sudo ip link set v-sys-gw master br0

sudo ip link set v-srv-gw up
sudo ip link set v-rh-gw up
sudo ip link set v-sys-gw up

# --- PASO 3: Configuración de Direccionamiento IP ---
sudo ip netns exec NS-SRV ip addr add 10.0.0.10/24 dev v-srv
sudo ip netns exec NS-SRV ip link set v-srv up

sudo ip netns exec NS-RH ip addr add 10.0.0.20/24 dev v-rh
sudo ip netns exec NS-RH ip link set v-rh up

sudo ip netns exec NS-SYS ip addr add 10.0.0.30/24 dev v-sys
sudo ip netns exec NS-SYS ip link set v-sys up

sudo ip addr add 10.0.0.1/24 dev br0

# --- PASO 4: Gateway y Salida a Internet (NAT) ---
sudo ip netns exec NS-SRV ip route add default via 10.0.0.1
sudo ip netns exec NS-RH ip route add default via 10.0.0.1
sudo ip netns exec NS-SYS ip route add default via 10.0.0.1

sudo sysctl -w net.ipv4.ip_forward=1

# Detectamos la interfaz de internet del host (enp1s0 en tu caso)
sudo iptables -t nat -A POSTROUTING -s 10.0.0.0/24 -o enp1s0 -j MASQUERADE

echo ">>> Laboratorio recreado. Verificando conexión..."
sudo ip netns exec NS-SRV ping -c 4 8.8.8.8

# ================================================================================
# SESIÓN FINALIZADA
# ================================================================================
# Fecha fin:     2026-02-15 19:04:38
# Duración:      Sesión completada
# Repositorio:   ~/Labs/labs/
# ================================================================================