#!/bin/bash

# ================================================================================
# LABORATORIO: lab-0002 - NETWORKS SEGMENTADAS CON BRIDGE INTERNO
# ================================================================================
# Fecha inicio:  2026-02-16 15:23:43
# Hostname:      ubuntu
# Usuario:       student
# Sistema:       Ubuntu 24.04.4 LTS
# Kernel:        6.8.0-100-generic
# Working Dir:   /home/student
# GitHub:        [https://github.com/jensygomez/Labs](https://github.com/jensygomez/Labs)
# ================================================================================

# ================================================================================
#        TOPOLOGÍA FINAL DEL LABORATORIO (RH con Switch Interno)
# ================================================================================
#
#                                     Internet
#                                        ^
#                               ┌─────────────────┐
#                               │  Host Interface │
#                               │    (enp1s0)     │
#                               └────────┬────────┘
#                                        |
#                               ┌─────────────────┐
#                               │     CORE-GW     │
#                               │  (IP: 10.0.0.1) │
#                               │  [ Bridge br0 ] │
#                               └────────┬────────┘
#                                        │
#                                        │  ┌─────────────────────────────┐
#                                        └──┼─────── v-rh-br ──────────────┤
#                                              │  [NS-RH - Switch Interno]  │
#                                              │  [ Bridge br-rh 10.0.0.20] │
#                                              │        │                    │
#                                              └────────┼────────────────────┘
#                                                       │  v-u1-br
#                                                       │
#                                                ┌──────┴──────┐
#                                                │  NS-USER-RH-1│
#                                                │    10.0.0.21 │
#                                                └──────────────┘
#
# ================================================================================

# ================================================================================
# FILOSOFÍA DE UN ARQUITECTO DE REDES: SEGMENTACIÓN AVANZADA
# ================================================================================
#
# # Este laboratorio demuestra el poder de la segmentación jerárquica.
# # No solo aislamos departamentos, creamos switches internos.
#
# 1. EL BRIDGE COMO GATEWAY CENTRAL:
#    br0 no es solo un puente, es el cerebro de la red. Controla el flujo
#    entre departamentos y decide quién habla con quién.
#
# 2. SWITCH INTERNO POR DEPARTAMENTO:
#    NS-RH tiene su propio bridge (br-rh) actuando como switch L2 interno.
#    Esto permite escalabilidad: podemos agregar 10, 20, 50 usuarios RH
#    sin tocar el CORE-GW.
#
# 3. JERARQUÍA DE CONECTIVIDAD:
#    USER-RH-1 → br-rh (10.0.0.20) → br0 (10.0.0.1) → Internet
#    Cada capa conoce solo su vecino inmediato. Escalabilidad pura.
#
# 4. LA BELLEZA DE LOS VETH PAIRS:
#    Un solo par veth conecta mundos enteros. v-rh-br lleva todo el tráfico
#    del switch interno RH hacia el CORE-GW. Elegancia kernel-level.
#
# 5. VERIFICACIÓN END-TO-END:
#    USER-RH-1 pings br-rh ✓ | br-rh pings CORE-GW ✓ | Próximo paso: Internet
#
# # Linux networking = Software Defined Networking casero. Gratis. Potente.
#
# ================================================================================

# --- PASO 1: CORE BRIDGE (Gateway Principal) ---
echo "🎯 PASO 1: Creando CORE BRIDGE (Gateway Principal)"
sudo ip link add name br0 type bridge
sudo ip link set br0 up
sudo ip addr add 10.0.0.1/24 dev br0
sudo ip addr show br0

# --- PASO 2: NAMESPACE RH + Cableado al CORE ---
echo "🏢 PASO 2: Namespace RH + Conexión al CORE-GW"
sudo ip netns add NS-RH
sudo ip link add v-rh type veth peer name v-rh-br
sudo ip link set v-rh-br master br0
sudo ip link set v-rh netns NS-RH
sudo ip netns exec NS-RH ip link set lo up
sudo ip netns exec NS-RH ip link set v-rh up
sudo ip netns exec NS-RH ip addr add 10.0.0.20/24 dev v-rh
sudo ip netns exec NS-RH ping -c4 10.0.0.1

# --- PASO 3: SWITCH INTERNO EN RH ---
echo "🔄 PASO 3: Switch Interno (br-rh) en Namespace RH"
sudo ip netns exec NS-RH ip link add name br-rh type bridge
sudo ip netns exec NS-RH ip link set br-rh up
sudo ip netns exec NS-RH ip addr del 10.0.0.20/24 dev v-rh
sudo ip netns exec NS-RH ip link set v-rh master br-rh
sudo ip netns exec NS-RH ip addr add 10.0.0.20/24 dev br-rh
sudo ip netns exec NS-RH ping -c4 10.0.0.1

# --- PASO 4: USUARIO FINAL EN RH ---
echo "👤 PASO 4: Usuario Final (USER-RH-1) en Switch RH"
sudo ip netns add USER-RH-1
sudo ip link add v-u1 type veth peer name v-u1-br
sudo ip link set v-u1-br netns NS-RH
sudo ip netns exec NS-RH ip link set v-u1-br master br-rh
sudo ip netns exec NS-RH ip link set v-u1-br up
sudo ip link set v-u1 netns USER-RH-1
sudo ip netns exec USER-RH-1 ip link set lo up
sudo ip netns exec USER-RH-1 ip link set v-u1 up
sudo ip netns exec USER-RH-1 ip addr add 10.0.0.21/24 dev v-u1

# --- PASO 5: VERIFICACIONES FINALES ---
echo "✅ PASO 5: Verificación End-to-End"
sudo ip netns exec USER-RH-1 ping -c4 10.0.0.20  # Switch RH interno
sudo ip netns exec USER-RH-1 ping -c4 10.0.0.1   # CORE-GW

echo "🎉 LABORATORIO COMPLETADO: Segmentación jerárquica funcionando!"
echo "📊 USER-RH-1 → Switch-RH → CORE-GW ✓"

# ================================================================================
# SESIÓN FINALIZADA
