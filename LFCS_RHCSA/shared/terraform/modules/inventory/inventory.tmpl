---
all:
  children:
%{ for role, group_name in role_group_map ~}
    ${group_name}:
      hosts:
%{ for k, node in nodes ~}
%{ if node.role == role ~}
        ${node.name}:
          ansible_host: ${split("/", node.ip)[0]}
%{ endif ~}
%{ endfor ~}
%{ endfor ~}
  vars:
    ansible_user: ansible
    ansible_ssh_private_key_file: ~/.ssh/id_systech_control
    ansible_python_interpreter: /usr/bin/python3
