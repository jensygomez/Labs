# ═══════════════════════════════════════════════════════════════════════════════
# 7. EVIDENCIAS TÉCNICAS - AUTOGRADING / AUDITORÍA
#═══════════════════════════════════════════════════════════════════════════════
  # Estados servicios
  - systemctl is-active nginx > /etc/j01-v01-nginx.status
  - systemctl is-active firewalld > /etc/j01-v01-firewalld.status
  - firewall-cmd --list-all > /etc/j01-v01-firewall.state
  - ss -tuln > /etc/j01-v01-ports.state
  - ip addr show enp1s0 > /etc/j01-v01-network.state

  # Flags canónicos
  - echo "J01 V01 - Firewall bloquea HTTP (nginx activo)" > /etc/j01-variant-v01.flag
  - echo "J01 BASE + V01 aplicada correctamente - IP:192.168.122.20" > /etc/j01-base.flag

  # Log auditoría
  - echo "=== J01-V01 DEPLOY COMPLETED $(date)" >> /var/log/j01-v01-network.log

