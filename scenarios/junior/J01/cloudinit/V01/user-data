#cloud-config
#
# ============================================================================
# J01 – V01 (DEBUG)
# Objetivo: Verificar que cloud-init se ejecuta en la VM CLONADA
# ============================================================================

write_files:
  - path: /etc/lab.info
    permissions: '0644'
    content: |
      LAB=J01
      LEVEL=Junior
      VARIANT=V01
      STATUS=cloud-init-ok

  - path: /etc/motd
    permissions: '0644'
    content: |
      ============================================================================
                       🎫 INCIDENT RESPONSE LAB – J01 / V01
      ============================================================================
      cloud-init FUE EJECUTADO CORRECTAMENTE

      Fecha: $(date)
      Host : $(hostname)

      Si puedes leer esto, el user-data está siendo aplicado.
      ============================================================================
