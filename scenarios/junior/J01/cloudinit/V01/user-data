# ═══════════════════════════════════════════════════════════════════════════════
# 1. CONFIGURACIÓN DE RED - IP ADMINISTRATIVA FIJA (CRÍTICO)
#═══════════════════════════════════════════════════════════════════════════════
runcmd:
  # IP ESTÁTICA para lab
  - nmcli con mod enp1s0 ipv4.method manual ipv4.addresses 192.168.122.20/24 ipv4.gateway 192.168.122.1 ipv4.dns "8.8.8.8 1.1.1.1" || true
  - nmcli con down enp1s0 || true
  - nmcli con up enp1s0
  - echo "[V01] IP fija aplicada: 192.168.122.20" > /var/log/j01-v01-network.log

# ═══════════════════════════════════════════════════════════════════════════════
# 2. SERVICIOS BASE - NGINX ACTIVO
#═══════════════════════════════════════════════════════════════════════════════
  # Nginx corriendo y escuchando puerto 80
  - dnf install -y nginx || true
  - systemctl enable --now nginx
  - echo "[V01] Nginx activado y escuchando puerto 80" >> /var/log/j01-v01-network.log

  # firewalld activo (SSH permitido por defecto)
  - systemctl enable --now firewalld
  - echo "[V01] firewalld activado" >> /var/log/j01-v01-network.log

# ═══════════════════════════════════════════════════════════════════════════════
# 3. FALLLO ESPECÍFICO V01 - FIREWALL BLOQUEA HTTP
#═══════════════════════════════════════════════════════════════════════════════
  # REMOVER explícitamente servicio HTTP (bloqueo intencional)
  - firewall-cmd --permanent --remove-service=http || true
  - firewall-cmd --permanent --remove-port=80/tcp || true
  - firewall-cmd --reload
  - echo "[V01] HTTP bloqueado intencionalmente por firewalld" >> /var/log/j01-v01-network.log

# ═══════════════════════════════════════════════════════════════════════════════
# 4. CONTENIDO NGINX - PÁGINA DE ÉXITO
#═══════════════════════════════════════════════════════════════════════════════
  - |
    cat << 'EOF' > /var/www/html/index.html
    <!DOCTYPE html>
    <html>
    <head>
        <title>J01-V01 NOC Junior Lab - Firewall HTTP</title>
        <meta charset="UTF-8">
        <style>
            body { font-family: monospace; background: #000; color: #0f0; padding: 20px; }
            h1 { color: #00ff00; }
            .status { background: #111; padding: 15px; border: 1px solid #0f0; }
            .fixed { color: #ff0; }
        </style>
    </head>
    <body>
        <h1>🏆 J01-V01 RESUELTO CORRECTAMENTE</h1>
        <div class="status">
            <h2>Diagnóstico Estudiante:</h2>
            <ul>
                <li><b>✓</b> ping 192.168.122.20 → OK</li>
                <li><b>✓</b> nginx: active (running) puerto 80</li>
                <li><b>✗→✓</b> firewalld: http service AGREGADO</li>
            </ul>
            <h2 class="fixed">Comando de corrección:</h2>
            <pre>firewall-cmd --permanent --add-service=http && firewall-cmd --reload</pre>
        </div>
    </body>
    </html>
    EOF

  # Permisos nginx
  - restorecon -R /var/www/html
  - chown -R nginx:nginx /var/www/html
  - chmod 644 /var/www/html/index.html

# ═══════════════════════════════════════════════════════════════════════════════
# 5. DOCUMENTACIÓN DEL ESCENARIO - VISIBLE PARA ESTUDIANTE
#═══════════════════════════════════════════════════════════════════════════════
  - |
    cat << 'EOF' > /etc/j01-scenario.txt
    ════════════════════════════════════════════════════════════════════════════════
    
                LAB J01-V01: Redes y Conectividad - Firewall HTTP
    
    ════════════════════════════════════════════════════════════════════════════════
    
    ROL: NOC Engineer Junior / SysAdmin en entrenamiento
    
    TOPOLOGÍA:
      HOST (tu laptop)  ───[ INTERNET ]───  SERVER_EU (esta VM: 192.168.122.20)
    
    OBJETIVO:
      Resolver: curl http://192.168.122.20 → página NOC Lab
    
    SÍNTOMAS OBSERVADOS:
    ┌─────────────────────────────────────────────────────────────┐
    │ HOST$ ping 192.168.122.20             → OK (1ms)            │
    │ HOST$ ssh student@192.168.122.20      → OK                  │
    │ HOST$ curl http://192.168.122.20      → Connection refused  │
    └─────────────────────────────────────────────────────────────┘
    
    HERRAMIENTAS ESPERADAS:
      • ping, curl, nc -zv 192.168.122.20 80
      • ss -tuln | grep :80
      • systemctl status nginx
      • firewall-cmd --list-all
    
    RESTRICCIONES:
      • NO deshabilites firewalld (solo agrega regla)
      • NO reinstales nginx
