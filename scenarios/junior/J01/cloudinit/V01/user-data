#cloud-config
write_files:
  - path: /etc/lab.info
    permissions: '0644'
    content: |
      LAB=J01
      LEVEL=Junior
      VARIANT=V01
      INCIDENT=ICMP y conectividad externa bloqueadas por firewall

  - path: /etc/motd
    permissions: '0644'
    content: |
      ============================================================================
                    INCIDENT RESPONSE LAB J01 – V01
      ============================================================================
      INCIDENTE: No hay ping al gateway ni a Internet
      OBJETIVO : Diagnosticar bloqueo de red (Firewall)
      JENSY GOMEZ
      ============================================================================
      NOTA: Acceso remoto disponible (SSH)
      ============================================================================

runcmd:
  - sleep 10

  # 1. Garantizar canal de gestión (SSH desde host)
  - firewall-cmd --permanent --zone=public --add-rich-rule='rule family="ipv4" source address="192.168.122.1" port port="22" protocol="tcp" accept'

  # 2. Bloquear ICMP (entrada y salida)
  - firewall-cmd --permanent --zone=public --add-rich-rule='rule protocol="icmp" drop'

  # 3. Bloquear salida a Internet (excepto red local)
  - firewall-cmd --permanent --zone=public --add-rich-rule='rule family="ipv4" destination NOT address="192.168.122.0/24" drop'

  - firewall-cmd --reload
  - hostnamectl set-hostname lab-j01-v01
