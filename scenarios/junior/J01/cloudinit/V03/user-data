# ═══════════════════════════════════════════════════════════════════════════════
# 6. EVIDENCIAS TÉCNICAS - AUTOGRADING / AUDITORÍA
#═══════════════════════════════════════════════════════════════════════════════
  # Estado servicios
  - systemctl is-active nginx > /etc/j01-v03-nginx.status
  - systemctl is-active firewalld > /etc/j01-v03-firewalld.status

  # Estado red y puertos
  - cp /etc/nginx/nginx.conf /etc/j01-v03-nginx.conf.state
  - ss -tuln > /etc/j01-v03-ports.state
  - ip addr show enp1s0 > /etc/j01-v03-network.state
  - firewall-cmd --list-all > /etc/j01-v03-firewall.state

  # Flags canónicos
  - echo "J01 V03 - Nginx puerto 8080 (esperado 80)" > /etc/j01-variant-v03.flag
  - echo "J01 BASE + V03 aplicada correctamente - IP:192.168.122.30" > /etc/j01-base.flag

  # Log de auditoría completo
  - echo "=== J01-V03 DEPLOY COMPLETED $(date)" >> /var/log/j01-v03-network.log
  - echo "IP: 192.168.122.30" >> /var/log/j01-v03-network.log
  - echo "Nginx FAIL: listen 8080 (esperado 80)" >> /var/log/j01-v03-network.log
  - echo "Firewall OK: puerto 80 permitido" >> /var/log/j01-v03-network.log

