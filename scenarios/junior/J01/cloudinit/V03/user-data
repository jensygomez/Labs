# ═══════════════════════════════════════════════════════════════════════════════
# 1. CONFIGURACIÓN DE RED - IP ADMINISTRATIVA FIJA (CRÍTICO)
#═══════════════════════════════════════════════════════════════════════════════
runcmd:
  # IP ESTÁTICA para lab (distinta de base para evitar conflictos)
  - nmcli con mod enp1s0 ipv4.method manual ipv4.addresses 192.168.122.30/24 ipv4.gateway 192.168.122.1 ipv4.dns "8.8.8.8 1.1.1.1" || true
  - nmcli con down enp1s0 || true
  - nmcli con up enp1s0
  - echo "[V03] IP fija aplicada: 192.168.122.30" > /var/log/j01-v03-network.log

# ═══════════════════════════════════════════════════════════════════════════════
# 2. SERVICIOS BASE - NGINX ACTIVO PUERTO 8080 (NO 80!)
#═══════════════════════════════════════════════════════════════════════════════
  # Firewall ABIERTO puerto 80 (¡PERO NGINX NO lo usa!)
  - systemctl enable --now firewalld
  - firewall-cmd --permanent --add-service=http
  - firewall-cmd --permanent --add-service=ssh
  - firewall-cmd --reload
  - echo "[V03] Firewall permite HTTP (nginx usa 8080)" >> /var/log/j01-v03-network.log

  # Nginx en puerto 8080 (FALLO ESPECÍFICO V03)
  - dnf install -y nginx || true
  - |
    sed -i 's/listen\s*80;/listen 8080;/g' /etc/nginx/nginx.conf
  - nginx -t || true
  - systemctl enable --now nginx
  - echo "[V03] Nginx reconfigurado puerto 8080" >> /var/log/j01-v03-network.log

# ═══════════════════════════════════════════════════════════════════════════════
# 3. FALLLO ESPECÍFICO V03 - NGINX ESCUCHA PUERTO 8080
#═══════════════════════════════════════════════════════════════════════════════
  # Config nginx explícita puerto 8080
  - |
    cat << 'EOF' > /etc/nginx/conf.d/j01-v03.conf
    server {
        listen 8080;
        server_name _;
        
        location / {
            root /var/www/html;
            index index.html;
        }
    }
    EOF
  - nginx -t && systemctl reload nginx || true
  - echo "[V03] nginx.conf: listen 8080 (FALLO INTENCIONAL)" >> /var/log/j01-v03-network.log

