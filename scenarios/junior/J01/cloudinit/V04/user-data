# ═══════════════════════════════════════════════════════════════════════════════
# 6. EVIDENCIAS TÉCNICAS - AUTOGRADING / AUDITORÍA
#═══════════════════════════════════════════════════════════════════════════════
  # Estado servicios
  - systemctl is-active nginx > /etc/j01-v04-nginx.status
  - systemctl is-active firewalld > /etc/j01-v04-firewalld.status

  # Estado red y tc
  - tc qdisc show dev enp1s0 > /etc/j01-v04-tc.state
  - ip addr show enp1s0 > /etc/j01-v04-network.state
  - firewall-cmd --list-all > /etc/j01-v04-firewall.state
  - ss -tuln > /etc/j01-v04-ports.state

  # Flags canónicos
  - echo "J01 V04 - tc netem delay 500ms 10% loss" > /etc/j01-variant-v04.flag
  - echo "J01 BASE + V04 aplicada correctamente - IP:192.168.122.40" > /etc/j01-base.flag

  # Log de auditoría completo
  - echo "=== J01-V04 DEPLOY COMPLETED $(date)" >> /var/log/j01-v04-network.log
  - echo "IP: 192.168.122.40" >> /var/log/j01-v04-network.log
  - echo "tc qdisc: delay 500ms 100ms loss 10%" >> /var/log/j01-v04-network.log

# ═══════════════════════════════════════════════════════════════════════════════
# 7. SELINUX Y PERMISOS - CONSISTENCIA
