# ═══════════════════════════════════════════════════════════════════════════════
# 1. CONFIGURACIÓN DE RED - IP ADMINISTRATIVA FIJA (CRÍTICO)
#═══════════════════════════════════════════════════════════════════════════════
runcmd:
  # IP ESTÁTICA para lab (distinta de base para evitar conflictos)
  - nmcli con mod enp1s0 ipv4.method manual ipv4.addresses 192.168.122.40/24 ipv4.gateway 192.168.122.1 ipv4.dns "8.8.8.8 1.1.1.1" || true
  - nmcli con down enp1s0 || true
  - nmcli con up enp1s0
  - echo "[V04] IP fija aplicada: 192.168.122.40" > /var/log/j01-v04-network.log

# ═══════════════════════════════════════════════════════════════════════════════
# 2. SERVICIOS BASE - TODO FUNCIONANDO PERFECTO
#═══════════════════════════════════════════════════════════════════════════════
  # Firewall completamente abierto
  - systemctl enable --now firewalld
  - firewall-cmd --permanent --add-service=http
  - firewall-cmd --permanent --add-service=ssh
  - firewall-cmd --reload
  - echo "[V04] Firewall configurado correctamente" >> /var/log/j01-v04-network.log

  # Nginx normal puerto 80
  - dnf install -y nginx || true
  - systemctl enable --now nginx
  - echo "[V04] Nginx puerto 80 activado" >> /var/log/j01-v04-network.log

# ═══════════════════════════════════════════════════════════════════════════════
# 3. FALLLO ESPECÍFICO V04 - LATENCIA + PÉRDIDA CON `tc`
#═══════════════════════════════════════════════════════════════════════════════
  # SIMULAR latencia 500ms + 10% pérdida paquetes (INTERMITENTE)
  - dnf install -y iproute || true
  - |
    tc qdisc del dev enp1s0 root 2>/dev/null || true
    tc qdisc add dev enp1s0 root netem delay 500ms 100ms loss 10%
  - echo "[V04] tc aplicado: 500ms delay + 10% loss en enp1s0" >> /var/log/j01-v04-network.log

  # Script para mostrar estado tc (estudiante puede ejecutar)
  - |
    cat << 'EOF' > /usr/local/bin/check-latency.sh
    #!/bin/bash
    echo "=== J01-V04 LATENCIA SIMULADA ==="
    tc qdisc show dev enp1s0
    echo ""
    echo "PING TEST (desde HOST deberías ver alta latencia)"
    echo "ping -c 10 192.168.122.40"
    EOF
  - chmod +x /usr/local/bin/check-latency.sh

