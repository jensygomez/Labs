runcmd:
  # === 1. IP Fija (192.168.122.40) - V04 ESPECÍFICO ===
  - nmcli con mod enp1s0 ipv4.method manual ipv4.addresses 192.168.122.40/24 ipv4.gateway 192.168.122.1 ipv4.dns "8.8.8.8 1.1.1.1" || true
  - nmcli con down enp1s0 || true
  - nmcli con up enp1s0

  # === 2. SERVICIOS BASE (NGINX + FIREWALL PERFECTOS) ===
  - dnf install -y nginx iproute || true
  - systemctl enable --now firewalld
  - firewall-cmd --permanent --add-service=http || true
  - firewall-cmd --permanent --add-service=ssh || true
  - firewall-cmd --reload
  - systemctl enable --now nginx

  # === 3. FALLLO V04: tc netem LATENCIA 500ms + 10% LOSS ===
  - tc qdisc del dev enp1s0 root 2>/dev/null || true
  - tc qdisc add dev enp1s0 root netem delay 500ms 100ms loss 10%

  # === 4. Script diagnóstico ===
  - |
    cat << 'EOF' > /usr/local/bin/check-latency.sh
    #!/bin/bash
    echo "=== J01-V04 LATENCIA SIMULADA ==="
    tc qdisc show dev enp1s0
    echo "FIX: tc qdisc del dev enp1s0 root"
    EOF
  - chmod +x /usr/local/bin/check-latency.sh

  # === 5. Página nginx éxito ===
  - mkdir -p /usr/share/nginx/html
  - |
    cat << 'EOF' > /usr/share/nginx/html/index.html
    <!DOCTYPE html>
    <html><head><title>J01-V04 NOC Lab - Latencia FIX</title>
    <meta charset="UTF-8"><style>body{font-family:monospace;background:#000;color:#0f0;}
    h1{color:#00ff00;}</style></head><body>
    <h1>🏆 J01-V04 RESUELTO!</h1>
    <p>ping &lt;2ms ✓<br>
    tc qdisc del dev enp1s0 root</p>
    </body></html>
    EOF

  # ═══════════════════════════════════════════════════════════════════════════════
  # 6. MOTD TICKET - FORMATO PROFESIONAL 
  #═══════════════════════════════════════════════════════════════════════════════
  - |
    cat << 'EOF' > /etc/motd
    ════════════════════════════════════════════════════════════════════════════════
    
                 LAB J01-V04: Redes y Conectividad - Latencia Intermitente
    
    ════════════════════════════════════════════════════════════════════════════════
    
    ROL: NOC Engineer Junior / SysAdmin en entrenamiento
    
    TOPOLOGÍA:
      HOST (tu laptop)  ───[ INTERNET ]───  SERVER_EU (192.168.122.40)
    
    OBJETIVO:
      Resolver: ping/HTTP estable &lt; 5ms (actual: 500ms+ intermitente)
    
    SÍNTOMAS OBSERVADOS:
    ┌─────────────────────────────────────────────────────────────┐
    │ HOST$ ping -c10 192.168.122.40 → 500ms+ | 10% packet loss! │
    │ HOST$ curl http://192.168.122.40 → timeouts intermitentes │
    │ VM$ ping -c5 192.168.122.1 → 500ms+                       │
    └─────────────────────────────────────────────────────────────┘
    
    HERRAMIENTAS ESPERADAS:
      • ping -c20 192.168.122.40 (métricas latencia/loss)
      • mtr 192.168.122.40
      • tc qdisc show dev enp1s0   ← ¡AQUÍ ESTÁ EL FALLO!
      • ip link show enp1s0
    
    RESTRICCIONES:
      • NO reinicies servidor
      • NO modifiques firewall (OK)
      • NO cambies IP/rutas
    
    💡 PISTAS:
      1. Firewall OK (puertos abiertos)
      2. nginx OK (puerto 80)
      3. ¿Latencia dónde se inyecta? → tc qdisc
      4. ¿Herramienta RedHat para simular red?
    
    🎯 FLUJO ESPERADO:
      ping lento → tc qdisc show → tc qdisc del dev enp1s0 root → ping normal ✓
    
    ════════════════════════════════════════════════════════════════════════════════
    EOF

  # === 7. Documento escenario ===
  - |
    cat << 'EOF' > /etc/j01-scenario.txt
    LAB: J01-V04 - tc netem Latencia

    OBJETIVO: ping &lt;5ms + curl OK

    SÍNTOMAS:
    • ping 192.168.122.40 → 500ms+ 10% loss ✗
    • curl http://192.168.122.40 → timeout ✗
    • nginx/firewall OK ✓

    FIX: tc qdisc del dev enp1s0 root

    HERRAMIENTAS: tc qdisc show, ping -c20
    EOF

  # === 8. Evidencias ===
  - systemctl is-active nginx > /etc/j01-v04-nginx.status
  - tc qdisc show dev enp1s0 > /etc/j01-v04-tc.state
  - firewall-cmd --list-all > /etc/j01-v04-firewall.state

  # === 9. Flags ===
  - echo "J01 V04 - tc netem 500ms 10% loss" > /etc/j01-variant-v04.flag
  - echo "J01 V04 aplicada - IP:192.168.122.40" > /etc/j01-base.flag

  # === 10. SELinux + permisos ===
  - restorecon -R /usr/share/nginx/html || true
  - chown -R nginx:nginx /usr/share/nginx/html || true
