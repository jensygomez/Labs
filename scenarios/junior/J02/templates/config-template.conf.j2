# ==============================================================================
# config-template.conf.j2 — PLANTILLA CONFIGURACIÓN J02
# ==============================================================================
# 
# RELACIONES ← ATRÁS (DEPENDENCIAS)
# ┌─────────────────────────────────────────────────────────────┐
# │ 1. CARGADO POR: tasks/base.yml → template module             │
# │    src: templates/config-template.conf.j2                   │
# │    dest: "{{ config_path }}"  ← /etc/[SERVICE]/[CONFIG].conf│
# │                                                          │
# │ 2. REQUIERE variables de resolve.yml:                      │
# │    • global_service_name    ← random de services[]         │
# │    • service_port           ← random de ports[]            │
# │    • log_path               ← derivada                     │
# │    • config_path            ← derivada                     │
# └─────────────────────────────────────────────────────────────┘
# 
# RELACIONES → ADELANTE (CONSUMIDORES)
# ┌─────────────────────────────────────────────────────────────┐
# │ 1. STUDENT analiza: cat {{ config_path }}                   │
# │ 2. Verificaciones: test -f {{ config_path }}                │
# │ 3. Variantes de fallo inyectan corrupción aquí              │
# └─────────────────────────────────────────────────────────────┘
# 
# FLUJO: resolve.yml → base.yml → [ESTE TEMPLATE] → STUDENT DEBUG
# EJEMPLO REAL: /etc/data-processor/settings.yaml (ALEATORIO)
# ==============================================================================

# Configuración para {{ global_service_name }}  ← ALEATORIO: internal-api, data-processor...
# Archivo: {{ global_config_file }}             ← ALEATORIO: application.conf, settings.yaml...

service:
  name: "{{ global_service_name }}"                    ← ALEATORIO de services[]
  description: "Internal service for J02 lab"
  version: "1.0.0"

network:
  port: {{ service_port }}                             ← ALEATORIO: 8080, 9000, 14000...
  host: "0.0.0.0"
  timeout: 30

logging:
  level: "INFO"
  file: "{{ log_path }}"                               ← /var/log/[SERVICE]/[LOG].log
  max_size: "100MB"
  retain_days: 7

features:
  enabled: true
  maintenance_mode: false
  debug_endpoints: false

# 🔍 PISTAS PARA STUDENT (verificación de estado)
required_paths:
  - "/etc/{{ global_service_name }}/enabled"           ← base.yml crea este archivo
  - "/var/run/{{ global_service_name }}/ready"         ← base.yml crea este archivo  
  - "{{ config_path }}"                                ← este mismo archivo

# 📋 DEPENDENCIAS DEL SERVICIO (pistas adicionales)
dependencies:
  required_services:
    - "network-online.target"
    - "postgresql.service"                             ← pista falsa
  optional_services:
    - "redis.service"                                  ← pista falsa
    - "nginx.service"                                  ← pista falsa

# ==============================================================================
# USO EN LABORATORIO (ALEATORIO POR EJECUCIÓN):
# 1. base.yml: template → /etc/[SERVICE-RANDOM]/[CONFIG-RANDOM]
# 2. STUDENT: cat /etc/data-processor/settings.yaml → ve:
#      service: { name: "data-processor", port: 9090 }
# 3. systemctl status data-processor.service → lee esta config ALEATORIA
# 4. Variantes corrompen: permisos, contenido, owner...
# ==============================================================================
