# ==============================================================================
# service-template.service.j2 — PLANTILLA SYSTEMD J02 (CORREGIDA)
# ==============================================================================
# 
# RELACIONES ← ATRÁS (DEPENDENCIAS) ✅ TODAS PROPAGADAS
# ┌─────────────────────────────────────────────────────────────┐
# │ 1. CARGADO POR: tasks/base.yml → template module             │
# │    src: templates/service-template.service.j2               │
# │    dest: /etc/systemd/system/{{ global_service_name }}.service │
# │                                                          │
# │ 2. REQUIERE variables de resolve.yml (TODAS PROPAGADAS):    │
# │    • global_service_name  ← ✅ propagada                    │
# │    • global_service_user  ← ✅ propagada                    │
# │    • global_config_file   ← ✅ propagada                    │
# │    • global_log_file      ← ✅ propagada                    │
# │    • service_port         ← ✅ propagada                    │
# │    • service_dir          ← ✅ propagada                    │
# └─────────────────────────────────────────────────────────────┘
# 
# RELACIONES → ADELANTE (CONSUMIDORES)
# ┌─────────────────────────────────────────────────────────────┐
# │ 1. STUDENT: systemctl status [SERVICE].service              │
# │ 2. STUDENT: systemctl cat [SERVICE].service → ve config     │
# │ 3. STUDENT: journalctl -u [SERVICE] → ve ExecStart logs     │
# │ 4. Variantes corrompen este archivo (user=, ExecStart=...)  │
# └─────────────────────────────────────────────────────────────┘
# 
# FLUJO: resolve.yml → J02.yml(propagación) → base.yml → [ESTE TEMPLATE]
# EJEMPLO: /etc/systemd/system/auth-gateway.service ✅
# ==============================================================================

# ==============================================================================
# {{ global_service_name }}.service - Template para laboratorio J02
# ← ALEATORIO: auth-gateway.service, data-processor.service...
# ==============================================================================

[Unit]
Description={{ global_service_name }} Service (J02 Lab)                    ← ✅ global_service_name
Documentation=https://internal.wiki/{{ global_service_name }}             ← ✅ global_service_name
After=network-online.target
Wants=network-online.target
Requires=network-online.target

[Service]
Type=simple
User={{ global_service_user }}                                            ← ✅ global_service_user
Group={{ global_service_user }}                                           ← ✅ global_service_user
WorkingDirectory={{ service_dir }}                                        ← ✅ service_dir (/opt/auth-gateway)

ExecStart={{ service_dir }}/start.sh                                      ← ✅ service_dir/start.sh
ExecStartPre=/bin/echo "Starting {{ global_service_name }} service"      ← ✅ global_service_name
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

# Environment (VARIABLES PARA start.sh) ✅ TODAS CORREGIDAS
Environment="SERVICE_NAME={{ global_service_name }}"                      ← ✅ global_service_name
Environment="CONFIG_FILE={{ config_path }}"                              ← ✅ config_path (/etc/auth-gateway/app.conf)
Environment="LOG_FILE={{ log_path }}"                                    ← ✅ log_path (/var/log/auth-gateway/app.log)
Environment="PORT={{ service_port }}"                                    ← ✅ service_port

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ global_service_name }}                               ← ✅ global_service_name

# Security (BASELINE - variantes lo rompen)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

# Resource limits (BASELINE - variantes los modifican)
LimitNOFILE=65536
LimitNPROC=4096
LimitCORE=infinity
MemoryLimit=512M
CPUQuota=100%
TasksMax=infinity

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=60s
StartLimitBurst=3

# Timeouts
TimeoutStartSec=180s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target

# ==============================================================================
# ✅ VARIABLES CORREGIDAS:
# ❌ selected_service     → ✅ global_service_name
# ❌ selected_log_file    → ✅ global_log_file  
# ❌ current_config_file  → ✅ global_config_file (via config_path)
# ❌ current_log_file     → ✅ global_log_file (via log_path)
# ❌ current_port         → ✅ service_port
# 
# USO EN LABORATORIO (ALEATORIO POR EJECUCIÓN):
# 1. base.yml: template → /etc/systemd/system/data-processor.service
# 2. base.yml: systemctl daemon-reload + systemctl enable
# 3. STUDENT: systemctl status data-processor.service → User=svc-process
# 4. STUDENT: systemctl cat data-processor.service → Environment="PORT=9090"
# 5. Variantes: variant_1.yml → User=root, variant_2.yml → ExecStart=/bin/false
# ==============================================================================
