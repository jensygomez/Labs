#!/bin/bash
# ==============================================================================
# Script de inicio para {{ global_service_name }} (LAB J02)
# ==============================================================================
# Este script asume que systemd exporta:
#   SERVICE_NAME
#   CONFIG_FILE
#   LOG_FILE
#   PORT
# ==============================================================================

set -euo pipefail

# Validar variables de entorno críticas
: "${SERVICE_NAME:?Missing SERVICE_NAME}"
: "${CONFIG_FILE:?Missing CONFIG_FILE}"
: "${LOG_FILE:?Missing LOG_FILE}"
: "${PORT:?Missing PORT}"

SERVICE_USER="{{ global_service_user }}"

# Crear directorio de logs si no existe
LOG_DIR="$(dirname "$LOG_FILE")"
mkdir -p "$LOG_DIR"
chown "$SERVICE_USER:$SERVICE_USER" "$LOG_DIR"

# Verificar que el usuario existe
if ! id "$SERVICE_USER" &>/dev/null; then
    echo "ERROR: User $SERVICE_USER does not exist" >&2
    exit 1
fi

# Verificar archivo de configuración
if [ ! -f "$CONFIG_FILE" ]; then
    echo "ERROR: Config file $CONFIG_FILE not found" >&2
    exit 1
fi

if [ ! -r "$CONFIG_FILE" ]; then
    echo "ERROR: Cannot read config file $CONFIG_FILE" >&2
    exit 1
fi

# Mostrar límites efectivos (útil para variantes)
echo "[$SERVICE_NAME] Effective resource limits:" | tee -a "$LOG_FILE"
echo "  Max open files: $(ulimit -n)" | tee -a "$LOG_FILE"
echo "  Max processes: $(ulimit -u)" | tee -a "$LOG_FILE"

# Cargar configuración (si existe contenido)
source "$CONFIG_FILE"

# Función de limpieza
cleanup() {
    echo "Stopping $SERVICE_NAME at $(date)" | tee -a "$LOG_FILE"
    exit 0
}

trap cleanup EXIT TERM INT

# Inicio del servicio
echo "Starting $SERVICE_NAME on port $PORT at $(date)" | tee -a "$LOG_FILE"
echo "Running as user: $(id)" | tee -a "$LOG_FILE"

# Simulación de servicio activo
while true; do
    echo "$(date): $SERVICE_NAME active on port $PORT" >> "$LOG_FILE"
    sleep 30
done
