hostname: j02-troubleshooting

users:
  - name: student
    gecos: Student User
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: wheel
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE9AAAAIByFDKwjMDeGJ5GRhXmZHa75h7dK9JcPHvWWtesSO3/x RHCSA Storage Labs

ssh_pwauth: false
disable_root: true

write_files:
  - path: /etc/motd
    content: |
      J02 MULTI-IP LAB - BASE SANA

      ADMIN: 192.168.122.20  → SSH  ✓
      WEB:   192.168.122.30  → HTTP ✓
      DB:    192.168.122.40  → MySQL✓

      Tests:
        ssh student@192.168.122.20
        curl http://192.168.122.30
        nc -zv 192.168.122.40 3306

packages:
  - firewalld
  - nginx
  - mariadb-server
  - policycoreutils-python-utils
  - setroubleshoot-server
  - telnet
  - net-tools
  - bind-utils

runcmd:
  #===========================================================================
  # 1. MÓDULO DUMMY PERSISTENTE
  #===========================================================================
  - echo 'dummy' > /etc/modules-load.d/dummy.conf
  - modprobe dummy

  #===========================================================================
  # 2. SYSTEMD SERVICE: ADMIN IP (192.168.122.20)
  #===========================================================================
  - |
    cat <<EOF > /etc/systemd/system/admin-ip.service
    [Unit]
    Description=Admin IP 192.168.122.20
    After=network.target
    
    [Service]
    Type=oneshot
    ExecStart=/sbin/ip addr flush dev enp1s0
    ExecStart=/sbin/ip addr add 192.168.122.20/24 dev enp1s0
    ExecStart=/sbin/ip link set enp1s0 up
    ExecStart=/sbin/ip route add default via 192.168.122.1
    RemainAfterExit=yes
    
    [Install]
    WantedBy=multi-user.target
    EOF

  #===========================================================================
  # 3. SYSTEMD SERVICE: WEB IP (192.168.122.30)
  #===========================================================================
  - |
    cat <<EOF > /etc/systemd/system/web-ip.service
    [Unit]
    Description=Web IP 192.168.122.30
    After=network.target
    
    [Service]
    Type=oneshot
    ExecStart=/sbin/ip link add dummy0 type dummy
    ExecStart=/sbin/ip addr add 192.168.122.30/24 dev dummy0
    ExecStart=/sbin/ip link set dummy0 up
    RemainAfterExit=yes
    
    [Install]
    WantedBy=multi-user.target
    EOF

  #===========================================================================
  # 4. SYSTEMD SERVICE: DB IP (192.168.122.40)
  #===========================================================================
  - |
    cat <<EOF > /etc/systemd/system/db-ip.service
    [Unit]
    Description=DB IP 192.168.122.40
    After=network.target
    
    [Service]
    Type=oneshot
    ExecStart=/sbin/ip link add dummy1 type dummy
    ExecStart=/sbin/ip addr add 192.168.122.40/24 dev dummy1
    ExecStart=/sbin/ip link set dummy1 up
    RemainAfterExit=yes
    
    [Install]
    WantedBy=multi-user.target
    EOF

  #===========================================================================
  # 5. ACTIVAR TODOS LOS SERVICES DE IP
  #===========================================================================
  - systemctl daemon-reload
  - systemctl enable admin-ip.service web-ip.service db-ip.service
  - systemctl start admin-ip.service web-ip.service db-ip.service

  #===========================================================================
  # 6. ESPERAR QUE LAS IPS ESTÉN LISTAS
  #===========================================================================
  - sleep 3

  #===========================================================================
  # 7. FIREWALL BASE SANO (ZONAS CORRECTAS)
  #===========================================================================
  - firewall-cmd --permanent --zone=public   --add-interface=enp1s0
  - firewall-cmd --permanent --zone=internal --add-interface=dummy0
  - firewall-cmd --permanent --zone=internal --add-interface=dummy1
  - firewall-cmd --permanent --zone=public   --add-service=ssh
  - firewall-cmd --permanent --zone=internal --add-service=http
  - firewall-cmd --permanent --zone=internal --add-service=mysql
  - firewall-cmd --reload

  #===========================================================================
  # 8. SERVICIOS
  #===========================================================================
  - systemctl enable --now nginx
  - systemctl enable --now mariadb
  - setenforce 1
  - echo "<h1>✅ J02 WEB OK - 192.168.122.30</h1>" > /usr/share/nginx/html/index.html
  - chown -R nginx:nginx /usr/share/nginx/html
  - |
    cat <<EOF > /etc/my.cnf.d/j02-lab.cnf
    [mysqld]
    bind-address = 0.0.0.0
    EOF
  - systemctl restart mariadb

  #===========================================================================
  # 9. VERIFICACIÓN
  #===========================================================================
  - echo "BASE SANA OK - $(date)" >> /var/log/j02-base.log
