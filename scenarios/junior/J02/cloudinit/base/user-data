hostname: j02-firewall-troubleshooting

# 1. Configuración de RED
network:
  version: 2
  ethernets:
    enp1s0:
      addresses:
        - 192.168.122.20/24
        - 192.168.122.30/24  
        - 192.168.122.40/24
      gateway4: 192.168.122.1
      dhcp4: false

# 2. Usuario
users:
  - name: student
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAAIByFDKwjMDeGJ5GRhXmZHa75h7dK9JcPHvWWtesSO3/x RHCSA Storage Labs

ssh_pwauth: false
disable_root: true

# 3. Paquetes básicos
packages:
  - firewalld
  - nginx
  - mariadb-server

# 4. Verificación
runcmd:
  - sleep 3
  - echo "IPs:" && ip addr
  - echo "Usuario student creado:" && id student

