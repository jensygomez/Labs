hostname: j02-troubleshooting

users:
  - name: student
    gecos: Student User
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: wheel
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAAIByFDKwjMDeGJ5GRhXmZHa75h7dK9JcPHvWWtesSO3/x RHCSA Storage Labs

ssh_pwauth: false
disable_root: true

write_files:
  - path: /etc/motd
    content: |
      J02 MULTI-IP LAB - BASE SANA

      ADMIN: 192.168.122.20  → SSH  ✓
      WEB:   192.168.122.30  → HTTP ✓
      DB:    192.168.122.40  → MySQL✓

      Tests:
        ssh student@192.168.122.20
        curl http://192.168.122.30
        nc -zv 192.168.122.40 3306

  # Archivo de debug para ver qué pasó
  - path: /root/cloudinit-debug.sh
    content: |
      #!/bin/bash
      echo "=== DEBUG SCRIPT ==="
      echo "Fecha: $(date)"
      echo ""
      echo "=== Interfaces ==="
      ip a
      echo ""
      echo "=== Rutas ==="
      ip route
      echo ""
      echo "=== NetworkManager ==="
      nmcli con show
      echo ""
      echo "=== Systemd Network ==="
      systemctl status NetworkManager 2>/dev/null || systemctl status network 2>/dev/null || true
      echo ""
      echo "=== Archivos de configuración ==="
      ls -la /etc/sysconfig/network-scripts/ifcfg-* 2>/dev/null || true
      echo ""
      echo "=== Servicios de IP ==="
      systemctl status admin-ip web-ip db-ip
    permissions: '0755'

packages:
  - firewalld
  - nginx
  - mariadb-server
  - policycoreutils-python-utils
  - setroubleshoot-server
  - telnet
  - net-tools
  - bind-utils
  - NetworkManager

runcmd:
  #===========================================================================
  # 0. ESPERAR A QUE NETWORK ESTÉ LISTO
  #===========================================================================
  - systemctl start NetworkManager 2>/dev/null || true
  - sleep 5
  
  #===========================================================================
  # 1. DETECTAR INTERFAZ PRINCIPAL DINÁMICAMENTE
  #===========================================================================
  - |
    # Encontrar la interfaz activa
    if ip link show enp1s0 2>/dev/null; then
      MAIN_IFACE="enp1s0"
    elif ip link show eth0 2>/dev/null; then
      MAIN_IFACE="eth0"
    elif ip link show ens3 2>/dev/null; then
      MAIN_IFACE="ens3"
    else
      # Encontrar la primera interfaz Ethernet
      MAIN_IFACE=$(ip link | grep -E "^[0-9]+: (en|eth)" | head -1 | awk -F: '{print $2}' | tr -d ' ')
    fi
    
    echo "Interfaz principal detectada: ${MAIN_IFACE}"
    echo "MAIN_IFACE=${MAIN_IFACE}" > /tmp/network-info.txt

  #===========================================================================
  # 2. CONFIGURAR IP ESTÁTICA EN INTERFAZ PRINCIPAL
  #===========================================================================
runcmd:
  # ... código anterior ...
  
  #===========================================================================
  # 2. CONFIGURAR IP ESTÁTICA EN INTERFAZ PRINCIPAL
  #===========================================================================

  # Parte A: Detección y lógica principal
  - |
    source /tmp/network-info.txt
    
    if command -v nmcli &> /dev/null; then
      echo "Configurando con NetworkManager..."
      CON_NAME=$(nmcli -t -f NAME con show --active | head -1)
      
      if [ -z "$CON_NAME" ]; then
        CON_NAME="static-${MAIN_IFACE}"
        nmcli con add type ethernet ifname ${MAIN_IFACE} con-name ${CON_NAME} \
          ip4 192.168.122.20/24 gw4 192.168.122.1
      else
        nmcli con mod "${CON_NAME}" \
          ipv4.method manual \
          ipv4.addresses 192.168.122.20/24 \
          ipv4.gateway 192.168.122.1 \
          ipv4.dns "8.8.8.8 8.8.4.4"
      fi
      
      nmcli con up "${CON_NAME}"
      echo "nmcli" > /tmp/network-method.txt
    else
      echo "network-scripts" > /tmp/network-method.txt
    fi

  # Parte B: Configuración network-scripts (solo si no se usó nmcli)
  - |
    if [ "$(cat /tmp/network-method.txt)" = "network-scripts" ]; then
      source /tmp/network-info.txt
      echo "Configurando con network-scripts..."
      
      # Crear archivo de configuración usando echo (sin heredoc)
      echo "DEVICE=${MAIN_IFACE}" > /etc/sysconfig/network-scripts/ifcfg-${MAIN_IFACE}
      echo "BOOTPROTO=none" >> /etc/sysconfig/network-scripts/ifcfg-${MAIN_IFACE}
      echo "ONBOOT=yes" >> /etc/sysconfig/network-scripts/ifcfg-${MAIN_IFACE}
      echo "IPADDR=192.168.122.20" >> /etc/sysconfig/network-scripts/ifcfg-${MAIN_IFACE}
      echo "PREFIX=24" >> /etc/sysconfig/network-scripts/ifcfg-${MAIN_IFACE}
      echo "GATEWAY=192.168.122.1" >> /etc/sysconfig/network-scripts/ifcfg-${MAIN_IFACE}
      echo "DNS1=8.8.8.8" >> /etc/sysconfig/network-scripts/ifcfg-${MAIN_IFACE}
      echo "DNS2=8.8.4.4" >> /etc/sysconfig/network-scripts/ifcfg-${MAIN_IFACE}
      echo "DEFROUTE=yes" >> /etc/sysconfig/network-scripts/ifcfg-${MAIN_IFACE}
      echo "IPV4_FAILURE_FATAL=no" >> /etc/sysconfig/network-scripts/ifcfg-${MAIN_IFACE}
      echo "IPV6INIT=no" >> /etc/sysconfig/network-scripts/ifcfg-${MAIN_IFACE}
      
      systemctl restart network
    fi

  # Parte C: Verificación común
  - |
    source /tmp/network-info.txt
    ip addr show ${MAIN_IFACE} | grep 192.168.122.20 && echo "✅ IP principal configurada" || echo "❌ Falló IP principal"

  #===========================================================================
  # 3. MÓDULO DUMMY PERSISTENTE
  #===========================================================================
  - echo 'dummy' > /etc/modules-load.d/dummy.conf
  - modprobe dummy
  - sleep 2

  #===========================================================================
  # 4. SYSTEMD SERVICE: WEB IP (192.168.122.30) - DUMMY0
  #===========================================================================
  - |
    cat <<EOF > /etc/systemd/system/web-ip.service
    [Unit]
    Description=Web IP 192.168.122.30 on dummy0
    After=network-online.target
    Requires=network-online.target
    
    [Service]
    Type=oneshot
    ExecStartPre=-/sbin/modprobe dummy
    ExecStart=/sbin/ip link add dummy0 type dummy
    ExecStart=/sbin/ip addr add 192.168.122.30/24 dev dummy0
    ExecStart=/sbin/ip link set dummy0 up
    ExecStop=/sbin/ip link del dummy0
    RemainAfterExit=yes
    
    [Install]
    WantedBy=multi-user.target
    EOF

  #===========================================================================
  # 5. SYSTEMD SERVICE: DB IP (192.168.122.40) - DUMMY1
  #===========================================================================
  - |
    cat <<EOF > /etc/systemd/system/db-ip.service
    [Unit]
    Description=DB IP 192.168.122.40 on dummy1
    After=network-online.target
    Requires=network-online.target
    
    [Service]
    Type=oneshot
    ExecStartPre=-/sbin/modprobe dummy
    ExecStart=/sbin/ip link add dummy1 type dummy
    ExecStart=/sbin/ip addr add 192.168.122.40/24 dev dummy1
    ExecStart=/sbin/ip link set dummy1 up
    ExecStop=/sbin/ip link del dummy1
    RemainAfterExit=yes
    
    [Install]
    WantedBy=multi-user.target
    EOF

  #===========================================================================
  # 6. ELIMINAR SERVICIO ADMIN-IP VIEJO Y ACTIVAR NUEVOS
  #===========================================================================
  - systemctl daemon-reload
  - systemctl disable admin-ip.service 2>/dev/null || true
  - rm -f /etc/systemd/system/admin-ip.service 2>/dev/null || true
  - systemctl enable web-ip.service db-ip.service
  - systemctl start web-ip.service db-ip.service

  #===========================================================================
  # 7. ESPERAR QUE LAS IPS ESTÉN LISTAS Y VERIFICAR
  #===========================================================================
  - sleep 5
  - echo "=== VERIFICACIÓN DE IPS ===" > /var/log/ip-setup.log
  - ip a show ${MAIN_IFACE} >> /var/log/ip-setup.log
  - ip a show dummy0 >> /var/log/ip-setup.log 2>/dev/null || echo "dummy0 no encontrado" >> /var/log/ip-setup.log
  - ip a show dummy1 >> /var/log/ip-setup.log 2>/dev/null || echo "dummy1 no encontrado" >> /var/log/ip-setup.log

  #===========================================================================
  # 8. FIREWALL BASE SANO (ZONAS CORRECTAS)
  #===========================================================================
  - |
    source /tmp/network-info.txt
    firewall-cmd --permanent --zone=public --add-interface=${MAIN_IFACE}
    firewall-cmd --permanent --zone=internal --add-interface=dummy0
    firewall-cmd --permanent --zone=internal --add-interface=dummy1
    firewall-cmd --permanent --zone=public --add-service=ssh
    firewall-cmd --permanent --zone=internal --add-service=http
    firewall-cmd --permanent --zone=internal --add-service=mysql
    firewall-cmd --reload

  #===========================================================================
  # 9. SERVICIOS
  #===========================================================================
  - systemctl enable --now nginx
  - systemctl enable --now mariadb
  - setenforce 1
  - echo "<h1>✅ J02 WEB OK - 192.168.122.30</h1>" > /usr/share/nginx/html/index.html
  - chown -R nginx:nginx /usr/share/nginx/html
  - |
    cat <<EOF > /etc/my.cnf.d/j02-lab.cnf
    [mysqld]
    bind-address = 0.0.0.0
    EOF
  - systemctl restart mariadb

  #===========================================================================
  # 10. VERIFICACIÓN FINAL Y DEBUG
  #===========================================================================
  - /root/cloudinit-debug.sh > /var/log/cloudinit-debug-full.log
  - echo "=== RESUMEN ==="
  - echo "IP Principal (${MAIN_IFACE}):"
  - ip -4 addr show ${MAIN_IFACE} | grep inet
  - echo "IP Web (dummy0):"
  - ip -4 addr show dummy0 2>/dev/null | grep inet || echo "No configurada"
  - echo "IP DB (dummy1):"
  - ip -4 addr show dummy1 2>/dev/null | grep inet || echo "No configurada"
  
  - echo "BASE SANA OK - $(date)" >> /var/log/j02-base.log
  - echo "✅ Configuración completada. Ver logs en /var/log/cloudinit-debug-full.log"






















