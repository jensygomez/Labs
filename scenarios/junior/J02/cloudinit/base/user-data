#cloud-config
###############################################################################
# LAB: J01 (Junior)
# ROLE: Base canónica del laboratorio
# PURPOSE:
#   - Definir el estado inicial común a TODAS las variantes (V01, V02, ...)
#   - Configurar identidad, acceso SSH y red administrativa fija
#   - NO inyecta fallos ni desviaciones (eso es responsabilidad de Vxx)
###############################################################################

# ---------------------------------------------------------------------------
# Identidad del sistema
# ---------------------------------------------------------------------------
hostname: j01-base

# ---------------------------------------------------------------------------
# Usuarios
# ---------------------------------------------------------------------------
users:
  - name: student
    gecos: Student User
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: wheel
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIByFDKwjMDeGJ5GRhXmZHa75h7dK9JcPHvWWtesSO3/x RHCSA Storage Labs

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
ssh_pwauth: false        # Deshabilita login por password
disable_root: true       # Root solo vía sudo

# ---------------------------------------------------------------------------
# Gestión de paquetes
# ---------------------------------------------------------------------------
package_update: false
package_upgrade: false

# ---------------------------------------------------------------------------
# Red – IP administrativa fija (CRÍTICO)
# ---------------------------------------------------------------------------
# Todas las VMs Junior arrancan SIEMPRE con esta IP
# Evita DHCP aleatorio de libvirt
# ---------------------------------------------------------------------------
runcmd:
  - |
    nmcli con mod enp1s0 \
      ipv4.method manual \
      ipv4.addresses 192.168.122.20/24 \
      ipv4.gateway 192.168.122.1 \
      ipv4.dns "8.8.8.8 1.1.1.1"

  - nmcli con down enp1s0 || true
  - nmcli con up enp1s0

  # -------------------------------------------------------------------------
  # Evidencia de base aplicada correctamente
  # -------------------------------------------------------------------------
  - echo "[cloud-init] J01 base aplicada correctamente" > /etc/j01-base.flag
