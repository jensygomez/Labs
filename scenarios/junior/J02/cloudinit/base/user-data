#cloud-config
###############################################################################
# LAB: J02 (Junior) - Troubleshooting Firewalld y SELinux
# FILE: scenarios/junior/J02/cloudinit/base/user-data
# ROLE: Base canónica del laboratorio
# PURPOSE:
#   - Estado inicial común para V01-V04
#   - Servicios: firewalld↑, nginx↑, mariadb↑, SELinux enforcing
#   - IP fija 192.168.122.20 (auto-detecta interfaz)
#   - Sin fallos específicos (los inyectan variantes Vxx)
###############################################################################

# ---------------------------------------------------------------------------
# Identidad del sistema
# ---------------------------------------------------------------------------


hostname: j02-firewall-troubleshooting

users:
  - name: student
    gecos: Student User
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: wheel
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIByFDKwjMDeGJ5GRhXmZHa75h7dK9JcPHvWWtesSO3/x RHCSA Storage Labs

ssh_pwauth: false
disable_root: true
package_update: false
package_upgrade: false

write_files:
  - path: /etc/motd
    content: |
      =====================================================
      LAB J02: Troubleshooting Firewalld & SELinux
      Hostname: j02-firewall-troubleshooting
      IP fija: 192.168.122.20
      Servicios: firewalld↑, SELinux↑, nginx↑, mariadb↑
      =====================================================
      
      🔍 Comandos de diagnóstico:
        sestatus
        firewall-cmd --list-all
        systemctl status nginx mariadb
        sealert -a /var/log/audit/audit.log
      
      🧪 Test desde HOST:
        curl http://192.168.122.20
        nc -zv 192.168.122.20 3306

  - path: /etc/j02-base.flag
    content: "J02 base aplicada correctamente - %Y-%m-%d %H:%M:%S"
    permissions: '0644'

packages:
  - firewalld
  - nginx
  - mariadb-server
  - policycoreutils-python-utils
  - setroubleshoot-server
  - telnet
  - net-tools
  - bind-utils

runcmd:
  # === 1. RED: IP fija ===
  - 'INTERFACE=$(ip -o link show | awk -F": " "{print $2}" | grep -E "^(eth|enp)" | head -1)'
  - nmcli con mod "${INTERFACE}" ipv4.method manual ipv4.addresses 192.168.122.20/24 ipv4.gateway 192.168.122.1 ipv4.dns "8.8.8.8 1.1.1.1"
  - nmcli con down "${INTERFACE}"
  - nmcli con up "${INTERFACE}"
  - sleep 3


  # === 2. SERVICIOS ===
  - systemctl enable --now firewalld
  - systemctl enable --now nginx
  - systemctl enable --now mariadb
  - sleep 1

  # === 3. SELinux ===
  - setenforce 1
  - sed -i 's/^SELINUX=.*$/SELINUX=enforcing/' /etc/selinux/config
  - sleep 1

  # === 4. NGINX ===
  - 'echo "<h1>✅ J02 Firewall Lab - Nginx OK</h1><p>IP: 192.168.122.20</p>" > /usr/share/nginx/html/index.html'
  - chown -R nginx:nginx /usr/share/nginx/html
  - restorecon -R /usr/share/nginx/html
  - sleep 1

  # === 5. MARIADB ===
  - mysql -e "SET PASSWORD FOR 'root'@'localhost'=PASSWORD(''); FLUSH PRIVILEGES;" || true
  - 'echo "[mysqld] bind-address = 0.0.0.0" > /etc/my.cnf.d/lab.cnf'
  - systemctl restart mariadb
  - sleep 1

  # === 6. EVIDENCIA FINAL ===
  - bash -c "echo '[J02-BASE] $(date)' >> /var/log/j02-setup.log"
  - bash -c "echo 'IP: $(ip addr show | grep 192.168.122.20)' >> /var/log/j02-setup.log"
  - bash -c "echo 'SELinux: $(sestatus | grep Current)' >> /var/log/j02-setup.log"
  - bash -c "echo 'Firewalld: $(firewall-cmd --state)' >> /var/log/j02-setup.log"
  - bash -c "echo 'Nginx: $(systemctl is-active nginx)' >> /var/log/j02-setup.log"
  - bash -c "echo 'MariaDB: $(systemctl is-active mariadb)' >> /var/log/j02-setup.log"
  - sleep 1

final_message: |
  🎉 *** J02 BASE completada exitosamente ***
  
  📍 IP: 192.168.122.20 | SELinux: enforcing
  🔧 Servicios: firewalld/nginx/mariadb corriendo
  🚦 Puertos BLOQUEADOS por firewalld (listo para V01-V04)
  
  📋 Logs: cat /var/log/j02-setup.log
