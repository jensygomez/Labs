hostname: j02-firewall-troubleshooting

users:
  - name: student
    gecos: Student User
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: wheel
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE9AAAAIByFDKwjMDeGJ5GRhXmZHa75h7dK9JcPHvWWtesSO3/x RHCSA Storage Labs

ssh_pwauth: false
disable_root: true

write_files:
  - path: /etc/motd
    content: |
      J02 MULTI-IP LAB - BASE SANA
      IP ADM: 192.168.122.20  → SSH ✓
      IP WEB: 192.168.122.30  → HTTP ✓  
      IP DB:  192.168.122.40  → MySQL ✓
      
      🧪 Tests OK:
        ssh student@192.168.122.20
        curl http://192.168.122.30
        nc -zv 192.168.122.40 3306

packages:
  - firewalld nginx mariadb-server policycoreutils-python-utils setroubleshoot-server telnet net-tools bind-utils

runcmd:
  # === 1. CONFIGURAR 3 INTERFACES VIRTUALES ===
  - ip link add dummy0 type dummy
  - ip link add dummy1 type dummy  
  - ip addr add 192.168.122.20/24 dev dummy0
  - ip addr add 192.168.122.30/24 dev dummy1
  - ip addr add 192.168.122.40/24 dev enp1s0
  - ip link set dummy0 up
  - ip link set dummy1 up
  - ip route add default via 192.168.122.1

  # === 2. SERVICIOS BASE SANA ===
  - systemctl enable --now firewalld nginx mariadb
  - setenforce 1

  # === 3. FIREWALL SANO (TODOS los puertos ABIERTOS) ===
  - firewall-cmd --permanent --add-service=ssh --zone=public
  - firewall-cmd --permanent --add-service=http --zone=public  
  - firewall-cmd --permanent --add-service=mysql --zone=public
  - firewall-cmd --permanent --add-interface=dummy0 --zone=internal
  - firewall-cmd --permanent --add-interface=dummy1 --zone=internal
  - firewall-cmd --reload

  # === 4. NGINX en IP .30 ===
  - 'echo "<h1>✅ J02 WEB OK - 192.168.122.30</h1>" > /usr/share/nginx/html/index.html'
  - chown -R nginx:nginx /usr/share/nginx/html

  # === 5. MARIADB en IP .40 ===
  - 'echo "[mysqld] bind-address = 0.0.0.0" > /etc/my.cnf.d/lab.cnf'
  - systemctl restart mariadb

  # === 6. BASE SANA VERIFICACIÓN ===
  - bash -c "echo 'BASE SANA: $(date)' >> /var/log/j02-base.log"
