runcmd:
  #===========================================================================
  # 1. SERVICIOS BASE (SANA)
  #===========================================================================

  - systemctl enable --now firewalld nginx mariadb
  - setenforce 1

  #===========================================================================
  # 2. VIRUS V03 — ROMPER CONTEXTO SELINUX DE NGINX
  #===========================================================================

  # Cambia contexto a uno NO permitido por httpd
  - chcon -R -t default_t /usr/share/nginx/html

  # (Importante) NO reiniciar nginx aquí: el síntoma es sutil
  #===========================================================================

  #===========================================================================
  # 3. MOTD — TICKET DE PRODUCCIÓN
  #===========================================================================

  - |
    cat << 'EOF' > /etc/motd
    ════════════════════════════════════════════════════════════════════════════════
    
                  LAB J02-V03 — SELINUX BLOQUEA NGINX
    
    ════════════════════════════════════════════════════════════════════════════════
    
    📌 TICKET:
      "La WEB no carga, pero el firewall parece correcto"
    
    TOPOLOGÍA:
      ADMIN → 192.168.122.20 (SSH)        ✓
      WEB   → 192.168.122.30 (HTTP)       ✗
      DB    → 192.168.122.40 (MySQL 3306) ✓
    
    🔴 SÍNTOMAS DESDE HOST:
      curl http://192.168.122.30        → FAIL
      nc -zv 192.168.122.30 80          → OK
    
    🔍 ESTADO EN VM:
      systemctl status nginx            → active (running)
      ss -tuln | grep :80               → LISTEN
      firewall-cmd --list-all --zone=internal → http ✓
      getenforce                        → Enforcing
    
    ⚠️ SOSPECHA:
      SELinux bloquea acceso a contenido web
    
    🛠️ COMANDOS CLAVE:
      ls -Z /usr/share/nginx/html/
      ausearch -m AVC -ts recent
      sealert -a /var/log/audit/audit.log
    
    🎯 OBJETIVO:
      Restaurar acceso HTTP SIN:
        • Desactivar SELinux
        • Cambiar firewalld
        • Reinstalar nginx
    
    💡 SOLUCIÓN ESPERADA:
      restorecon -Rv /usr/share/nginx/html/
      systemctl restart nginx
    
    ════════════════════════════════════════════════════════════════════════════════
    EOF

  #===========================================================================
  # 4. DOCUMENTO DEL ESCENARIO
  #===========================================================================

  - |
    cat << 'EOF' > /etc/j02-scenario.txt
    J02-V03 — SELINUX BLOQUEA NGINX
    
    OBJETIVO:
      curl http://192.168.122.30 → OK
    
    SÍNTOMAS:
      • nc -zv 192.168.122.30 80 → OK
      • curl http://192.168.122.30 → FAIL
    
    DIAGNÓSTICO:
      • nginx activo y escuchando
      • firewalld correcto
      • SELinux enforcing
      • contexto de /usr/share/nginx/html incorrecto
    
    VERIFICACIÓN:
      ls -Z /usr/share/nginx/html/
      sealert -a /var/log/audit/audit.log
    
    FIX:
      restorecon -Rv /usr/share/nginx/html/
      systemctl restart nginx
    
    VALIDACIÓN:
      curl http://192.168.122.30 → OK
    EOF

  #===========================================================================
  # 5. EVIDENCIAS
  #===========================================================================

  - ls -Z /usr/share/nginx/html > /etc/j02-v03-selinux.context
  - ausearch -m AVC -ts recent > /etc/j02-v03-avc.log || true
  - systemctl is-active nginx > /etc/j02-v03-nginx.status

  #===========================================================================
  # 6. FLAGS
  #===========================================================================

  - echo "J02-V03 | SELinux bloquea nginx (.30)" > /etc/j02-variant.flag
  - echo "J02-V03 aplicado - $(date)" >> /var/log/j02-variants.log
