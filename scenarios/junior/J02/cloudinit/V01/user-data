#cloud-config
hostname: j02-firewall-troubleshooting

# ========== PARTE DE RED (DEL BASE) ==========
network:
  version: 2
  ethernets:
    enp1s0:
      addresses:
        - 192.168.122.20/24
        - 192.168.122.30/24  
        - 192.168.122.40/24
      gateway4: 192.168.122.1
      dhcp4: false

users:
  - name: student
    gecos: Student User
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: wheel
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAAIByFDKwjMDeGJ5GRhXmZHa75h7dK9JcPHvWWtesSO3/x RHCSA Storage Labs

ssh_pwauth: false
disable_root: true

packages:
  - firewalld
  - nginx
  - mariadb-server
  - policycoreutils-python-utils
  - setroubleshoot-server
  - telnet
  - net-tools
  - bind-utils

# ========== UN SOLO BLOQUE runcmd ==========
runcmd:
  # 1. Verificar red
  - sleep 5
  - ip addr
  
  # 2. Configurar servicios
  - systemctl enable --now firewalld nginx mariadb
  - setenforce 1
  
  # 3. "Virus" V01 - Firewall bloquea HTTP
  - firewall-cmd --zone=internal --remove-service=http --permanent
  - firewall-cmd --reload
  
  # 4. MOTD V01
  - |
    cat << 'EOF' > /etc/motd
    ════════════════════════════════════════════════════════════════════════════════
    
                  LAB J02-V01 — FIREWALLD BLOQUEA HTTP
    
    ════════════════════════════════════════════════════════════════════════════════
    
    📌 TICKET:
      "La WEB no carga, pero la base de datos responde correctamente"
    
    TOPOLOGÍA:
      ADMIN → 192.168.122.20 (SSH)        ✓
      WEB   → 192.168.122.30 (HTTP)       ✗
      DB    → 192.168.122.40 (MySQL 3306) ✓
    
    🔴 SÍNTOMAS DESDE HOST:
      curl http://192.168.122.30        → Connection refused
      nc -zv 192.168.122.40 3306        → OK
    
    🔍 ESTADO EN VM:
      systemctl status nginx            → active (running)
      ss -tuln | grep :80               → LISTEN
      firewall-cmd --list-all --zone=internal → http ❌
    
    🎯 OBJETIVO:
      Restaurar acceso HTTP SIN:
        • Reiniciar nginx
        • Desactivar firewalld
        • Romper persistencia
    
    🛠️ COMANDOS CLAVE:
      firewall-cmd --list-all --zone=internal
      firewall-cmd --permanent --add-service=http --zone=internal
      firewall-cmd --reload
    
    ════════════════════════════════════════════════════════════════════════════════
    EOF
  
  # 5. Documento del escenario
  - |
    cat << 'EOF' > /etc/j02-scenario.txt
    J02-V01 — FIREWALLD BLOQUEA HTTP
    
    OBJETIVO:
      curl http://192.168.122.30 → OK
    
    SÍNTOMAS:
      • ping 192.168.122.30 → OK
      • curl http://192.168.122.30 → FAIL
      • nc -zv 192.168.122.40 3306 → OK
    
    DIAGNÓSTICO:
      • nginx activo y escuchando
      • firewalld (zona internal) sin servicio http
    
    FIX:
      firewall-cmd --permanent --add-service=http --zone=internal
      firewall-cmd --reload
    
    VALIDACIÓN:
      curl http://192.168.122.30 → OK
    EOF
  
  # 6. Evidencias
  - firewall-cmd --list-all --zone=internal > /etc/j02-v01-firewall.state
  - systemctl is-active nginx > /etc/j02-v01-nginx.status
  - ss -tuln | grep :80 > /etc/j02-v01-ports.state
  
  # 7. Flags
  - echo "J02-V01 | Firewall bloquea HTTP (.30)" > /etc/j02-variant.flag
  - echo "J02-V01 aplicado - $(date)" >> /var/log/j02-variants.log