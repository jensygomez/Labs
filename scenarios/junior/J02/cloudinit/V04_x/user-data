runcmd:
  #===========================================================================
  # 1. SERVICIOS BASE
  #===========================================================================

  - systemctl enable --now firewalld nginx mariadb
  - setenforce 1

  #===========================================================================
  # 2. VIRUS V04-A — MARIADB EN PUERTO CUSTOM + DATADIR NO ESTÁNDAR
  #===========================================================================

  # Crear nuevo datadir
  - mkdir -p /data/mysql
  - chown -R mysql:mysql /data/mysql

  # Cambiar puerto y datadir (SIN ajustar SELinux)
  - |
    cat <<EOF > /etc/my.cnf.d/j02-v04.cnf
    [mysqld]
    port=3307
    datadir=/data/mysql
    bind-address=0.0.0.0
    EOF

  - systemctl restart mariadb || true

  #===========================================================================
  # 3. VIRUS V04-B — RICH RULE MAL ESCRITA
  #===========================================================================

  # Elimina mysql estándar
  - firewall-cmd --zone=internal --remove-service=mysql --permanent

  # Rich rule INCORRECTA (syntax válida, lógica incorrecta)
  - firewall-cmd --permanent --add-rich-rule='rule family="ipv4" port port="3307" protocol="tcp" reject'
  - firewall-cmd --reload

  #===========================================================================
  # 4. MOTD — TICKET DE PRODUCCIÓN
  #===========================================================================

  - |
    cat << 'EOF' > /etc/motd
    ════════════════════════════════════════════════════════════════════════════════
    
                LAB J02-V04 — SELINUX + RICH RULE (MYSQL 3307)
    
    ════════════════════════════════════════════════════════════════════════════════
    
    📌 TICKET:
      "La base de datos cambió de puerto y ahora no responde"
    
    TOPOLOGÍA:
      WEB → 192.168.122.30 (HTTP)        ✓
      DB  → 192.168.122.40:3307          ✗
    
    🔴 SÍNTOMAS DESDE HOST:
      nc -zv 192.168.122.40 3307       → FAIL
      curl http://192.168.122.30       → OK
    
    🔍 ESTADO EN VM:
      systemctl status mariadb         → active (running)
      ss -tuln | grep 3307             → LISTEN
      firewall-cmd --list-rich-rules   → regla sospechosa ❌
      getenforce                       → Enforcing
    
    ⚠️ DOBLE PROBLEMA:
      1. Rich rule mal definida
      2. SELinux bloquea /data/mysql
    
    🎯 OBJETIVO:
      Restaurar acceso MySQL SIN:
        • Cambiar puerto de nuevo
        • Desactivar SELinux
        • Abrir todo en firewalld
    
    🛠️ COMANDOS CLAVE:
      firewall-cmd --list-rich-rules
      firewall-cmd --remove-rich-rule=...
      firewall-cmd --permanent --add-rich-rule=CORRECTA
      semanage fcontext -l | grep mysql
      restorecon -Rv /data/mysql
    
    ════════════════════════════════════════════════════════════════════════════════
    EOF

  #===========================================================================
  # 5. DOCUMENTO DEL ESCENARIO
  #===========================================================================

  - |
    cat << 'EOF' > /etc/j02-scenario.txt
    J02-V04 — SELINUX + RICH RULE (MYSQL 3307)
    
    OBJETIVO:
      nc -zv 192.168.122.40 3307 → OK
    
    SÍNTOMAS:
      • ss -tuln → 3307 LISTEN ✓
      • nc -zv 192.168.122.40 3307 → FAIL
    
    DIAGNÓSTICO:
      • firewalld: rich rule incorrecta
      • SELinux: datadir /data/mysql sin contexto mysql
    
    FIX FIREWALL (ejemplo correcto):
      firewall-cmd --permanent --add-rich-rule='
        rule family="ipv4"
        source address="192.168.122.0/24"
        port port="3307" protocol="tcp" accept'
      firewall-cmd --reload
    
    FIX SELINUX:
      semanage fcontext -a -t mysqld_db_t "/data/mysql(/.*)?"
      restorecon -Rv /data/mysql
    
    VALIDACIÓN:
      nc -zv 192.168.122.40 3307 → OK
    EOF

  #===========================================================================
  # 6. EVIDENCIAS
  #===========================================================================

  - firewall-cmd --list-rich-rules > /etc/j02-v04-richrules.state
  - ls -Zd /data/mysql > /etc/j02-v04-selinux.context
  - ss -tuln | grep 3307 > /etc/j02-v04-ports.state

  #===========================================================================
  # 7. FLAGS
  #===========================================================================

  - echo "J02-V04 | SELinux + Rich Rule MySQL 3307" > /etc/j02-variant.flag
  - echo "J02-V04 aplicado - $(date)" >> /var/log/j02-variants.log
