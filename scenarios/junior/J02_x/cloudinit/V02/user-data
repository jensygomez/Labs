runcmd:
  #===========================================================================
  # 1. SERVICIOS (BASE SANA)
  #===========================================================================

  - systemctl enable --now firewalld nginx mariadb
  - setenforce 1

  #===========================================================================
  # 2. VIRUS V02 — ZONA INCORRECTA PARA DB (MYSQL)
  #===========================================================================

  # Fuerza el error: quitar mysql de zona internal
  - firewall-cmd --zone=internal --remove-service=mysql --permanent

  # Asegura que la interfaz DB esté en una zona que NO permite mysql
  - firewall-cmd --zone=public --add-interface=dummy1 --permanent

  - firewall-cmd --reload

  #===========================================================================
  # 3. MOTD — TICKET DE PRODUCCIÓN
  #===========================================================================

  - |
    cat << 'EOF' > /etc/motd
    ════════════════════════════════════════════════════════════════════════════════
    
                  LAB J02-V02 — FIREWALLD + ZONAS (MYSQL)
    
    ════════════════════════════════════════════════════════════════════════════════
    
    📌 TICKET:
      "La base de datos no responde, pero la WEB funciona correctamente"
    
    TOPOLOGÍA:
      ADMIN → 192.168.122.20 (SSH)        ✓
      WEB   → 192.168.122.30 (HTTP)       ✓
      DB    → 192.168.122.40 (MySQL 3306) ✗
    
    🔴 SÍNTOMAS DESDE HOST:
      nc -zv 192.168.122.40 3306        → FAIL
      curl http://192.168.122.30        → OK
    
    🔍 ESTADO EN VM:
      systemctl status mariadb          → active (running)
      ss -tuln | grep 3306              → LISTEN
      firewall-cmd --get-active-zones
        → dummy1 en zona PUBLIC ❌
    
    🎯 OBJETIVO:
      Restaurar conectividad MySQL SIN:
        • Reiniciar mariadb
        • Desactivar firewalld
        • Abrir todo en public
    
    🛠️ COMANDOS CLAVE:
      firewall-cmd --get-active-zones
      firewall-cmd --zone=internal --add-interface=dummy1 --permanent
      firewall-cmd --permanent --add-service=mysql --zone=internal
      firewall-cmd --reload
    
    ════════════════════════════════════════════════════════════════════════════════
    EOF

  #===========================================================================
  # 4. DOCUMENTO DEL ESCENARIO
  #===========================================================================

  - |
    cat << 'EOF' > /etc/j02-scenario.txt
    J02-V02 — FIREWALLD + ZONAS (MYSQL BLOQUEADO)
    
    OBJETIVO:
      nc -zv 192.168.122.40 3306 → OK
    
    SÍNTOMAS:
      • curl http://192.168.122.30 → OK
      • nc -zv 192.168.122.40 3306 → FAIL
    
    DIAGNÓSTICO:
      • mariadb activo y escuchando
      • interfaz dummy1 en zona incorrecta (public)
      • servicio mysql no permitido en zona internal
    
    FIX (UNA de las dos):
      A) Corregir zona:
         firewall-cmd --zone=internal --add-interface=dummy1 --permanent
      B) O permitir mysql:
         firewall-cmd --permanent --add-service=mysql --zone=internal
    
      firewall-cmd --reload
    
    VALIDACIÓN:
      nc -zv 192.168.122.40 3306 → OK
    EOF

  #===========================================================================
  # 5. EVIDENCIAS
  #===========================================================================

  - firewall-cmd --get-active-zones > /etc/j02-v02-zones.state
  - firewall-cmd --list-all --zone=internal > /etc/j02-v02-firewall.state
  - ss -tuln | grep 3306 > /etc/j02-v02-ports.state

  #===========================================================================
  # 6. FLAGS
  #===========================================================================

  - echo "J02-V02 | Firewalld zonas bloquean MySQL (.40)" > /etc/j02-variant.flag
  - echo "J02-V02 aplicado - $(date)" >> /var/log/j02-variants.log
