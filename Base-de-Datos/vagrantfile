# -- mode: ruby --
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  
  nodes = [
    { name: "node01", ip: "192.168.122.11", extra_disks: [] },
    { name: "node02", ip: "192.168.122.12", extra_disks: [] },  # no extra disks needed
    { name: "node03", ip: "192.168.122.13", extra_disks: [] }
  ]
  
  nodes.each do |node|
    config.vm.define node[:name] do |node_config|
      node_config.vm.hostname = node[:name]
      
      node_config.vm.network "private_network", 
        ip: node[:ip], 
        libvirt__network_name: "mgmt-net",
        libvirt__dhcp_enabled: false
      
      node_config.vm.provider "libvirt" do |lv|
        lv.memory = 1024
        lv.cpus = 1
        lv.driver = "kvm"
        node[:extra_disks].each do |size|
          lv.storage :file, :size => size, :type => 'qcow2'
        end
      end
      
      # ── GENERAL PROVISIONING (all nodes) ──
      node_config.vm.provision "shell", inline: <<-SHELL
        echo "🔧 Configuring #{node[:name]}..."
        
        for host in node01 node02 node03; do
          sed -i "/$host/d" /etc/hosts
        done
        
        cat << 'HOSTS' >> /etc/hosts
192.168.122.11 node01
192.168.122.12 node02
192.168.122.13 node03
HOSTS

        useradd -m -s /bin/bash bob 2>/dev/null || true
        echo 'bob:caleston123' | chpasswd
        echo 'bob ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/bob
        chmod 0440 /etc/sudoers.d/bob
        
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq
        apt-get install -y -qq sshpass curl acl lvm2 ufw zip tree ntp nfs-kernel-server
      SHELL
      
      # ── NODE02: SERVER WITH 12 INCIDENTS ──
      if node[:name] == "node02"
        node_config.vm.provision "shell", privileged: true, inline: <<-SHELL
          echo "🖥️ Configuring node02 with 12 incidents..."
          
          export DEBIAN_FRONTEND=noninteractive
          apt-get install -y -qq nginx vim tree
          
          # ── TASK 1: tree package NOT installed (we will remove if present) ──
          apt-get remove -y tree 2>/dev/null || true
          
          # ── TASK 2: AppArmor is active by default, but we ensure it's not disabled ──
          # (nothing to do, just leave as is)
          
          # ── TASK 3: Script directory ──
          mkdir -p /opt/scripts
          # No script created yet, student will create it
          
          # ── TASK 4: No custom sudoers for bob yet ──
          rm -f /etc/sudoers.d/bob-systemctl 2>/dev/null || true
          
          # ── TASK 5: No systemd timer yet ──
          rm -f /etc/systemd/system/hello.* 2>/dev/null || true
          
          # ── TASK 6: No custom rsyslog config yet ──
          rm -f /etc/rsyslog.d/99-cron.conf 2>/dev/null || true
          
          # ── TASK 7: No static route yet ──
          # (we won't pre-add anything)
          
          # ── TASK 8: NFS server not yet configured ──
          # (exports file empty)
          
          # ── TASK 9: no background nice process yet ──
          
          # ── TASK 10: alternative editor not set yet ──
          # (default is nano? Actually Ubuntu has nano as default, but we can force it to vim.tiny)
          update-alternatives --set editor /usr/bin/vim.tiny 2>/dev/null || true
          
          # ── TASK 11: hostname currently 'node02' (will be changed to server02) ──
          
          # ── TASK 12: no limits.conf custom entries yet ──
          sed -i '/# END OF CUSTOM LIMITS/d' /etc/security/limits.conf 2>/dev/null || true
          
          # Shared directory for NFS
          mkdir -p /opt/shared
          chown root:root /opt/shared
          chmod 755 /opt/shared
          
          systemctl enable nginx
          systemctl start nginx
          
          echo "✅ node02 configured with 12 incidents"
        SHELL
      end
      
      # ── NODE03: VAULT ──
      if node[:name] == "node03"
        node_config.vm.provision "shell", privileged: true, inline: <<-SHELL
          echo "🔒 Preparing vault..."
          mkdir -p /opt/ops-compliance/mock-exam-009
          chown -R bob:bob /opt/ops-compliance
          chmod -R 755 /opt/ops-compliance
          echo "✅ Vault ready at /opt/ops-compliance/mock-exam-009/"
        SHELL
      end
      
      # ── NODE01: TICKET + VERIFICATION + VALIDATOR (evidence‑based) ──
      if node[:name] == "node01"
        node_config.vm.provision "shell", privileged: false, inline: <<-SHELL
          echo "🎫 Generating Ticket, verification, validator, and evidence script on node01..."
          
          # ═══════════════════════════════════════════════════════
          # TICKET (English)
          # ═══════════════════════════════════════════════════════
          cat << 'TICKET' > /home/vagrant/TICKET_MOCK-009.txt
================================================================================
TICKET MOCK-009   │  Severity: MEDIUM  │  Environment: PRODUCTION
🔐 MOCK-009 — The Final Frontier (12 Tasks)
Module: LFCS Complete  │  Difficulty: 3/10  │  Level: L2
Control Station:    node01  (Administrator — bob)
Server Node:        node02  (Ubuntu 22.04)
Vault Destination:  node03  (/opt/ops-compliance/mock-exam-009/)
Cluster Password:   caleston123

This server (node02) requires 12 system administration tasks covering topics not
yet addressed in previous mocks. Manage your time: ~8–10 minutes per task.
If stuck, move to the next one.

================================================================================
TASK 1 — Package Management: Install and Verify 'tree' (3 points)
================================================================================
The development team needs the 'tree' command for directory listings.

On node02:
1. Install the package 'tree' using apt.
2. Verify installation by running 'which tree' (should return /usr/bin/tree).

CRITERIA:
  [ ] Package 'tree' is installed (dpkg -l | grep tree)                  --> 50%
  [ ] 'which tree' returns a valid path                                  --> 50%

TIME: 5 minutes

================================================================================
TASK 2 — Security/AppArmor: Enforce Mode (3 points)
================================================================================
Ensure AppArmor is active and in enforcing mode.

On node02:
1. Check if AppArmor is running (sudo aa-status).
2. If not enforcing, set it to enforce (sudo aa-enforce /etc/apparmor.d/*).
   (Ubuntu 22.04 is already enforcing, but verify).

CRITERIA:
  [ ] AppArmor is active (sudo aa-status shows profiles in enforce)      --> 50%
  [ ] The command 'getenforce' would show "Enforcing" (but use aa-status)--> 50%

TIME: 5 minutes

================================================================================
TASK 3 — Shell Scripting: Create a Hello Script (3 points)
================================================================================
Create a simple script that prints a greeting.

On node02:
1. Create /opt/scripts/hello.sh with content:
   #!/bin/bash
   echo "Hello LFCS"
2. Make it executable (chmod +x).
3. Test it (should output "Hello LFCS").

CRITERIA:
  [ ] File /opt/scripts/hello.sh exists and is executable               --> 40%
  [ ] Contains the correct echo command                                  --> 30%
  [ ] Running it produces "Hello LFCS"                                   --> 30%

TIME: 8 minutes

================================================================================
TASK 4 — Sudoers: Passwordless systemctl for bob (3 points)
================================================================================
Allow user bob to run systemctl without a password.

On node02:
1. Create a sudoers file in /etc/sudoers.d/ (e.g., bob-systemctl).
2. Add line: bob ALL=(ALL) NOPASSWD: /usr/bin/systemctl
3. Verify with 'sudo -l -U bob' (should show that entry).

CRITERIA:
  [ ] File exists in /etc/sudoers.d/ with correct permission (0440)     --> 30%
  [ ] Contains the exact line                                            --> 40%
  [ ] sudo -l -U bob shows the entry                                    --> 30%

TIME: 10 minutes

================================================================================
TASK 5 — Systemd Timer: Daily Hello Script (3 points)
================================================================================
Schedule the hello.sh script to run daily at 02:30 using a systemd timer.

On node02:
1. Create a service unit /etc/systemd/system/hello.service that executes /opt/scripts/hello.sh.
2. Create a timer unit /etc/systemd/system/hello.timer with OnCalendar=daily and
   OnCalendar=02:30 (or OnCalendar=*-*-* 02:30:00).
3. Enable and start the timer.
4. Verify with 'systemctl list-timers hello.timer'.

CRITERIA:
  [ ] Both service and timer unit files exist                            --> 30%
  [ ] Timer is enabled and active                                        --> 40%
  [ ] Timer shows next trigger time (systemctl list-timers)            --> 30%

TIME: 15 minutes

================================================================================
TASK 6 — Rsyslog: Custom Cron Logging (3 points)
================================================================================
Log all cron messages to a separate file.

On node02:
1. Create a config file in /etc/rsyslog.d/ (e.g., 99-cron.conf).
2. Add line: cron.* /var/log/cron-custom.log
3. Restart rsyslog (sudo systemctl restart rsyslog).
4. Verify that the file /var/log/cron-custom.log exists (may be empty initially).

CRITERIA:
  [ ] Config file exists with correct content                            --> 40%
  [ ] Rsyslog service restarted successfully                             --> 20%
  [ ] Log file /var/log/cron-custom.log exists                           --> 40%

TIME: 10 minutes

================================================================================
TASK 7 — Networking: Add a Static Route (3 points)
================================================================================
Add a temporary static route to reach network 10.10.10.0/24 via gateway 192.168.122.1.

On node02:
1. Use 'ip route add' to add the route.
2. Verify with 'ip route show' (route appears).

CRITERIA:
  [ ] Route 10.10.10.0/24 via 192.168.122.1 exists in routing table    --> 100%

TIME: 5 minutes

================================================================================
TASK 8 — NFS: Export a Directory (3 points)
================================================================================
Install NFS server and export /opt/shared to all clients with read-write permissions.

On node02:
1. Install nfs-kernel-server (already installed).
2. Add an export line to /etc/exports: /opt/shared *(rw,sync,no_subtree_check)
3. Export with 'exportfs -a' and verify with 'exportfs -v'.

CRITERIA:
  [ ] /etc/exports contains the correct line                             --> 40%
  [ ] exportfs -v shows the export                                       --> 40%
  [ ] The directory /opt/shared is exported (showmount -e localhost)    --> 20%

TIME: 10 minutes

================================================================================
TASK 9 — Process Priority: Run with nice (3 points)
================================================================================
Start a background process with a low priority (higher nice value).

On node02:
1. Run: nice -n 15 sleep 300 &
2. Verify the process is running with the correct nice value using 'ps -o pid,ni,comm | grep sleep'.

CRITERIA:
  [ ] A 'sleep 300' process is running with nice value 15               --> 100%

TIME: 5 minutes

================================================================================
TASK 10 — Alternatives: Set Default Editor to nano (3 points)
================================================================================
Make 'nano' the default editor using update-alternatives.

On node02:
1. Ensure nano is installed (already).
2. Run: sudo update-alternatives --set editor /usr/bin/nano
3. Verify with 'update-alternatives --display editor' shows nano as the selected one.

CRITERIA:
  [ ] update-alternatives --display editor shows nano with priority >0   --> 50%
  [ ] /usr/bin/editor symlink points to /etc/alternatives/editor -> nano --> 50%

TIME: 8 minutes

================================================================================
TASK 11 — Hostname: Set Permanent Hostname to server02 (3 points)
================================================================================
Change the system's hostname to 'server02' permanently.

On node02:
1. Use hostnamectl set-hostname server02
2. Verify with hostnamectl --static and check /etc/hostname.

CRITERIA:
  [ ] hostnamectl --static shows 'server02'                              --> 60%
  [ ] /etc/hostname contains 'server02'                                  --> 40%

TIME: 5 minutes

================================================================================
TASK 12 — Limits: Increase File Descriptor Limit (3 points)
================================================================================
Set system-wide file descriptor limits to 65535 for all users.

On node02:
1. Edit /etc/security/limits.conf
2. Add lines:
   * soft nofile 65535
   * hard nofile 65535
3. Verify with 'ulimit -n' (for new sessions, but we can check file content).

CRITERIA:
  [ ] /etc/security/limits.conf contains both lines                      --> 60%
  [ ] Lines are not commented out (no leading #)                        --> 40%

TIME: 8 minutes

================================================================================
EVIDENCE PIPELINE TO NODE03 (Optional — does not affect score)
================================================================================
To automate evidence collection, run on node01:
  bash /home/vagrant/generate-evidence.sh

This fetches outputs for all 12 tasks and stores them in:
  node03:/opt/ops-compliance/mock-exam-009/evidence.txt

It is **not mandatory** but useful for auditing.

================================================================================
SCORING SUMMARY
================================================================================
Task 1:  3 pts (Package Management)
Task 2:  3 pts (Security/AppArmor)
Task 3:  3 pts (Scripting)
Task 4:  3 pts (Sudoers)
Task 5:  3 pts (Systemd Timer)
Task 6:  3 pts (Rsyslog)
Task 7:  3 pts (Networking - route)
Task 8:  3 pts (NFS)
Task 9:  3 pts (Process priority)
Task 10: 3 pts (Alternatives)
Task 11: 3 pts (Hostname)
Task 12: 3 pts (Limits)
TOTAL: 36 points
PASSING (67%): 25 points

TOTAL TIME: 120 minutes

When done, run: bash /home/vagrant/validate.sh
================================================================================
TICKET

          # ═══════════════════════════════════════════════════════
          # INITIAL VERIFICATION SCRIPT (verify-009.sh)
          # ═══════════════════════════════════════════════════════
          cat << 'VERIFY' > /tmp/verify-009.sh
#!/bin/bash
RED='\e[1;31m'; GREEN='\e[1;32m'; YELLOW='\e[1;33m'; CYAN='\e[1;36m'; RESET='\e[0m'
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=5"; PASS="caleston123"; FAIL=0

echo -e "${CYAN}╔════════════════════════════════════════════════════════════════╗${RESET}"
echo -e "${CYAN}║          VERIFYING SCENARIO MOCK-009                           ║${RESET}"
echo -e "${CYAN}╚════════════════════════════════════════════════════════════════╝${RESET}"
echo ""

echo -e "${YELLOW}[1/6] node02: tree package NOT installed${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "dpkg -l tree 2>/dev/null | grep -q ^ii" 2>/dev/null; then
  echo -e "      ${RED}✗ tree is already installed (should be absent)${RESET}"; FAIL=1
else
  echo -e "      ${GREEN}✓ OK (not installed)${RESET}"
fi

echo -e "${YELLOW}[2/6] node02: /opt/scripts directory exists${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "[ -d /opt/scripts ]" 2>/dev/null; then
  echo -e "      ${GREEN}✓ OK${RESET}"
else
  echo -e "      ${RED}✗ FALLÓ${RESET}"; FAIL=1
fi

echo -e "${YELLOW}[3/6] node02: no custom sudoers for systemctl${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "ls /etc/sudoers.d/bob-systemctl 2>/dev/null" 2>/dev/null; then
  echo -e "      ${RED}✗ custom sudoers file already exists${RESET}"; FAIL=1
else
  echo -e "      ${GREEN}✓ OK${RESET}"
fi

echo -e "${YELLOW}[4/6] node02: no systemd timer/service for hello${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "systemctl status hello.timer 2>/dev/null | grep -q 'Loaded: loaded'" 2>/dev/null; then
  echo -e "      ${RED}✗ hello.timer already exists${RESET}"; FAIL=1
else
  echo -e "      ${GREEN}✓ OK${RESET}"
fi

echo -e "${YELLOW}[5/6] node02: no custom rsyslog config for cron${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "ls /etc/rsyslog.d/99-cron.conf 2>/dev/null" 2>/dev/null; then
  echo -e "      ${RED}✗ custom rsyslog config already exists${RESET}"; FAIL=1
else
  echo -e "      ${GREEN}✓ OK${RESET}"
fi

echo -e "${YELLOW}[6/6] node03: Vault exists${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node03 "[ -d /opt/ops-compliance/mock-exam-009 ]" 2>/dev/null; then
  echo -e "      ${GREEN}✓ OK${RESET}"
else
  echo -e "      ${RED}✗ FALLÓ${RESET}"; FAIL=1
fi

echo ""
if [ $FAIL -eq 0 ]; then
  echo -e "${GREEN}✅ SCENARIO READY — Press ENTER to see the ticket${RESET}"
else
  echo -e "${RED}⚠️  SOME CHECKS FAILED${RESET}"
fi
echo ""
read -r
cat /home/vagrant/TICKET_MOCK-009.txt
VERIFY
          chmod +x /tmp/verify-009.sh
          sed -i '/verify-009/d' /home/vagrant/.bashrc 2>/dev/null || true
          echo 'bash /tmp/verify-009.sh' >> /home/vagrant/.bashrc

          # ═══════════════════════════════════════════════════════
          # EVIDENCE GENERATOR (generate-evidence.sh)
          # ═══════════════════════════════════════════════════════
          #
          # NOTE: This script is the single source of truth for validation.
          # The header lines (--- TASK N: DESCRIPTION ---) MUST match
          # exactly those searched by validate.sh (case, spacing, number).
          #
          cat << 'EVIDENCE' > /home/vagrant/generate-evidence.sh
#!/bin/bash
# generate-evidence.sh - Collects output for each task and saves to node03.
# Header format must be synchronized with validate.sh.

SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=5"
PASS="caleston123"
DEST="node03:/opt/ops-compliance/mock-exam-009/evidence.txt"

echo "🔍 Collecting evidence from node02..."
{
  echo "=== EVIDENCE FOR MOCK-009 ==="
  echo "Date: $(date)"
  echo ""

  # TASK 1: Package tree
  echo "--- TASK 1: PACKAGE TREE INSTALLED ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "dpkg -l tree 2>/dev/null | grep ^ii; which tree 2>/dev/null || echo 'not found'"
  echo ""

  # TASK 2: AppArmor status
  echo "--- TASK 2: APPARMOR ENFORCING ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "sudo aa-status 2>/dev/null | head -n 5 || echo 'AppArmor not active'"
  echo ""

  # TASK 3: hello.sh script
  echo "--- TASK 3: HELLO SCRIPT ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "ls -l /opt/scripts/hello.sh 2>/dev/null; cat /opt/scripts/hello.sh 2>/dev/null; /opt/scripts/hello.sh 2>/dev/null || echo 'script missing'"
  echo ""

  # TASK 4: Sudoers entry
  echo "--- TASK 4: SUDOERS ENTRY ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "sudo -l -U bob 2>/dev/null | grep -A2 'User bob' || echo 'no sudo entry'"
  echo ""

  # TASK 5: Systemd timer
  echo "--- TASK 5: SYSTEMD TIMER ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "systemctl status hello.timer 2>/dev/null; systemctl list-timers hello.timer 2>/dev/null || echo 'timer not found'"
  echo ""

  # TASK 6: Rsyslog config
  echo "--- TASK 6: RSYSLOG CUSTOM CONFIG ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "cat /etc/rsyslog.d/99-cron.conf 2>/dev/null; ls -l /var/log/cron-custom.log 2>/dev/null || echo 'file missing'"
  echo ""

  # TASK 7: Static route
  echo "--- TASK 7: STATIC ROUTE ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "ip route show 2>/dev/null | grep '10.10.10.0/24' || echo 'route missing'"
  echo ""

  # TASK 8: NFS export
  echo "--- TASK 8: NFS EXPORT ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "cat /etc/exports 2>/dev/null | grep /opt/shared; exportfs -v 2>/dev/null | grep /opt/shared || echo 'export missing'"
  echo ""

  # TASK 9: nice process
  echo "--- TASK 9: NICE PROCESS ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "ps -eo pid,ni,comm 2>/dev/null | grep '[s]leep' | head -n 1 || echo 'no sleep process'"
  echo ""

  # TASK 10: update-alternatives editor
  echo "--- TASK 10: EDITOR ALTERNATIVE ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "update-alternatives --display editor 2>/dev/null | grep -E '^/usr/bin/nano' | head -n 1; ls -l /usr/bin/editor 2>/dev/null || echo 'editor link missing'"
  echo ""

  # TASK 11: Hostname
  echo "--- TASK 11: HOSTNAME ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "hostnamectl --static 2>/dev/null; cat /etc/hostname 2>/dev/null || echo 'hostname missing'"
  echo ""

  # TASK 12: Limits
  echo "--- TASK 12: FILE DESCRIPTOR LIMITS ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "grep -E '^\*[[:space:]]+(soft|hard)[[:space:]]+nofile' /etc/security/limits.conf 2>/dev/null || echo 'limits missing'"
  echo ""

  echo "=== END OF EVIDENCE ==="
} | sshpass -p $PASS ssh $SSH_OPTS bob@node03 "cat > /opt/ops-compliance/mock-exam-009/evidence.txt"

if [ $? -eq 0 ]; then
  echo "✅ Evidence saved to $DEST"
else
  echo "❌ Failed to save evidence"
fi
EVIDENCE
          chmod +x /home/vagrant/generate-evidence.sh

          # ═══════════════════════════════════════════════════════
          # VALIDATOR (validate.sh) — evidence‑based
          # ═══════════════════════════════════════════════════════
          #
          # NOTE: This script fetches evidence.txt ONCE from node03,
          # then validates each task using its dedicated block.
          # Headers must match those in generate-evidence.sh exactly.
          #
          cat << 'VALIDATOR' > /home/vagrant/validate.sh
#!/bin/bash
# validate.sh - Validates all tasks by reading evidence.txt from node03.
# Single fetch, scoped grep per task, graceful failure if evidence missing.

RED='\e[1;31m'; GREEN='\e[1;32m'; YELLOW='\e[1;33m'; CYAN='\e[1;36m'; MAGENTA='\e[1;35m'; RESET='\e[0m'; BOLD='\e[1m'
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=5"
PASS="caleston123"
TOTAL=0; MAX=36; PASS_COUNT=0; FAIL_COUNT=0

# --- Fetch evidence from node03 ---
EVIDENCE_FILE="/tmp/evidence-$$.txt"
echo -e "${CYAN}Fetching evidence from node03...${RESET}"
if ! sshpass -p $PASS scp $SSH_OPTS bob@node03:/opt/ops-compliance/mock-exam-009/evidence.txt "$EVIDENCE_FILE" 2>/dev/null; then
  echo -e "${RED}ERROR: Could not fetch evidence.txt from node03.${RESET}"
  echo -e "${RED}Please run 'bash /home/vagrant/generate-evidence.sh' first.${RESET}"
  exit 1
fi

# Helper to extract a task's block (between its header and the next header)
extract_block() {
  local task_num=$1
  local next_num=$((task_num + 1))
  local header_pattern="--- TASK ${task_num}:"
  local next_header_pattern="--- TASK ${next_num}:"
  # If next_num > 12, use end-of-file
  if [ $next_num -le 12 ]; then
    sed -n "/$header_pattern/,/$next_header_pattern/p" "$EVIDENCE_FILE" | sed '$d'  # remove line with next header
  else
    sed -n "/$header_pattern/,\$p" "$EVIDENCE_FILE"
  fi
}

# Check if a block contains a pattern (grep -q)
block_contains() {
  local block="$1"
  local pattern="$2"
  echo "$block" | grep -q "$pattern"
}

# Wrapper for each task validation
validate_task() {
  local n=$1; local name=$2; local pts=$3; local pattern=$4; local desc=$5
  echo -e "\n${CYAN}┌─ TASK $n: $name ($pts pts) ─${RESET}"
  echo -e "${YELLOW}   $desc${RESET}"
  
  block=$(extract_block $n)
  if [ -z "$block" ]; then
    echo -e "   ${RED}❌ Evidence block for Task $n not found (header missing).${RESET}"
    echo -e "   ${YELLOW}   Run generate-evidence.sh again.${RESET}"
    FAIL_COUNT=$((FAIL_COUNT + 1))
    return
  fi
  
  if echo "$block" | grep -qE "$pattern"; then
    echo -e "   ${GREEN}✅ +$pts pts${RESET}"
    TOTAL=$((TOTAL + pts)); PASS_COUNT=$((PASS_COUNT + 1))
  else
    echo -e "   ${RED}❌ +0 pts${RESET}"
    # Optional: show what we found?
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi
}

echo -e "${MAGENTA}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║     🎯 VALIDATOR LFCS — MOCK #009                            ║"
echo "║        The Final Frontier (12 tasks)                         ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "${RESET}"
echo -e "${BOLD}Validating using evidence from node03...${RESET}\n"

# T1: tree installed
validate_task 1 "Package tree" 3 \
  "tree[[:space:]]+install|^ii[[:space:]]+tree|which tree.*/usr/bin/tree" \
  "tree package installed and which tree returns path"

# T2: AppArmor enforcing
validate_task 2 "AppArmor enforcing" 3 \
  "enforce|Enforcing|profiles.*enforce" \
  "AppArmor active and in enforcing mode"

# T3: hello script
validate_task 3 "Hello script" 3 \
  "Hello LFCS|/opt/scripts/hello.sh.*executable" \
  "Script exists, executable, prints 'Hello LFCS'"

# T4: sudoers entry
validate_task 4 "Sudoers systemctl" 3 \
  "bob.*NOPASSWD.*systemctl|/usr/bin/systemctl" \
  "bob has NOPASSWD for systemctl"

# T5: systemd timer
validate_task 5 "Systemd timer" 3 \
  "hello.timer.*loaded|hello.timer.*active|02:30" \
  "Timer unit exists, enabled, shows next trigger"

# T6: rsyslog config
validate_task 6 "Rsyslog cron" 3 \
  "cron\.\*.*/var/log/cron-custom.log|cron-custom.log" \
  "Custom rsyslog rule for cron and log file exists"

# T7: static route
validate_task 7 "Static route" 3 \
  "10\.10\.10\.0/24.*via.*192\.168\.122\.1" \
  "Route 10.10.10.0/24 via 192.168.122.1 is present"

# T8: NFS export
validate_task 8 "NFS export" 3 \
  "/opt/shared.*\*.*rw|exportfs.*/opt/shared" \
  "/opt/shared exported with rw to all"

# T9: nice process
validate_task 9 "Nice process" 3 \
  "sleep.*ni:?[[:space:]]*15|sleep[[:space:]]+300.*15" \
  "sleep 300 running with nice 15"

# T10: editor alternative
validate_task 10 "Editor alternative" 3 \
  "/usr/bin/nano.*priority|editor.*->.*nano" \
  "nano set as default editor via update-alternatives"

# T11: hostname
validate_task 11 "Hostname server02" 3 \
  "server02" \
  "hostname is server02 (static and /etc/hostname)"

# T12: limits
validate_task 12 "File descriptor limits" 3 \
  "\*[[:space:]]+(soft|hard)[[:space:]]+nofile[[:space:]]+65535" \
  "limits.conf contains * soft/hard nofile 65535"

# ── Cleanup ──
rm -f "$EVIDENCE_FILE"

# ── Final summary ──
PERCENT=$((TOTAL * 100 / MAX))

echo -e "\n${MAGENTA}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                    📊 FINAL RESULT                          ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "${RESET}"
echo -e "${BOLD}Tasks passed:${RESET}  ${GREEN}$PASS_COUNT / 12${RESET}"
echo -e "${BOLD}Tasks failed:${RESET}   ${RED}$FAIL_COUNT / 12${RESET}"
echo -e "${BOLD}Score:${RESET}         ${CYAN}$TOTAL / $MAX points${RESET}"
echo -e "${BOLD}Percentage:${RESET}    ${CYAN}$PERCENT%${RESET}"
echo -e "${BOLD}Passing (67%):${RESET}  ${CYAN}25 points${RESET}"
echo ""

if [ $PERCENT -ge 67 ]; then
  echo -e "${GREEN}${BOLD}"
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║           🎉 PASSED! CONGRATULATIONS, BOB! 🎉               ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo -e "${RESET}"
else
  echo -e "${RED}${BOLD}"
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║               ❌ NOT PASSED — KEEP GOING! 💪                 ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo -e "${RESET}"
fi
echo ""
VALIDATOR
          chmod +x /home/vagrant/validate.sh

          echo "✅ Ticket + Verification + Validator + Evidence script created."
          echo "🚀 vagrant ssh node01 → automatic verification"
          echo "📝 When done: bash /home/vagrant/validate.sh"
          echo "📦 (Optional) Send evidence: bash /home/vagrant/generate-evidence.sh"
        SHELL
      end
    end
  end
end
