# -- mode: ruby --
# vi: set ft=ruby :
ENV['VAGRANT_NO_PARALLEL'] = 'yes'
Vagrant.configure("2") do |config|
  config.vm.box = "almalinux/9"
  config.ssh.insert_key = false

  nodes = [
    { name: "node01", ip: "192.168.122.11", extra_disks: [] },
    { name: "node02", ip: "192.168.122.12", extra_disks: ['1G'] }
  ]

  nodes.each do |node|
    config.vm.define node[:name] do |node_config|
      node_config.vm.hostname = node[:name]
      
      # Primary private network
      node_config.vm.network "private_network",
        ip: node[:ip],
        libvirt__network_name: "mgmt-net",
        libvirt__dhcp_enabled: false

      # Secondary network for node02 (for Bonding task)
      if node[:name] == "node02"
        node_config.vm.network "private_network",
          ip: "192.168.123.12",
          libvirt__network_name: "mgmt-net-2",
          libvirt__dhcp_enabled: false
      end

      node_config.vm.provider "libvirt" do |lv|
        lv.memory = 2048
        lv.cpus = 2
        lv.driver = "kvm"
        node[:extra_disks].each do |size|
          lv.storage :file, :size => size, :type => 'qcow2'
        end
      end

      # ── GENERAL PROVISIONING (all nodes) ──
      node_config.vm.provision "shell", inline: <<-SHELL
        echo "🔧 Configuring #{node[:name]}..."
        for host in node01 node02; do
          sed -i "/$host/d" /etc/hosts
        done
        cat << 'HOSTS' >> /etc/hosts
192.168.122.11 node01
192.168.122.12 node02
HOSTS
        useradd -m -s /bin/bash bob 2>/dev/null || true
        echo 'bob:caleston123' | chpasswd
        echo 'bob ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/bob
        chmod 0440 /etc/sudoers.d/bob
        dnf install -y -q epel-release >/dev/null 2>&1
        dnf install -y -q sshpass curl acl >/dev/null 2>&1
        systemctl enable --now sshd >/dev/null 2>&1
        systemctl disable --now firewalld >/dev/null 2>&1 || true
      SHELL

      # ── NODE02: SERVER WITH 12 INCIDENTS ──
      if node[:name] == "node02"
        node_config.vm.provision "shell", privileged: true, inline: <<-SHELL
          echo "🖥️ Configuring node02 for MOCK-016..."
          
          # Install required packages (ADDED 'libvirt' for the daemon)
          dnf install -y -q libvirt libvirt-client nfs-utils podman nftables iptables openssl nmap-ncat >/dev/null 2>&1
          
          # Prepare directories and groups for ACL task
          mkdir -p /shared/data
          groupadd devs 2>/dev/null || true
          usermod -aG devs bob 2>/dev/null || true
          chmod 750 /shared/data
          
          # Start a background sleep process for bob (for renice task)
          su - bob -c "nohup sleep 3600 >/dev/null 2>&1 &"
          
          # Create dummy files for find task (Task 11)
          touch /var/tmp/bob_file1 /var/tmp/bob_file2 /var/tmp/bob_file3
          chown bob:bob /var/tmp/bob_file*
          
          # Prepare dummy libvirt VM for autostart task
          mkdir -p /etc/libvirt/qemu
          cat << 'EOF' > /etc/libvirt/qemu/mock16-vm.xml
<domain type='qemu'>
  <name>mock16-vm</name>
  <uuid>12345678-1234-1234-1234-123456789016</uuid>
  <memory unit='KiB'>65536</memory>
  <vcpu>1</vcpu>
  <os>
    <type arch='x86_64'>hvm</type>
  </os>
</domain>
EOF
          systemctl enable --now libvirtd >/dev/null 2>&1
          virsh define /etc/libvirt/qemu/mock16-vm.xml >/dev/null 2>&1 || true
          
          # Enable lingering for bob so user systemd services can be checked
          loginctl enable-linger bob >/dev/null 2>&1 || true

          echo "✅ node02 configured for MOCK-016"
        SHELL
      end

      # ── NODE01: TICKET + VERIFICATION + VALIDATOR ──
      if node[:name] == "node01"
        node_config.vm.provision "shell", privileged: false, inline: <<-SHELL
          echo "🎫 Generating Ticket, verification, and validator on node01..."
          
          cat << 'TICKET' > /home/vagrant/TICKET_MOCK-016.txt
================================================================================
TICKET MOCK-016   |  Severity: MEDIUM-HIGH  |  Environment: PRODUCTION
🔐 MOCK-016 — Integrated Matrix B (12 Tasks)  |  AlmaLinux 9
Module: LFCS Complete  |  Difficulty: 4/10  |  Level: L2
Control Station:    node01  (Administrator — bob)
Server Node:        node02  (AlmaLinux 9)
Cluster Password:   caleston123
This mock escalates difficulty by integrating default ACLs, network bonding,
NFSv4, process tuning, SSL generation, rootless Podman+systemd, DNAT, and
advanced systemd/libvirt management. Manage your time: ~10 mins per task.
================================================================================
TASK 1 — Users/Security: Default ACLs (3 points)
================================================================================
On node02, configure default ACLs on the directory `/shared/data` so that the
group `devs` automatically receives `rwx` permissions on all newly created 
files and subdirectories.
CRITERIA:
[ ] Default ACL for group devs with rwx exists on /shared/data            --> 50%
[ ] Directory permissions are correctly set (e.g., 750 or 770)            --> 50%
TIME: 8 minutes
================================================================================
TASK 2 — Networking: Network Bonding (3 points)
================================================================================
On node02, configure a network bond named `bond0` using `nmcli`. Set the mode
to `active-backup` (mode 1) and attach two available network interfaces 
(e.g., eth1 and eth2, or their enpXsX equivalents) as slaves.
CRITERIA:
[ ] bond0 connection exists and mode is active-backup                     --> 50%
[ ] Two interfaces are successfully attached as ports to bond0            --> 50%
TIME: 12 minutes
================================================================================
TASK 3 — Storage: NFSv4 Local Export & Mount (3 points)
================================================================================
On node02, export the directory `/srv/nfs_share` via NFSv4. Then, mount this
export locally on `/mnt/nfs_local` persistently in `/etc/fstab`. Ensure the
nfs-server service is enabled and running.
CRITERIA:
[ ] /srv/nfs_share is exported in /etc/exports with NFSv4 settings        --> 50%
[ ] /mnt/nfs_local is mounted persistently via /etc/fstab                 --> 50%
TIME: 12 minutes
================================================================================
TASK 4 — Operations: Process Tuning (3 points)
================================================================================
On node02, identify the `sleep 3600` process running under user `bob` and 
change its niceness value to `15` using the `renice` command.
CRITERIA:
[ ] The sleep 3600 process for user bob has a NI value of 15              --> 100%
TIME: 8 minutes
================================================================================
TASK 5 — Security: SSL/TLS Generation (3 points)
================================================================================
On node02, use `openssl` to generate a 2048-bit RSA private key and a 
self-signed SSL certificate valid for 365 days. Save them as:
- Key: `/etc/ssl/private/mock16.key`
- Cert: `/etc/ssl/certs/mock16.crt`
CRITERIA:
[ ] Private key exists and is valid 2048-bit RSA                          --> 50%
[ ] Certificate exists, is self-signed, and valid for ~365 days           --> 50%
TIME: 10 minutes
================================================================================
TASK 6 — Containers: Podman Systemd Integration (3 points)
================================================================================
On node02, as user `bob`, create a systemd user service to manage a rootless
Podman container (e.g., running `alpine` or `nginx`). Enable and start the
service so it runs under bob's user systemd instance.
CRITERIA:
[ ] Systemd user service file exists for bob                              --> 50%
[ ] Service is active and managing a running podman container             --> 50%
TIME: 15 minutes
================================================================================
TASK 7 — Storage: Prioritized Swap File (3 points)
================================================================================
On node02, create a 512MB swap file at `/swapfile2`, set strict permissions
(600), format it, and enable it persistently in `/etc/fstab` with a priority
of 10.
CRITERIA:
[ ] /swapfile2 exists with 600 permissions and is active in swapon        --> 50%
[ ] /etc/fstab contains the entry with pri=10                             --> 50%
TIME: 10 minutes
================================================================================
TASK 8 — Networking: Port Redirection (DNAT) (3 points)
================================================================================
On node02, configure a firewall rule (using `nftables` or `iptables`) to 
redirect incoming TCP traffic destined for port 80 to port 8080 on the local machine.
CRITERIA:
[ ] DNAT rule exists in nftables or iptables nat table                    --> 100%
TIME: 12 minutes
================================================================================
TASK 9 — Essential Commands: Advanced Journalctl (3 points)
================================================================================
On node02, use `journalctl` to filter all log entries with priority `err` 
(or higher) since the last boot, and save the output to `/tmp/boot_errors.log`.
CRITERIA:
[ ] /tmp/boot_errors.log exists and contains journalctl output            --> 50%
[ ] Output is filtered for priority err and current boot (-b)             --> 50%
TIME: 8 minutes
================================================================================
TASK 10 — Operations: Virtualization Autostart (3 points)
================================================================================
On node02, use `virsh` to configure the pre-defined dummy VM `mock16-vm` 
to start automatically when the libvirt daemon boots.
CRITERIA:
[ ] mock16-vm is listed in `virsh list --autostart`                       --> 100%
TIME: 8 minutes
================================================================================
TASK 11 — Essential Commands: Find with Exec (3 points)
================================================================================
On node02, use a single `find` command to locate all files in `/var/tmp` 
owned by user `bob` and change their group ownership to `devs` using `-exec`
or `xargs`.
CRITERIA:
[ ] Command uses find with -exec or xargs to change group                 --> 50%
[ ] Files in /var/tmp owned by bob now belong to group devs               --> 50%
TIME: 10 minutes
================================================================================
TASK 12 — Operations: Systemd Drop-in Override (3 points)
================================================================================
On node02, create a systemd drop-in override for the `sshd.service` to add 
the environment variable `CUSTOM_ENV=mock16` without modifying the main unit file.
CRITERIA:
[ ] Drop-in directory and override.conf exist for sshd.service            --> 50%
[ ] systemctl show sshd.service reflects CUSTOM_ENV=mock16                --> 50%
TIME: 12 minutes
================================================================================
SCORING SUMMARY
================================================================================
Task 1:  3 pts (Default ACLs)      Task 7:  3 pts (Prioritized Swap)
Task 2:  3 pts (Network Bonding)    Task 8:  3 pts (DNAT Redirection)
Task 3:  3 pts (NFSv4 Local Mount)  Task 9:  3 pts (Journalctl Filter)
Task 4:  3 pts (Process Renice)     Task 10: 3 pts (Libvirt Autostart)
Task 5:  3 pts (SSL Generation)     Task 11: 3 pts (Find + Exec)
Task 6:  3 pts (Podman Systemd)     Task 12: 3 pts (Systemd Drop-in)
TOTAL: 36 points
PASSING (67%): 25 points
TOTAL TIME: 120 minutes
When done, run: bash /home/vagrant/validate.sh
================================================================================
TICKET

          cat << 'VERIFY' > /tmp/verify-016.sh
#!/bin/bash
RED='\e[1;31m'; GREEN='\e[1;32m'; YELLOW='\e[1;33m'; CYAN='\e[1;36m'; RESET='\e[0m'
PASS="caleston123"
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=5"
FAIL=0
echo -e "\${CYAN}╔════════════════════════════════════════════════════════════════╗\${RESET}"
echo -e "\${CYAN}║          VERIFYING SCENARIO MOCK-016 (AlmaLinux 9)             ║\${RESET}"
echo -e "\${CYAN}╚════════════════════════════════════════════════════════════════╝\${RESET}"

echo -e "\${YELLOW}[1/4] node02: Extra disk and second network interface exist\${RESET}"
if sshpass -p \$PASS ssh \$SSH_OPTS bob@node02 "lsblk | grep -q vdb && ip a | grep -q 192.168.123" 2>/dev/null; then
  echo -e "      \${GREEN}✓ OK\${RESET}"
else
  echo -e "      \${RED}✗ FAILED\${RESET}"; FAIL=1
fi

echo -e "\${YELLOW}[2/4] node02: Required packages installed\${RESET}"
if sshpass -p \$PASS ssh \$SSH_OPTS bob@node02 "rpm -q nfs-utils libvirt-client podman nftables openssl" >/dev/null 2>&1; then
  echo -e "      \${GREEN}✓ OK\${RESET}"
else
  echo -e "      \${RED}✗ FAILED\${RESET}"; FAIL=1
fi

echo -e "\${YELLOW}[3/4] node02: /shared/data exists and devs group created\${RESET}"
if sshpass -p \$PASS ssh \$SSH_OPTS bob@node02 "[ -d /shared/data ] && getent group devs" >/dev/null 2>&1; then
  echo -e "      \${GREEN}✓ OK\${RESET}"
else
  echo -e "      \${RED}✗ FAILED\${RESET}"; FAIL=1
fi

echo -e "\${YELLOW}[4/4] node02: Dummy libvirt VM defined (System session)\${RESET}"
# FIXED: Added sudo to check system session instead of user session
if sshpass -p \$PASS ssh \$SSH_OPTS bob@node02 "sudo virsh list --all 2>/dev/null | grep -q mock16-vm" 2>/dev/null; then
  echo -e "      \${GREEN}✓ OK\${RESET}"
else
  echo -e "      \${RED}✗ FAILED\${RESET}"; FAIL=1
fi

echo ""
if [ \$FAIL -eq 0 ]; then
  echo -e "\${GREEN}✅ SCENARIO READY — Press ENTER to see the ticket\${RESET}"
else
  echo -e "\${RED}⚠️  SOME CHECKS FAILED\${RESET}"
fi
read -r
cat /home/vagrant/TICKET_MOCK-016.txt
VERIFY
          chmod +x /tmp/verify-016.sh
          sed -i '/verify-016/d' /home/vagrant/.bashrc 2>/dev/null || true
          echo 'bash /tmp/verify-016.sh' >> /home/vagrant/.bashrc

          cat << 'VALIDATOR' > /home/vagrant/validate.sh
#!/bin/bash
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=5"
PASS="caleston123"
NODE="bob@node02"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
RESET='\033[0m'
BOLD='\033[1m'
TOTAL=0
MAX=36
PASS_COUNT=0
FAIL_COUNT=0

run_remote() {
  sshpass -p "\$PASS" ssh \$SSH_OPTS "\$NODE" "\$1" 2>/dev/null
}

print_res() {
  local n=\$1; local name=\$2; local pts=\$3; local pass=\$4; local desc=\$5; local out=\$6
  echo -e "\n\${CYAN}┌─ TASK \$n: \$name (\$pts pts) ─\${RESET}"
  echo -e "\${YELLOW}   \$desc\${RESET}"
  if [ "\$pass" -eq 1 ]; then
    echo -e "   \${GREEN}✅ +\$pts pts\${RESET}"
    TOTAL=\$((TOTAL + pts))
    PASS_COUNT=\$((PASS_COUNT + 1))
  else
    echo -e "   \${RED}❌ +0 pts\${RESET}"
    echo -e "   \${YELLOW}   Output obtained:\${RESET}"
    echo "\$out" | head -n 3 | sed 's/^/   /'
    FAIL_COUNT=\$((FAIL_COUNT + 1))
  fi
}

echo -e "\${MAGENTA}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║      🎯 VALIDATOR LFCS — MOCK #016 (AlmaLinux 9)            ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "\${RESET}"

# 1. DEFAULT ACLS
out=\$(run_remote "getfacl /shared/data 2>/dev/null | grep -q 'default:group:devs:rwx' && echo OK || echo FAIL")
if [ "\$out" = "OK" ]; then ok=1; else ok=0; fi
print_res 1 "default acls" 3 \$ok "Default ACL for group devs with rwx on /shared/data" "\$out"

# 2. NETWORK BONDING
out=\$(run_remote "nmcli con show bond0 2>/dev/null | grep -q 'active-backup' && nmcli con show bond0 | grep -q 'slave' && echo OK || echo FAIL")
if [ "\$out" = "OK" ]; then ok=1; else ok=0; fi
print_res 2 "network bonding" 3 \$ok "bond0 exists, mode active-backup, with slave interfaces" "\$out"

# 3. NFSv4 LOCAL MOUNT
out_export=\$(run_remote "grep -q '/srv/nfs_share' /etc/exports 2>/dev/null && echo OK || echo FAIL")
out_mount=\$(run_remote "mount | grep -q '/mnt/nfs_local' 2>/dev/null && echo OK || echo FAIL")
if [ "\$out_export" = "OK" ] && [ "\$out_mount" = "OK" ]; then ok=1; else ok=0; fi
print_res 3 "nfs4 local mount" 3 \$ok "/srv/nfs_share exported and mounted on /mnt/nfs_local" "export: \$out_export | mount: \$out_mount"

# 4. PROCESS RENICE
out=\$(run_remote "ps -eo user,nice,cmd 2>/dev/null | grep 'bob' | grep 'sleep 3600' | grep -q '15' && echo OK || echo FAIL")
if [ "\$out" = "OK" ]; then ok=1; else ok=0; fi
print_res 4 "process renice" 3 \$ok "sleep 3600 process for bob has nice value 15" "\$out"

# 5. SSL GENERATION
out_key=\$(run_remote "openssl rsa -in /etc/ssl/private/mock16.key -check -noout 2>/dev/null | grep -q 'RSA key ok' && echo OK || echo FAIL")
out_cert=\$(run_remote "openssl x509 -in /etc/ssl/certs/mock16.crt -noout -text 2>/dev/null | grep -q '2048' && echo OK || echo FAIL")
if [ "\$out_key" = "OK" ] && [ "\$out_cert" = "OK" ]; then ok=1; else ok=0; fi
print_res 5 "ssl generation" 3 \$ok "2048-bit RSA key and self-signed cert generated" "key: \$out_key | cert: \$out_cert"

# 6. PODMAN SYSTEMD (Made more robust to accept any service name)
out_container=\$(run_remote "su - bob -c 'podman ps -q' 2>/dev/null")
out_svc=\$(run_remote "su - bob -c 'systemctl --user list-units --type=service --state=running' 2>/dev/null | grep -v 'session' | grep -q 'service' && echo OK || echo FAIL")
if [ -n "\$out_container" ] && [ "\$out_svc" = "OK" ]; then ok=1; else ok=0; fi
print_res 6 "podman systemd" 3 \$ok "Rootless podman container managed by user systemd service" "container: \$out_container | svc: \$out_svc"

# 7. PRIORITIZED SWAP
out_file=\$(run_remote "ls -l /swapfile2 2>/dev/null | grep -q 'rw-------' && echo OK || echo FAIL")
out_prio=\$(run_remote "swapon --show 2>/dev/null | grep -q '/swapfile2.*10' && echo OK || echo FAIL")
if [ "\$out_file" = "OK" ] && [ "\$out_prio" = "OK" ]; then ok=1; else ok=0; fi
print_res 7 "prioritized swap" 3 \$ok "Swap file /swapfile2 active with priority 10" "file: \$out_file | prio: \$out_prio"

# 8. DNAT REDIRECTION
out=\$(run_remote "nft list ruleset 2>/dev/null | grep -q 'dnat to :8080' || iptables -t nat -L PREROUTING 2>/dev/null | grep -q '8080' && echo OK || echo FAIL")
if [ "\$out" = "OK" ]; then ok=1; else ok=0; fi
print_res 8 "dnat redirection" 3 \$ok "Port 80 redirected to 8080 via nftables or iptables" "\$out"

# 9. JOURNALCTL FILTER
out=\$(run_remote "[ -f /tmp/boot_errors.log ] && grep -qi 'err' /tmp/boot_errors.log && echo OK || echo FAIL")
if [ "\$out" = "OK" ]; then ok=1; else ok=0; fi
print_res 9 "journalctl filter" 3 \$ok "/tmp/boot_errors.log contains filtered err logs from current boot" "\$out"

# 10. LIBVIRT AUTOSTART (FIXED: Added sudo for system session)
out=\$(run_remote "sudo virsh list --autostart 2>/dev/null | grep -q 'mock16-vm' && echo OK || echo FAIL")
if [ "\$out" = "OK" ]; then ok=1; else ok=0; fi
print_res 10 "libvirt autostart" 3 \$ok "mock16-vm is configured to autostart with libvirtd" "\$out"

# 11. FIND WITH EXEC
out=\$(run_remote "find /var/tmp -user bob -exec stat -c '%G' {} + 2>/dev/null | grep -q 'devs' && echo OK || echo FAIL")
if [ "\$out" = "OK" ]; then ok=1; else ok=0; fi
print_res 11 "find with exec" 3 \$ok "Files in /var/tmp owned by bob changed to group devs via find -exec" "\$out"

# 12. SYSTEMD DROP-IN
out=\$(run_remote "systemctl show sshd.service 2>/dev/null | grep -q 'CUSTOM_ENV=mock16' && echo OK || echo FAIL")
if [ "\$out" = "OK" ]; then ok=1; else ok=0; fi
print_res 12 "systemd drop-in" 3 \$ok "sshd.service has drop-in override with CUSTOM_ENV=mock16" "\$out"

PERCENT=\$((TOTAL * 100 / MAX))
echo -e "\n\${MAGENTA}╔══════════════════════════════════════════════════════════════╗\${RESET}"
echo -e "\${MAGENTA}║                     📊 FINAL RESULT                          ║\${RESET}"
echo -e "\${MAGENTA}╚══════════════════════════════════════════════════════════════╝\${RESET}"
echo -e "\${BOLD}Score:\${RESET}         \${CYAN}\$TOTAL / \$MAX points (\${PERCENT}%)\${RESET}"
if [ \$PERCENT -ge 67 ]; then
  echo -e "\n\${GREEN}\${BOLD}🎉 PASSED! CONGRATULATIONS! 🎉\${RESET}"
else
  echo -e "\n\${RED}\${BOLD}❌ NOT PASSED — KEEP GOING! 💪\${RESET}"
fi
VALIDATOR
          chmod +x /home/vagrant/validate.sh
          echo "✅ Ticket + Verification + Validator created."
          echo "🚀 vagrant ssh node01 -> automatic verification"
          echo "📝 When done: bash /home/vagrant/validate.sh"
        SHELL
      end
    end
  end
end
