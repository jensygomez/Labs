# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  
  # ============================================
  # CONFIGURACIÓN GLOBAL
  # ============================================
  config.vm.box = "almalinux/9"
  
  # Red compartida para todos los nodos
  MGMT_NET = "mgmt-net"
  BASE_IP = "192.168.122"
  
  # ============================================
  # PROVISIONAMIENTO BASE (TODOS LOS NODOS)
  # ============================================
  $base_provision = <<-SCRIPT
    echo "=== Configuración Base ==="
    
    # Instalar paquetes comunes
    dnf install -y epel-release
    dnf install -y ansible-core lsof vim net-tools bind-utils
    
    # Configurar VIM
    cat > ~/.vimrc <<-'VIMRC'
set number
syntax on
set expandtab
set tabstop=2
set shiftwidth=2
VIMRC
    
    # Habilitar SSH
    systemctl enable --now sshd
    
    # Desactivar firewall para simplicidad (entorno de laboratorio)
    systemctl stop firewalld || true
    systemctl disable firewalld || true
    
    echo "=== Base configuration complete ==="
  SCRIPT

  # ============================================
  # NODO 1: alma01 (HEALTHY - NODO DE REFERENCIA)
  # ============================================
  config.vm.define "alma01" do |node|
    node.vm.hostname = "alma01"
    node.vm.network "private_network",
      ip: "#{BASE_IP}.11",
      libvirt__network_name: MGMT_NET,
      libvirt__dhcp_enabled: false
    
    node.vm.provider "libvirt" do |lv|
      lv.memory = 768
      lv.cpus = 1
      lv.driver = "kvm"
    end
    
    node.vm.provision "shell", privileged: true, inline: $base_provision
    
    node.vm.provision "shell", privileged: true, inline: <<-SCRIPT
      echo "=== alma01: Nodo Saludable (Referencia) ==="
      echo "Este nodo permanece intacto para comparación"
      
      # Crear directorio de logs para consistencia
      mkdir -p /var/log/app-metrics
      echo "Nodo de referencia - sin incidentes" > /var/log/app-metrics/README.txt
    SCRIPT
  end

  # ============================================
  # NODO 2: alma02 (BROKEN - INCIDENTE APLICADO)
  # ============================================
  config.vm.define "alma02" do |node|
    node.vm.hostname = "alma02"
    node.vm.network "private_network",
      ip: "#{BASE_IP}.12",
      libvirt__network_name: MGMT_NET,
      libvirt__dhcp_enabled: false
    
    node.vm.provider "libvirt" do |lv|
      lv.memory = 768
      lv.cpus = 1
      lv.driver = "kvm"
      
      # Disco dedicado para logs (512MB)
      lv.storage :file, size: '512M', type: 'qcow2'
    end
    
    node.vm.provision "shell", privileged: true, inline: $base_provision
    
    # Aplicar INC-002 en alma02
    node.vm.provision "shell", privileged: true, inline: <<-SCRIPT
      echo "=== APLICANDO INC-002 en alma02 ==="
      
      # 1. Formatear y montar disco de logs
      mkfs.xfs -f /dev/vdb
      REAL_UUID=$(blkid -s UUID -o value /dev/vdb)
      mkdir -p /var/log/app-metrics
      mount /dev/vdb /var/log/app-metrics
      echo "UUID=$REAL_UUID /var/log/app-metrics xfs defaults 0 0" >> /etc/fstab
      
      # 2. RED HERRING: archivo estático comprimido (60MB)
      echo "Creando RED HERRING: legacy-debug.log.1.gz"
      dd if=/dev/urandom of=/var/log/app-metrics/legacy-debug.log.1.gz bs=1M count=60 status=none
      
      # 3. CAUSA RAÍZ: archivo de log creciendo (190MB)
      echo "Creando CAUSA RAÍZ: metrics.log (190MB)"
      dd if=/dev/zero of=/var/log/app-metrics/metrics.log bs=1M count=190 status=none
      
      chown -R vagrant:vagrant /var/log/app-metrics
      
      # 4. Servicio que escribe logs continuamente
      cat <<'EOF' > /usr/local/bin/app-metrics-writer.sh
#!/bin/bash
while true; do
  if ! echo "[$(date -Iseconds)] metric_sample cpu=$(shuf -i 1-100 -n1) mem=$(shuf -i 1-100 -n1)" >> /var/log/app-metrics/metrics.log; then
    echo "FATAL: could not write to metrics.log, disk full?" >&2
    exit 1
  fi
  sleep 5
done
EOF
      chmod +x /usr/local/bin/app-metrics-writer.sh
      
      cat <<EOF > /etc/systemd/system/app-metrics.service
[Unit]
Description=App Metrics Collector
RequiresMountsFor=/var/log/app-metrics
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/local/bin/app-metrics-writer.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
      
      systemctl daemon-reload
      systemctl enable --now app-metrics.service
      
      # 5. NO hay política de logrotate (CAUSA RAÍZ)
      
      # 6. Generar TICKET
      cat <<'TICKET' > /home/vagrant/TICKET_INCIDENT-02.txt
======================================================================
INCIDENT TICKET #02 - HIGH PRIORITY
======================================================================
TITLE: /var/log/app-metrics partition almost full, app-metrics service
       intermittently failing
SEVERITY: SEV-2
REPORTED BY: Monitoring System (automated alert)
NODE AFFECTED: alma02
======================================================================

DESCRIPTION:
"Disk usage alert fired for the /var/log/app-metrics partition on
alma02 -- currently above 85% used. The app-metrics service has
restarted several times in the last hour with write errors in its
logs.

While investigating, we noticed a very large file called
'legacy-debug.log.1.gz' sitting in that same directory -- it looks
like the obvious space hog. However, previous on-call engineers have
mentioned that clearing space here has only provided temporary
relief in the past; the partition fills up again within days.

Please investigate and provide a PERMANENT fix, not just a one-time
cleanup."

EVALUATION CRITERIA:
1. Identify and discard the false negative (the static compressed
   legacy log -- confirm whether it is actually still growing).
2. Identify the real root cause of the recurring disk fill.
3. Free enough space to bring the partition back to a healthy level.
4. Ensure app-metrics.service is running and stable.
5. Prevent this from recurring (this becomes the Phase 2 Ansible task).

ESTIMATED TIME: 60 - 75 minutes.
======================================================================
TICKET

      # 7. Generar VALIDADOR
      cat <<'VALIDATOR' > /home/vagrant/validate.sh
#!/bin/bash
CYAN='\033[0;36m'; GREEN='\033[0;32m'; RED='\033[0;31m'
YELLOW='\033[0;33m'; MAGENTA='\033[0;35m'; RESET='\033[0m'
TOTAL=0; PASS_COUNT=0; FAIL_COUNT=0

print_res() {
  local n=$1; local name=$2; local pts=$3; local pass=$4; local desc=$5
  echo -e "\n${CYAN}CHECK $n: $name ($pts pts)${RESET}"
  echo -e "${YELLOW}   $desc${RESET}"
  if [ "$pass" -eq 1 ]; then
    echo -e "   ${GREEN}PASS +$pts pts${RESET}"
    TOTAL=$((TOTAL + pts)); PASS_COUNT=$((PASS_COUNT + 1))
  else
    echo -e "   ${RED}FAIL +0 pts${RESET}"
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi
}

echo -e "${MAGENTA}Validando resolución de INC-002 en alma02...${RESET}"

# Check 1: Uso de disco < 80%
USAGE=$(df --output=pcent /var/log/app-metrics | tail -1 | tr -dc '0-9')
if [ "$USAGE" -lt 80 ]; then ok=1; else ok=0; fi
print_res 1 "Disco Saludable" 3 $ok "Uso de /var/log/app-metrics < 80% (actual: ${USAGE}%)"

# Check 2: Servicio activo
STATUS=$(systemctl is-active app-metrics.service)
if [ "$STATUS" == "active" ]; then ok=1; else ok=0; fi
print_res 2 "Servicio Activo" 3 $ok "app-metrics.service está activo (estado: $STATUS)"

# Check 3: metrics.log bajo control (< 50MB)
LOG_SIZE_MB=$(du -m /var/log/app-metrics/metrics.log 2>/dev/null | cut -f1)
if [ -n "$LOG_SIZE_MB" ] && [ "$LOG_SIZE_MB" -lt 50 ]; then ok=1; else ok=0; fi
print_res 3 "Log Activo Controlado" 3 $ok "metrics.log < 50MB (actual: ${LOG_SIZE_MB:-unknown}MB)"

# Check 4: Política logrotate implementada (SOLUCIÓN PERMANENTE)
if [ -f /etc/logrotate.d/app-metrics ] && grep -q "metrics.log" /etc/logrotate.d/app-metrics; then ok=1; else ok=0; fi
print_res 4 "Política Logrotate" 4 $ok "/etc/logrotate.d/app-metrics existe y referencia metrics.log"

echo -e "\n${CYAN}RESUMEN${RESET}"
echo -e "Aprobados: ${GREEN}$PASS_COUNT${RESET} | Fallados: ${RED}$FAIL_COUNT${RESET} | Puntaje Total: ${YELLOW}$TOTAL / 13${RESET}"

if [ $TOTAL -eq 13 ]; then
  echo -e "${GREEN}🎉 ¡FELICITACIONES! Resolución completa de INC-002${RESET}"
else
  echo -e "${YELLOW}⚠️  Revisa los checks fallados y vuelve a intentarlo${RESET}"
fi
VALIDATOR

      # 8. Generar BREAK SCRIPT
      cat <<'BREAKSCRIPT' > /home/vagrant/break.sh
#!/bin/bash
# Re-aplica INC-002 sin destruir la VM
set -e
echo "Re-aplicando INC-002 en alma02..."

systemctl stop app-metrics.service 2>/dev/null || true
rm -f /etc/logrotate.d/app-metrics
dd if=/dev/zero of=/var/log/app-metrics/metrics.log bs=1M count=190 status=none
chown vagrant:vagrant /var/log/app-metrics/metrics.log
systemctl start app-metrics.service

echo "✅ Incidente re-aplicado. Ejecuta tu playbook de Ansible y luego validate.sh"
BREAKSCRIPT

      chmod +x /home/vagrant/validate.sh /home/vagrant/break.sh
      chown vagrant:vagrant /home/vagrant/validate.sh /home/vagrant/break.sh /home/vagrant/TICKET_INCIDENT-02.txt
      
      echo "=========================================="
      echo "✅ INC-002 desplegado en alma02"
      echo "=========================================="
      echo "📋 Ver ticket: cat /home/vagrant/TICKET_INCIDENT-02.txt"
      echo "🔍 Validar: bash /home/vagrant/validate.sh"
      echo "🔄 Re-aplicar: sudo bash /home/vagrant/break.sh"
      echo "=========================================="
    SCRIPT
  end

  # ============================================
  # NODO 3: alma03 (HEALTHY - NODO DE REFERENCIA)
  # ============================================
  config.vm.define "alma03" do |node|
    node.vm.hostname = "alma03"
    node.vm.network "private_network",
      ip: "#{BASE_IP}.13",
      libvirt__network_name: MGMT_NET,
      libvirt__dhcp_enabled: false
    
    node.vm.provider "libvirt" do |lv|
      lv.memory = 768
      lv.cpus = 1
      lv.driver = "kvm"
    end
    
    node.vm.provision "shell", privileged: true, inline: $base_provision
    
    node.vm.provision "shell", privileged: true, inline: <<-SCRIPT
      echo "=== alma03: Nodo Saludable (Referencia) ==="
      echo "Nodo de referencia - sin incidentes"
      mkdir -p /var/log/app-metrics
      echo "Nodo saludable - no afectado por INC-002" > /var/log/app-metrics/README.txt
    SCRIPT
  end

  # ============================================
  # NODO 4: client01 (CLIENTE ALPINE LINUX)
  # ============================================
  config.vm.define "client01" do |node|
    node.vm.box = "alpine/alpine64"
    node.vm.hostname = "client01"
    node.vm.network "private_network",
      ip: "#{BASE_IP}.14",
      libvirt__network_name: MGMT_NET,
      libvirt__dhcp_enabled: false
    
    node.vm.provider "libvirt" do |lv|
      lv.memory = 512
      lv.cpus = 1
      lv.driver = "kvm"
    end
    
    # Provisionamiento para Alpine
    node.vm.provision "shell", privileged: true, inline: <<-SCRIPT
      echo "=== Configurando client01 (Alpine) ==="
      
      # Actualizar repositorios
      apk update
      
      # Instalar herramientas
      apk add --no-cache \
        openssh-client \
        curl \
        wget \
        scp \
        net-tools \
        bind-tools \
        iputils
      
      # Habilitar SSH
      rc-update add sshd
      rc-service sshd start
      
      # Configurar cliente ligero
      echo "client01: Cliente de pruebas Alpine" > /etc/motd
      
      echo "=== client01 configurado ==="
    SCRIPT
  end

  # ============================================
  # POST-PROVISION: Mensaje final
  # ============================================
  config.vm.provision "shell", privileged: false, run: "always", inline: <<-SCRIPT
    echo ""
    echo "=========================================="
    echo "🏗️  INFRAESTRUCTURA PERMANENTE DESPLEGADA"
    echo "=========================================="
    echo "📊 TOPOLOGÍA:"
    echo "   ✅ alma01 - 192.168.122.11 (Saludable)"
    echo "   🔴 alma02 - 192.168.122.12 (INC-002 APLICADO)"
    echo "   ✅ alma03 - 192.168.122.13 (Saludable)"
    echo "   🖥️  client01 - 192.168.122.14 (Cliente Alpine)"
    echo ""
    echo "📝 INCIDENTE APLICADO: INC-002 en alma02"
    echo "   Conéctate: vagrant ssh alma02"
    echo "   Lee el ticket: cat /home/vagrant/TICKET_INCIDENT-02.txt"
    echo ""
    echo "🔧 COMANDOS ÚTILES:"
    echo "   vagrant ssh alma02"
    echo "   vagrant ssh alma01  # Nodo de referencia"
    echo "   vagrant ssh client01 # Cliente de pruebas"
    echo "   bash /home/vagrant/validate.sh  # Validar resolución"
    echo "   sudo bash /home/vagrant/break.sh # Re-aplicar incidente"
    echo "=========================================="
  SCRIPT

end
