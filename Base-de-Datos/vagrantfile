# -- mode: ruby --
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  
  nodes = [
    { name: "node01", ip: "192.168.122.11", extra_disks: [] },
    { name: "node02", ip: "192.168.122.12", extra_disks: ['1G', '512M'] },
    { name: "node03", ip: "192.168.122.13", extra_disks: [] }
  ]
  
  nodes.each do |node|
    config.vm.define node[:name] do |node_config|
      node_config.vm.hostname = node[:name]
      
      node_config.vm.network "private_network", 
        ip: node[:ip], 
        libvirt__network_name: "mgmt-net",
        libvirt__dhcp_enabled: false
      
      node_config.vm.provider "libvirt" do |lv|
        lv.memory = 1024
        lv.cpus = 1
        lv.driver = "kvm"
        node[:extra_disks].each do |size|
          lv.storage :file, :size => size, :type => 'qcow2'
        end
      end
      
      # ── PROVISIONADO GENERAL (todos los nodos) ──
      node_config.vm.provision "shell", inline: <<-SHELL
        echo "🔧 Configurando #{node[:name]}..."
        
        for host in node01 node02 node03; do
          sed -i "/$host/d" /etc/hosts
        done
        
        cat << 'HOSTS' >> /etc/hosts
192.168.122.11 node01
192.168.122.12 node02
192.168.122.13 node03
HOSTS

        useradd -m -s /bin/bash bob 2>/dev/null || true
        echo 'bob:caleston123' | chpasswd
        echo 'bob ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/bob
        chmod 0440 /etc/sudoers.d/bob
        
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq
        apt-get install -y -qq sshpass curl acl lvm2
      SHELL
      
      # ── NODE02: SERVIDOR CON 12 INCIDENTES ──
      if node[:name] == "node02"
        node_config.vm.provision "shell", privileged: true, inline: <<-SHELL
          echo "🖥️ Configurando node02 con 12 incidentes..."
          
          export DEBIAN_FRONTEND=noninteractive
          apt-get install -y -qq nginx vim tree
          
          # ── TAREA 1: Log de aplicación para awk/sort ──
          mkdir -p /var/log/webapp
          cat << 'LOG' > /var/log/webapp/access.log
192.168.1.10 GET /index.html 200 1024
192.168.1.11 POST /api/login 401 512
192.168.1.12 GET /dashboard 200 2048
192.168.1.13 GET /api/users 500 256
192.168.1.14 POST /api/data 201 4096
192.168.1.15 GET /index.html 200 1024
192.168.1.16 GET /api/users 500 128
192.168.1.17 DELETE /api/session 200 64
192.168.1.18 GET /dashboard 200 2048
192.168.1.19 POST /api/upload 413 8192
LOG
          
          # ── TAREA 2: Grupos para usuario ──
          groupadd -f webdevs
          groupadd -f dbadmins
          groupadd -f monitoring
          
          # ── TAREA 3: Disco /dev/vdb para LVM (sin formatear) ──
          # Se deja crudo para que el alumno haga pvcreate
          
          # ── TAREA 4: Swap (no se crea, alumno lo hace) ──
          
          # ── TAREA 5: Disco /dev/vdc formateado para fstab ──
          mkfs.ext4 -F /dev/vdc 2>/dev/null || true
          
          # ── TAREA 6: sysctl con valor por defecto ──
          # vm.swappiness ya viene en 60 por defecto
          
          # ── TAREA 7: Logs para journalctl (3 warnings + otros) ──
          logger -p user.warning "Disk usage critical on /var"
          logger -p user.warning "Memory threshold exceeded"
          logger -p user.warning "Network latency above 200ms"
          logger -p user.info "Backup completed"
          logger -p user.err "Service timeout"
          
          # ── TAREA 8: /etc/hosts sin entrada para db-primary.internal ──
          
          # ── TAREA 9: SSH config (PasswordAuthentication yes por defecto) ──
          
          # ── TAREA 10: Usuario para cron ──
          useradd -m -s /bin/bash backupuser 2>/dev/null || true
          echo 'backupuser:caleston123' | chpasswd
          
          # ── TAREA 11: Directorio para ACLs ──
          mkdir -p /opt/secure-data
          chmod 770 /opt/secure-data
          chown root:webdevs /opt/secure-data
          useradd -m -s /bin/bash readonly_user 2>/dev/null || true
          echo 'readonly_user:caleston123' | chpasswd
          
          # ── TAREA 12: Archivos para tar ──
          mkdir -p /opt/app-configs
          echo "db_host=10.0.0.5" > /opt/app-configs/database.conf
          echo "cache_ttl=3600" > /opt/app-configs/cache.conf
          echo "log_level=info" > /opt/app-configs/logging.conf
          echo "api_timeout=30" > /opt/app-configs/api.conf
          
          # nginx activo
          systemctl enable nginx
          systemctl start nginx
          
          echo "✅ node02 configurado con 12 incidentes"
        SHELL
      end
      
      # ── NODE03: BÓVEDA ──
      if node[:name] == "node03"
        node_config.vm.provision "shell", privileged: true, inline: <<-SHELL
          echo "🔒 Preparando bóveda..."
          mkdir -p /opt/ops-compliance/simulacro-007
          chown -R bob:bob /opt/ops-compliance
          chmod -R 755 /opt/ops-compliance
          echo "✅ Bóveda lista en /opt/ops-compliance/simulacro-007/"
        SHELL
      end
      
      # ── NODE01: TICKET + VERIFICACIÓN + VALIDADOR + EVIDENCIA OPCIONAL ──
      if node[:name] == "node01"
        node_config.vm.provision "shell", privileged: false, inline: <<-SHELL
          echo "🎫 Generando Ticket, verificación, validador y script de evidencia en node01..."
          
          # ═══════════════════════════════════════════════════════
          # TICKET (con mejoras)
          # ═══════════════════════════════════════════════════════
          cat << 'TICKET' > /home/vagrant/TICKET_SIMULACRO-007.txt
================================================================================
TICKET SIMULACRO-007  │  Severidad: MEDIA  │  Ambiente: PRODUCCIÓN
🔐 SIMULACRO-007 — Lo Mejor de Ambos Mundos (12 Tareas)
Módulo: LFCS Complete  │  Dificultad: 3/10  │  Nivel: L2
Ubicación de Control:  node01  (Estación del Administrador — bob)
Nodo Servidor:         node02  (Ubuntu 22.04)
Nodo Bóveda Destino:   node03  (/opt/ops-compliance/simulacro-007/)
Contraseña del Clúster: caleston123

Un servidor en node02 requiere 12 tareas de administración independientes.
Cada tarea aborda un dominio diferente del LFCS. Gestiona tu tiempo:
máximo 8-10 minutos por tarea. Si te trabas, pasa a la siguiente.

================================================================================
TAREA 1 — Essential Commands: Análisis de Log con awk (peso 3 puntos)
================================================================================
El equipo de desarrollo necesita identificar errores HTTP en los logs.

En node02:
1. El archivo /var/log/webapp/access.log contiene registros de acceso web
2. Extrae solo las líneas donde el código HTTP sea 500 (error de servidor)
3. De esas líneas, extrae la IP (columna 1) y la URL (columna 3)
4. Guarda el resultado en /opt/errors-500.txt

CRITERIOS:
  [ ] El archivo /opt/errors-500.txt existe                                --> 30%
  [ ] Contiene solo líneas con código 500                                  --> 30%
  [ ] Muestra IP y URL (columnas 1 y 3)                                    --> 40%

TIEMPO MÁXIMO: 10 minutos

================================================================================
TAREA 2 — Users/Groups: Usuario con Múltiples Grupos (peso 3 puntos)
================================================================================
Se requiere crear un usuario con acceso a múltiples equipos.

En node02:
1. Crea un usuario llamado "sysop" con shell /bin/bash
2. Grupo primario: webdevs
3. Grupos secundarios: dbadmins Y monitoring
4. Contraseña: caleston123
5. Verifica con 'id sysop'

CRITERIOS:
  [ ] Usuario sysop existe con shell /bin/bash                             --> 30%
  [ ] Grupo primario es webdevs                                            --> 30%
  [ ] Grupos secundarios incluyen dbadmins y monitoring                    --> 40%

TIEMPO MÁXIMO: 10 minutos

================================================================================
TAREA 3 — Storage/LVM: Crear Volumen Lógico (peso 3 puntos)
================================================================================
Se requiere almacenamiento LVM para la aplicación.

En node02:
1. El disco /dev/vdb está disponible (sin formatear)
2. Inicialízalo como Physical Volume (pvcreate)
3. Crea un Volume Group llamado "appdata_vg"
4. Crea un Logical Volume llamado "logs_lv" de 500M
5. Formatea el LV como ext4 (mkfs.ext4)

CRITERIOS:
  [ ] /dev/vdb es un Physical Volume                                       --> 25%
  [ ] Volume Group "appdata_vg" existe                                     --> 25%
  [ ] Logical Volume "logs_lv" de 500M existe                              --> 25%
  [ ] El LV está formateado como ext4                                      --> 25%

TIEMPO MÁXIMO: 12 minutos

================================================================================
TAREA 4 — Storage/Swap: Archivo de Swap (peso 3 puntos)
================================================================================
Se requiere swap adicional para el servidor.

En node02:
1. Crea un archivo de 256MB en /swapfile usando dd
2. Configúralo como swap (mkswap)
3. Actívalo (swapon)
4. Asegura persistencia en /etc/fstab
5. Permisos 600 (importante)

CRITERIOS:
  [ ] /swapfile existe con 256MB                                           --> 25%
  [ ] Está activo como swap (swapon --show)                                --> 25%
  [ ] Entrada correcta en /etc/fstab                                       --> 25%
  [ ] Permisos del archivo son 600                                         --> 25%

TIEMPO MÁXIMO: 10 minutos

================================================================================
TAREA 5 — Storage/fstab: Montaje Persistente (peso 3 puntos)
================================================================================
Se requiere montar un disco de backup.

En node02:
1. El disco /dev/vdc está formateado como ext4
2. Crea el directorio /mnt/archives
3. Monta /dev/vdc en /mnt/archives
4. Configura /etc/fstab para montaje persistente con opciones 'defaults'
5. Valida con 'mount -a'

CRITERIOS:
  [ ] /mnt/archives existe                                                 --> 20%
  [ ] /dev/vdc está montado en /mnt/archives                               --> 30%
  [ ] Entrada correcta en /etc/fstab                                       --> 30%
  [ ] mount -a no produce errores                                          --> 20%

TIEMPO MÁXIMO: 10 minutos

================================================================================
TAREA 6 — Operations/sysctl: Parámetro del Kernel (peso 3 puntos)
================================================================================
Se requiere optimizar el uso de memoria swap.

En node02:
1. Crea un archivo en /etc/sysctl.d/ llamado 99-vm-tuning.conf
2. Establece vm.swappiness = 10
3. Aplica el cambio inmediatamente (sin reiniciar)
4. Verifica que el valor actual sea 10

CRITERIOS:
  [ ] Archivo /etc/sysctl.d/99-vm-tuning.conf existe                       --> 30%
  [ ] Contiene vm.swappiness = 10                                          --> 25%
  [ ] Valor runtime actual es 10                                           --> 25%
  [ ] Cambio aplicado sin reinicio                                         --> 20%

TIEMPO MÁXIMO: 10 minutos

================================================================================
TAREA 7 — Operations/journalctl: Contar Warnings (peso 3 puntos)
================================================================================
El equipo de operaciones necesita saber cuántas advertencias hay en el log.

En node02:
1. Usa journalctl para buscar mensajes con prioridad "warning"
2. Cuenta cuántos mensajes de warning existen en TODO el sistema
   (NO filtres por etiqueta; cuenta todos los warnings)
3. Guarda SOLO el número en /opt/warning-count.txt

CRITERIOS:
  [ ] /opt/warning-count.txt existe                                        --> 30%
  [ ] Contiene solo un número                                              --> 30%
  [ ] El número es correcto (al menos 3)                                   --> 40%

TIEMPO MÁXIMO: 10 minutos

================================================================================
TAREA 8 — Networking: Entrada en /etc/hosts (peso 3 puntos)
================================================================================
Se requiere resolución local para el servidor de base de datos.

En node02:
1. Agrega una entrada en /etc/hosts:
   IP: 10.10.10.100
   Hostname: db-primary.internal
2. Verifica que la entrada fue agregada correctamente

CRITERIOS:
  [ ] Entrada existe en /etc/hosts                                         --> 50%
  [ ] db-primary.internal resuelve a 10.10.10.100                          --> 50%

TIEMPO MÁXIMO: 8 minutos

================================================================================
TAREA 9 — Networking/SSH: Deshabilitar Password Auth (peso 3 puntos)
================================================================================
Por política de seguridad, se debe deshabilitar autenticación por contraseña.

En node02:
1. Edita /etc/ssh/sshd_config
2. Establece PasswordAuthentication no (sin #, descomentada)
3. NO reinicies el servicio SSH (puedes recargar con systemctl reload sshd
   si lo deseas; no es necesario para la evaluación, pero es buena práctica)

CRITERIOS:
  [ ] Línea "PasswordAuthentication no" existe (sin #)                     --> 60%
  [ ] No hay líneas contradictorias activas                                --> 40%

TIEMPO MÁXIMO: 10 minutos

================================================================================
TAREA 10 — Operations/Cron: Tarea Programada (peso 3 puntos)
================================================================================
Se requiere un backup automático diario.

En node02:
1. Crea un cron job para el usuario "backupuser"
2. Debe ejecutar: echo "backup done" >> /tmp/backup-status.log
3. Frecuencia: todos los días a las 02:15 AM
4. Verifica con 'sudo crontab -u backupuser -l'
   (Usa espacios o tabuladores; la validación es flexible)

CRITERIOS:
  [ ] Cron job existe para backupuser                                      --> 30%
  [ ] Horario: 15 2 * * * (o equivalente con tabs)                         --> 40%
  [ ] Comando correcto                                                     --> 30%

TIEMPO MÁXIMO: 10 minutos

================================================================================
TAREA 11 — Users/ACLs: Acceso de Solo Lectura (peso 3 puntos)
================================================================================
Un usuario necesita acceso limitado a datos sensibles.

En node02:
1. El directorio /opt/secure-data existe (propiedad root:webdevs, 770)
2. El usuario "readonly_user" existe
3. Otorga permisos r-x (lectura y ejecución) a readonly_user sobre
   /opt/secure-data usando setfacl
4. Verifica con getfacl

CRITERIOS:
  [ ] ACL aplicada con setfacl                                             --> 40%
  [ ] readonly_user tiene permisos r-x                                     --> 40%
  [ ] getfacl muestra la ACL correctamente                                 --> 20%

TIEMPO MÁXIMO: 10 minutos

================================================================================
TAREA 12 — Essential/tar: Backup de Configuraciones (peso 3 puntos)
================================================================================
Se requiere un backup comprimido de las configuraciones.

En node02:
1. El directorio /opt/app-configs/ contiene archivos .conf
2. Crea /opt/configs-backup.tar.gz con TODO el contenido de /opt/app-configs/
3. Verifica que el archivo es válido (tar -tzf)

CRITERIOS:
  [ ] /opt/configs-backup.tar.gz existe                                    --> 40%
  [ ] Es un tar.gz válido                                                  --> 30%
  [ ] Contiene TODOS los archivos .conf (database.conf, cache.conf,
      logging.conf, api.conf)                                              --> 30%

TIEMPO MÁXIMO: 10 minutos

================================================================================
PIPELINE DE EVIDENCIA A NODE03 (OPCIONAL — NO PUNTÚA)
================================================================================
Si deseas automatizar la entrega de evidencias, ejecuta en node01:
  bash /home/vagrant/generate-evidence.sh

Esto recolectará las salidas de las 12 tareas y las copiará a:
  node03:/opt/ops-compliance/simulacro-007/evidence.txt

No es obligatorio, pero ayuda a completar el flujo de trabajo.

================================================================================
RESUMEN DE PUNTUACIÓN
================================================================================
Tarea 1:  3 pts (Essential - awk/log)
Tarea 2:  3 pts (Users/Groups)
Tarea 3:  3 pts (Storage - LVM)
Tarea 4:  3 pts (Storage - Swap)
Tarea 5:  3 pts (Storage - fstab)
Tarea 6:  3 pts (Operations - sysctl)
Tarea 7:  3 pts (Operations - journalctl)
Tarea 8:  3 pts (Networking - hosts)
Tarea 9:  3 pts (Networking - SSH)
Tarea 10: 3 pts (Operations - Cron)
Tarea 11: 3 pts (Users - ACLs)
Tarea 12: 3 pts (Essential - tar)
TOTAL: 36 puntos
MÍNIMO PARA APROBAR (67%): 25 puntos

TIEMPO TOTAL MÁXIMO: 120 minutos

Cuando termines, ejecuta: bash /home/vagrant/validate.sh
================================================================================
TICKET

          # ═══════════════════════════════════════════════════════
          # SCRIPT DE VERIFICACIÓN INICIAL
          # ═══════════════════════════════════════════════════════
          cat << 'VERIFY' > /tmp/verify-007.sh
#!/bin/bash
RED='\e[1;31m'; GREEN='\e[1;32m'; YELLOW='\e[1;33m'; CYAN='\e[1;36m'; RESET='\e[0m'
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=5"; PASS="caleston123"; FAIL=0

echo -e "${CYAN}╔════════════════════════════════════════════════════════════════╗${RESET}"
echo -e "${CYAN}║          VERIFICACIÓN DE ESCENARIO SIMULACRO-007              ║${RESET}"
echo -e "${CYAN}╚════════════════════════════════════════════════════════════════╝${RESET}"
echo ""

echo -e "${YELLOW}[1/8] node02: Log de webapp existe${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "[ -f /var/log/webapp/access.log ]" 2>/dev/null; then
  echo -e "      ${GREEN}✓ OK${RESET}"
else
  echo -e "      ${RED}✗ FALLÓ${RESET}"; FAIL=1
fi

echo -e "${YELLOW}[2/8] node02: Grupos webdevs, dbadmins, monitoring${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "getent group webdevs >/dev/null && getent group dbadmins >/dev/null && getent group monitoring >/dev/null" 2>/dev/null; then
  echo -e "      ${GREEN}✓ OK${RESET}"
else
  echo -e "      ${RED}✗ FALLÓ${RESET}"; FAIL=1
fi

echo -e "${YELLOW}[3/8] node02: Disco vdb disponible (sin formatear)${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "sudo blkid /dev/vdb 2>/dev/null | grep -q ." 2>/dev/null; then
  echo -e "      ${RED}✗ Disco ya formateado${RESET}"; FAIL=1
else
  echo -e "      ${GREEN}✓ OK (crudo)${RESET}"
fi

echo -e "${YELLOW}[4/8] node02: Disco vdc formateado ext4${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "sudo blkid /dev/vdc | grep -q ext4" 2>/dev/null; then
  echo -e "      ${GREEN}✓ OK${RESET}"
else
  echo -e "      ${RED}✗ FALLÓ${RESET}"; FAIL=1
fi

echo -e "${YELLOW}[5/8] node02: nginx activo${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "sudo systemctl is-active --quiet nginx" 2>/dev/null; then
  echo -e "      ${GREEN}✓ OK${RESET}"
else
  echo -e "      ${RED}✗ FALLÓ${RESET}"; FAIL=1
fi

echo -e "${YELLOW}[6/8] node02: Usuarios backupuser y readonly_user${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "id backupuser >/dev/null 2>&1 && id readonly_user >/dev/null 2>&1" 2>/dev/null; then
  echo -e "      ${GREEN}✓ OK${RESET}"
else
  echo -e "      ${RED}✗ FALLÓ${RESET}"; FAIL=1
fi

echo -e "${YELLOW}[7/8] node02: Directorio /opt/secure-data${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node02 "[ -d /opt/secure-data ]" 2>/dev/null; then
  echo -e "      ${GREEN}✓ OK${RESET}"
else
  echo -e "      ${RED}✗ FALLÓ${RESET}"; FAIL=1
fi

echo -e "${YELLOW}[8/8] node03: Bóveda existe${RESET}"
if sshpass -p $PASS ssh $SSH_OPTS bob@node03 "[ -d /opt/ops-compliance/simulacro-007 ]" 2>/dev/null; then
  echo -e "      ${GREEN}✓ OK${RESET}"
else
  echo -e "      ${RED}✗ FALLÓ${RESET}"; FAIL=1
fi

echo ""
if [ $FAIL -eq 0 ]; then
  echo -e "${GREEN}✅ ESCENARIO LISTO — Presiona ENTER para ver el ticket${RESET}"
else
  echo -e "${RED}⚠️  ALGUNAS VERIFICACIONES FALLARON${RESET}"
fi
echo ""
read -r
cat /home/vagrant/TICKET_SIMULACRO-007.txt
VERIFY
          chmod +x /tmp/verify-007.sh
          sed -i '/verify-007/d' /home/vagrant/.bashrc 2>/dev/null || true
          echo 'bash /tmp/verify-007.sh' >> /home/vagrant/.bashrc

          # ═══════════════════════════════════════════════════════
          # VALIDADOR FINAL (validate.sh) — MEJORADO
          # ═══════════════════════════════════════════════════════
          cat << 'VALIDATOR' > /home/vagrant/validate.sh
#!/bin/bash
RED='\e[1;31m'; GREEN='\e[1;32m'; YELLOW='\e[1;33m'; CYAN='\e[1;36m'; MAGENTA='\e[1;35m'; RESET='\e[0m'; BOLD='\e[1m'
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=5"
PASS="caleston123"
TOTAL=0; MAX=36; PASS_COUNT=0; FAIL_COUNT=0

run02() { sshpass -p $PASS ssh $SSH_OPTS bob@node02 "$1" 2>/dev/null; }

check() {
  local n=$1; local name=$2; local pts=$3; local cmd=$4; local desc=$5
  echo -e "\n${CYAN}┌─ TAREA $n: $name ($pts pts) ─${RESET}"
  echo -e "${YELLOW}   $desc${RESET}"
  if run02 "$cmd" >/dev/null 2>&1; then
    echo -e "   ${GREEN}✅ +$pts pts${RESET}"
    TOTAL=$((TOTAL + pts)); PASS_COUNT=$((PASS_COUNT + 1))
  else
    echo -e "   ${RED}❌ +0 pts${RESET}"
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi
}

echo -e "${MAGENTA}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║     🎯 VALIDADOR LFCS — SIMULACRO #007                      ║"
echo "║        Lo Mejor de Ambos Mundos (12 tareas)                 ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "${RESET}"
echo -e "${BOLD}Validando en node02...${RESET}\n"

# T1: awk/log
check 1 "awk/log 500" 3 \
  "[ -f /opt/errors-500.txt ] && grep -q '500' /var/log/webapp/access.log && [ \$(wc -l < /opt/errors-500.txt) -ge 1 ]" \
  "Archivo /opt/errors-500.txt con IPs y URLs de errores 500"

# T2: User sysop
check 2 "User sysop" 3 \
  "id sysop 2>/dev/null | grep -q 'webdevs' && id sysop 2>/dev/null | grep -q 'dbadmins' && id sysop 2>/dev/null | grep -q 'monitoring'" \
  "Usuario sysop con grupos webdevs, dbadmins, monitoring"

# T3: LVM
echo -e "\n${CYAN}┌─ TAREA 3: LVM (3 pts) ─${RESET}"
pv=$(run02 "sudo pvs 2>/dev/null | grep -q '/dev/vdb' && echo ok")
vg=$(run02 "sudo vgs 2>/dev/null | grep -q 'appdata_vg' && echo ok")
lv=$(run02 "sudo lvs 2>/dev/null | grep -q 'logs_lv' && echo ok")
fs=$(run02 "sudo blkid /dev/appdata_vg/logs_lv 2>/dev/null | grep -q ext4 && echo ok")
if [ "$pv" = "ok" ] && [ "$vg" = "ok" ] && [ "$lv" = "ok" ] && [ "$fs" = "ok" ]; then
  echo -e "   ${GREEN}✅ +3 pts${RESET}"; TOTAL=$((TOTAL+3)); PASS_COUNT=$((PASS_COUNT+1))
else
  echo -e "   ${RED}❌ +0 pts${RESET}"
  [ "$pv" != "ok" ] && echo -e "   ${RED}  ✗ PV${RESET}"
  [ "$vg" != "ok" ] && echo -e "   ${RED}  ✗ VG${RESET}"
  [ "$lv" != "ok" ] && echo -e "   ${RED}  ✗ LV${RESET}"
  [ "$fs" != "ok" ] && echo -e "   ${RED}  ✗ FS${RESET}"
  FAIL_COUNT=$((FAIL_COUNT+1))
fi

# T4: Swap
echo -e "\n${CYAN}┌─ TAREA 4: Swap file (3 pts) ─${RESET}"
sw1=$(run02 "sudo swapon --show 2>/dev/null | grep -q '/swapfile' && echo ok")
sw2=$(run02 "grep -q '/swapfile' /etc/fstab && echo ok")
sw3=$(run02 "stat -c %a /swapfile 2>/dev/null | grep -q '600' && echo ok")
if [ "$sw1" = "ok" ] && [ "$sw2" = "ok" ] && [ "$sw3" = "ok" ]; then
  echo -e "   ${GREEN}✅ +3 pts${RESET}"; TOTAL=$((TOTAL+3)); PASS_COUNT=$((PASS_COUNT+1))
else
  echo -e "   ${RED}❌ +0 pts${RESET}"
  [ "$sw1" != "ok" ] && echo -e "   ${RED}  ✗ Swap no activo${RESET}"
  [ "$sw2" != "ok" ] && echo -e "   ${RED}  ✗ No en fstab${RESET}"
  [ "$sw3" != "ok" ] && echo -e "   ${RED}  ✗ Permisos != 600${RESET}"
  FAIL_COUNT=$((FAIL_COUNT+1))
fi

# T5: fstab mount
echo -e "\n${CYAN}┌─ TAREA 5: fstab /dev/vdc (3 pts) ─${RESET}"
m1=$(run02 "mount | grep -q '/dev/vdc.*on /mnt/archives' && echo ok")
m2=$(run02 "grep -E '/dev/vdc.*/mnt/archives.*ext4.*defaults' /etc/fstab >/dev/null && echo ok")
if [ "$m1" = "ok" ] && [ "$m2" = "ok" ]; then
  echo -e "   ${GREEN}✅ +3 pts${RESET}"; TOTAL=$((TOTAL+3)); PASS_COUNT=$((PASS_COUNT+1))
else
  echo -e "   ${RED}❌ +0 pts${RESET}"
  [ "$m1" != "ok" ] && echo -e "   ${RED}  ✗ No montado${RESET}"
  [ "$m2" != "ok" ] && echo -e "   ${RED}  ✗ fstab incorrecto${RESET}"
  FAIL_COUNT=$((FAIL_COUNT+1))
fi

# T6: sysctl
echo -e "\n${CYAN}┌─ TAREA 6: sysctl vm.swappiness (3 pts) ─${RESET}"
s1=$(run02 "sysctl -n vm.swappiness 2>/dev/null | tr -d '\r\n'")
s2=$(run02 "[ -f /etc/sysctl.d/99-vm-tuning.conf ] && grep -q 'vm.swappiness.*=.*10' /etc/sysctl.d/99-vm-tuning.conf && echo ok")
if [ "$s1" = "10" ] && [ "$s2" = "ok" ]; then
  echo -e "   ${GREEN}✅ +3 pts${RESET}"; TOTAL=$((TOTAL+3)); PASS_COUNT=$((PASS_COUNT+1))
else
  echo -e "   ${RED}❌ +0 pts${RESET}"
  [ "$s1" != "10" ] && echo -e "   ${RED}  ✗ Runtime=$s1 (debe ser 10)${RESET}"
  [ "$s2" != "ok" ] && echo -e "   ${RED}  ✗ Archivo persistente incorrecto${RESET}"
  FAIL_COUNT=$((FAIL_COUNT+1))
fi

# T7: journalctl warnings (mejorado: ahora valida que el número sea >= 3, pero además que el archivo contenga solo un número)
check 7 "journalctl warnings" 3 \
  "[ -f /opt/warning-count.txt ] && [ \$(cat /opt/warning-count.txt | tr -d '[:space:]' | grep -E '^[0-9]+$') ] && [ \$(cat /opt/warning-count.txt | tr -d '[:space:]') -ge 3 ] 2>/dev/null" \
  "/opt/warning-count.txt con número >= 3 (solo dígitos)"

# T8: hosts
check 8 "/etc/hosts" 3 \
  "grep -q '10.10.10.100.*db-primary.internal' /etc/hosts" \
  "Entrada db-primary.internal → 10.10.10.100"

# T9: SSH
check 9 "SSH PasswordAuth" 3 \
  "grep -E '^PasswordAuthentication[[:space:]]+no' /etc/ssh/sshd_config >/dev/null" \
  "PasswordAuthentication no (sin #)"

# T10: Cron (flexible con espacios/tabs)
check 10 "Cron backupuser" 3 \
  "sudo crontab -u backupuser -l 2>/dev/null | grep -qE '^15[[:space:]]+2[[:space:]]+\*[[:space:]]+\*[[:space:]]+\*'" \
  "Cron: 15 2 * * * para backupuser"

# T11: ACLs
check 11 "ACL readonly_user" 3 \
  "getfacl /opt/secure-data 2>/dev/null | grep -qE 'user:readonly_user:r-x'" \
  "ACL r-x para readonly_user en /opt/secure-data"

# T12: tar (validación mejorada: comprueba que los 4 archivos .conf estén dentro)
echo -e "\n${CYAN}┌─ TAREA 12: tar backup (3 pts) ─${RESET}"
t1=$(run02 "[ -f /opt/configs-backup.tar.gz ] && echo ok")
t2=$(run02 "tar -tzf /opt/configs-backup.tar.gz 2>/dev/null | grep -q 'database.conf' && echo ok")
t3=$(run02 "tar -tzf /opt/configs-backup.tar.gz 2>/dev/null | grep -q 'cache.conf' && echo ok")
t4=$(run02 "tar -tzf /opt/configs-backup.tar.gz 2>/dev/null | grep -q 'logging.conf' && echo ok")
t5=$(run02 "tar -tzf /opt/configs-backup.tar.gz 2>/dev/null | grep -q 'api.conf' && echo ok")
if [ "$t1" = "ok" ] && [ "$t2" = "ok" ] && [ "$t3" = "ok" ] && [ "$t4" = "ok" ] && [ "$t5" = "ok" ]; then
  echo -e "   ${GREEN}✅ +3 pts${RESET}"; TOTAL=$((TOTAL+3)); PASS_COUNT=$((PASS_COUNT+1))
else
  echo -e "   ${RED}❌ +0 pts${RESET}"
  [ "$t1" != "ok" ] && echo -e "   ${RED}  ✗ Archivo no existe${RESET}"
  [ "$t2" != "ok" ] && echo -e "   ${RED}  ✗ Falta database.conf${RESET}"
  [ "$t3" != "ok" ] && echo -e "   ${RED}  ✗ Falta cache.conf${RESET}"
  [ "$t4" != "ok" ] && echo -e "   ${RED}  ✗ Falta logging.conf${RESET}"
  [ "$t5" != "ok" ] && echo -e "   ${RED}  ✗ Falta api.conf${RESET}"
  FAIL_COUNT=$((FAIL_COUNT+1))
fi

# ═══════════════════════════════════════════════════════════════
# RESULTADO FINAL
# ═══════════════════════════════════════════════════════════════
PERCENT=$((TOTAL * 100 / MAX))

echo -e "\n${MAGENTA}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                    📊 RESULTADO FINAL                        ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "${RESET}"
echo -e "${BOLD}Tareas aprobadas:${RESET}  ${GREEN}$PASS_COUNT / 12${RESET}"
echo -e "${BOLD}Tareas fallidas:${RESET}   ${RED}$FAIL_COUNT / 12${RESET}"
echo -e "${BOLD}Puntuación:${RESET}       ${CYAN}$TOTAL / $MAX puntos${RESET}"
echo -e "${BOLD}Porcentaje:${RESET}       ${CYAN}$PERCENT%${RESET}"
echo -e "${BOLD}Mínimo (67%):${RESET}     ${CYAN}25 puntos${RESET}"
echo ""

if [ $PERCENT -ge 67 ]; then
  echo -e "${GREEN}${BOLD}"
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║           🎉 ¡APROBADO! ¡FELICIDADES, BOB! 🎉               ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo -e "${RESET}"
else
  echo -e "${RED}${BOLD}"
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║               ❌ NO APROBADO — ¡Sigue así! 💪               ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo -e "${RESET}"
fi
echo ""
VALIDATOR
          chmod +x /home/vagrant/validate.sh
          
          # ═══════════════════════════════════════════════════════
          # SCRIPT DE EVIDENCIA OPCIONAL (generate-evidence.sh)
          # ═══════════════════════════════════════════════════════
          cat << 'EVIDENCE' > /home/vagrant/generate-evidence.sh
#!/bin/bash
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=5"
PASS="caleston123"
DEST="node03:/opt/ops-compliance/simulacro-007/evidence.txt"

echo "🔍 Recopilando evidencias de node02..."
{
  echo "=== EVIDENCIAS SIMULACRO-007 ==="
  echo "Fecha: $(date)"
  echo ""
  echo "--- Tarea 1: /opt/errors-500.txt ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "cat /opt/errors-500.txt 2>/dev/null || echo 'No existe'"
  echo ""
  echo "--- Tarea 2: id sysop ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "id sysop 2>/dev/null || echo 'No existe'"
  echo ""
  echo "--- Tarea 3: sudo lvs ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "sudo lvs 2>/dev/null || echo 'No LVs'"
  echo ""
  echo "--- Tarea 4: sudo swapon --show ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "sudo swapon --show 2>/dev/null || echo 'No swap'"
  echo ""
  echo "--- Tarea 5: mount | grep vdc ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "mount | grep vdc 2>/dev/null || echo 'No montado'"
  echo ""
  echo "--- Tarea 6: sysctl vm.swappiness ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "sysctl vm.swappiness 2>/dev/null || echo 'No aplicado'"
  echo ""
  echo "--- Tarea 7: cat /opt/warning-count.txt ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "cat /opt/warning-count.txt 2>/dev/null || echo 'No existe'"
  echo ""
  echo "--- Tarea 8: grep db-primary /etc/hosts ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "grep db-primary /etc/hosts 2>/dev/null || echo 'No existe'"
  echo ""
  echo "--- Tarea 9: grep PasswordAuthentication /etc/ssh/sshd_config ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "grep -E '^PasswordAuthentication' /etc/ssh/sshd_config 2>/dev/null || echo 'No configurado'"
  echo ""
  echo "--- Tarea 10: sudo crontab -u backupuser -l ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "sudo crontab -u backupuser -l 2>/dev/null || echo 'No hay cron'"
  echo ""
  echo "--- Tarea 11: getfacl /opt/secure-data ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "getfacl /opt/secure-data 2>/dev/null || echo 'No existe'"
  echo ""
  echo "--- Tarea 12: ls -lh /opt/configs-backup.tar.gz ---"
  sshpass -p $PASS ssh $SSH_OPTS bob@node02 "ls -lh /opt/configs-backup.tar.gz 2>/dev/null || echo 'No existe'"
  echo ""
  echo "=== FIN DE EVIDENCIAS ==="
} | sshpass -p $PASS ssh $SSH_OPTS bob@node03 "cat > /opt/ops-compliance/simulacro-007/evidence.txt"

if [ $? -eq 0 ]; then
  echo "✅ Evidencia guardada en $DEST"
else
  echo "❌ Fallo al guardar la evidencia"
fi
EVIDENCE
          chmod +x /home/vagrant/generate-evidence.sh
          
          echo "✅ Ticket + Verificación + Validador + Script de evidencia creados."
          echo "🚀 vagrant ssh node01 → verificación automática"
          echo "📝 Al terminar: bash /home/vagrant/validate.sh"
          echo "📦 (Opcional) Envía evidencias: bash /home/vagrant/generate-evidence.sh"
        SHELL
      end
    end
  end
end
