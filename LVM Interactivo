class ChallengeSystem:
    """Sistema de retos estructurado y validado"""
    
    def __init__(self, logger: Logger):
        self.logger = logger
        self.challenges = self._load_challenges()
    
    def _load_challenges(self) -> Dict:
        """Carga la definición de retos completa"""
        return {
            "basic": [
                {
                    "id": "B01",
                    "name": "Creación de VG y LVs básicos",
                    "description": "Crear VG 'vg_train_XXX' con 2 LVs, formatear XFS y montar",
