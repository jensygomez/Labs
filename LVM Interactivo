                        "lvcreate -L 500M -n lv_data vg_train_123",
                        "lvcreate -L 300M -n lv_backup vg_train_123",
                        "mkfs.xfs /dev/vg_train_123/lv_data",
                        "mkdir -p /mnt/lvm_data && mount /dev/vg/lv_data /mnt/lvm_data",
                        "blkid /dev/vg/lv_data >> /etc/fstab"
                    ]
                }
            ],
            "intermediate": [
                {
                    "id": "I01",
                    "name": "Extensión de VG y LV",
                    "description": "Añadir /dev/loop5 a VG existente y extender lv_data a 1.5G",
                    "points": 15,
                    "validation": self.validate_vg_extend,
                    "hints": [
                        "pvcreate /dev/loop5",
                        "vgextend vg_train_XXX /dev/loop5", 
                        "lvextend -L +1G /dev/vg_train_XXX/lv_data",
                        "xfs_growfs /dev/vg_train_XXX/lv_data"
                    ]
                }
            ],
            "advanced": [
                {
                    "id": "A01",
                    "name": "Creación de snapshot LVM",
                    "description": "Crear snapshot 200M de lv_data y montarlo en /mnt/snapshot",
                    "points": 20,
                    "validation": self.validate_snapshot,
                    "hints": [
                        "lvcreate -s -L 200M -n lv_data_snap /dev/vg_train_XXX/lv_data",
                        "mkfs.xfs /dev/vg_train_XXX/lv_data_snap",
                        "mkdir -p /mnt/snapshot && mount /dev/vg/lv_data_snap /mnt/snapshot"
                    ]
                }
            ]
        }
    
    def validate_basic_lvm(self, challenge_data: Dict) -> Tuple[bool, str]:
        """Valida reto básico de LVM"""
        try:
            vg_name = challenge_data.get("vg_name")
            
            # Verificar VG existe
            result = subprocess.run(
                ["vgs", vg_name, "--noheadings", "-o", "vg_name"],
                capture_output=True,
                text=True
            )
            if result.returncode != 0:
                return False, f"VG {vg_name} no existe"
            
            # Verificar LVs
            lvs = challenge_data.get("lvs", [])
            for lv in lvs:
                result = subprocess.run(
                    ["lvs", f"{vg_name}/{lv['name']}", "--noheadings", "-o", "lv_name"],
                    capture_output=True,
                    text=True
                )
                if result.returncode != 0:
                    return False, f"LV {lv['name']} no existe en VG {vg_name}"
                
                # Verificar filesystem
                dev_path = f"/dev/{vg_name}/{lv['name']}"
                result = subprocess.run(
                    ["blkid", "-s", "TYPE", "-o", "value", dev_path],
                    capture_output=True,
                    text=True
                )
                fs_type = result.stdout.strip()
                if not fs_type or "xfs" not in fs_type.lower():
                    return False, f"LV {lv['name']} no tiene XFS (usa mkfs.xfs)"
                
                # Verificar montaje si corresponde
                if lv.get("mount_point"):
                    result = subprocess.run(
                        ["findmnt", "-n", "-o", "SOURCE", lv["mount_point"]],
                        capture_output=True,
                        text=True
                    )
                    if dev_path not in result.stdout:
                        return False, f"LV {lv['name']} no montado en {lv['mount_point']}"
            
            return True, "✅ Reto básico completado correctamente"
            
        except Exception as e:
            return False, f"Error en validación: {str(e)}"
    
    def validate_vg_extend(self, challenge_data: Dict) -> Tuple[bool, str]:
        """Valida extensión de VG y LV - COMPLETA"""
        try:
            vg_name = challenge_data.get("vg_name")
            expected_size = challenge_data.get("expected_size_gb", 3.0)
            lv_name = challenge_data.get("lv_name", "lv_data")
            
            # Verificar VG existe y tiene tamaño extendido
            vg_result = subprocess.run(
                ["vgs", vg_name, "--noheadings", "-o", "vg_name,VGSize", "--units", "G"],
                capture_output=True, text=True
            )
            if vg_result.returncode != 0:
                return False, f"VG {vg_name} no existe"
            
            vg_info = vg_result.stdout.strip().split()
            vg_size = float(vg_info[1].replace('G', ''))
            if vg_size < expected_size:
                return False, f"VG {vg_name} solo tiene {vg_size:.1f}GB (esperado: {expected_size}+GB)"
            
            # Verificar LV extendido
            lv_result = subprocess.run(
                ["lvs", f"{vg_name}/{lv_name}", "--noheadings", "-o", "lv_name,LvSize", "--units", "G"],
                capture_output=True, text=True
            )
            if lv_result.returncode != 0:
                return False, f"LV {lv_name} no existe en {vg_name}"
            
            lv_info = lv_result.stdout.strip().split()
            lv_size = float(lv_info[1].replace('G', ''))
            if lv_size < 1.5:
                return False, f"LV {lv_name} solo tiene {lv_size:.1f}GB (debe estar extendido >1.5GB)"
            
            # Verificar filesystem redimensionado (XFS)
            dev_path = f"/dev/{vg_name}/{lv_name}"
            xfs_result = subprocess.run(
                ["xfs_info", dev_path], capture_output=True, text=True
            )
            if xfs_result.returncode != 0 or "xfs" not in xfs_result.stdout.lower():
                return False, f"LV {lv_name} no tiene XFS redimensionado (usa xfs_growfs {dev_path})"
            
            return True, f"✅ VG y LV extendidos correctamente (VG: {vg_size:.1f}GB)"
            
        except Exception as e:
            return False, f"Error validando extensión: {str(e)}"

    def validate_snapshot(self, challenge_data: Dict) -> Tuple[bool, str]:
        """Valida creación y uso de snapshots - COMPLETA"""
        try:
            vg_name = challenge_data.get("vg_name")
            original_lv = challenge_data.get("original_lv", "lv_data")
            snapshot_lv = challenge_data.get("snapshot_lv", "lv_data_snap")
            mount_point = challenge_data.get("snapshot_mount", "/mnt/snapshot")
            
            # Verificar snapshot existe
            snap_result = subprocess.run(
                ["lvs", f"{vg_name}/{snapshot_lv}", "--noheadings", "-o", "lv_name,segtype"],
                capture_output=True, text=True
            )
            if snap_result.returncode != 0:
                return False, f"Snapshot {snapshot_lv} no existe en {vg_name}"
            
            snap_info = snap_result.stdout.strip().split()
            if len(snap_info) < 2 or "snapshot" not in snap_info[1].lower():
                return False, f"{snapshot_lv} no es un snapshot válido (usa: lvcreate -s ...)"
            
            # Verificar original sigue activo
            orig_result = subprocess.run(
                ["lvs", f"{vg_name}/{original_lv}", "--noheadings", "-o", "lv_name,status"],
                capture_output=True, text=True
            )
            if orig_result.returncode != 0:
                return False, f"LV original {original_lv} no existe"
            
            # Verificar snapshot montado si se especificó
            snap_path = f"/dev/{vg_name}/{snapshot_lv}"
            if mount_point and os.path.exists(mount_point):
                result = subprocess.run(
                    ["findmnt", "-n", "-o", "SOURCE", mount_point],
                    capture_output=True, text=True
                )
                if snap_path not in result.stdout:
                    return False, f"Snapshot no montado en {mount_point}"
            
            return True, f"✅ Snapshot {snapshot_lv} creado y funcional"
            
        except Exception as e:
            return False, f"Error validando snapshot: {str(e)}"

