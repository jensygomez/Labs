# ===================== CLASE PRINCIPAL =====================
class LVM_Trainer:
    """Clase principal del entrenador LVM"""
    
    def __init__(self):
        self.config = Config()
        self.logger = Logger(self.config.log_dir)
        self.ui = UserInterface(self.logger)
        self.loop_manager = LoopDeviceManager(self.config, self.logger)
        self.challenge_system = ChallengeSystem(self.logger)
        
        # Estado de la sesión
        self.session_state = {
            "start_time": datetime.now().isoformat(),
            "completed_challenges": [],
            "score": 0,
            "current_level": "basic"
        }
    
    def run(self):
        """Método principal de ejecución"""
        try:
            # Mostrar banner
            self.ui.print_banner()
            
            # Validar entorno
            if not SecurityValidator.validate_environment(self.config):
                self.logger.warning("Procediendo con validaciones fallidas")
            
            # Verificar argumentos
            parser = argparse.ArgumentParser(description='LVM RHCSA Trainer')
            parser.add_argument('--safe-mode', action='store_true', help='Modo seguro máximo')
            parser.add_argument('--clean', action='store_true', help='Limpiar antes de empezar')
            args = parser.parse_args()
            
            if args.clean:
                self.cleanup_system()
            
            # Bucle principal
            while True:
                choice = self.ui.show_menu()
                
                if choice == '1':
                    self.training_mode()
                elif choice == '2':
                    self.exam_mode()
                elif choice == '3':
                    self.free_mode()
                elif choice == '4':
                    self.show_progress()
                elif choice == '5':
                    self.show_config()
                elif choice == '6':
                    self.cleanup_system()
                elif choice == '7':
                    self.exit_program()
                else:
                    print("\033[93mOpción no válida\033[0m")
        
        except KeyboardInterrupt:
            self.exit_program()
        except Exception as e:
            self.logger.error(f"Error crítico: {e}")
            self.emergency_cleanup()
    
    def training_mode(self):
        """Modo entrenamiento guiado - COMPLETO"""
        self.logger.info("🎓 Iniciando modo entrenamiento")
        
        # Crear entorno base
        disks = self.detect_empty_disks()
        if not disks:
            disks = self.loop_manager.create_loop_devices(3)
        
        # Seleccionar reto según nivel
        level = self.session_state["current_level"]
        challenges = self.challenge_system.challenges.get(level, [])
        
        if not challenges:
            self.logger.warning(f"No hay retos disponibles para nivel {level}")
            return
        
        challenge = random.choice(challenges)
        
        # Configurar datos del reto
        challenge_data = {
            "disks": disks[:2],
            "vg_name": f"vg_train_{random.randint(100,999)}",
            "lvs": [
                {"name": f"lv_data_{random.randint(1,9)}", "size": "500M", "mount_point": SAFE_MOUNT_POINTS[0]},
                {"name": f"lv_backup_{random.randint(1,9)}", "size": "300M", "mount_point": SAFE_MOUNT_POINTS[1]}
            ]
        }
        
        # Mostrar reto
        self.ui.show_challenge({**challenge, **challenge_data}, level)
        
        # Bucle de interacción
        self.interactive_loop(challenge, challenge_data)
    
    def exam_mode(self):
        """Modo examen cronometrado - COMPLETO"""
        self.logger.info("🧪 Iniciando MODO EXAMEN RHCSA (15 minutos)")
        
        # Crear 4 discos para examen realista
        disks = self.loop_manager.create_loop_devices(4)
        start_time = time.time()
        exam_time = 15 * 60  # 15 minutos
        
        print(f"\n⏱️   EXAMEN RHCSA LVM - 15 MINUTOS")
        print(f"💾   Discos: {', '.join(disks)}")
        print("🎯  Tareas: 1 VG con 3 LVs + 1 snapshot + extender 1 LV")
        print("💡   Comandos: time, status, validate, !comando")
        print("-" * 60)
        
        while time.time() - start_time < exam_time:
            remaining = int(exam_time - (time.time() - start_time))
            mins, secs = divmod(remaining, 60)
            print(f"\r⏱️  {mins:02d}:{secs:02d}", end="", flush=True)
            
            try:
                cmd = input("\nexamen> ").strip().lower()
            except:
                continue
                
            if cmd == 'time':
                print(f"\n⏱️  Tiempo restante: {mins:02d}:{secs:02d}")
            elif cmd == 'status':
                self.show_current_status()
            elif cmd == 'validate':
                # Validación examen completa
                success, msg = self.challenge_system.validate_basic_lvm({
                    "vg_name": "vg_exam", 
                    "lvs": [{"name": "lv_root"}, {"name": "lv_home"}, {"name": "lv_data"}]
                })
                if success:
                    self.logger.success("🎉 ¡EXAMEN APROBADO! 🎉")
                    self.session_state["score"] += 50
                    break
                else:
                    self.logger.error(f"❌ {msg}")
            elif cmd == 'quit':
                break
            elif cmd.startswith('!'):
                self.execute_safe_command(cmd[1:])
        
        elapsed = time.time() - start_time
        mins, secs = divmod(int(elapsed), 60)
        print(f"\n⏱️  Tiempo usado: {mins:02d}:{secs:02d}")
    
    def free_mode(self):
        """Modo libre para experimentar - COMPLETO"""
        self.logger.info("🆓 MODO LIBRE - Experimenta sin restricciones")
        disks = self.loop_manager.create_loop_devices(5)
        
        print(f"\n💾 Discos libres creados: {', '.join(disks)}")
        print("📋 Comandos disponibles: check, status, cleanup, !comando_bash, menu")
        print("🎛️   ¡Crea tus propios VGs/LVs/snapshots sin validación!")
        print("-" * 60)
        
        while True:
            cmd = input("\nfree> ").strip().lower()
            if cmd == 'check':
                self.show_current_status()
            elif cmd == 'status':
                subprocess.run(["lsblk", "-f", "-o", "NAME,FSTYPE,MOUNTPOINT,SIZE"], shell=True)
            elif cmd == 'cleanup':
                self.cleanup_system()
                break
            elif cmd.startswith('!'):
                self.execute_safe_command(cmd[1:])
            elif cmd == 'menu':
                break
            else:
                print("💡 Usa: check, status, !comando, cleanup, menu")
    
    def interactive_loop(self, challenge: Dict, challenge_data: Dict):
        """Bucle interactivo para resolver reto"""
        while True:
            cmd = input("\nlvm-trainer> ").strip().lower()
            
            if cmd == 'check':
                self.show_current_status()
            elif cmd == 'hint':
                self.show_hint(challenge)
            elif cmd == 'validate':
                success, message = challenge["validation"](challenge_data)
                if success:
                    self.logger.success(f"✅ {message}")
                    self.session_state["score"] += challenge["points"]
                    self.session_state["completed_challenges"].append(challenge["id"])
                    input("\nPresiona Enter para continuar...")
                    break
                else:
                    self.logger.error(f"❌ {message}")
            elif cmd == 'skip':
                self.logger.warning("⚠️  Reto saltado")
                break
            elif cmd == 'menu':
                return
            elif cmd.startswith('!'):
                self.execute_safe_command(cmd[1:])
            else:
                print("\033[93mComando no reconocido. Usa: check, hint, validate, skip, menu, !comando\033[0m")
    
    def show_current_status(self):
        """Muestra estado actual del sistema LVM"""
        commands = [
            ("🔧 PVs", "pvs --all --units G"),
            ("📦 VGs", "vgs --units G"), 
            ("📂 LVs", "lvs --units G -o+devices"),
            ("🗂️  Mounts", "mount | grep -E '(mapper|/dev/vg)' | head -10 || echo 'Ninguno'"),
            ("📄 FSTAB", "grep -E '(mapper|/dev/vg)' /etc/fstab 2>/dev/null || echo 'Sin entradas LVM'")
        ]
        
        for title, cmd in commands:
            print(f"\n{'─'*50}")
            print(f"{title}:")
            print(f"{'─'*50}")
            result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
            print(result.stdout.strip() if result.stdout.strip() else "(vacío)")
    
    def show_hint(self, challenge: Dict):
        """Muestra pistas del reto"""
        hints = challenge.get("hints", [])
        if hints:
            hint = random.choice(hints)
            print(f"\n💡 Pista: \033[94m{hint}\033[0m")
        else:
            print("\033[93mNo hay pistas disponibles\033[0m")
    
    def execute_safe_command(self, command: str):
        """Ejecuta comandos bash con validación de seguridad"""
        dangerous = ["rm -rf", "dd if=", "format", "fdisk /dev/sd"]
        
        if any(danger in command for danger in dangerous):
            self.logger.warning(f"🚨 Comando potencialmente peligroso: {command}")
            confirm = input("¿Está SEGURO? (s/N): ")
            if confirm.lower() != 's':
                return
        
        try:
            result = subprocess.run(
                command,
                shell=True,
                capture_output=True,
                text=True,
                timeout=30
            )
            if result.stdout:
                print(result.stdout)
            if result.stderr:
                print(f"\033[93m{result.stderr}\033[0m")
            if result.returncode != 0:
                self.logger.warning(f"Return code: {result.returncode}")
        except subprocess.TimeoutExpired:
            self.logger.error("⏰ Comando excedió 30s")
        except Exception as e:
            self.logger.error(f"Error ejecutando: {e}")
    
    def detect_empty_disks(self) -> List[str]:
        """Detecta discos vacíos seguros para usar"""
        try:
            result = subprocess.run(
                "lsblk -d -n -p -o NAME,SIZE,TYPE,MOUNTPOINT,RO",
                shell=True,
                capture_output=True,
                text=True
            )
            
            empty_disks = []
            for line in result.stdout.splitlines():
                parts = line.split()
                if len(parts) < 3:
                    continue
                
                disk, size, dtype = parts[0], parts[1], parts[2]
                
                # Filtros de seguridad
                if dtype != "disk":
                    continue
                if any(excl in disk for excl in self.config.exclude_disks):
                    continue
                if len(parts) > 3 and parts[3] != "":
                    continue
                if len(parts) > 4 and parts[4] == "1":
                    continue
                
                # Verificar sin particiones
                part_check = subprocess.run(
                    f"lsblk -ln {disk} | grep -c '^[└├]─'",
                    shell=True,
                    capture_output=True,
                    text=True
                )
                if part_check.stdout.strip() == "0":
                    empty_disks.append(disk)
            
            return empty_disks
            
        except Exception as e:
            self.logger.error(f"Error detectando discos: {e}")
            return []
    
    def cleanup_system(self):
        """Limpia todo el sistema LVM de forma segura"""
        self.logger.warning("🧹 Iniciando limpieza completa del sistema...")
        
        confirm = input("\n⚠️  ¿Está SEGURO de querer limpiar TODO LVM? (escriba 'LIMPIAR'): ")
        if confirm != "LIMPIAR":
            self.logger.info("Limpieza cancelada")
            return
        
        print("🔄 Desmontando LVM mounts...")
        # Desmontar puntos de montaje LVM
        mount_result = subprocess.run(
            "mount | grep -E '/dev/mapper|/dev/vg' | cut -d' ' -f3",
            shell=True,
            capture_output=True,
            text=True
        )
        
        for mount_point in mount_result.stdout.splitlines():
            if mount_point.strip():
                subprocess.run(["umount", mount_point.strip()], capture_output=True)
                self.logger.debug(f"Desmontado: {mount_point.strip()}")
        
        print("🔄 Backup y limpieza fstab...")
        # Backup fstab
        subprocess.run("cp /etc/fstab /etc/fstab.lvm_backup.$(date +%s)", shell=True)
        subprocess.run(
            "grep -v -E '(mapper|/dev/vg)' /etc/fstab > /etc/fstab.new && mv /etc/fstab.new /etc/fstab",
            shell=True
        )
        
        print("🔄 Removiendo LVs/VGs/PVs...")
        # Eliminar LVs, VGs y PVs
        subprocess.run("lvremove -f $(lvs --noheadings -o lv_path 2>/dev/null) 2>/dev/null || true", shell=True)
        subprocess.run("vgremove -f $(vgs --noheadings -o vg_name 2>/dev/null) 2>/dev/null || true", shell=True)
        subprocess.run("pvremove -f $(pvs --noheadings -o pv_name 2>/dev/null) 2>/dev/null || true", shell=True)
        
        # Limpiar loop devices
        self.loop_manager.cleanup_all()
        
        self.logger.success("✅ ¡Sistema LVM limpiado completamente!")
    
    def emergency_cleanup(self):
        """Limpieza de emergencia"""
        self.logger.error("🚨 Ejecutando limpieza de EMERGENCIA...")
        self.cleanup_system()
    
