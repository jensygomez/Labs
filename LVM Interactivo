# ===================== LOGGING PROFESIONAL =====================
class Logger:
    """Sistema de logging estructurado"""
    def __init__(self, log_dir: Path):
        self.log_dir = log_dir
        self.session_id = datetime.now().strftime("%Y%m%d_%H%M%S")
        self.log_file = log_dir / f"lvm_trainer_{self.session_id}.log"
        
    def log(self, level: str, message: str, **kwargs):
        timestamp = datetime.now().isoformat()
        entry = f"{timestamp} [{level}] {message}"
        if kwargs:
            entry += f" | {json.dumps(kwargs, default=str)}"
        
        # Consola con colores
        colors = {
            "INFO": "\033[94m",      # Azul
            "SUCCESS": "\033[92m",   # Verde
            "WARNING": "\033[93m",   # Amarillo
            "ERROR": "\033[91m",     # Rojo
            "DEBUG": "\033[90m",     # Gris
        }
        reset = "\033[0m"
        
        if level in colors:
            print(f"{colors[level]}{entry}{reset}")
        else:
            print(entry)
            
        # Archivo de log
        with open(self.log_file, 'a') as f:
            f.write(entry + "\n")
    
    def info(self, msg, **kwargs): self.log("INFO", msg, **kwargs)
    def success(self, msg, **kwargs): self.log("SUCCESS", msg, **kwargs)
    def warning(self, msg, **kwargs): self.log("WARNING", msg, **kwargs)
    def error(self, msg, **kwargs): self.log("ERROR", msg, **kwargs)
    def debug(self, msg, **kwargs): self.log("DEBUG", msg, **kwargs)

# ===================== VALIDACIÓN DE SEGURIDAD =====================
class SecurityValidator:
    """Valida que el entorno sea seguro para operaciones LVM"""
    
    @staticmethod
    def validate_environment(config: Config) -> bool:
        """Validaciones previas a la ejecución"""
        validations = [
            ("Sistema operativo compatible", SecurityValidator._check_os()),
            ("Herramientas LVM instaladas", SecurityValidator._check_tools()),
            ("Espacio en disco suficiente", SecurityValidator._check_disk_space()),
            ("No en sistema de producción", SecurityValidator._check_production()),
            ("Permisos root correctos", SecurityValidator._check_root()),
            ("Loop support habilitado", SecurityValidator._check_loop()),
        ]
        
        all_ok = True
        for desc, result in validations:
            if not result[0]:
                print(f"\033[91m✗ {desc}: {result[1]}\033[0m")
                all_ok = False
            else:
                print(f"\033[92m✓ {desc}\033[0m")
        
        if not all_ok:
            print("\n\033[93m⚠️  El entorno no cumple con los requisitos de seguridad.\033[0m")
            if input("¿Continuar de todos modos? (s/N): ").lower() != 's':
                sys.exit(1)
        
        return all_ok
    
    @staticmethod
    def _check_os() -> Tuple[bool, str]:
        """Verifica sistema operativo compatible"""
        try:
            with open('/etc/os-release', 'r') as f:
                content = f.read().lower()
                if 'redhat' in content or 'centos' in content or 'fedora' in content:
                    return True, "RHEL/CentOS/Fedora detectado"
                elif 'ubuntu' in content or 'debian' in content:
                    return True, "Debian/Ubuntu detectado"
                return False, "Sistema no soportado oficialmente"
        except:
            return False, "No se pudo detectar el SO"
    
    @staticmethod
    def _check_tools() -> Tuple[bool, str]:
        """Verifica herramientas necesarias"""
        tools = ['pvcreate', 'vgcreate', 'lvcreate', 'lsblk', 'losetup', 'mkfs.xfs']
        missing = []
        for tool in tools:
            if shutil.which(tool) is None:
                missing.append(tool)
        if missing:
            return False, f"Faltan herramientas: {', '.join(missing)}"
        return True, "Todas las herramientas disponibles"
    
    @staticmethod
    def _check_disk_space() -> Tuple[bool, str]:
        """Verifica espacio en disco para loop devices"""
        stat = os.statvfs('/')
        free_gb = (stat.f_frsize * stat.f_bavail) / (1024**3)
        if free_gb < 10:
            return False, f"Solo {free_gb:.1f}GB libres (se necesitan 10+ GB)"
        return True, f"{free_gb:.1f}GB disponibles"
    
    @staticmethod
    def _check_production() -> Tuple[bool, str]:
        """Detecta si está en sistema de producción"""
        try:
            # Verificar si es una VM (menos riesgo)
            with open('/sys/class/dmi/id/product_name', 'r') as f:
                product = f.read().lower()
                if 'vmware' in product or 'virtual' in product or 'kvm' in product:
                    return True, "Entorno virtual detectado"
            
            # Verificar servicios críticos
            critical_services = ['mysql', 'postgresql', 'httpd', 'nginx', 'docker']
            for service in critical_services:
                if os.path.exists(f"/etc/systemd/system/{service}.service"):
                    return False, f"Servicio crítico {service} detectado"
            
            return True, "No parece ser sistema de producción"
        except:
            return True, "No se pudo verificar (asumiendo seguro)"
    
    @staticmethod
    def _check_root() -> Tuple[bool, str]:
        """Verifica permisos root"""
        if os.geteuid() != 0:
            return False, "Se requieren privilegios root"
        return True, "Ejecutando como root"
    
    @staticmethod
    def _check_loop() -> Tuple[bool, str]:
        """Verifica soporte para loop devices"""
        if not os.path.exists('/dev/loop-control'):
            return False, "Kernel sin soporte loop devices"
        return True, "Loop support disponible"

# ===================== GESTIÓN DE LOOP DEVICES SEGUROS =====================
class LoopDeviceManager:
    """Gestiona loop devices de forma segura y controlada"""
    
    def __init__(self, config: Config, logger: Logger):
        self.config = config
        self.logger = logger
        self.loop_map_file = config.state_dir / "loop_device_map.json"
        self.loop_devices = self._load_loop_map()
    
    def _load_loop_map(self) -> Dict[str, str]:
        """Carga mapeo de loop devices desde archivo"""
        if self.loop_map_file.exists():
            try:
                with open(self.loop_map_file, 'r') as f:
                    return json.load(f)
            except:
                return {}
        return {}
    
    def _save_loop_map(self):
        """Guarda mapeo de loop devices"""
        with open(self.loop_map_file, 'w') as f:
            json.dump(self.loop_devices, f, indent=2)
    
    def create_loop_devices(self, count: int = 5) -> List[str]:
        """Crea loop devices de forma segura - FIXED"""
        created = []
        
        for i in range(count):
            if len(created) >= count:
                break
                
            img_name = f"lvm_disk_{datetime.now().strftime('%Y%m%d')}_{i}.img"
            img_path = self.config.loop_dir / img_name
            size_gb = random.choice(self.config.loop_sizes_gb)
            
            self.logger.info(f"Creando loop device {i+1}/{count} ({size_gb}GB)")
            
            try:
                # ✅ FIXED: Sin capture_output
                subprocess.run(["truncate", "-s", f"{size_gb}G", str(img_path)], check=True)
                img_path.chmod(0o600)
                
                result = subprocess.run(
                    ["losetup", "--find", "--show", str(img_path)],
                    capture_output=True, text=True, check=True
                )
                loop_dev = result.stdout.strip()
                
                # ✅ FIXED: Sin capture_output + DEVNULL
                subprocess.run(["wipefs", "-a", loop_dev], check=False)
                
                self.loop_devices[loop_dev] = {
                    "image": str(img_path), "size_gb": size_gb,
                    "created": datetime.now().isoformat()
                }
                created.append(loop_dev)
                self.logger.success(f"Loop device creado: {loop_dev}")
                
            except subprocess.CalledProcessError as e:
                self.logger.error(f"Error loop device: {e}")
                if img_path.exists():
                    img_path.unlink()
        
        self._save_loop_map()
        return created
    
    def cleanup_all(self):
        """Limpieza loop devices - FIXED"""
        self.logger.info("Limpiando loop devices...")
        
        # ✅ FIXED: Sin capture_output + DEVNULL
        subprocess.run(["losetup", "-D"], check=False)
        
        for img in self.config.loop_dir.glob("*.img"):
            try:
                img.unlink()
                self.logger.debug(f"Imagen eliminada: {img}")
            except Exception as e:
                self.logger.warning(f"No se pudo eliminar {img}: {e}")
        
        self.loop_devices.clear()
        if self.loop_map_file.exists():
            self.loop_map_file.unlink()
        
        self.logger.success("Limpieza completada")

