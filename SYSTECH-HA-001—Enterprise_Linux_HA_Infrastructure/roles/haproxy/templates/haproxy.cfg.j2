global
    log         127.0.0.1 local2
    chroot      /var/lib/haproxy
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon
    stats socket /var/lib/haproxy/stats

defaults
    mode                    http
    log                     global
    option                  httplog
    option                  dontlognull
    option http-server-close
    option forwardfor        except 127.0.0.0/8
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000

frontend http_front
    bind {{ keepalived_vip | default('192.168.122.250') }}:{{ haproxy_frontend_port | default(80) }}
    default_backend http_back

backend http_back
    balance {{ haproxy_backend_balance | default('roundrobin') }}
    {% for host in groups['ha_nodes'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:{{ haproxy_backend_port | default(80) }} check
    {% endfor %}

listen stats
    bind {{ keepalived_vip | default('192.168.122.250') }}:9000
    mode http
    stats enable
    stats uri /
    stats refresh 5s


