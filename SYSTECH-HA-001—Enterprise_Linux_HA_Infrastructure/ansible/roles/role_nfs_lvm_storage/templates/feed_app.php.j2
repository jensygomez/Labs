<?php
header('Content-Type: application/json');

$host = '{{ db_host_ip }}';
$db   = '{{ db_name }}';
$user = '{{ db_user }}';
$pass = '{{ db_pass }}';

$query_type = isset($_GET['q']) ? (int)$_GET['q'] : 1;
$server_node = gethostname();

try {
    $pdo = new PDO("pgsql:host=$host;dbname=$db", $user, $pass);
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    switch ($query_type) {
        case 1:
            $title = "¿Cuántos empleados hay en total?";
            $sql = "SELECT COUNT(*) as total_empleados FROM employees;";
            break;
        case 2:
            $title = "¿Cuántos ganan más de $1000?";
            $sql = "SELECT first_name, last_name, salary FROM employees WHERE salary > 1000 ORDER BY salary DESC;";
            break;
        case 3:
            $title = "Lista de empleados del departamento de RH";
            $sql = "SELECT first_name, last_name, department, salary FROM employees WHERE department = 'RH';";
            break;
        case 4:
            $title = "Lista de empleados cuyo nombre inicia con 'A'";
            $sql = "SELECT first_name, last_name, department FROM employees WHERE first_name LIKE 'A%';";
            break;
        case 5:
            $title = "Empleados con más de 2 años en la empresa";
            $sql = "SELECT first_name, last_name, hire_date FROM employees WHERE hire_date <= CURRENT_DATE - INTERVAL '2 years';";
            break;
        default:
            $title = "Consulta no válida";
            $sql = "SELECT COUNT(*) FROM employees;";
    }

    $stmt = $pdo->query($sql);
    $results = $stmt->fetchAll(PDO::FETCH_ASSOC);

    echo json_encode([
        'status' => 'success',
        'atendido_por' => $server_node,
        'pregunta' => $title,
        'data' => $results
    ], JSON_PRETTY_PRINT);

} catch (PDOException $e) {
    http_response_code(500);
    echo json_encode([
        'status' => 'error',
        'atendido_por' => $server_node,
        'message' => $e->getMessage()
    ]);
}
?>
