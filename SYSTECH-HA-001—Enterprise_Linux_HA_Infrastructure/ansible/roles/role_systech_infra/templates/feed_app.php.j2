<?php
header('Content-Type: application/json');

// Configuración (estas variables serán reemplazadas por Ansible)
$host = '{{ db_host_ip }}';
$db   = '{{ db_name }}';
$user = '{{ db_user }}';
$pass = '{{ db_pass }}';

$query_type = isset($_GET['q']) ? (int)$_GET['q'] : 1;
$action = isset($_GET['action']) ? $_GET['action'] : null;
$server_node = gethostname();

// CLIENTE 02: Escritura en Storage01 con retención dinámica
if ($action === 'storage_write') {
    // Obtener duración de la URL (por defecto 20 segundos)
    $duration = isset($_GET['duration']) ? (int)$_GET['duration'] : 20;
    sleep($duration);

    $storage_dir = '/var/www/html/uploads/';
    if (!file_exists($storage_dir)) {
        @mkdir($storage_dir, 0777, true);
    }

    $filename = $storage_dir . 'client02_write_' . date('Ymd_His') . '_' . $server_node . '.txt';
    $content = "Escritura de Client02 procesada por el nodo [" . $server_node . "] el " . date('Y-m-d H:i:s') . "\n";
    file_put_contents($filename, $content);

    echo json_encode([
        'status'         => 'success',
        'atendido_por'   => $server_node,
        'accion'         => "Escritura real en NFS storage01 completada ({$duration}s)",
        'archivo_creado' => basename($filename)
    ]);
    exit;
}

if ($action === 'storage_read') {
    sleep(2); 

    $storage_dir = '/var/www/html/uploads/';
    $files = file_exists($storage_dir) ? array_diff(scandir($storage_dir), array('.', '..')) : [];

    echo json_encode([
        'status'         => 'success',
        'atendido_por'   => $server_node,
        'accion'         => 'Lectura de directorio NFS storage01 completada',
        'total_archivos' => count($files),
        'ultimos_archivos' => array_values(array_slice($files, -5))
    ]);
    exit;
}

// CLIENTE 04: Consolidación batch + rotación de evidencias en Storage (NFS webdata)
// NOTA: Esta acción es 100% filesystem (NFS), NO requiere PostgreSQL.
// Por eso vive AQUÍ, fuera del try/PDO de más abajo — moverla dentro del
// bloque de conexión a DB forzaba abrir una conexión PDO innecesaria en
// cada ciclo de client04. Bajo carga simultánea de client01 (hasta 90s de
// ocupación) o client03 (reportes pesados GROUP BY/AVG) esa conexión podía
// demorarse lo suficiente para que el script total superase el
// max_execution_time de PHP, generando un "Fatal error: Maximum execution
// time exceeded" en texto plano en vez de JSON — de ahí el error
// intermitente "parse error: Invalid numeric literal" en jq del lado del
// cliente, y la ausencia de archivos audit_consolidated_* en storage.
if ($action === 'consolidate_audit') {
    $duration = isset($_GET['duration']) ? (int)$_GET['duration'] : 15;
    $max_keep = isset($_GET['max_keep']) ? (int)$_GET['max_keep'] : 20;

    $storage_dir = '/var/www/html/uploads/';
    if (!file_exists($storage_dir)) {
        @mkdir($storage_dir, 0777, true);
    }

    // 1. Listar archivos de evidencias de los otros clientes
    $all_files = file_exists($storage_dir) ? array_diff(scandir($storage_dir), array('.', '..')) : [];
    $evidence_files = array_values(array_filter($all_files, function($f) {
        return preg_match('/^client0[123]_/', $f) && substr($f, -4) === '.txt';
    }));

    // 2. Leer cada archivo y construir contenido consolidado
    $consolidated  = "=============================================================\n";
    $consolidated .= "  REPORTE CONSOLIDADO DE EVIDENCIAS\n";
    $consolidated .= "  Generado por: [" . $server_node . "] el " . date('Y-m-d H:i:s') . "\n";
    $consolidated .= "  Total archivos fuente leídos: " . count($evidence_files) . "\n";
    $consolidated .= "=============================================================\n\n";

    $read_count = 0;
    foreach ($evidence_files as $file) {
        $filepath = $storage_dir . $file;
        if (is_file($filepath)) {
            $consolidated .= "--- [" . $file . "] ---\n";
            $consolidated .= @file_get_contents($filepath) . "\n\n";
            $read_count++;
            // Simula procesamiento por archivo (I/O real en NFS)
            usleep(300000); // 0.3s por archivo
        }
    }

    // 3. Ocupar el servidor el tiempo restante indicado (simula carga sostenida)
    $elapsed = $read_count * 0.3;
    $remaining = max(0, $duration - $elapsed);
    if ($remaining > 0) {
        sleep((int)ceil($remaining));
    }

    // 4. Escribir archivo consolidado
    $consolidated_file = 'audit_consolidated_' . date('Ymd_His') . '_' . $server_node . '.txt';
    file_put_contents($storage_dir . $consolidated_file, $consolidated);

    // 5. Rotación: borrar los archivos de evidencia más antiguos si exceden max_keep
    $deleted = [];
    if (count($evidence_files) > $max_keep) {
        sort($evidence_files); // Orden alfabético = cronológico por el formato del nombre
        $to_delete = array_slice($evidence_files, 0, count($evidence_files) - $max_keep);
        foreach ($to_delete as $old_file) {
            @unlink($storage_dir . $old_file);
            $deleted[] = $old_file;
        }
    }

    // 6. Rotación de consolidados: mantener solo los últimos 3
    $consolidated_files = array_values(array_filter($all_files, function($f) {
        return preg_match('/^audit_consolidated_.*\.txt$/', $f);
    }));
    $consolidated_deleted = [];
    if (count($consolidated_files) > 3) {
        sort($consolidated_files);
        $to_delete_cons = array_slice($consolidated_files, 0, count($consolidated_files) - 3);
        foreach ($to_delete_cons as $old_file) {
            @unlink($storage_dir . $old_file);
            $consolidated_deleted[] = $old_file;
        }
    }

    echo json_encode([
        'status'             => 'success',
        'atendido_por'       => $server_node,
        'accion'             => "Consolidación batch + rotación completada ({$duration}s)",
        'archivos_leidos'    => $read_count,
        'archivos_borrados'  => count($deleted),
        'consolidado_creado' => $consolidated_file,
        'retencion_activa'   => $max_keep,
        'consolidados_borrados' => count($consolidated_deleted)
    ]);
    exit;
}

// ------------------------------------------------------------
// PARA EL RESTO DE ACCIONES: Conectamos a PostgreSQL
// ------------------------------------------------------------
try {
    $pdo = new PDO("pgsql:host=$host;dbname=$db", $user, $pass);
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    // CLIENTE 01: Consulta SQL con evidencia escrita en Storage (NFS webdata)
    if ($action === 'client01_query') {
        $duration = isset($_GET['duration']) ? (int)$_GET['duration'] : 60;

        $stmt = $pdo->query("SELECT first_name, last_name FROM employees WHERE first_name LIKE 'A%';");
        $results = $stmt->fetchAll(PDO::FETCH_ASSOC);

        // Ocupa el servidor el tiempo indicado (simula carga sostenida)
        sleep($duration);

        $storage_dir = '/var/www/html/uploads/';
        if (!file_exists($storage_dir)) {
            @mkdir($storage_dir, 0777, true);
        }

        $filename = $storage_dir . 'client01_query_' . date('Ymd_His') . '_' . $server_node . '.txt';
        $content  = "Consulta de Client01 procesada por el nodo [" . $server_node . "] el " . date('Y-m-d H:i:s') . "\n";
        $content .= "Pregunta: Empleados cuyo nombre inicia con 'A'\n";
        $content .= "Resultado: " . count($results) . " registro(s) encontrado(s)\n";
        foreach ($results as $r) {
            $content .= "  - " . $r['first_name'] . " " . $r['last_name'] . "\n";
        }
        file_put_contents($filename, $content);

        echo json_encode([
            'status'           => 'success',
            'atendido_por'     => $server_node,
            'accion'           => "Consulta SQL + evidencia en NFS storage01 completada ({$duration}s)",
            'total_resultados' => count($results),
            'archivo_creado'   => basename($filename)
        ]);
        exit;
    }

 consolidate_audit
