# Configuración gestionada por Ansible - SYSTECH DNS
listen-address=127.0.0.1,{{ ansible_default_ipv4.address | default('10.10.10.20') }}
bind-interfaces
server=8.8.8.8
server=8.8.4.4

# Dominio interno (RFC 9476 - reservado para redes privadas, no reservado para mDNS)
domain=lab.systech.internal
expand-hosts

# Leer hosts adicionales para resolución interna
addn-hosts=/etc/dnsmasq.hosts

# No reenviar consultas de dominios no enrutables
domain-needed
bogus-priv
