#!/bin/bash
# =============================================================================
# LAB BLOQUE 7 — SEGURIDAD (VERSIÓN COMPLETA Y FUNCIONAL)
# Rocky Linux 9 — Preparación RHCSA + LFCS
# =============================================================================

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'; NC='\033[0m'

echo ""
echo "================================================================"
echo "  LAB BLOQUE 7 — SEGURIDAD"
echo "  Rocky Linux 9 — Preparacion RHCSA + LFCS"
echo "================================================================"
echo ""

# =============================================================================
# VERIFICACIÓN INICIAL
# =============================================================================
echo -e "${YELLOW}[VERIFICANDO] Comprobando requisitos...${NC}"

# Verificar que somos root
if [ $EUID -ne 0 ]; then
    echo -e "${RED}ERROR: Este script debe ejecutarse como root${NC}"
    echo "Ejecuta: sudo $0"
    exit 1
fi

# Verificar Rocky Linux
if [ ! -f /etc/rocky-release ]; then
    echo -e "${YELLOW}ADVERTENCIA: No parece Rocky Linux, continuando...${NC}"
fi

echo -e "${GREEN}✓ Requisitos OK${NC}"
echo ""

# =============================================================================
# PASO 1: INSTALAR PAQUETES NECESARIOS
# =============================================================================
echo -e "${YELLOW}[1/7] Instalando paquetes necesarios...${NC}"

# Actualizar repositorios
dnf makecache -y > /dev/null 2>&1

# Instalar paquetes básicos
dnf install -y epel-release > /dev/null 2>&1

# Instalar todos los paquetes necesarios
dnf install -y \
    podman \
    httpd \
    policycoreutils \
    policycoreutils-python-utils \
    setools-console \
    setroubleshoot-server \
    audit \
    fail2ban \
    openssh-server \
    libpwquality \
    firewalld \
    > /dev/null 2>&1

echo -e "${GREEN}✓ Paquetes instalados${NC}"
echo ""

# =============================================================================
# PASO 2: CONFIGURAR SERVICIOS BÁSICOS
# =============================================================================
echo -e "${YELLOW}[2/7] Configurando servicios básicos...${NC}"

# Activar firewalld
systemctl start firewalld > /dev/null 2>&1
systemctl enable firewalld > /dev/null 2>&1

# Activar httpd
systemctl start httpd > /dev/null 2>&1
systemctl enable httpd > /dev/null 2>&1

# Activar auditd
systemctl start auditd > /dev/null 2>&1
systemctl enable auditd > /dev/null 2>&1

# Activar sshd
systemctl start sshd > /dev/null 2>&1
systemctl enable sshd > /dev/null 2>&1

echo -e "${GREEN}✓ Servicios configurados${NC}"
echo ""

# =============================================================================
# PASO 3: CONFIGURAR RED DE CONTENEDORES
# =============================================================================
echo -e "${YELLOW}[3/7] Configurando red de contenedores...${NC}"

# Crear red para contenedores si no existe
if ! podman network exists lab-network 2>/dev/null; then
    podman network create \
        --driver bridge \
        --subnet 172.20.0.0/24 \
        --gateway 172.20.0.1 \
        lab-network > /dev/null 2>&1
    echo -e "${GREEN}✓ Red lab-network creada${NC}"
else
    echo -e "${GREEN}✓ Red lab-network ya existe${NC}"
fi
echo ""

# =============================================================================
# PASO 4: CONFIGURAR ESCENARIOS DE SEGURIDAD (BUGS INTENCIONALES)
# =============================================================================
echo -e "${YELLOW}[4/7] Configurando escenarios de seguridad (bugs intencionales)...${NC}"

# ---- SELINUX ----
echo "  Configurando SELinux..."

# Directorio con contexto incorrecto
mkdir -p /srv/web_lab
echo "SELinux Lab Content - Corregir contexto" > /srv/web_lab/index.html
chcon -t default_t /srv/web_lab/index.html 2>/dev/null

# Configurar Apache para puerto 8080
echo "Listen 8080" > /etc/httpd/conf.d/ports_lab.conf

# Configurar VirtualHost
cat > /etc/httpd/conf.d/selinux_lab.conf << 'EOF'
<VirtualHost *:8080>
    DocumentRoot /srv/web_lab
    <Directory /srv/web_lab>
        Require all granted
    </Directory>
</VirtualHost>
EOF

# Configurar SELinux para puerto 8080
semanage port -a -t http_port_t -p tcp 8080 2>/dev/null || \
semanage port -m -t http_port_t -p tcp 8080 2>/dev/null

# Desactivar booleano (bug intencional)
setsebool -P httpd_can_network_connect off 2>/dev/null

# Reiniciar Apache
systemctl restart httpd 2>/dev/null

echo "  ✓ SELinux configurado"

# ---- USUARIOS Y SUDO ----
echo "  Configurando usuarios..."

# Crear usuarios
for user in devuser opsuser auditor; do
    if ! id $user &>/dev/null; then
        useradd -m $user 2>/dev/null
    fi
done

# Establecer contraseñas
echo "devuser:dev1234" | chpasswd 2>/dev/null
echo "opsuser:ops1234" | chpasswd 2>/dev/null
echo "auditor:aud1234" | chpasswd 2>/dev/null

# Bug intencional: devuser con sudo sin password
echo "devuser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/devuser
chmod 440 /etc/sudoers.d/devuser

echo "  ✓ Usuarios configurados"

# ---- PAM (POLÍTICAS DE CONTRASEÑAS) ----
echo "  Configurando políticas de contraseñas..."

# Backup
[ -f /etc/security/pwquality.conf ] && \
    cp /etc/security/pwquality.conf /etc/security/pwquality.conf.backup

# Política débil (bug intencional)
cat > /etc/security/pwquality.conf << 'EOF'
# POLÍTICA DÉBIL - BUG INTENCIONAL
minlen = 4
minclass = 1
maxrepeat = 5
dcredit = 0
ucredit = 0
lcredit = 0
ocredit = 0
EOF

# Configurar login.defs
if [ -f /etc/login.defs ]; then
    cp /etc/login.defs /etc/login.defs.backup
    sed -i 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS   999/' /etc/login.defs
    sed -i 's/^PASS_MIN_DAYS.*/PASS_MIN_DAYS    0/' /etc/login.defs
    sed -i 's/^PASS_MIN_LEN.*/PASS_MIN_LEN     4/' /etc/login.defs
fi

echo "  ✓ Políticas configuradas"

# ---- SSH (CONFIGURACIÓN INSEGURA) ----
echo "  Configurando SSH inseguro..."

if [ -f /etc/ssh/sshd_config ]; then
    cp /etc/ssh/sshd_config /etc/ssh/sshd_config.backup
    
    # Crear configuración insegura
    mkdir -p /etc/ssh/sshd_config.d
    cat > /etc/ssh/sshd_config.d/99-lab-insecure.conf << 'EOF'
# CONFIGURACIÓN INSEGURA - BUG INTENCIONAL
PermitRootLogin yes
PasswordAuthentication yes
MaxAuthTries 10
PermitEmptyPasswords yes
X11Forwarding yes
LogLevel INFO
EOF
    
    systemctl restart sshd 2>/dev/null
fi

echo "  ✓ SSH configurado"

# ---- PERMISOS ESPECIALES (SUID/SGID) ----
echo "  Configurando permisos especiales..."

# Directorio compartido sin sticky bit
mkdir -p /srv/shared_lab
chmod 777 /srv/shared_lab

# Binario con SUID innecesario
if [ -f /usr/bin/cat ]; then
    cp /usr/bin/cat /usr/local/bin/cat_lab
    chmod u+s /usr/local/bin/cat_lab
fi

# Directorio de grupo sin SGID
groupadd labgroup 2>/dev/null
usermod -aG labgroup devuser 2>/dev/null
usermod -aG labgroup opsuser 2>/dev/null
mkdir -p /srv/labgroup_dir
chown root:labgroup /srv/labgroup_dir
chmod 775 /srv/labgroup_dir

echo "  ✓ Permisos configurados"

# ---- FAIL2BAN (DESACTIVADO) ----
echo "  Configurando fail2ban..."

# Desactivar jails
mkdir -p /etc/fail2ban/jail.d
cat > /etc/fail2ban/jail.d/99-lab.conf << 'EOF'
# FAIL2BAN DESACTIVADO - BUG INTENCIONAL
[sshd]
enabled = false

[http-get-dos]
enabled = false
EOF

systemctl restart fail2ban 2>/dev/null || true

echo "  ✓ fail2ban configurado"

echo -e "${GREEN}✓ Escenarios de seguridad configurados${NC}"
echo ""

# =============================================================================
# PASO 5: CREAR CONTENEDORES
# =============================================================================
echo -e "${YELLOW}[5/7] Creando contenedores para el laboratorio...${NC}"

# Descargar imagen de Rocky Linux
echo "  Descargando imagen base (puede tardar un momento)..."
podman pull rockylinux/rockylinux:9 > /dev/null 2>&1
echo "  ✓ Imagen lista"

# Función para crear contenedor
crear_contenedor() {
    local nombre=$1
    local ip=$2
    local usuario=$3
    local herramientas=$4
    
    echo "  Creando $nombre ($ip)..."
    
    # Eliminar si existe
    podman rm -f $nombre 2>/dev/null
    
    # Crear contenedor
    podman run -d \
        --name $nombre \
        --network lab-network \
        --ip $ip \
        --hostname $nombre \
        --restart=always \
        rockylinux/rockylinux:9 \
        sleep infinity > /dev/null 2>&1
    
    if [ $? -eq 0 ]; then
        echo "    ✓ Contenedor creado"
        
        # Esperar un momento
        sleep 2
        
        # Instalar paquetes básicos
        echo "    Instalando herramientas básicas..."
        podman exec $nombre bash -c " \
            dnf install -y epel-release > /dev/null 2>&1 && \
            dnf install -y openssh-clients curl wget iproute iputils bind-utils vim $herramientas > /dev/null 2>&1" > /dev/null 2>&1
        
        # Crear usuario
        podman exec $nombre bash -c " \
            useradd $usuario 2>/dev/null && \
            echo '$usuario:lab1234' | chpasswd 2>/dev/null" > /dev/null 2>&1
        
        echo "    ✓ Configuración completada"
    else
        echo "    ${RED}✗ Error al crear contenedor${NC}"
    fi
}

# Crear contenedores
crear_contenedor "lab-client1" "172.20.0.10" "client1" ""
crear_contenedor "lab-client2" "172.20.0.20" "client2" ""
crear_contenedor "lab-attacker" "172.20.0.99" "attacker" "nmap netcat tcpdump"

echo -e "${GREEN}✓ Contenedores creados${NC}"
echo ""

# =============================================================================
# PASO 6: CONFIGURAR INICIO AUTOMÁTICO
# =============================================================================
echo -e "${YELLOW}[6/7] Configurando inicio automático...${NC}"

# Crear script de inicio
cat > /usr/local/bin/iniciar-lab.sh << 'EOF'
#!/bin/bash
# Iniciar contenedores del laboratorio

sleep 5

for contenedor in lab-client1 lab-client2 lab-attacker; do
    if podman ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^$contenedor$"; then
        if ! podman ps --format '{{.Names}}' 2>/dev/null | grep -q "^$contenedor$"; then
            podman start $contenedor 2>/dev/null
        fi
    fi
done
EOF

chmod +x /usr/local/bin/iniciar-lab.sh

# Crear servicio systemd
cat > /etc/systemd/system/lab-contenedores.service << 'EOF'
[Unit]
Description=Iniciar contenedores del laboratorio
After=network.target podman.service
Requires=podman.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/iniciar-lab.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

# Activar servicio
systemctl daemon-reload
systemctl enable lab-contenedores.service > /dev/null 2>&1
systemctl start lab-contenedores.service > /dev/null 2>&1

# Crear alias en .bashrc
cat >> /root/.bashrc << 'EOF'

# Alias para el laboratorio de seguridad
alias lab-client1='podman exec -it lab-client1 bash'
alias lab-client2='podman exec -it lab-client2 bash'
alias lab-attacker='podman exec -it lab-attacker bash'
alias lab-ps='podman ps -a'
alias lab-logs='podman logs -f'
alias lab-status='systemctl status lab-contenedores.service'
EOF

echo -e "${GREEN}✓ Inicio automático configurado${NC}"
echo ""

# =============================================================================
# PASO 7: VERIFICACIÓN FINAL
# =============================================================================
echo -e "${YELLOW}[7/7] Verificando instalación...${NC}"
echo ""

# Verificar servicios
echo "  Servicios del sistema:"
for servicio in httpd firewalld sshd auditd; do
    if systemctl is-active --quiet $servicio 2>/dev/null; then
        echo "    ${GREEN}✓${NC} $servicio: activo"
    else
        echo "    ${RED}✗${NC} $servicio: inactivo"
    fi
done

echo ""
echo "  Contenedores:"
for contenedor in lab-client1 lab-client2 lab-attacker; do
    if podman ps --format '{{.Names}}' 2>/dev/null | grep -q "^$contenedor$"; then
        ip=$(podman inspect $contenedor 2>/dev/null | grep IPAddress | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1)
        echo "    ${GREEN}✓${NC} $contenedor: $ip (activo)"
    else
        if podman ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^$contenedor$"; then
            echo "    ${YELLOW}⚠${NC} $contenedor: detenido"
        else
            echo "    ${RED}✗${NC} $contenedor: no existe"
        fi
    fi
done

# =============================================================================
# RESUMEN FINAL
# =============================================================================
echo ""
echo "================================================================"
echo -e "${GREEN}  LABORATORIO DE SEGURIDAD - COMPLETADO${NC}"
echo "================================================================"
echo ""
echo "📋 BUGS INTENCIONALES PARA PRACTICAR:"
echo ""
echo "  🔴 SELinux:"
echo "    - /srv/web_lab/index.html tiene contexto incorrecto (default_t)"
echo "    - httpd_can_network_connect=off"
echo ""
echo "  🔴 Usuarios y sudo:"
echo "    - devuser tiene NOPASSWD:ALL (inseguro)"
echo "    - opsuser y auditor sin permisos sudo"
echo ""
echo "  🔴 Políticas de contraseñas:"
echo "    - Longitud mínima: 4 caracteres"
echo "    - PASS_MAX_DAYS: 999 días"
echo ""
echo "  🔴 SSH:"
echo "    - PermitRootLogin yes"
echo "    - PermitEmptyPasswords yes"
echo ""
echo "  🔴 Permisos especiales:"
echo "    - /srv/shared_lab sin sticky bit"
echo "    - /usr/local/bin/cat_lab con SUID"
echo ""
echo "  🔴 fail2ban:"
echo "    - Jails desactivados"
echo ""
echo "🖥️  CONTENEDORES DISPONIBLES:"
echo "    lab-client1  → 172.20.0.10 (cliente normal)"
echo "    lab-client2  → 172.20.0.20 (cliente normal)"
echo "    lab-attacker → 172.20.0.99 (herramientas de ataque)"
echo ""
echo "🚀 COMANDOS ÚTILES (después de 'source /root/.bashrc'):"
echo "    lab-client1    - Acceder al cliente 1"
echo "    lab-client2    - Acceder al cliente 2"
echo "    lab-attacker   - Acceder al atacante"
echo "    lab-ps         - Ver contenedores"
echo "    lab-status     - Ver estado del servicio"
echo ""
echo "💾 BACKUPS CREADOS:"
echo "    /etc/ssh/sshd_config.backup"
echo "    /etc/security/pwquality.conf.backup"
echo "    /etc/login.defs.backup"
echo ""
echo "================================================================"
echo ""
echo -e "${YELLOW}Para empezar, ejecuta: source /root/.bashrc${NC}"
echo -e "${YELLOW}Luego: lab-client1 (para acceder al primer cliente)${NC}"
echo ""