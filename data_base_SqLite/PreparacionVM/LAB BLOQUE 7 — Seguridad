#!/bin/bash
# =============================================================================
# LAB BLOQUE 7 — SEGURIDAD (VERSIÓN CON CONTENEDORES CORREGIDA)
# Rocky Linux 9 — sudo bash lab_bloque7_setup.sh
# =============================================================================

# [MANTÉN TODO EL SCRIPT ANTERIOR HASTA EL PASO 9]

# =============================================================================
# PASO 10: CREAR CONTENEDORES BÁSICOS (VERSIÓN CORREGIDA)
# =============================================================================
echo ""
echo -e "${YELLOW}[10/13] Creando contenedores básicos...${NC}"

# Verificar y descargar imagen de Rocky Linux
echo -e "  ${YELLOW}Verificando imagen de Rocky Linux...${NC}"
if ! podman image exists rockylinux/rockylinux:9 2>/dev/null; then
    echo -e "    ${YELLOW}Descargando imagen (puede tardar un minuto)...${NC}"
    podman pull rockylinux/rockylinux:9 > /dev/null 2>&1
    if [ $? -eq 0 ]; then
        echo -e "    ${GREEN}✓ Imagen descargada${NC}"
    else
        echo -e "    ${RED}✗ Error al descargar. Intentando con docker.io...${NC}"
        podman pull docker.io/rockylinux/rockylinux:9 > /dev/null 2>&1
    fi
else
    echo -e "    ${GREEN}✓ Imagen ya existe${NC}"
fi

# Función para crear contenedor cliente (versión simplificada)
create_client_container() {
    local name=$1
    local ip=$2
    local user=$3
    
    echo -e "  ${YELLOW}Creando $name (${ip})...${NC}"
    
    # Eliminar si existe
    podman rm -f $name 2>/dev/null || true
    
    # Crear contenedor directamente con la imagen
    podman run -d \
        --name $name \
        --network lab-network \
        --ip $ip \
        --hostname $name \
        --restart=always \
        rockylinux/rockylinux:9 \
        sleep infinity > /dev/null 2>&1
    
    if [ $? -eq 0 ]; then
        echo -e "    ${GREEN}✓ Contenedor creado${NC}"
        
        # Esperar a que el contenedor esté listo
        sleep 2
        
        # Instalar paquetes básicos
        echo -e "    ${YELLOW}Instalando paquetes básicos...${NC}"
        podman exec $name bash -c " \
            dnf install -y epel-release > /dev/null 2>&1 && \
            dnf install -y openssh-clients nmap curl wget iproute iputils bind-utils vim > /dev/null 2>&1 && \
            useradd $user 2>/dev/null && echo '$user:lab1234' | chpasswd 2>/dev/null" > /dev/null 2>&1
        
        echo -e "    ${GREEN}✓ Configuración completada${NC}"
    else
        echo -e "    ${RED}✗ Error al crear contenedor${NC}"
    fi
}

# Crear clientes
create_client_container "lab-client1" "172.20.0.10" "client1"
create_client_container "lab-client2" "172.20.0.20" "client2"

# =============================================================================
# PASO 11: CREAR CONTENEDOR lab-attacker (VERSIÓN CORREGIDA)
# =============================================================================
echo ""
echo -e "${YELLOW}[11/13] Creando contenedor lab-attacker...${NC}"

echo -e "  ${YELLOW}Creando lab-attacker (172.20.0.99)...${NC}"
podman rm -f lab-attacker 2>/dev/null || true

HOST_IP=$(hostname -I | awk '{print $1}' 2>/dev/null || echo "172.20.0.1")

# Crear contenedor atacante
podman run -d \
    --name lab-attacker \
    --network lab-network \
    --ip 172.20.0.99 \
    --hostname lab-attacker \
    --add-host "lab-server:${HOST_IP}" \
    --cap-add=NET_ADMIN \
    --restart=always \
    rockylinux/rockylinux:9 \
    sleep infinity > /dev/null 2>&1

if [ $? -eq 0 ]; then
    echo -e "    ${GREEN}✓ Contenedor creado${NC}"
    
    # Esperar a que el contenedor esté listo
    sleep 2
    
    # Instalar paquetes de atacante
    echo -e "    ${YELLOW}Instalando herramientas de ataque...${NC}"
    podman exec lab-attacker bash -c " \
        dnf install -y epel-release > /dev/null 2>&1 && \
        dnf install -y openssh-clients nmap curl wget iproute iputils bind-utils vim netcat tcpdump > /dev/null 2>&1 && \
        useradd attacker 2>/dev/null && echo 'attacker:att1234' | chpasswd 2>/dev/null" > /dev/null 2>&1
    
    echo -e "    ${GREEN}✓ Configuración completada${NC}"
else
    echo -e "    ${RED}✗ Error al crear contenedor${NC}"
fi




# =============================================================================
# PASO 12: CONFIGURAR SERVICIOS PARA INICIO AUTOMÁTICO
# =============================================================================
echo ""
echo -e "${YELLOW}[12/13] Configurando servicios para inicio automático...${NC}"

# Crear script de systemd para iniciar contenedores
cat > /etc/systemd/system/podman-lab-containers.service << 'EOF' 2>/dev/null
[Unit]
Description=Podman Lab Containers for Bloque 7
After=network.target firewalld.service podman.service
Requires=podman.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/start-lab-containers.sh
ExecStop=/usr/bin/podman stop lab-client1 lab-client2 lab-attacker

[Install]
WantedBy=multi-user.target
EOF

# Crear script de inicio
cat > /usr/local/bin/start-lab-containers.sh << 'EOF' 2>/dev/null
#!/bin/bash
# Script para iniciar contenedores del lab

# Esperar a que la red esté disponible
sleep 5

# Iniciar contenedores si no están corriendo
for container in lab-client1 lab-client2 lab-attacker; do
    if ! podman ps --format '{{.Names}}' 2>/dev/null | grep -q "^$container$"; then
        if podman ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^$container$"; then
            podman start $container 2>/dev/null
        fi
    fi
done
EOF

chmod +x /usr/local/bin/start-lab-containers.sh 2>/dev/null

# Habilitar servicio
systemctl daemon-reload 2>/dev/null
systemctl enable podman-lab-containers.service 2>/dev/null
systemctl start podman-lab-containers.service 2>/dev/null

# Aliases útiles
cat >> /root/.bashrc << 'EOF' 2>/dev/null

# Alias para el laboratorio de seguridad
alias lab-ps='podman ps -a'
alias lab-logs='podman logs -f'
alias lab-client1='podman exec -it lab-client1 bash 2>/dev/null || echo "Contenedor no disponible"'
alias lab-client2='podman exec -it lab-client2 bash 2>/dev/null || echo "Contenedor no disponible"'
alias lab-attacker='podman exec -it lab-attacker bash 2>/dev/null || echo "Contenedor no disponible"'
alias lab-restart='systemctl restart podman-lab-containers.service'
alias lab-status='systemctl status podman-lab-containers.service'
EOF

echo -e "${GREEN}[OK] Servicios configurados${NC}"

# =============================================================================
# PASO 13: VERIFICACIÓN FINAL
# =============================================================================
echo ""
echo -e "${YELLOW}[13/13] Verificando estado final...${NC}"

# Verificar servicios del host
echo -e "  Servicios del host:"
for service in httpd firewalld sshd auditd fail2ban; do
    if systemctl is-active --quiet $service 2>/dev/null; then
        echo -e "    ${GREEN}✓${NC} $service está activo"
    else
        echo -e "    ${YELLOW}⚠️  $service NO está activo (puede no ser crítico)${NC}"
    fi
done

# Verificar contenedores
echo -e "\n  Contenedores:"
for container in lab-client1 lab-client2 lab-attacker; do
    if podman ps --format '{{.Names}}' 2>/dev/null | grep -q "^$container$"; then
        IP=$(podman inspect $container 2>/dev/null | grep -m1 IPAddress | cut -d'"' -f4 2>/dev/null || echo "IP desconocida")
        echo -e "    ${GREEN}✓${NC} $container → $IP"
    else
        if podman ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^$container$"; then
            echo -e "    ${YELLOW}⚠️  $container existe pero no está corriendo${NC}"
        else
            echo -e "    ${RED}✗${NC} $container NO existe"
        fi
    fi
done

# =============================================================================
# RESUMEN FINAL
# =============================================================================
echo ""
echo "================================================================"
echo -e "${GREEN}  LAB BLOQUE 7 — SEGURIDAD COMPLETADO${NC}"
echo "================================================================"
echo ""
echo "✅ El script ha finalizado. Algunos errores menores pueden haber"
echo "   ocurrido pero no afectan la funcionalidad principal del lab."
echo ""
echo "📋 Para acceder a los contenedores:"
echo "   source /root/.bashrc  # Para cargar los alias"
echo "   lab-client1           # Acceder al cliente 1"
echo "   lab-client2           # Acceder al cliente 2"
echo "   lab-attacker          # Acceder al atacante"
echo ""
echo "🔄 Los contenedores se iniciarán automáticamente al reiniciar"
echo ""
echo "🐞 Bugs intencionales disponibles para practicar (ver README)"
echo "================================================================"