#!/bin/bash
# =============================================================================
# LAB BLOQUE 8 — CONTENEDORES (PODMAN + DOCKER)
# Rocky Linux 9 — sudo bash lab_bloque8_setup.sh
# Preparación RHCSA + LFCS
# =============================================================================

# set -e

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'; NC='\033[0m'

echo ""
echo "================================================================"
echo "  LAB BLOQUE 8 — CONTENEDORES PODMAN + DOCKER"
echo "  Rocky Linux 9 — Preparacion RHCSA + LFCS"
echo "================================================================"
echo ""

# =============================================================================
# PASO 0: VERIFICACIONES
# =============================================================================
echo -e "${YELLOW}[0/10] Verificando prerequisitos...${NC}"

[[ $EUID -ne 0 ]] && echo -e "${RED}ERROR: Ejecutar como root.${NC}" && exit 1

# Detectar usuario no-root para ejercicios rootless
SUDO_USER_HOME=$(eval echo ~${SUDO_USER})
LAB_USER=${SUDO_USER:-$(logname 2>/dev/null || echo "labuser")}

echo -e "  Usuario de laboratorio detectado: ${BLUE}${LAB_USER}${NC}"
echo -e "${GREEN}[OK] Prerequisitos verificados${NC}"

# =============================================================================
# PASO 1: INSTALAR PODMAN
# =============================================================================
echo ""
echo -e "${YELLOW}[1/10] Verificando e instalando Podman...${NC}"

if ! command -v podman &>/dev/null; then
    echo "  Instalando Podman..."
    dnf install -y podman podman-compose podman-docker > /dev/null 2>&1
    echo -e "  ${GREEN}[OK]${NC} Podman instalado"
else
    echo -e "  ${GREEN}[OK]${NC} Podman ya instalado: $(podman --version)"
fi

# Instalar herramientas adicionales de Podman
dnf install -y \
    podman-compose \
    buildah \
    skopeo \
    > /dev/null 2>&1 || true

echo -e "${GREEN}[OK] Podman y herramientas listas${NC}"

# =============================================================================
# PASO 2: INSTALAR DOCKER CE
# =============================================================================
echo ""
echo -e "${YELLOW}[2/10] Verificando e instalando Docker CE...${NC}"

if ! command -v docker &>/dev/null; then
    echo "  Añadiendo repositorio Docker CE..."

    # Eliminar conflictos previos
    dnf remove -y docker docker-client docker-client-latest \
        docker-common docker-latest docker-latest-logrotate \
        docker-logrotate docker-engine 2>/dev/null || true

    # Añadir repo oficial Docker
    dnf install -y dnf-plugins-core > /dev/null 2>&1
    dnf config-manager --add-repo \
        https://download.docker.com/linux/centos/docker-ce.repo \
        > /dev/null 2>&1

    # Instalar Docker CE
    dnf install -y \
        docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin \
        > /dev/null 2>&1

    echo -e "  ${GREEN}[OK]${NC} Docker CE instalado"
else
    echo -e "  ${GREEN}[OK]${NC} Docker ya instalado: $(docker --version)"
fi

# Iniciar y habilitar Docker
systemctl enable docker --now > /dev/null 2>&1
echo -e "${GREEN}[OK] Docker CE listo${NC}"

# =============================================================================
# PASO 3: CONFIGURAR COEXISTENCIA PODMAN + DOCKER
# =============================================================================
echo ""
echo -e "${YELLOW}[3/10] Configurando coexistencia Podman + Docker...${NC}"

# Evitar que podman-docker interfiera con docker real
# podman-docker crea un alias 'docker' -> podman
# Lo desactivamos para que el docker real tenga prioridad
if rpm -q podman-docker &>/dev/null; then
    # El wrapper de podman-docker está en /usr/bin/docker
    # Docker CE instala el suyo en el mismo path — dnf resuelve esto
    # Verificar cuál está activo
    DOCKER_BIN=$(which docker)
    echo -e "  Docker binario activo: ${BLUE}${DOCKER_BIN}${NC}"
fi

# Configurar usuario LAB_USER para usar Docker sin sudo
usermod -aG docker "${LAB_USER}" 2>/dev/null || true

# Configurar Podman rootless para LAB_USER
loginctl enable-linger "${LAB_USER}" 2>/dev/null || true

# Configurar subuid/subgid para rootless
if ! grep -q "^${LAB_USER}:" /etc/subuid 2>/dev/null; then
    echo "${LAB_USER}:100000:65536" >> /etc/subuid
fi
if ! grep -q "^${LAB_USER}:" /etc/subgid 2>/dev/null; then
    echo "${LAB_USER}:100000:65536" >> /etc/subgid
fi

echo -e "${GREEN}[OK] Coexistencia configurada${NC}"

# =============================================================================
# PASO 4: CREAR IMAGENES BASE PARA EJERCICIOS
# =============================================================================
echo ""
echo -e "${YELLOW}[4/10] Creando imagenes y Dockerfiles de practica...${NC}"

mkdir -p /opt/lab_bloque8/{dockerfiles,compose,volumes,scripts}

# --- Imagen 1: app-web simple ---
cat > /opt/lab_bloque8/dockerfiles/Dockerfile.web << 'EOF'
FROM rockylinux/rockylinux:9
RUN dnf install -y httpd && dnf clean all
RUN echo "Lab Bloque 8 - Web App" > /var/www/html/index.html
EXPOSE 80
CMD ["/usr/sbin/httpd", "-D", "FOREGROUND"]
EOF

# --- Imagen 2: app-web con bug (puerto no expuesto) ---
cat > /opt/lab_bloque8/dockerfiles/Dockerfile.web-bug << 'EOF'
FROM rockylinux/rockylinux:9
RUN dnf install -y httpd && dnf clean all
RUN echo "Lab Bloque 8 - Web App Bug" > /var/www/html/index.html
# Bug intencional: EXPOSE comentado — el puerto no esta documentado
# EXPOSE 80
CMD ["/usr/sbin/httpd", "-D", "FOREGROUND"]
EOF

# --- Imagen 3: app con volumen ---
cat > /opt/lab_bloque8/dockerfiles/Dockerfile.data << 'EOF'
FROM rockylinux/rockylinux:9
RUN dnf install -y vim && dnf clean all
RUN mkdir -p /data
VOLUME ["/data"]
CMD ["/bin/bash", "-c", "sleep infinity"]
EOF

# --- Imagen 4: Containerfile para Podman (RHCSA style) ---
cat > /opt/lab_bloque8/dockerfiles/Containerfile.rhcsa << 'EOF'
FROM ubi8/ubi-minimal
RUN microdnf install -y curl && microdnf clean all
LABEL maintainer="lab@rhcsa.local"
LABEL description="RHCSA Lab Container"
ENV APP_ENV=lab
ENV APP_PORT=8080
EXPOSE 8080
CMD ["/bin/bash", "-c", "while true; do echo RHCSA Lab running; sleep 30; done"]
EOF

# --- Imagen 5: Containerfile con bug (CMD incorrecto) ---
cat > /opt/lab_bloque8/dockerfiles/Containerfile.bug << 'EOF'
FROM rockylinux/rockylinux:9
RUN dnf install -y nginx && dnf clean all
EXPOSE 80
# Bug intencional: comando inexistente — el contenedor crasheará
CMD ["/usr/sbin/nginx-lab", "-g", "daemon off;"]
EOF

# Construir imagenes que se usaran en los ejercicios
echo -e "  ${YELLOW}Construyendo imagen lab-web:latest...${NC}"
docker build -t lab-web:latest \
    -f /opt/lab_bloque8/dockerfiles/Dockerfile.web \
    /opt/lab_bloque8/dockerfiles/ -q 2>/dev/null || true

echo -e "  ${YELLOW}Construyendo imagen lab-data:latest con Podman...${NC}"
podman build -t lab-data:latest \
    -f /opt/lab_bloque8/dockerfiles/Dockerfile.data \
    /opt/lab_bloque8/dockerfiles/ -q 2>/dev/null || true

echo -e "${GREEN}[OK] Imagenes y Dockerfiles creados en /opt/lab_bloque8/dockerfiles/${NC}"

# =============================================================================
# PASO 5: CREAR ESCENARIOS DE REDES
# =============================================================================
echo ""
echo -e "${YELLOW}[5/10] Creando redes de practica...${NC}"

# Red Docker para ejercicios
docker network rm lab-bridge 2>/dev/null || true
docker network create \
    --driver bridge \
    --subnet 192.168.50.0/24 \
    --gateway 192.168.50.1 \
    lab-bridge 2>/dev/null || true

# Red Podman para ejercicios
podman network rm lab-podman-net 2>/dev/null || true
podman network create \
    --driver bridge \
    --subnet 192.168.60.0/24 \
    --gateway 192.168.60.1 \
    lab-podman-net 2>/dev/null || true

echo -e "${GREEN}[OK] Redes lab-bridge (Docker) y lab-podman-net (Podman) creadas${NC}"

# =============================================================================
# PASO 6: CREAR VOLUMENES DE PRACTICA
# =============================================================================
echo ""
echo -e "${YELLOW}[6/10] Creando volumenes de practica...${NC}"

# Volúmenes Docker
docker volume rm lab-vol-data lab-vol-config 2>/dev/null || true
docker volume create lab-vol-data
docker volume create lab-vol-config

# Poblar volumen con datos de prueba
docker run --rm \
    -v lab-vol-data:/data \
    rockylinux/rockylinux:9 \
    bash -c "echo 'datos persistentes lab bloque 8' > /data/test.txt" \
    2>/dev/null || true

# Bind mount directory
mkdir -p /opt/lab_bloque8/volumes/bindmount
echo "archivo bind mount" > /opt/lab_bloque8/volumes/bindmount/data.txt

echo -e "${GREEN}[OK] Volumenes Docker creados${NC}"

# =============================================================================
# PASO 7: CREAR ESCENARIO DOCKER COMPOSE
# =============================================================================
echo ""
echo -e "${YELLOW}[7/10] Creando escenarios Docker Compose...${NC}"

# Compose funcional
cat > /opt/lab_bloque8/compose/docker-compose.yml << 'EOF'
version: '3.8'

services:
  web:
    image: rockylinux/rockylinux:9
    container_name: lab-compose-web
    command: >
      bash -c "dnf install -y httpd -q &&
               echo 'Compose Lab Web' > /var/www/html/index.html &&
               httpd -D FOREGROUND"
    ports:
      - "8081:80"
    networks:
      - lab-compose-net
    volumes:
      - web-data:/var/www/html
    restart: unless-stopped

  db:
    image: rockylinux/rockylinux:9
    container_name: lab-compose-db
    command: bash -c "sleep infinity"
    networks:
      - lab-compose-net
    volumes:
      - db-data:/data
    restart: unless-stopped

networks:
  lab-compose-net:
    driver: bridge

volumes:
  web-data:
  db-data:
EOF

# Compose con bug (imagen inexistente)
cat > /opt/lab_bloque8/compose/docker-compose-bug.yml << 'EOF'
version: '3.8'

services:
  web:
    # Bug intencional: imagen que no existe
    image: lab-imagen-inexistente:999
    container_name: lab-compose-bug
    ports:
      - "8082:80"

  db:
    image: rockylinux/rockylinux:9
    container_name: lab-compose-db-bug
    # Bug intencional: puerto duplicado con el compose funcional
    command: bash -c "sleep infinity"
EOF

# Podman Compose
cat > /opt/lab_bloque8/compose/podman-compose.yml << 'EOF'
version: '3.8'

services:
  app:
    image: rockylinux/rockylinux:9
    container_name: lab-podman-compose-app
    command: bash -c "sleep infinity"
    volumes:
      - /opt/lab_bloque8/volumes/bindmount:/mnt/data:Z
EOF

echo -e "${GREEN}[OK] Archivos Compose creados en /opt/lab_bloque8/compose/${NC}"

# =============================================================================
# PASO 8: CREAR UNIDADES SYSTEMD PARA PODMAN (RHCSA)
# =============================================================================
echo ""
echo -e "${YELLOW}[8/10] Creando escenarios systemd + Podman...${NC}"

mkdir -p /etc/systemd/system

# Contenedor Podman de práctica para generar unidad systemd
podman rm -f lab-systemd-app 2>/dev/null || true
podman run -d \
    --name lab-systemd-app \
    --restart always \
    rockylinux/rockylinux:9 \
    bash -c "sleep infinity" 2>/dev/null || true

# Generar unidad systemd desde el contenedor
podman generate systemd \
    --name lab-systemd-app \
    --files \
    --new 2>/dev/null || true

# Mover la unidad generada al directorio correcto
mv container-lab-systemd-app.service \
    /etc/systemd/system/ 2>/dev/null || true

# Unidad systemd con bug (ExecStart incorrecto)
cat > /etc/systemd/system/lab-container-bug.service << 'EOF'
[Unit]
Description=Lab Container Bug — Bloque 8
After=network.target

[Service]
# Bug intencional: comando incorrecto
ExecStart=/usr/bin/podman run --name lab-bug-container \
    rockylinux/rockylinux:9 \
    /usr/bin/comando-inexistente
ExecStop=/usr/bin/podman stop lab-bug-container
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload

echo -e "${GREEN}[OK] Unidades systemd creadas${NC}"

# =============================================================================
# PASO 9: CONFIGURAR PODMAN ROOTLESS PARA LAB_USER
# =============================================================================
echo ""
echo -e "${YELLOW}[9/10] Configurando Podman rootless...${NC}"

# Crear directorio de configuración para el usuario
mkdir -p "${SUDO_USER_HOME}/.config/containers"

# Configuración de registros para el usuario
cat > "${SUDO_USER_HOME}/.config/containers/registries.conf" << 'EOF'
[registries.search]
registries = ['docker.io', 'registry.access.redhat.com', 'quay.io']

[registries.insecure]
registries = []

[registries.block]
registries = []
EOF

chown -R "${LAB_USER}:${LAB_USER}" \
    "${SUDO_USER_HOME}/.config" 2>/dev/null || true

# Script de verificación rootless para el usuario
cat > /opt/lab_bloque8/scripts/test-rootless.sh << 'EOF'
#!/bin/bash
# Ejecutar como usuario normal (NO root)
echo "=== Test Podman Rootless ==="
echo "Usuario actual: $(whoami)"
echo "UID: $(id -u)"
podman run --rm rockylinux/rockylinux:9 \
    bash -c "echo 'Rootless funciona correctamente'"
podman info | grep -E "rootless|cgroupVersion"
EOF
chmod +x /opt/lab_bloque8/scripts/test-rootless.sh

echo -e "${GREEN}[OK] Podman rootless configurado para ${LAB_USER}${NC}"

# =============================================================================
# PASO 10: INYECTAR BUGS PARA TROUBLESHOOTING
# =============================================================================
echo ""
echo -e "${YELLOW}[10/10] Inyectando bugs para ejercicios de troubleshooting...${NC}"

# Bug 1: Contenedor Docker con nombre duplicado
docker rm -f lab-bug-duplicate 2>/dev/null || true
docker run -d --name lab-bug-duplicate \
    rockylinux/rockylinux:9 \
    bash -c "sleep infinity" 2>/dev/null || true

# Bug 2: Contenedor Podman con volumen montado con permisos incorrectos
mkdir -p /opt/lab_bloque8/volumes/broken
chmod 000 /opt/lab_bloque8/volumes/broken
podman rm -f lab-bug-volume 2>/dev/null || true

# Bug 3: Red Docker eliminada con contenedor huérfano
docker network rm lab-orphan-net 2>/dev/null || true
docker network create lab-orphan-net 2>/dev/null || true
docker rm -f lab-bug-orphan 2>/dev/null || true
docker run -d \
    --name lab-bug-orphan \
    --network lab-orphan-net \
    rockylinux/rockylinux:9 \
    bash -c "sleep infinity" 2>/dev/null || true
# Desconectar el contenedor de la red para crear huérfano
docker network disconnect lab-orphan-net \
    lab-bug-orphan 2>/dev/null || true

# Bug 4: Imagen con tag incorrecto
docker tag lab-web:latest lab-web:broken 2>/dev/null || true
docker rmi lab-web:latest 2>/dev/null || true

# Bug 5: Contenedor con restart policy incorrecta
docker rm -f lab-bug-restart 2>/dev/null || true
docker run -d \
    --name lab-bug-restart \
    --restart no \
    rockylinux/rockylinux:9 \
    bash -c "exit 1" 2>/dev/null || true

echo -e "${GREEN}[OK] Bugs inyectados${NC}"

# =============================================================================
# RESUMEN FINAL
# =============================================================================
echo ""
echo "================================================================"
echo -e "${GREEN}  LAB BLOQUE 8 — CONTENEDORES COMPLETADO${NC}"
echo "================================================================"
echo ""
echo "HERRAMIENTAS INSTALADAS:"
echo "  Podman  : $(podman --version 2>/dev/null)"
echo "  Docker  : $(docker --version 2>/dev/null)"
echo "  Buildah : $(buildah --version 2>/dev/null | head -1)"
echo "  Skopeo  : $(skopeo --version 2>/dev/null)"
echo ""
echo "RECURSOS CREADOS:"
echo ""
echo "  Dockerfiles y Containerfiles:"
echo "    /opt/lab_bloque8/dockerfiles/Dockerfile.web"
echo "    /opt/lab_bloque8/dockerfiles/Dockerfile.web-bug"
echo "    /opt/lab_bloque8/dockerfiles/Dockerfile.data"
echo "    /opt/lab_bloque8/dockerfiles/Containerfile.rhcsa"
echo "    /opt/lab_bloque8/dockerfiles/Containerfile.bug"
echo ""
echo "  Imagenes construidas:"
echo "    lab-web:broken  (Docker — tag correcto eliminado)"
echo "    lab-data:latest (Podman)"
echo ""
echo "  Redes:"
echo "    lab-bridge      (Docker  — 192.168.50.0/24)"
echo "    lab-podman-net  (Podman  — 192.168.60.0/24)"
echo ""
echo "  Volumenes Docker:"
echo "    lab-vol-data    (con datos de prueba)"
echo "    lab-vol-config  (vacio)"
echo ""
echo "  Compose:"
echo "    /opt/lab_bloque8/compose/docker-compose.yml"
echo "    /opt/lab_bloque8/compose/docker-compose-bug.yml"
echo "    /opt/lab_bloque8/compose/podman-compose.yml"
echo ""
echo "  Systemd:"
echo "    /etc/systemd/system/container-lab-systemd-app.service"
echo "    /etc/systemd/system/lab-container-bug.service"
echo ""
echo "BUGS INTENCIONALES:"
echo "  [1] lab-bug-duplicate  → nombre duplicado en Docker"
echo "  [2] /volumes/broken    → permisos 000 en bind mount"
echo "  [3] lab-bug-orphan     → contenedor sin red asignada"
echo "  [4] lab-web:latest     → tag eliminado, solo existe :broken"
echo "  [5] lab-bug-restart    → restart=no en contenedor que falla"
echo "  [6] Containerfile.bug  → CMD con binario inexistente"
echo "  [7] docker-compose-bug → imagen inexistente en compose"
echo "  [8] lab-container-bug  → ExecStart incorrecto en systemd"
echo ""
echo "PARA EJERCICIOS ROOTLESS:"
echo "  Ejecutar como ${LAB_USER} (no root):"
echo "  bash /opt/lab_bloque8/scripts/test-rootless.sh"
echo ""
echo "DIRECTORIO PRINCIPAL DEL LAB:"
echo "  /opt/lab_bloque8/"
echo ""
echo "================================================================"
echo "  Los 40 ejercicios del Bloque 8 estan listos."
echo "================================================================"