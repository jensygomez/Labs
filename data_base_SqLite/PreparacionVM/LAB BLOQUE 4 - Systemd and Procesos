# -----------------------------------------------------------------------------
# Script que atrapa señales y muestra mensaje
# -----------------------------------------------------------------------------
cat > /usr/local/lib/lab-services/signal-handler.sh << 'EOF'
#!/bin/bash
# Atrapa señales y muestra mensaje
trap 'echo "Recibida SIGINT (Ctrl+C) - Ignorando"' INT
trap 'echo "Recibida SIGTERM - Ignorando, usa SIGKILL"' TERM
trap 'echo "Recibida SIGHUP - Recargando configuración (simulado)"' HUP
trap 'echo "Recibida SIGUSR1 - Estadísticas"; ps -p $$ -o pid,ppid,pri,ni,cmd' USR1
trap 'echo "Recibida SIGUSR2 - Log rotado (simulado)"' USR2

echo "PID: $$ - Manejador de señales. Envía señales para probar:"
echo "kill -HUP $$  (SIGHUP - recarga)"
echo "kill -USR1 $$ (SIGUSR1 - estadísticas)"
echo "kill -USR2 $$ (SIGUSR2 - rotar logs)"
echo "kill -TERM $$ (SIGTERM - ignorado)"
echo "kill -KILL $$ (SIGKILL - forzar terminación)"
while true; do
    sleep 10
done
EOF
chmod +x /usr/local/lib/lab-services/signal-handler.sh

