#!/bin/bash
# Script para diagnosticar el laboratorio - NO SOLUCIONA, SOLO MUESTRA
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "=== DIAGNÓSTICO DEL LABORATORIO SYSTEMD ==="
echo ""

echo "1. SERVICIOS FALLIDOS:"
systemctl --failed
echo ""

echo "2. UNIDADES CON ERRORES:"
systemctl list-units --state=failed --all --no-legend | awk '{print $1}'
echo ""

echo "3. TIMERS ACTIVOS:"
systemctl list-timers --all | head -20
echo ""

echo "4. DEPENDENCIAS DE LAB-DEPEND-A:"
systemctl list-dependencies lab-depend-a.service 2>/dev/null || echo "lab-depend-a.service no encontrado"
echo ""

echo "5. PROCESOS DESTACADOS:"
ps aux | grep -E "sleep|lab-services|hog|zombie" | grep -v grep
echo ""

echo "6. LOGS RECIENTES DE LAB:"
journalctl -u lab-* --since "5 minutes ago" --no-pager | tail -20
echo ""

echo "=== FIN DEL DIAGNÓSTICO ==="
echo "Usa los comandos de systemd y procesos para investigar más."
EOF
chmod +x /usr/local/bin/check-systemd-lab.sh

