#!/bin/bash
# Genera logs de diferentes prioridades
i=0
while true; do
    i=$((i + 1))
    logger -p user.info "Lab log generator: info message $i"
    if [ $((i % 10)) -eq 0 ]; then
        logger -p user.warning "Lab log generator: warning message $i"
    fi
    if [ $((i % 20)) -eq 0 ]; then
        logger -p user.err "Lab log generator: error message $i"
    fi
    sleep 5
done
EOF
