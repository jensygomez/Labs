#!/bin/bash
# =============================================================================
# LAB BLOQUE 4 — SYSTEMD Y PROCESOS
# Preparación para LFCS + RHCSA
# Rocky Linux 9 — Ejecutar como root
# =============================================================================
#
# OBJETIVO
# --------
# Preparar un entorno REALISTA para practicar administración de systemd y
# procesos en Linux, alineado con los objetivos oficiales de LFCS y RHCSA.
#
# Este script:
# - NO explica
# - NO sugiere ejercicios
# - NO deja documentación operativa en el sistema
#
# El alumno deberá inspeccionar el estado del sistema, diagnosticar problemas
# y corregir las configuraciones erróneas.
#
# ---------------------------------------------------------------------------
# ESTADO INICIAL DE LA VM
# ---------------------------------------------------------------------------
# Servicios personalizados con errores:
#   - Unidades que fallan al iniciar (dependency, ExecStart incorrecto)
#   - Unidades sin install (WantedBy)
#   - Unidades con permisos incorrectos
#   - Timers mal configurados
#   - Targets personalizados con dependencias rotas
#
# Procesos con problemas:
#   - Procesos zombies (simulados)
#   - Procesos con alta carga CPU (simulado)
#   - Procesos con nice incorrecto
#   - Procesos huérfanos (simulados)
#
# ---------------------------------------------------------------------------
# TEMAS CUBIERTOS
# ---------------------------------------------------------------------------
# - systemctl (start, stop, enable, disable, status, is-active)
# - journalctl (logs, filtros, boots)
# - Analizar unidades (dependencias, condiciones)
# - Crear y modificar servicios personalizados
# - Timers systemd (alternativa a cron)
# - Targets (runlevels) personalizados
# - Procesos: ps, top, htop, nice, renice, kill, pkill
# - Señales (SIGTERM, SIGKILL, SIGHUP)
# - Jobs en foreground/background (jobs, bg, fg)
# - NoHUP, disown
#
# =============================================================================

set -e

# -----------------------------------------------------------------------------
# VERIFICACIÓN
# -----------------------------------------------------------------------------
[[ $EUID -eq 0 ]] || { echo "Ejecutar como root"; exit 1; }

# -----------------------------------------------------------------------------
# VARIABLES
# -----------------------------------------------------------------------------
BACKUP_DIR="/root/lab_backups_bloque4_$(date +%Y%m%d_%H%M%S)"
UNIT_DIR="/etc/systemd/system"
ok() { echo "✅ $1"; }


# =============================================================================
# 1. VERIFICACIONES Y BACKUPS
# =============================================================================
echo "🔍 Verificando entorno..."

# Verificar Rocky Linux
if ! grep -q "Rocky Linux" /etc/os-release 2>/dev/null; then
    echo "⚠️  Este script fue diseñado para Rocky Linux 9"
    read -p "¿Continuar de todas formas? (s/N): " -n 1 -r
    echo
    [[ $REPLY =~ ^[Ss]$ ]] || exit 1
fi

# Crear backups
mkdir -p "$BACKUP_DIR"
echo "📦 Creando backup en: $BACKUP_DIR"

# Backup de unidades systemd existentes (solo las que vamos a tocar)
for unit in lab-*.service lab-*.timer lab-*.target; do
    [ -f "$UNIT_DIR/$unit" ] && cp "$UNIT_DIR/$unit" "$BACKUP_DIR/" 2>/dev/null || true
done

# Backup de configuraciones de logind
[ -f /etc/systemd/logind.conf ] && cp /etc/systemd/logind.conf "$BACKUP_DIR/"

ok "Backups guardados en $BACKUP_DIR"

# =============================================================================
# 2. INSTALAR PAQUETES NECESARIOS
# =============================================================================
echo "📦 Instalando paquetes necesarios..."
dnf install -y psmisc stress-ng htop iotop sysstat 2>/dev/null || true
ok "Paquetes instalados"

# =============================================================================
# 3. LIMPIEZA DE LABORATORIOS ANTERIORES
# =============================================================================
echo "🧹 Limpiando configuraciones anteriores..."

# Detener y deshabilitar servicios de laboratorio previos
for unit in $(systemctl list-unit-files | grep -E "lab-.*\.service" | awk '{print $1}'); do
    systemctl stop "$unit" 2>/dev/null || true
    systemctl disable "$unit" 2>/dev/null || true
done

# Eliminar unidades anteriores
rm -f "$UNIT_DIR"/lab-*.service "$UNIT_DIR"/lab-*.timer "$UNIT_DIR"/lab-*.target 2>/dev/null || true
systemctl daemon-reload

ok "Entorno limpio para nuevo laboratorio"

# =============================================================================
# 4. CREAR DIRECTORIOS PARA SCRIPTS DE SERVICIOS
