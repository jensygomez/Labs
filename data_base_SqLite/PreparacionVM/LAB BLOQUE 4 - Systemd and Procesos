#!/bin/bash
# Crea un proceso hijo que termina pero no es recolectado
echo "Padre PID: $$"
echo "Creando hijo que se convertirá en zombie..."
sleep 2 &
echo "Hijo PID: $!"
echo "El hijo terminará pero no será recolectado"
echo "Ejecutar: ps aux | grep Z para ver zombies"
# No hacemos wait, el hijo queda zombie
sleep 3600
EOF
