cat > "$UNIT_DIR/lab-crash-loop.service" << 'EOF'
[Unit]
Description=Lab Service - Crash loop (Restart=always)
After=network.target

[Service]
Type=simple
ExecStart=/bin/false
Restart=always
RestartSec=5
StartLimitBurst=3
StartLimitInterval=60

[Install]
WantedBy=multi-user.target
EOF

# -----------------------------------------------------------------------------
