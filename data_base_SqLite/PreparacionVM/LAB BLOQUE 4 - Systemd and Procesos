#!/bin/bash
# Script que consume CPU - para prácticas de nice, renice, kill
echo "PID: $$ - Iniciando consumo de CPU"
echo "Ejecutar: renice -n +5 -p $$ para bajar prioridad"
echo "Ejecutar: kill -9 $$ para terminar"
counter=0
while true; do
    counter=$((counter + 1))
    if [ $counter -eq 10000000 ]; then
        echo "$$: Aún vivo..." > /dev/null
        counter=0
