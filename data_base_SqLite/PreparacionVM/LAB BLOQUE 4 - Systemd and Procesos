Description=Lab Service - Start limit
After=network.target
StartLimitBurst=2
StartLimitInterval=30

[Service]
Type=simple
ExecStart=/bin/false
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

