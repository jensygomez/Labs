# -----------------------------------------------------------------------------
# Script para simular proceso huérfano (heredero de init)
# -----------------------------------------------------------------------------
cat > /usr/local/lib/lab-services/orphan-maker.sh << 'EOF'
#!/bin/bash
# Crea un proceso huérfano (padre muere antes)
echo "Padre PID: $$"
echo "Creando hijo que quedará huérfano..."
(
    echo "Hijo PID: $PPID - Esperando a que padre muera..."
    sleep 5
    echo "Hijo PID: $$ - Padre ha muerto, ahora soy huérfano. Mi nuevo padre es: $(ps -o ppid= -p $$ | tr -d ' ')"
    echo "Ejecutar: pstree -p 1 para ver procesos"
    sleep 3600
) &
child=$!
echo "Hijo creado con PID: $child"
echo "Padre termina ahora, hijo quedará huérfano"
exit 0
EOF
chmod +x /usr/local/lib/lab-services/orphan-maker.sh

