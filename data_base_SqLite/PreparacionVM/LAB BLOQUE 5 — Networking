#!/bin/bash
# =============================================================================
# LAB BLOQUE 5 — NETWORKING (VERSIÓN SEGURA)
# =============================================================================

set -e

echo "🌐 Preparando escenario de Networking (Sin bloquear al usuario)..."

# 1. CREAR RED FICTICIA (Para no tocar tu IP de acceso)
# -----------------------------------------------------------------------------
# Creamos una interfaz dummy llamada 'lab-admin'
nmcli con add type dummy con-name "lab-virtual" ifname lab0 || true

# Inyectamos el error de la máscara /32 aquí (en la interfaz ficticia)
nmcli con mod "lab-virtual" ipv4.addresses "192.168.100.10/32" ipv4.method manual
nmcli con up "lab-virtual"

# 2. SSH - CONFIGURACIÓN DE PRÁCTICA (Archivo aparte)
# -----------------------------------------------------------------------------
# En lugar de romper el SSH principal, creamos un banner y una regla de puerto
# que solo verás cuando intentes entrar a una IP específica.
echo "⚠️  ACCESO DE LABORATORIO - SOLO PERSONAL AUTORIZADO" > /etc/ssh/ssh_banner_lab
# (No tocaremos PermitRootLogin para que no te quedes fuera)

# 3. FIREWALLD - ESCENARIO DE TROUBLESHOOTING
# -----------------------------------------------------------------------------
# Crearemos una zona nueva para que la arregles, pero NO tocaremos la zona 'public'
# que es por donde entras tú.
systemctl start firewalld
firewall-cmd --permanent --new-zone=lab-restricted
firewall-cmd --permanent --zone=lab-restricted --add-source=192.168.100.0/24
firewall-cmd --permanent --zone=lab-restricted --set-target=REJECT
firewall-cmd --reload

# 4. ROUTING - EL CAMINO A NINGUNA PARTE
# -----------------------------------------------------------------------------
# Esta ruta es inofensiva para tu conexión actual
ip route add 10.20.30.0/24 via 127.0.0.1 dev lo || true

echo "✅ Escenario listo y SEGURO."
echo "   - Tu acceso SSH principal NO ha sido tocado."
echo "   - Practica 'nmcli' sobre la conexión 'lab-virtual'."
echo "   - El problema del Firewall está en la zona 'lab-restricted'."