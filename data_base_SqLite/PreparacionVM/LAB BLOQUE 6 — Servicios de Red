#!/bin/bash
# =============================================================================
# LAB BLOQUE 6 — SERVICIOS DE RED + CLIENTES PODMAN
# Rocky Linux 9 — sudo bash lab_bloque6_setup.sh
# Preparación RHCSA / LFCS
# =============================================================================

set -e
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'; NC='\033[0m'

echo ""; echo "================================================================"
echo "  LAB BLOQUE 6 — SERVICIOS DE RED + CONTENEDORES PODMAN"
echo "================================================================"; echo ""

# --- PASO 0: VERIFICACIONES ---
echo -e "${YELLOW}[0/9] Verificando prerequisitos...${NC}"
[[ $EUID -ne 0 ]] && echo -e "${RED}ERROR: Ejecutar como root.${NC}" && exit 1
command -v podman &>/dev/null || dnf install -y podman podman-plugins
echo -e "${GREEN}[OK] Prerequisitos${NC}"

# --- PASO 1: INSTALAR PAQUETES ---
echo -e "${YELLOW}[1/9] Instalando servicios...${NC}"
dnf install -y httpd nfs-utils samba samba-client bind bind-utils \
    chrony vsftpd rpcbind > /dev/null 2>&1
echo -e "${GREEN}[OK] Paquetes instalados${NC}"

# --- PASO 2: APACHE ---
echo -e "${YELLOW}[2/9] Configurando Apache...${NC}"
mkdir -p /var/www/html/secret
echo "Bienvenido al Lab"  > /var/www/html/index.html
echo "Contenido Privado"  > /var/www/html/secret/index.html
chown -R root:root /var/www/html/secret
chmod 700 /var/www/html/secret   # Bug: 403 Forbidden intencional
echo -e "${GREEN}[OK] Apache listo (bug 403 en /secret)${NC}"

# --- PASO 3: NFS ---
echo -e "${YELLOW}[3/9] Configurando NFS...${NC}"
mkdir -p /mnt/nfs_share
echo "Archivo NFS" > /mnt/nfs_share/test.txt
chown -R nobody:nobody /mnt/nfs_share
chmod 755 /mnt/nfs_share
# Bug: solo 127.0.0.1 — nivel intermedio pedirá abrir a 172.20.0.0/24
echo "/mnt/nfs_share 127.0.0.1(rw,sync,no_root_squash)" > /etc/exports
echo -e "${GREEN}[OK] NFS listo (bug: solo 127.0.0.1)${NC}"

# --- PASO 4: SAMBA ---
echo -e "${YELLOW}[4/9] Configurando Samba...${NC}"
useradd -s /sbin/nologin smbuser 2>/dev/null || true
mkdir -p /srv/samba/public
chmod 777 /srv/samba/public
echo "Archivo Samba" > /srv/samba/public/test.txt
grep -q "\[publico\]" /etc/samba/smb.conf || cat >> /etc/samba/smb.conf << 'EOF'

[publico]
   path = /srv/samba/public
   browseable = yes
   writable = yes
   guest ok = yes
   create mask = 0777
   directory mask = 0777
EOF
echo -e "${GREEN}[OK] Samba listo (share publico)${NC}"

# --- PASO 5: BIND (DNS) ---
echo -e "${YELLOW}[5/9] Configurando BIND...${NC}"
# Sin modificar: escucha solo en 127.0.0.1 (bug para nivel intermedio)
echo -e "${GREEN}[OK] BIND sin tocar (bug: solo localhost)${NC}"

# --- PASO 6: CHRONY ---
echo -e "${YELLOW}[6/9] Configurando Chrony...${NC}"
grep -q "1.2.3.4" /etc/chrony.conf || echo "server 1.2.3.4 iburst" >> /etc/chrony.conf
echo -e "${GREEN}[OK] Chrony con servidor NTP falso 1.2.3.4${NC}"

# --- PASO 7: VSFTPD ---
echo -e "${YELLOW}[7/9] Configurando vsftpd...${NC}"
sed -i 's/anonymous_enable=NO/anonymous_enable=YES/' /etc/vsftpd/vsftpd.conf
echo -e "${GREEN}[OK] vsftpd con anonymous habilitado${NC}"

# --- PASO 8: INICIAR SERVICIOS ---
echo -e "${YELLOW}[8/9] Iniciando servicios...${NC}"
for svc in rpcbind nfs-server httpd smb nmb named chronyd vsftpd; do
    systemctl enable "$svc" --now 2>/dev/null \
        && echo -e "  ${GREEN}[OK]${NC} $svc" \
        || echo -e "  ${RED}[WARN]${NC} $svc — revisar: systemctl status $svc"
done
exportfs -ra 2>/dev/null || true
echo -e "${GREEN}[OK] Servicios iniciados${NC}"

# --- PASO 9: PODMAN — RED + CONTENEDORES ---
echo -e "${YELLOW}[9/9] Creando red Podman y contenedores...${NC}"

podman network rm lab-network 2>/dev/null || true
podman network create \
    --driver bridge \
    --subnet 172.20.0.0/24 \
    --gateway 172.20.0.1 \
    lab-network
echo -e "  ${BLUE}[NET]${NC} lab-network creada (172.20.0.0/24)"

podman rm -f lab-client1 lab-client2 2>/dev/null || true

# Imagen con todas las herramientas cliente para RHCSA/LFCS
TMPDIR=$(mktemp -d)
cat > "$TMPDIR/Containerfile" << 'CONTAINEREOF'
FROM rockylinux/rockylinux:9
RUN dnf install -y \
    nfs-utils samba-client cifs-utils \
    bind-utils curl wget \
    openssh-clients ftp \
    iproute iputils net-tools \
    tcpdump vim passwd sudo \
    && dnf clean all
RUN useradd labuser && echo "labuser:lab1234" | chpasswd
RUN echo "labuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
CMD ["/bin/bash", "-c", "sleep infinity"]
CONTAINEREOF

echo -e "  ${YELLOW}Construyendo imagen lab-client (1-2 min)...${NC}"
podman build -t lab-client:latest "$TMPDIR" -q
rm -rf "$TMPDIR"
echo -e "  ${BLUE}[IMG]${NC} Imagen construida"

HOST_IP="172.20.0.1"

podman run -d --name lab-client1 \
    --network lab-network --ip 172.20.0.10 \
    --hostname lab-client1 \
    --add-host "lab-server:${HOST_IP}" \
    --cap-add=NET_ADMIN --cap-add=SYS_ADMIN \
    lab-client:latest
echo -e "  ${GREEN}[OK]${NC} lab-client1 → 172.20.0.10"

podman run -d --name lab-client2 \
    --network lab-network --ip 172.20.0.20 \
    --hostname lab-client2 \
    --add-host "lab-server:${HOST_IP}" \
    --cap-add=NET_ADMIN --cap-add=SYS_ADMIN \
    lab-client:latest
echo -e "  ${GREEN}[OK]${NC} lab-client2 → 172.20.0.20"

sleep 2
echo -e "  Estado: $(podman inspect lab-client1 --format '{{.State.Status}}') / $(podman inspect lab-client2 --format '{{.State.Status}}')"

# --- RESUMEN ---
echo ""
echo "================================================================"
echo -e "${GREEN}  LAB BLOQUE 6 COMPLETADO${NC}"
echo "================================================================"
echo ""
echo "SERVICIOS (host):"
echo "  httpd      → :80  | bug: /secret = 403"
echo "  nfs-server → /mnt/nfs_share | bug: solo 127.0.0.1"
echo "  smb/nmb    → share 'publico'"
echo "  named      → DNS solo localhost"
echo "  chronyd    → NTP IP falsa 1.2.3.4"
echo "  vsftpd     → FTP anonymous=YES"
echo ""
echo "CONTENEDORES:"
echo "  lab-client1 → 172.20.0.10"
echo "  lab-client2 → 172.20.0.20"
echo "  Host desde contenedores: lab-server (172.20.0.1)"
echo ""
echo "ACCESO:"
echo "  podman exec -it lab-client1 bash"
echo "  podman exec -it lab-client2 bash"
echo ""
echo "NOTA: Firewall sin abrir — primer reto de los ejercicios"
echo "================================================================"