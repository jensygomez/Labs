#!/bin/bash
# =============================================================================
# LAB BLOQUE 6 — SERVICIOS DE RED (VERSIÓN INTEGRAL V3)
# Rocky Linux 9 — Preparación RHCSA + LFCS
# =============================================================================

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'; NC='\033[0m'

echo ""
echo "================================================================"
echo "  LAB BLOQUE 6 — SERVICIOS DE RED + CLIENTES PODMAN"
echo "  Rocky Linux 9 — Configuración Persistente"
echo "================================================================"
echo ""

# --- VERIFICACIÓN DE ROOT ---
if [ $EUID -ne 0 ]; then
    echo -e "${RED}ERROR: Ejecutar como root (sudo)${NC}"
    exit 1
fi

# =============================================================================
# PASO 1: INFRAESTRUCTURA DE CONTENEDORES (PODMAN)
# =============================================================================
echo -e "${YELLOW}[1/6] Instalando y configurando Podman primero...${NC}"

dnf install -y podman podman-plugins > /dev/null 2>&1

# Habilitar el servicio de reinicio de contenedores
systemctl enable --now podman-restart.service > /dev/null 2>&1

# Crear la red del laboratorio
podman network rm lab-network 2>/dev/null || true
podman network create \
    --driver bridge \
    --subnet 172.20.0.0/24 \
    --gateway 172.20.0.1 \
    lab-network

echo -e "${GREEN}✓ Podman y Red (172.20.0.0/24) preparados${NC}"

# =============================================================================
# PASO 2: INSTALAR SERVICIOS DE RED EN EL HOST
# =============================================================================
echo -e "${YELLOW}[2/6] Instalando servicios de red (esto puede tardar)...${NC}"

# Lista de paquetes para los 40 ejercicios
PACKAGES="httpd nfs-utils samba samba-client bind bind-utils chrony vsftpd rpcbind mod_ssl cifs-utils firewalld"

for pkg in $PACKAGES; do
    if ! rpm -q $pkg > /dev/null 2>&1; then
        echo -ne "  Instalando $pkg... "
        dnf install -y $pkg > /dev/null 2>&1
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "  $pkg ya está instalado."
    fi
done

# =============================================================================
# PASO 3: CONFIGURACIÓN DE SERVICIOS (CON BUGS PARA PRACTICAR)
# =============================================================================
echo -e "${YELLOW}[3/6] Aplicando configuraciones base y 'bugs' de examen...${NC}"

# Apache
mkdir -p /var/www/html/secret
echo "Bienvenido al Lab" > /var/www/html/index.html
echo "Contenido Privado" > /var/www/html/secret/index.html
[cite_start]chmod 700 /var/www/html/secret # Bug: 403 Forbidden intencional [cite: 4]

# NFS
mkdir -p /mnt/nfs_share
echo "Archivo NFS" > /mnt/nfs_share/test.txt
chown -R nobody:nobody /mnt/nfs_share
[cite_start]echo "/mnt/nfs_share 127.0.0.1(rw,sync,no_root_squash)" > /etc/exports # Bug: solo localhost [cite: 5, 17]

# Samba
useradd -s /sbin/nologin smbuser 2>/dev/null || true
(echo "smbpass"; echo "smbpass") | smbpasswd -a smbuser -s
if ! grep -q "\[publico\]" /etc/samba/smb.conf; then
cat >> /etc/samba/smb.conf << 'EOF'
[publico]
   path = /srv/samba/public
   browseable = yes
   writable = yes
   guest ok = yes
EOF
fi
[cite_start]mkdir -p /srv/samba/public && chmod 777 /srv/samba/public # [cite: 6]

# Chrony (NTP)
sed -i 's/^pool /#pool /' /etc/chrony.conf
[cite_start]echo "server 1.2.3.4 iburst" >> /etc/chrony.conf # Bug: IP falsa [cite: 8]

echo -e "${GREEN}✓ Configuraciones aplicadas${NC}"

# =============================================================================
# PASO 4: PERSISTENCIA (SYSTEMD)
# =============================================================================
echo -e "${YELLOW}[4/6] Activando persistencia de servicios...${NC}"

SERVICES="firewalld rpcbind nfs-server httpd smb nmb named chronyd vsftpd"
for svc in $SERVICES; do
    systemctl enable "$svc" --now > /dev/null 2>&1
done

echo -e "${GREEN}✓ Todos los servicios en 'enabled'${NC}"

# =============================================================================
# PASO 5: DESPLIEGUE DE CLIENTES (3 CONTENEDORES)
# =============================================================================
echo -e "${YELLOW}[5/6] Desplegando 3 clientes persistentes...${NC}"

# Usamos una sola imagen para ahorrar tiempo
IMAGE="rockylinux/rockylinux:9"
podman pull $IMAGE > /dev/null 2>&1

declare -A CLIENTS=( ["lab-client1"]="10" ["lab-client2"]="20" ["lab-admin"]="30" )

for NAME in "${!CLIENTS[@]}"; do
    podman rm -f "$NAME" 2>/dev/null || true
    
    # --restart always asegura que inicien al bootear la PC
    podman run -d --name "$NAME" \
        --network lab-network --ip "172.20.0.${CLIENTS[$NAME]}" \
        --hostname "$NAME" \
        --add-host "lab-server:172.20.0.1" \
        --restart always \
        --cap-add=NET_ADMIN --cap-add=SYS_ADMIN \
        $IMAGE sleep infinity > /dev/null
    
    echo -e "  Container $NAME → 172.20.0.${CLIENTS[$NAME]} ${GREEN}ACTIVO${NC}"
done

# =============================================================================
# PASO 6: RESUMEN FINAL
# =============================================================================
echo ""
echo -e "${BLUE}================================================================"
echo -e "${GREEN}  LISTO PARA LOS 40 EJERCICIOS (Básico/Interm/Avanz/Trouble)${NC}"
echo -e "================================================================${NC}"
echo -e "  Host (Servidor): 172.20.0.1"
echo -e "  Clientes: lab-client1, lab-client2, lab-admin"
echo -e "  Persistencia: Contenedores y servicios iniciarán con la PC."
echo -e "  Nota: Firewall activo. Deberás abrir puertos para avanzar."
echo -e "${BLUE}================================================================${NC}"