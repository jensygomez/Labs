main() {
    check_root

    mkdir -p "$LAB_BASE"
    mkdir -p "$(dirname "$LOG_FILE")"
    touch "$LOG_FILE"

    [[ "$ARG" == "reset" ]] && reset_lab

    log "Iniciando preparacion – Bloque 10: Boot, Recovery y Mantenimiento"

    setup_dependencias
    setup_boot
    setup_recovery
    setup_targets
    setup_logs
    setup_tareas
    setup_performance
    setup_troubleshooting

    hdr "Preparacion completada"
    echo -e "${GREEN}"
    echo "  Base : $LAB_BASE"
    echo "  Log  : $LOG_FILE"
    echo ""
    echo "  Estructura creada:"
    find "$LAB_BASE" -maxdepth 2 -type d | sort | while read -r d; do
        level=$(echo "$d" | tr -cd '/' | wc -c)
        indent=$(printf '%*s' $(( (level - 4) * 2 )) '')
        count=$(find "$d" -maxdepth 1 -type f 2>/dev/null | wc -l)
        printf "  %s%-35s (%d ficheros)\n" "$indent" "$(basename "$d")" "$count"
    done
    echo -e "${NC}"

    echo -e "${CYAN}Servicios habilitados en boot:${NC}"
    echo "  lab-boot-monitor.service    → escribe en /var/log/lab_boot_monitor.log"
    echo "  rsyslog                     → reglas en /etc/rsyslog.d/10-lab.conf"
    echo "  chronyd                     → sincronización NTP"
    echo "  tuned                       → perfil lab-perfil disponible"
    echo "  sysstat                     → recogida de datos sar"
    echo ""
    echo -e "${YELLOW}Tip RHCSA:${NC} el ejercicio de rd.break requiere reinicio real de la VM."
    echo "  Lee primero: $LAB_BASE/recovery/procedures/rd_break_procedure.txt"
}

main "$@"