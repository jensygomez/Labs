#!/bin/bash
# =============================================================================
# SCRIPT 10 - Preparación de entorno: Boot, Recovery y Mantenimiento
# Rocky Linux 9.x
# Certificaciones: LFCS / RHCSA
# =============================================================================
# Cubre:
#   - Proceso de arranque: GRUB2, initramfs, kernel parameters
#   - Recovery: rd.break, rescue target, chroot, password reset
#   - Systemd targets: emergency, rescue, multi-user, graphical
#   - Logs: journald, rsyslog, logrotate
#   - Tareas programadas: cron, at, anacron, chrony
#   - Performance: tuned, nice/renice, iostat, sar
# =============================================================================
# Uso:
#   chmod +x prep_10_boot_recovery.sh
#   sudo bash prep_10_boot_recovery.sh
#   sudo bash prep_10_boot_recovery.sh reset
# =============================================================================

set -euo pipefail

# ─── Colores ────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ─── Variables globales ──────────────────────────────────────────────────────
LAB_BASE="/opt/labs/bloque10"
LOG_FILE="/var/log/lab_prep_bloque10.log"
ARG="${1:-all}"

# ─── Helpers ────────────────────────────────────────────────────────────────
log()  { echo -e "$(date '+%Y-%m-%d %H:%M:%S') [INFO]  $*" | tee -a "$LOG_FILE"; }
ok()   { echo -e "${GREEN}  ✔ $*${NC}"  | tee -a "$LOG_FILE"; }
warn() { echo -e "${YELLOW}  ⚠ $*${NC}" | tee -a "$LOG_FILE"; }
err()  { echo -e "${RED}  ✘ $*${NC}"   | tee -a "$LOG_FILE"; }
hdr()  {
    echo -e "\n${CYAN}${BOLD}══════════════════════════════════════════${NC}"
    echo -e "${CYAN}${BOLD}  $*${NC}"
    echo -e "${CYAN}${BOLD}══════════════════════════════════════════${NC}"
}

check_root() {
    [[ $EUID -eq 0 ]] || { err "Ejecuta como root: sudo bash $0"; exit 1; }
}

install_pkg() {
    local pkg="$1"
    if ! rpm -q "$pkg" &>/dev/null; then
        dnf install -y "$pkg" &>>"$LOG_FILE" \
            && ok "Instalado: $pkg" \
            || warn "No disponible en repo: $pkg"
    else
        ok "Ya presente: $pkg"
    fi
}

mklab() {
    mkdir -p "$1"
    ok "Dir: $1"
}

# =============================================================================
# RESET
# =============================================================================
reset_lab() {
    hdr "RESET: Limpiando bloque 10"

    # Servicios creados por el lab
    for svc in lab-boot-monitor lab-crash-simulator lab-broken-service; do
        systemctl disable --now "${svc}.service" 2>/dev/null || true
        rm -f "/etc/systemd/system/${svc}.service"
    done
    systemctl daemon-reload 2>/dev/null || true

    # Contenedor de lab
    if command -v podman &>/dev/null; then
        podman stop lab-syslog-server 2>/dev/null || true
        podman rm   lab-syslog-server 2>/dev/null || true
        podman stop lab-broken-boot   2>/dev/null || true
        podman rm   lab-broken-boot   2>/dev/null || true
    fi

    # Cron jobs de lab
    crontab -l 2>/dev/null | grep -v "bloque10" | crontab - 2>/dev/null || true

    # Configuraciones modificadas – restaurar backups si existen
    [[ -f /etc/rsyslog.conf.lab_bak ]]  && mv /etc/rsyslog.conf.lab_bak  /etc/rsyslog.conf
    [[ -f /etc/logrotate.conf.lab_bak ]] && mv /etc/logrotate.conf.lab_bak /etc/logrotate.conf
    [[ -f /etc/chrony.conf.lab_bak ]]   && mv /etc/chrony.conf.lab_bak   /etc/chrony.conf

    # Usuarios de lab
    for u in labrecovery labtasks; do
        id "$u" &>/dev/null && userdel -r "$u" 2>/dev/null && ok "Usuario eliminado: $u"
    done

    # Directorio base
    rm -rf "$LAB_BASE"
    ok "Reset completo"
    exit 0
}

# =============================================================================
# SECCIÓN 1 – Dependencias
# =============================================================================
setup_dependencias() {
    hdr "Instalando dependencias"

    # Core boot/recovery tools
    install_pkg grub2-tools
    install_pkg grub2-tools-extra
    install_pkg dracut
    install_pkg dracut-tools

    # Logging
    install_pkg rsyslog
    install_pkg logrotate

    # Time sync
    install_pkg chrony

    # Scheduling
    install_pkg cronie
    install_pkg cronie-anacron
    install_pkg at

    # Performance
    install_pkg tuned
    install_pkg sysstat        # iostat, sar, mpstat
    install_pkg procps-ng      # top, vmstat, free
    install_pkg util-linux     # lscpu, lsblk

    # Herramientas de diagnóstico
    install_pkg lsof
    install_pkg psmisc         # pstree, killall
    install_pkg audit          # auditd para ejercicios de boot audit

    # Asegura que los servicios base estén activos
    systemctl enable --now rsyslog  2>/dev/null && ok "rsyslog activo"  || warn "rsyslog no pudo iniciar"
    systemctl enable --now crond    2>/dev/null && ok "crond activo"    || warn "crond no pudo iniciar"
    systemctl enable --now atd      2>/dev/null && ok "atd activo"      || warn "atd no pudo iniciar"
    systemctl enable --now chronyd  2>/dev/null && ok "chronyd activo"  || warn "chronyd no pudo iniciar"
    systemctl enable --now tuned    2>/dev/null && ok "tuned activo"    || warn "tuned no pudo iniciar"
    systemctl enable --now auditd   2>/dev/null && ok "auditd activo"   || warn "auditd no pudo iniciar"
}

# =============================================================================
# SECCIÓN 2 – Entorno GRUB2 y Boot Process
# Ejercicios: inspección de GRUB, kernel parameters, initramfs
# =============================================================================
setup_boot() {
    hdr "Boot Process – Creando entorno"

    local DIR="$LAB_BASE/boot"
    mklab "$DIR"
    mklab "$DIR/grub_backup"
    mklab "$DIR/initramfs_analysis"
    mklab "$DIR/kernel_params"

    # Backup de GRUB actual (solo lectura para los ejercicios)
    cp /etc/default/grub "$DIR/grub_backup/grub.default.original" 2>/dev/null \
        && ok "Backup: /etc/default/grub" \
        || warn "No se pudo copiar /etc/default/grub"

    [[ -f /boot/grub2/grub.cfg ]] && \
        cp /boot/grub2/grub.cfg "$DIR/grub_backup/grub.cfg.original" 2>/dev/null \
        && ok "Backup: grub.cfg" \
        || warn "grub.cfg no encontrado en /boot/grub2/"

    # Fichero de referencia con parámetros de kernel actuales
    cat /proc/cmdline > "$DIR/kernel_params/current_cmdline.txt" 2>/dev/null
    ok "Parámetros de kernel actuales guardados"

    # Información de initramfs actual
    ls -lh /boot/initramfs-*.img > "$DIR/initramfs_analysis/initramfs_list.txt" 2>/dev/null \
        && ok "Lista de initramfs guardada" \
        || warn "No se encontraron imágenes initramfs en /boot"

    # Snapshot del estado de boot actual
    systemd-analyze > "$DIR/boot_timing.txt" 2>/dev/null \
        && ok "Boot timing guardado" \
        || warn "systemd-analyze no disponible"

    systemd-analyze blame >> "$DIR/boot_timing.txt" 2>/dev/null || true

    # Fichero con los parámetros de GRUB que el alumno puede modificar
    # (el script los restaura en reset – nunca toca el original)
    cat > "$DIR/grub_params_lab.txt" <<'EOF'
# Parámetros de GRUB2 para practicar en ejercicios
# IMPORTANTE: No edites /etc/default/grub directamente en los ejercicios.
# Usa este fichero como referencia y aplica con grub2-mkconfig solo
# cuando el ejercicio lo indique explícitamente.

# Parámetros comunes del examen RHCSA/LFCS:
#
# Añadir en GRUB_CMDLINE_LINUX para boot en modo rescate:
#   systemd.unit=rescue.target
#
# Añadir para emergency target:
#   systemd.unit=emergency.target
#
# Añadir para rd.break (interrumpir en initramfs antes de montar /):
#   rd.break
#
# Añadir para deshabilitar SELinux temporalmente:
#   enforcing=0
#
# Añadir para modo verbose (ver todos los mensajes de boot):
#   rd.udev.log_level=debug
#
# Parámetro para especificar root diferente:
#   root=/dev/sda1
#
# Ver mensajes de boot sin quiet:
#   Eliminar 'rhgb quiet' de GRUB_CMDLINE_LINUX
EOF

    # Servicio de monitorización de boot para los ejercicios
    cat > /etc/systemd/system/lab-boot-monitor.service <<'EOF'
[Unit]
Description=Lab Boot Monitor – bloque10
After=multi-user.target
Wants=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'echo "$(date) – sistema arrancado OK" >> /var/log/lab_boot_monitor.log'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable lab-boot-monitor.service 2>/dev/null \
        && ok "lab-boot-monitor.service habilitado (arranca con el sistema)" \
        || warn "No se pudo habilitar lab-boot-monitor"

    ok "Entorno boot listo -> $DIR"
}

# =============================================================================
# SECCIÓN 3 – Recovery
# Ejercicios: rd.break, rescue target, chroot, password reset, SELinux repair
# =============================================================================
setup_recovery() {
    hdr "Recovery – Creando entorno"

    local DIR="$LAB_BASE/recovery"
    mklab "$DIR"
    mklab "$DIR/chroot_practice"
    mklab "$DIR/procedures"

    # Guías de procedimiento para los ejercicios de recovery
    # (el alumno las lee ANTES de hacer el ejercicio – son su referencia)
    cat > "$DIR/procedures/rd_break_procedure.txt" <<'EOF'
PROCEDIMIENTO: Reset de password root via rd.break
====================================================
CUÁNDO: El sistema arranca pero no conoces la contraseña de root.
APLICA A: RHCSA (ejercicio casi siempre presente en el examen)

PASOS:
1. Reinicia la VM.
2. En el menú de GRUB, pulsa 'e' para editar la entrada del kernel.
3. Localiza la línea que empieza con 'linux' (o 'linuxefi').
4. Al final de esa línea añade:   rd.break enforcing=0
5. Pulsa Ctrl+X para arrancar.
6. El sistema para en el initramfs con prompt (switch_root):#
7. Remonta / con escritura:
     mount -o remount,rw /sysroot
8. Entra en chroot:
     chroot /sysroot
9. Cambia la contraseña:
     passwd root
10. Crea el fichero de relabel de SELinux:
     touch /.autorelabel
11. Sal del chroot y reinicia:
     exit
     exit   (o reboot -f)
12. El sistema hará relabel de SELinux al arrancar (tarda ~2 min).

VERIFICACIÓN: Inicia sesión con la nueva contraseña.
EOF

    cat > "$DIR/procedures/rescue_target_procedure.txt" <<'EOF'
PROCEDIMIENTO: Arrancar en rescue.target
==========================================
CUÁNDO: El sistema no arranca normalmente, necesitas reparar algo.
DIFERENCIA con rd.break:
  - rescue.target: el sistema monta todos los filesystems y carga
    los servicios básicos. Tienes acceso completo al sistema.
  - rd.break: para ANTES de montar /. Solo tienes initramfs.
  - emergency.target: mínimo absoluto, solo / montado en ro.

DESDE GRUB:
  Añade en la línea del kernel:
    systemd.unit=rescue.target

DESDE SISTEMA EN MARCHA:
  systemctl isolate rescue.target
  (pide contraseña de root)

DESDE SISTEMA EN MARCHA (emergency):
  systemctl isolate emergency.target

VOLVER AL MODO NORMAL:
  systemctl default
  o
  systemctl isolate multi-user.target
EOF

    cat > "$DIR/procedures/chroot_repair_procedure.txt" <<'EOF'
PROCEDIMIENTO: Reparar sistema con chroot desde live/rescue
=============================================================
CUÁNDO: El sistema no arranca en absoluto. Usas un live CD o
        el modo rescue de la ISO de Rocky Linux.

PASOS:
1. Arranca desde ISO → Troubleshooting → Rescue a Rocky Linux system.
2. El installer monta el sistema en /mnt/sysimage automáticamente.
   Si no, monta manualmente:
     mount /dev/sda2 /mnt/sysimage          # partición raíz
     mount /dev/sda1 /mnt/sysimage/boot     # partición /boot
3. Monta los filesystems virtuales:
     mount --bind /dev  /mnt/sysimage/dev
     mount --bind /proc /mnt/sysimage/proc
     mount --bind /sys  /mnt/sysimage/sys
4. Entra en chroot:
     chroot /mnt/sysimage
5. Ahora estás "dentro" del sistema dañado. Puedes:
     - Reinstalar GRUB:     grub2-install /dev/sda
     - Regenerar grub.cfg:  grub2-mkconfig -o /boot/grub2/grub.cfg
     - Regenerar initramfs: dracut -f
     - Reparar paquetes:    dnf reinstall <paquete>
     - Editar /etc/fstab
6. Sal y reinicia:
     exit
     reboot
EOF

    # Servicio intencionalmente roto para ejercicios de recovery
    cat > /etc/systemd/system/lab-broken-service.service <<'EOF'
[Unit]
Description=Lab Broken Service – para ejercicios de recovery
After=network.target

[Service]
Type=simple
# Comando que falla intencionalmente
ExecStart=/bin/bash -c 'echo "Intentando iniciar..."; exit 1'
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    # NO habilitamos este servicio en boot – el alumno lo habilita en el ejercicio
    ok "lab-broken-service.service creado (no habilitado)"

    # Fichero fstab de ejemplo con un error para practicar recovery
    cat > "$DIR/fstab_roto.example" <<'EOF'
# /etc/fstab con error intencional – NO aplicar directamente
# Este fichero sirve para entender qué pasa cuando fstab tiene errores
#
# El error está en la última línea: dispositivo inexistente
# Si esto estuviera en /etc/fstab el sistema no arrancaría normalmente
# y caería en emergency.target

UUID=real-uuid-here    /          xfs     defaults        0 0
UUID=real-uuid-here    /boot      xfs     defaults        0 0
UUID=real-uuid-here    swap       swap    defaults        0 0
/dev/sdb99             /mnt/data  xfs     defaults        0 0
#                      ^^^^^^^^^ dispositivo que no existe → emergency.target
EOF

    # Usuario de recuperación para practicar reset de contraseña
    id labrecovery &>/dev/null || useradd -m -c "Lab Recovery User" labrecovery
    echo "labrecovery:RecoveryLab2024!" | chpasswd
    ok "Usuario labrecovery creado (pass: RecoveryLab2024!)"

    ok "Entorno recovery listo -> $DIR"
}

# =============================================================================
# SECCIÓN 4 – Systemd Targets
# Ejercicios: cambiar targets, crear targets custom, dependencias
# =============================================================================
setup_targets() {
    hdr "Systemd Targets – Creando entorno"

    local DIR="$LAB_BASE/targets"
    mklab "$DIR"

    # Snapshot del estado actual de targets
    systemctl list-units --type=target --all \
        > "$DIR/targets_actuales.txt" 2>/dev/null
    ok "Lista de targets guardada"

    systemctl get-default \
        > "$DIR/default_target.txt" 2>/dev/null
    ok "Target por defecto guardado: $(cat $DIR/default_target.txt)"

    # Tabla de referencia de targets para los ejercicios
    cat > "$DIR/targets_referencia.txt" <<'EOF'
REFERENCIA: Systemd Targets (equivalentes a runlevels SysV)
=============================================================

TARGET                    RUNLEVEL  DESCRIPCIÓN
─────────────────────────────────────────────────────────────
poweroff.target           0         Apaga el sistema
rescue.target             1         Modo monousuario con red
emergency.target          -         Mínimo absoluto, / en ro
multi-user.target         3         Multiusuario sin GUI (servidor)
graphical.target          5         Multiusuario con GUI
reboot.target             6         Reinicia el sistema

COMANDOS CLAVE:
  Ver target actual:          systemctl get-default
  Cambiar target permanente:  systemctl set-default <target>
  Cambiar target ahora:       systemctl isolate <target>
  Ir a rescue ahora:          systemctl isolate rescue.target
  Volver a normal:            systemctl default

EQUIVALENCIAS SysV → Systemd:
  init 0  →  systemctl poweroff
  init 1  →  systemctl isolate rescue.target
  init 3  →  systemctl isolate multi-user.target
  init 5  →  systemctl isolate graphical.target
  init 6  →  systemctl reboot
EOF

    # Target personalizado para los ejercicios avanzados
    cat > /etc/systemd/system/lab-maintenance.target <<'EOF'
[Unit]
Description=Lab Maintenance Target – bloque10
Documentation=man:systemd.special(7)
Requires=sysinit.target
After=sysinit.target
AllowIsolate=yes
EOF

    systemctl daemon-reload
    ok "lab-maintenance.target creado"

    ok "Entorno targets listo -> $DIR"
}

# =============================================================================
# SECCIÓN 5 – Journald y Rsyslog
# Ejercicios: journalctl, filtros, persistencia, rsyslog rules, remote logging
# =============================================================================
setup_logs() {
    hdr "Logging – Creando entorno"

    local DIR="$LAB_BASE/logs"
    mklab "$DIR"
    mklab "$DIR/rsyslog_rules"
    mklab "$DIR/journal_analysis"
    mklab "$DIR/logrotate_practice"

    # Backup de configuraciones originales antes de modificar
    cp /etc/rsyslog.conf   /etc/rsyslog.conf.lab_bak   2>/dev/null && ok "Backup rsyslog.conf"
    cp /etc/logrotate.conf /etc/logrotate.conf.lab_bak 2>/dev/null && ok "Backup logrotate.conf"

    # Asegurar que journal sea persistente (por defecto en Rocky 9 puede ser volátil)
    mkdir -p /var/log/journal
    systemd-tmpfiles --create --prefix /var/log/journal 2>/dev/null || true

    # Si no existe, configurar journald para persistencia
    if [[ ! -f /etc/systemd/journald.conf.d/lab-persist.conf ]]; then
        mkdir -p /etc/systemd/journald.conf.d
        cat > /etc/systemd/journald.conf.d/lab-persist.conf <<'EOF'
[Journal]
Storage=persistent
Compress=yes
SystemMaxUse=200M
SystemKeepFree=100M
EOF
        systemctl restart systemd-journald 2>/dev/null || true
        ok "Journal configurado como persistente"
    fi

    # Regla rsyslog de laboratorio – separa logs de lab en fichero propio
    cat > /etc/rsyslog.d/10-lab.conf <<'EOF'
# Regla de lab: todos los mensajes con tag "LAB_*" van a /var/log/lab.log
:programname, startswith, "LAB_" /var/log/lab.log
& stop
EOF
    systemctl restart rsyslog 2>/dev/null || true
    ok "Regla rsyslog lab creada (/var/log/lab.log)"

    # Generador de logs de prueba para los ejercicios
    cat > "$DIR/generar_logs_lab.sh" <<'EOF'
#!/bin/bash
# Genera entradas de log con diferentes prioridades para practicar journalctl
# Uso: bash generar_logs_lab.sh [N]   (N = número de entradas, default 50)

COUNT="${1:-50}"

for i in $(seq 1 "$COUNT"); do
    NIVEL=$((RANDOM % 4))
    case $NIVEL in
        0) logger -t "LAB_APP"  -p user.info    "INFO:  operacion $i completada OK" ;;
        1) logger -t "LAB_APP"  -p user.warning "WARN:  uso de memoria elevado en ciclo $i" ;;
        2) logger -t "LAB_APP"  -p user.err     "ERROR: fallo en conexion $i – reintentando" ;;
        3) logger -t "LAB_CRON" -p cron.info    "INFO:  tarea programada $i ejecutada" ;;
    esac
    sleep 0.1
done

echo "Generadas $COUNT entradas de log"
echo "Ver con: journalctl -t LAB_APP --since '5 minutes ago'"
echo "Ver con: tail -f /var/log/lab.log"
EOF
    chmod +x "$DIR/generar_logs_lab.sh"

    # Configuración de logrotate para logs de lab
    cat > /etc/logrotate.d/lab <<'EOF'
/var/log/lab.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
    postrotate
        systemctl reload rsyslog > /dev/null 2>&1 || true
    endscript
}
EOF
    ok "Configuración logrotate para /var/log/lab.log creada"

    # Copia de referencia de configuraciones para los ejercicios
    cp /etc/rsyslog.conf   "$DIR/rsyslog_rules/rsyslog.conf.original"   2>/dev/null || true
    cp /etc/logrotate.conf "$DIR/logrotate_practice/logrotate.conf.original" 2>/dev/null || true

    # Genera logs iniciales para que los ejercicios tengan datos
    bash "$DIR/generar_logs_lab.sh" 30 &>/dev/null || true
    ok "30 entradas de log generadas para los ejercicios"

    # Contenedor como servidor remoto de syslog (para ejercicios avanzados)
    if command -v podman &>/dev/null; then
        hdr "Contenedor: servidor de syslog remoto"

        # Directorio donde el contenedor escribirá los logs recibidos
        mklab "$DIR/remote_syslog_data"
        chmod 777 "$DIR/remote_syslog_data"

        # Imagen syslog-ng o rsyslog – usamos rsyslog sobre Rocky
        # Si la imagen no está disponible advertimos y continuamos
        podman pull docker.io/rsyslog/syslog_appliance_alpine:latest \
            &>>"$LOG_FILE" \
            && SYSLOG_IMAGE="docker.io/rsyslog/syslog_appliance_alpine:latest" \
            || SYSLOG_IMAGE=""

        if [[ -n "$SYSLOG_IMAGE" ]]; then
            podman run -d \
                --name lab-syslog-server \
                --restart unless-stopped \
                -p 514:514/udp \
                -p 514:514/tcp \
                -v "$DIR/remote_syslog_data:/var/log/remote:Z" \
                "$SYSLOG_IMAGE" &>>"$LOG_FILE" \
                && ok "Contenedor lab-syslog-server corriendo en puerto 514" \
                || warn "No se pudo iniciar lab-syslog-server"

            # Unidad systemd para que el contenedor arranque con el sistema
            cat > /etc/systemd/system/lab-syslog-container.service <<EOF
[Unit]
Description=Lab Remote Syslog Container – bloque10
After=network.target
Requires=network.target

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStart=podman start -a lab-syslog-server
ExecStop=podman stop lab-syslog-server

[Install]
WantedBy=multi-user.target
EOF
            systemctl daemon-reload
            systemctl enable lab-syslog-container.service 2>/dev/null \
                && ok "lab-syslog-container arranca con el sistema" \
                || warn "No se pudo habilitar lab-syslog-container"
        else
            warn "Imagen de syslog no disponible – ejercicios de remote logging usarán localhost"
            # Alternativa: configurar rsyslog local como receptor en puerto alternativo
            cat > /etc/rsyslog.d/20-lab-receiver.conf <<'EOF'
# Receptor UDP local en puerto 5140 (sin privilegios de root en prod)
# Para ejercicios de remote syslog sin contenedor
module(load="imudp")
input(type="imudp" port="5140")

# Guarda los logs remotos recibidos en fichero separado
if $fromhost-ip == '127.0.0.1' then /var/log/lab_remote.log
EOF
            systemctl restart rsyslog 2>/dev/null || true
            ok "Receptor rsyslog UDP en puerto 5140 configurado como alternativa"
        fi
    else
        warn "Podman no disponible – contenedor syslog omitido"
    fi

    ok "Entorno logging listo -> $DIR"
}

# =============================================================================
# SECCIÓN 6 – Tareas Programadas
# Ejercicios: cron, at, anacron, chrony, timedatectl
# =============================================================================
setup_tareas() {
    hdr "Tareas Programadas – Creando entorno"

    local DIR="$LAB_BASE/tareas"
    mklab "$DIR"
    mklab "$DIR/cron_scripts"
    mklab "$DIR/at_jobs"
    mklab "$DIR/chrony"

    # Scripts de ejemplo que el alumno programará con cron/at
    cat > "$DIR/cron_scripts/check_disk.sh" <<'EOF'
#!/bin/bash
# Script para programar con cron – comprueba uso de disco
THRESHOLD=80
LOGFILE="/var/log/lab_disk_check.log"
HOSTNAME=$(hostname -s)

df -h | awk 'NR>1 {gsub(/%/,"",$5); if($5+0 > '"$THRESHOLD"') print $0}' | \
while read -r line; do
    echo "$(date '+%Y-%m-%d %H:%M:%S') [ALERT] $HOSTNAME – $line" >> "$LOGFILE"
done

echo "$(date '+%Y-%m-%d %H:%M:%S') [OK] disk check completed" >> "$LOGFILE"
EOF
    chmod +x "$DIR/cron_scripts/check_disk.sh"

    cat > "$DIR/cron_scripts/cleanup_tmp.sh" <<'EOF'
#!/bin/bash
