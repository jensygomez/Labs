setup_performance() {
    hdr "Performance – Creando entorno"

    local DIR="$LAB_BASE/performance"
    mklab "$DIR"
    mklab "$DIR/tuned"
    mklab "$DIR/benchmarks"
    mklab "$DIR/sar_data"

    # Snapshot del perfil tuned actual
    tuned-adm active > "$DIR/tuned/perfil_actual.txt" 2>/dev/null \
        && ok "Perfil tuned actual guardado" \
        || warn "tuned-adm no disponible"

    tuned-adm list > "$DIR/tuned/perfiles_disponibles.txt" 2>/dev/null || true

    # Perfil tuned personalizado para los ejercicios
    mkdir -p /etc/tuned/lab-perfil
    cat > /etc/tuned/lab-perfil/tuned.conf <<'EOF'
[main]
summary=Perfil de laboratorio bloque10 – LFCS/RHCSA practice

[cpu]
governor=performance
energy_perf_bias=performance

[vm]
transparent_hugepages=never

[disk]
readahead=>4096

[scheduler]
sched_min_granularity_ns=10000000
sched_wakeup_granularity_ns=15000000
EOF
    ok "Perfil tuned 'lab-perfil' creado en /etc/tuned/lab-perfil/"

    # Script generador de carga para los ejercicios de performance
    cat > "$DIR/benchmarks/generar_carga.sh" <<'EOF'
#!/bin/bash
# Genera carga controlada de CPU y disco para practicar monitorización
# Uso: bash generar_carga.sh [cpu|disk|mem|all] [duracion_segundos]

TIPO="${1:-cpu}"
DURACION="${2:-30}"

case "$TIPO" in
    cpu)
        echo "Generando carga de CPU durante ${DURACION}s..."
        timeout "$DURACION" bash -c '
            while true; do
                echo "scale=5000; 4*a(1)" | bc -l > /dev/null 2>&1
            done
        ' &
        CPU_PID=$!
        echo "PID: $CPU_PID – monitoriza con: top -p $CPU_PID"
        echo "O con: ps -p $CPU_PID -o pid,ppid,%cpu,%mem,cmd"
        wait $CPU_PID 2>/dev/null
        echo "Carga CPU finalizada"
        ;;
    disk)
        echo "Generando carga de disco durante ${DURACION}s..."
        timeout "$DURACION" bash -c '
            while true; do
                dd if=/dev/urandom of=/tmp/lab_disk_test bs=1M count=10 2>/dev/null
                rm -f /tmp/lab_disk_test
            done
        ' &
        DISK_PID=$!
        echo "PID: $DISK_PID – monitoriza con: iostat -x 1"
        wait $DISK_PID 2>/dev/null
        echo "Carga disco finalizada"
        ;;
    mem)
        echo "Generando uso de memoria durante ${DURACION}s..."
        python3 -c "
import time
data = []
for i in range(50):
    data.append(' ' * 1024 * 1024)  # 1MB chunks
print(f'Reservados ~50MB')
time.sleep(int('$DURACION'))
" 2>/dev/null &
        MEM_PID=$!
        echo "PID: $MEM_PID – monitoriza con: free -h"
        wait $MEM_PID 2>/dev/null
        echo "Carga memoria finalizada"
        ;;
    all)
        bash "$0" cpu "$DURACION" &
        bash "$0" disk "$DURACION" &
        bash "$0" mem "$DURACION" &
        wait
        echo "Todas las cargas finalizadas"
        ;;
    *)
        echo "Uso: $0 [cpu|disk|mem|all] [segundos]"
        exit 1
        ;;
esac
EOF
    chmod +x "$DIR/benchmarks/generar_carga.sh"

    # Genera histórico de sar si sysstat está disponible
    if command -v sar &>/dev/null; then
        # Activa la recogida de datos de sysstat
        systemctl enable --now sysstat 2>/dev/null || true

        # Captura snapshot actual para los ejercicios
        sar -u 1 3 > "$DIR/sar_data/sar_cpu_sample.txt"    2>/dev/null || true
        sar -r 1 3 > "$DIR/sar_data/sar_mem_sample.txt"    2>/dev/null || true
        sar -d 1 3 > "$DIR/sar_data/sar_disk_sample.txt"   2>/dev/null || true
        vmstat 1 5 > "$DIR/sar_data/vmstat_sample.txt"     2>/dev/null || true
        iostat -x  > "$DIR/sar_data/iostat_sample.txt"     2>/dev/null || true
        ok "Snapshots de sar/vmstat/iostat guardados"
    else
        warn "sysstat no disponible – snapshots de sar omitidos"
    fi

    # Referencia de comandos de performance para el examen
    cat > "$DIR/performance_referencia.txt" <<'EOF'
REFERENCIA: Performance Monitoring – LFCS/RHCSA
================================================

TUNED:
  tuned-adm active               → perfil activo
  tuned-adm list                 → perfiles disponibles
  tuned-adm profile <nombre>     → activar perfil
  tuned-adm recommend            → recomienda perfil para este HW
  Perfiles clave para examen:
    throughput-performance       → servidores de alto rendimiento
    virtual-guest                → VMs (recomendado en examen RHCSA)
    powersave                    → ahorro de energía
    balanced                     → equilibrio (default en muchos sistemas)

PROCESOS (nice/renice):
  nice -n 10 comando             → lanza con prioridad reducida
  nice -n -10 comando            → lanza con prioridad alta (root)
  renice -n 5 -p <PID>           → cambia prioridad en caliente
  renice -n 5 -u <usuario>       → cambia prioridad de todos los proc del usuario
  ps -eo pid,ni,pri,%cpu,cmd     → ver nice y prioridad de todos los procesos
  Rango nice: -20 (máx prioridad) a +19 (mín prioridad)
  Solo root puede usar valores negativos.

IOSTAT:
  iostat                         → resumen desde el arranque
  iostat -x 1 5                  → extendido, cada 1s, 5 iteraciones
  iostat -x -d /dev/sda 1        → solo disco sda, cada 1s
  Columnas clave: %util, await, r/s, w/s

SAR (System Activity Reporter):
  sar -u 1 5                     → CPU cada 1s, 5 muestras
  sar -r 1 5                     → memoria RAM
  sar -d 1 5                     → actividad de disco
  sar -n DEV 1 5                 → actividad de red
  sar -q 1 5                     → load average y run queue
  sar -f /var/log/sa/sa<DD>      → datos históricos del día DD

VMSTAT:
  vmstat 1 5                     → resumen cada 1s, 5 muestras
  Columnas: r=run queue, b=blocked, si/so=swap in/out, wa=IO wait
EOF

    ok "Entorno performance listo -> $DIR"
}

