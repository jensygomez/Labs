# Script de backup - CONTIENE BUGS INTENCIONALES
# Objetivo: encontrar y corregir todos los errores

set -e

BACKUP_DIR=/opt/backups
SOURCE_DIR=$1
MAX_BACKUPS=5
LOG=/var/log/backup.log

log_msg() {
    local nivel=$1
    local msg=$2
    echo "$(date '+%Y-%m-%d %H:%M:%S') [$nivel] $msg" >> $LOG
}

# BUG 1: falta 'then'
if [ ! -d $SOURCE_DIR ]
    log_msg "ERROR" "Directorio $SOURCE_DIR no existe"
    exit 1
fi

[ -d $BACKUP_DIR ] || mkdir -p $BACKUP_DIR

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_NAME="backup_${TIMESTAMP}.tar.gz"

log_msg "INFO" "Iniciando backup de $SOURCE_DIR"
