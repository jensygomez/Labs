# Contador con race condition clasica – casi nunca llega a 10

CONTADOR_FILE="/tmp/lab_contador_$$.txt"
echo 0 > "$CONTADOR_FILE"

incrementar() {
    local actual
    actual=$(cat "$CONTADOR_FILE")
    local nuevo=$((actual + 1))
