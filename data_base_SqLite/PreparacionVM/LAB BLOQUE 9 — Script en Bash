    install_pkg ShellCheck || true
}

# =============================================================================
# MAIN
# =============================================================================
main() {
    check_root

    mkdir -p "$LAB_BASE"
    mkdir -p "$(dirname "$LOG_FILE")"
    touch "$LOG_FILE"

    [[ "$ARG" == "reset" ]] && reset_lab

    log "Iniciando preparacion – Bloque 09: Bash Scripting"

    setup_dependencias
    setup_basico
    setup_intermedio
    setup_avanzado
    setup_troubleshooting

    hdr "Preparacion completada"
    echo -e "${GREEN}"
    echo "  Base : $LAB_BASE"
    echo "  Log  : $LOG_FILE"
    echo ""
    echo "  Estructura creada:"
    find "$LAB_BASE" -maxdepth 2 -type d | sort | while read -r d; do
        level=$(echo "$d" | tr -cd '/' | wc -c)
        indent=$(printf '%*s' $(( (level - 4) * 2 )) '')
        count=$(find "$d" -maxdepth 1 -type f 2>/dev/null | wc -l)
        printf "  %s%-35s (%d ficheros)\n" "$indent" "$(basename "$d")" "$count"
    done
    echo -e "${NC}"
    echo -e "${YELLOW}Tip RHCSA/LFCS:${NC} usa shellcheck en todos tus scripts"
    echo "  shellcheck mi_script.sh"
}

main "$@"