#!/bin/bash
# =============================================================================
# SCRIPT 09 - Preparación de entorno: Scripting Bash
# Rocky Linux 9.x
# Certificaciones: LFCS / RHCSA
# =============================================================================
# Uso:
#   chmod +x prep_09_bash_scripting.sh
#   sudo bash prep_09_bash_scripting.sh
#   sudo bash prep_09_bash_scripting.sh reset
# =============================================================================

set -euo pipefail

# ─── Colores ────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ─── Variables globales ──────────────────────────────────────────────────────
LAB_BASE="/opt/labs/bloque09"
LOG_FILE="/var/log/lab_prep_bloque09.log"
ARG="${1:-all}"

# ─── Helpers ────────────────────────────────────────────────────────────────
log()  { echo -e "$(date '+%Y-%m-%d %H:%M:%S') [INFO]  $*" | tee -a "$LOG_FILE"; }
ok()   { echo -e "${GREEN}  ✔ $*${NC}"  | tee -a "$LOG_FILE"; }
warn() { echo -e "${YELLOW}  ⚠ $*${NC}" | tee -a "$LOG_FILE"; }
err()  { echo -e "${RED}  ✘ $*${NC}"   | tee -a "$LOG_FILE"; }
hdr()  {
    echo -e "\n${CYAN}${BOLD}══════════════════════════════════════════${NC}"
    echo -e "${CYAN}${BOLD}  $*${NC}"
    echo -e "${CYAN}${BOLD}══════════════════════════════════════════${NC}"
}

check_root() {
    [[ $EUID -eq 0 ]] || { err "Ejecuta como root: sudo bash $0"; exit 1; }
}

install_pkg() {
    local pkg="$1"
    if ! rpm -q "$pkg" &>/dev/null; then
        dnf install -y "$pkg" &>>"$LOG_FILE" \
            && ok "Instalado: $pkg" \
            || warn "No disponible en repo: $pkg"
    else
        ok "Ya presente: $pkg"
    fi
}

mklab() {
    mkdir -p "$1"
    ok "Dir: $1"
}

# =============================================================================
# RESET
# =============================================================================
reset_lab() {
    hdr "RESET: Limpiando bloque 09"
    rm -rf "$LAB_BASE"
    id labuser &>/dev/null && userdel -r labuser 2>/dev/null && ok "Usuario eliminado: labuser"
    ok "Reset completo"
    exit 0
}

