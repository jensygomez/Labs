    # BUG 3: aritmetica obsoleta con $[ ]
    EXCESO=$[ $BACKUPS_ACTUALES - $MAX_BACKUPS ]
    # BUG 4: sin comillas – falla con espacios en nombres de fichero
    ls -t $BACKUP_DIR/backup_*.tar.gz | tail -$EXCESO | xargs rm
    log_msg "INFO" "Eliminados $EXCESO backups antiguos"
