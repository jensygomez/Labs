# -*- mode: ruby -*-
# vi: set ft=ruby :

# INC-004: SSH Key-Based Authentication Failure (Directory Permissions Drift)
# Topology: node01/02/03 = app fleet | node04 = deployment / automation server

IP = {
  "node01" => "192.168.122.11",
  "node02" => "192.168.122.12",
  "node03" => "192.168.122.13",
  "node04" => "192.168.122.14",
}

# === CLAVE DEL DEPLOYER: generada UNA VEZ en el HOST, nunca en una VM ===
# Antes esto se generaba dentro de node04 y se intentaba compartir via
# /vagrant -- pero /vagrant NO es una carpeta compartida en tiempo real
# entre VMs (es un rsync unidireccional host->VM, congelado al aprovisionar).
# Por eso node01 nunca podia leer la clave que node04 habia generado.
# La solucion: generarla/leerla ACA, en el host, antes de tocar ninguna VM,
# y despues embeberla como texto en los heredocs de cada nodo -- mismo
# patron que ya usamos con la clave SSH personal en inc-001/inc-002.
DEPLOYER_KEY_PATH = File.expand_path("~/.ssh/id_deployer")

unless File.exist?(DEPLOYER_KEY_PATH)
  system("ssh-keygen -t ed25519 -N '' -f #{DEPLOYER_KEY_PATH} -q -C 'deployer@lab'")
end

DEPLOYER_PUBLIC_KEY  = File.read("#{DEPLOYER_KEY_PATH}.pub").strip
DEPLOYER_PRIVATE_KEY = File.read(DEPLOYER_KEY_PATH)

# === CLAVE PERSONAL DE JENSY (para que el/Ansible puedan entrar a las VMs) ===
JENSY_PUBLIC_KEY = File.read(File.expand_path("~/.ssh/id_ed25519.pub")).strip

Vagrant.configure("2") do |config|

  # === INYECTAR CLAVE SSH PERSONAL EN TODAS LAS VMs ===
  config.vm.provision "shell", privileged: false, inline: <<-SHELL
    echo "#{JENSY_PUBLIC_KEY}" >> /home/vagrant/.ssh/authorized_keys
    chmod 600 /home/vagrant/.ssh/authorized_keys
  SHELL

  # ============================================================
  # GLOBAL PROVISIONING -- Minimal requirements
  # ============================================================
  config.vm.provision "shell", privileged: true, inline: <<-SHELL
    echo "Installing base utilities..."
    dnf install -y openssh-clients openssh-server
    systemctl enable --now sshd
  SHELL

  # ============================================================
  # NODE04 -- Deployment / Automation Node
  # ============================================================
  config.vm.define "node04" do |n|
    n.vm.box = "almalinux/9"
    n.vm.hostname = "node04"
    n.vm.network "private_network",
      ip: IP["node04"], libvirt__network_name: "mgmt-net", libvirt__dhcp_enabled: false
    n.vm.provider "libvirt" do |lv|
      lv.memory = 1024
      lv.cpus = 1
      lv.driver = "kvm"
    end

    # La clave del deployer ya existe (viene del host) -- acá solo
    # se ESCRIBE en node04, no se genera de nuevo.
    n.vm.provision "shell", privileged: false, inline: <<-SHELL
      echo "==> node04: writing deployer SSH keypair (generated on host)..."
      mkdir -p ~/.ssh && chmod 700 ~/.ssh

      cat > ~/.ssh/id_deployer <<-'PRIVKEY'
#{DEPLOYER_PRIVATE_KEY}
PRIVKEY
      chmod 600 ~/.ssh/id_deployer
      echo "#{DEPLOYER_PUBLIC_KEY}" > ~/.ssh/id_deployer.pub
      chmod 644 ~/.ssh/id_deployer.pub

      cat > ~/test-deploy-access.sh <<-'TESTSCRIPT'
#!/bin/bash
for ip in 192.168.122.11 192.168.122.12 192.168.122.13; do
  echo -n "Testing deployer SSH connection to appuser@$ip ... "
  if ssh -i ~/.ssh/id_deployer -o StrictHostKeyChecking=no -o ConnectTimeout=3 appuser@$ip "hostname" >/dev/null 2>&1; then
    echo "OK"
  else
    echo "FAILED (Permission denied / Auth failed)"
  fi
done
TESTSCRIPT
      chmod +x ~/test-deploy-access.sh
    SHELL
  end

  # ============================================================
  # FLEET: node01, node02, node03 -- Identical baseline
  # ============================================================
  ["node01", "node02", "node03"].each do |node|
    config.vm.define node do |n|
      n.vm.box = "almalinux/9"
      n.vm.hostname = node
      n.vm.network "private_network",
        ip: IP[node], libvirt__network_name: "mgmt-net", libvirt__dhcp_enabled: false
      n.vm.provider "libvirt" do |lv|
        lv.memory = 1024
        lv.cpus = 1
        lv.driver = "kvm"
      end

      # La clave publica del deployer viene del host directamente --
      # ya NO se lee desde /vagrant, asi que no importa el orden de
      # arranque entre node04 y la flota.
      n.vm.provision "shell", privileged: true, inline: <<-SHELL
        echo "==> #{node}: Setting up application user and SSH baseline..."

        useradd -m -s /bin/bash appuser
        mkdir -p /home/appuser/.ssh
        echo "#{DEPLOYER_PUBLIC_KEY}" > /home/appuser/.ssh/authorized_keys

        chown -R appuser:appuser /home/appuser
        chmod 700 /home/appuser
        chmod 700 /home/appuser/.ssh
        chmod 600 /home/appuser/.ssh/authorized_keys

        echo "==> #{node}: Baseline complete."
      SHELL

      # Ticket lives on every fleet node
      n.vm.provision "shell", privileged: false, inline: <<-SHELL
        cat > ~/TICKET_INC-004.txt <<-'TICKET'
======================================================================
INC-004 - INCIDENT - P2
REPORTED BY: Jenkins CI/CD / Deployment Pipeline     TIME: 04:10 AM
SUMMARY: Automated application deployment failing via SSH on one node
DESCRIPTION:
The automated deployment job running on node04 is unable to deploy code
to 'appuser' on one of the application nodes. The deployment script fails
with "Permission denied (publickey)". As a result, the deployment pipeline
is blocked, and application code is out of sync across the fleet.

NOTES FROM PREVIOUS SHIFT (L1 night):
"Checked sshd service on all target nodes; active and running everywhere.
I verified that the deployer public key on node04 matches the string in
/home/appuser/.ssh/authorized_keys on the failing node. Since the key
matched, I suspected SSH port/firewall issues or sshd_config password
authentication settings being disabled. I restarted sshd on all nodes,
but deployment still fails with 'Permission denied'. Leaving for day shift."

CLIENT IMPACT: Code releases stalled; risk of partial fleet deployments.

RESOLUTION CRITERIA:
1. Identify and discard the false negative (sshd configuration or firewall).
2. Isolate which specific node rejects 'appuser' SSH authentication from node04.
3. Diagnose the root cause (StrictModes / POSIX directory ownership and permissions).
4. Apply standard SSH security permissions on home/SSH directories idempotently.
5. Build an Ansible Triage & Remediation playbook to audit and fix SSH key permissions across the fleet.
======================================================================
TICKET
        echo "Ticket available at ~/TICKET_INC-004.txt"
      SHELL
    end
  end

  # ============================================================
  # ROOT CAUSE INJECTION -- ONLY on node01
  # Fault: Permission drift on home and .ssh path (777 on /home/appuser
  # and 777 on /home/appuser/.ssh). SSHd StrictModes silently rejects
  # key-based auth when parent directories are group/world-writable.
  # ============================================================
  config.vm.define "node01" do |n|
    n.vm.provision "shell", privileged: true, inline: <<-SHELL
      echo "[FAULT] Injecting INC-004 SSH directory permission drift on node01..."

      chmod 777 /home/appuser
      chmod 777 /home/appuser/.ssh
      chmod 666 /home/appuser/.ssh/authorized_keys

      cat > /home/vagrant/break-ssh-perms.sh <<-'BREAK'
#!/bin/bash
set -e
echo "Re-injecting INC-004 (relaxing SSH directory permissions on $(hostname))...."

chmod 777 /home/appuser
chmod 777 /home/appuser/.ssh
chmod 666 /home/appuser/.ssh/authorized_keys

echo "Incident re-injected. SSH permissions broken."
BREAK
      chmod +x /home/vagrant/break-ssh-perms.sh
      chown vagrant:vagrant /home/vagrant/break-ssh-perms.sh

      echo "[FAULT] Ready."
    SHELL
  end

end
