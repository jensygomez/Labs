#!/bin/bash
# Ejercicio: Troubleshooting de Alta Latencia en Servidor
# Simula problemas reales de performance en producción

set -e

echo "=== CREANDO EJERCICIO DE DIAGNÓSTICO DE LATENCIA ==="

LAB_DIR="./latency-troubleshooting-lab"
mkdir -p "$LAB_DIR"
cd "$LAB_DIR"

# 1. Crear Dockerfile especializado para troubleshooting
cat > Dockerfile <<'EOF'
FROM ubuntu:24.04

# Instalar herramientas completas de diagnóstico
RUN apt-get update && apt-get install -y \
    htop \
    iotop \
    nethogs \
    iftop \
    dstat \
    sysstat \
    stress \
    apache2 \
    mysql-server \
    nginx \
    python3 \
    python3-pip \
    curl \
    wget \
    net-tools \
    iproute2 \
    tc \
    && pip3 install requests

# Configurar servicios para simular carga
RUN mkdir -p /var/www/html && \
    echo "<html><body><h1>Servidor Lento Simulado</h1></body></html>" > /var/www/html/index.html

# Script que genera problemas de latency
COPY generar-problemas.sh /root/
RUN chmod +x /root/generar-problemas.sh

# Script de diagnóstico guiado
COPY diagnostico-guiado.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/diagnostico-guiado.sh

CMD ["/root/generar-problemas.sh"]
EOF

# 2. Crear script que genera problemas de latency
cat > generar-problemas.sh <<'EOF'
#!/bin/bash
echo "=== 🐌 INICIANDO SERVIDOR CON PROBLEMAS DE LATENCIA ==="

# Iniciar servicios web
service apache2 start
service nginx start
service mysql start

# Crear carga de CPU (problema 1)
echo "🔴 Generando carga alta de CPU..."
stress --cpu 2 --timeout 3600 &

# Crear carga de I/O (problema 2)  
echo "🔴 Generando carga de disco..."
dd if=/dev/zero of=/tmp/disk-stress bs=1M count=1000 status=progress &

# Crear carga de memoria (problema 3)
echo "🔴 Generando carga de memoria..."
stress --vm 1 --vm-bytes 512M --timeout 3600 &

# Simular problemas de red (problema 4)
echo "🔴 Configurando latencia de red artificial..."
tc qdisc add dev eth0 root netem delay 500ms 100ms 25% loss 2% duplicate 1%

# Simular procesos zombies (problema 5)
echo "🔴 Creando procesos problemáticos..."
for i in {1..5}; do
    sleep 1000 &
done

# Servicio web lento (problema 6)
echo "🔴 Configurando servicio web lento..."
cat > /var/www/html/slow.php <<'PHPEOF'
<?php
// Simular procesamiento lento
usleep(500000); // 500ms delay
echo "Página con alta latencia - " . date('H:i:s');
?>
PHPEOF

# Base de datos con queries lentos (problema 7)
echo "🔴 Configurando MySQL con queries lentos..."
mysql -e "
CREATE DATABASE IF NOT EXISTS slow_db;
USE slow_db;
CREATE TABLE IF NOT EXISTS slow_table (
    id INT PRIMARY KEY AUTO_INCREMENT,
    data TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Insertar datos de prueba
INSERT INTO slow_table (data) VALUES 
('Datos de prueba 1'),
('Datos de prueba 2'),
('Datos de prueba 3');

-- Crear stored procedure lento
DELIMITER $$
CREATE PROCEDURE slow_query()
BEGIN
    DO SLEEP(2); -- Query que toma 2 segundos
    SELECT * FROM slow_table;
END$$
DELIMITER ;
"

echo ""
echo "✅ PROBLEMAS CONFIGURADOS EXITOSAMENTE"
echo ""
echo "📊 SÍNTOMAS REPORTADOS POR HELP DESK:"
echo "   - Páginas web timeout (5+ segundos)"
echo "   - Aplicaciones lentas para cargar"
echo "   - Tiempos de respuesta inconsistentes"
echo "   - Usuarios reportando 'congelamientos'"
echo ""
echo "🔧 HERRAMIENTAS DISPONIBLES:"
echo "   - top, htop, atop                  # CPU y procesos"
echo "   - iotop, iostat                    # I/O del disco"
echo "   - vmstat, free                     # Memoria"
echo "   - iftop, nethogs                   # Red"
echo "   - dstat, sar                       # Métricas combinadas"
echo "   - netstat, ss                      # Conexiones"
echo "   - mysqladmin                       # Base de datos"
echo ""
echo "🎯 TU MISIÓN:"
echo "   Identificar las 7 causas de latencia usando herramientas de diagnóstico"
echo ""
echo "💡 PISTA INICIAL: Comienza con 'htop' para visión general"

# Script interactivo de monitoreo
while true; do
    echo ""
    echo "=== 🕒 SIMULANDO TRAFICO WEB ==="
    # Generar requests HTTP
    curl -s http://localhost/ > /dev/null
    curl -s http://localhost/slow.php > /dev/null
    # Query lento a MySQL
    mysql -e "CALL slow_db.slow_query()" > /dev/null 2>&1 &
    sleep 5
done
EOF

# 3. Crear script de diagnóstico guiado
cat > diagnostico-guiado.sh <<'EOF'
#!/bin/bash
# Script de diagnóstico guiado para problemas de latencia

echo "=== 🔍 DIAGNÓSTICO DE LATENCIA - HERRAMIENTAS ==="

while true; do
    echo ""
    echo "Selecciona una herramienta de diagnóstico:"
    echo "1.  htop          - Procesos y CPU"
    echo "2.  iotop         - I/O del disco"
    echo "3.  vmstat 1 5    - Memoria y sistema"
    echo "4.  iostat -x 1 3 - Estadísticas de disco"
    echo "5.  iftop         - Tráfico de red"
    echo "6.  dstat -cdngy  - Métricas combinadas"
    echo "7.  nethogs       - Ancho de banda por proceso"
    echo "8.  mysqladmin    - Estado de base de datos"
    echo "9.  ss -tulpn     - Conexiones de red"
    echo "10. free -h       - Memoria disponible"
    echo "11. uptime        - Load average"
    echo "12. SAR report    - Histórico del sistema"
    echo "0.  Salir"
    echo ""
    read -p "Opción [0-12]: " choice

    case $choice in
        1) htop ;;
        2) iotop ;;
        3) vmstat 1 5 ;;
        4) iostat -x 1 3 ;;
        5) iftop ;;
        6) dstat -cdngy ;;
        7) nethogs ;;
        8) mysqladmin processlist ;;
        9) ss -tulpn ;;
        10) free -h ;;
        11) uptime ;;
        12) sar ;;
        0) break ;;
        *) echo "Opción inválida" ;;
    esac
done
EOF

