    {
      "mode": "managed",
      "type": "lxd_container",
      "name": "monitoring",
      "provider": "provider[\"registry.terraform.io/terraform-lxd/lxd\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "config": {
              "user.user-data": "#cloud-config\ndisable_root: false\n\nssh_authorized_keys:\n  - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN+gsGnVlOOJXtW6Wz87hc1CPhOz++T2lCoB6F3Eksbg jensyg@lxd-fleet\n\nwrite_files:\n  - path: /root/.ssh/authorized_keys\n    owner: root:root\n    permissions: '0600'\n    content: |\n      ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN+gsGnVlOOJXtW6Wz87hc1CPhOz++T2lCoB6F3Eksbg jensyg@lxd-fleet\n\n  - path: /etc/ssh/sshd_config.d/00-lxd-root.conf\n    owner: root:root\n    permissions: '0644'\n    content: |\n      PermitRootLogin yes\n\npackage_update: true\n\npackages:\n  - python3\n  - openssh-server\n  - e2fsprogs\n  - tar\n  - wget\n\nruncmd:\n  - ssh-keygen -A\n  - mkdir -p /root/.ssh\n  - chmod 700 /root/.ssh\n  - chown root:root /root/.ssh/authorized_keys || true\n  - chmod 600 /root/.ssh/authorized_keys || true\n  - sed -i -E \"s/^#?PermitRootLogin.*/PermitRootLogin yes/\" /etc/ssh/sshd_config || true\n  - systemctl enable --now sshd\n  - systemctl restart sshd\n\nfinal_message: \"cloud-init finished\"\n"
            },
            "device": [],
            "ephemeral": false,
            "file": [],
            "id": "monitoring",
            "image": "almalinux9-cloud",
