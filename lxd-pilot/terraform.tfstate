        {
          "schema_version": 0,
          "attributes": {
            "config": {
              "user.user-data": "#cloud-config\ndisable_root: false\nssh_authorized_keys:\n  - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN+gsGnVlOOJXtW6Wz87hc1CPhOz++T2lCoB6F3Eksbg jensyg@lxd-fleet\nwrite_files:\n  - path: /etc/ssh/sshd_config.d/00-lxd-root.conf\n    content: |\n      PermitRootLogin yes\n      PasswordAuthentication no\npackages:\n  - python3\n  - openssh-server\n  - tar\n  - wget\n  - curl\n  - unzip\n  - bind-utils\nruncmd:\n  - ssh-keygen -A\n  - systemctl enable --now sshd\n"
            },
