#!/bin/bash
LOG_FILE=/var/log/s3-backend.log
MOUNT_POINT=/mnt/central-orders
READY_FLAG=/var/lib/aws-creds-setup/.ready

mkdir -p "$MOUNT_POINT"

# Deterministic dependency check. This is the actual condition the
# service depends on -- do not rely on the AWS CLI / FakeCloud to
# surface a missing-credentials error, since FakeCloud accepts
# unauthenticated requests.
if [ ! -f "$READY_FLAG" ]; then
    echo "[$(date)] S3 backend FAILED: dependency not ready ($READY_FLAG missing)" >> "$LOG_FILE"
    exit 1
fi

RESULT=$(aws --endpoint-url {{ fakecloud_endpoint }} s3 ls s3://{{ bucket_name }} 2>&1)
if [ $? -eq 0 ]; then
    echo "[$(date)] S3 backend connected" >> "$LOG_FILE"
    touch "$MOUNT_POINT/.s3-mounted"
    echo "[$(date)] Backend mounted at $MOUNT_POINT" >> "$LOG_FILE"
    exit 0
else
    echo "[$(date)] S3 backend FAILED: $RESULT" >> "$LOG_FILE"
    exit 1
fi
