#!/bin/bash
# =============================================================================
# LAB BLOQUE 1 — Fundamentos del sistema
# Preparación para LFCS + RHCSA
# Rocky Linux 9 — Ejecutar como root
# =============================================================================
#
# ¿QUÉ HACE ESTE SCRIPT?
#
# Este script prepara un entorno de laboratorio completo en Rocky Linux 9
# para practicar los temas del Bloque 1 del temario LFCS y RHCSA. No instala
# ninguna aplicación de producción ni modifica configuraciones críticas del
# sistema. Todo lo que crea está aislado en directorios de práctica como
# /lab, /var/log/lab, /tmp y /opt/app.
#
# El script crea usuarios y grupos ficticios (juan, maria, carlos, deploy,
# auditor, appd) con la contraseña Lab2024!, genera archivos de log con
# contenido realista, y configura delibaeradamente permisos incorrectos,
# links rotos, ACLs mal configuradas y otros problemas que el alumno debe
# diagnosticar y corregir. Cada escenario está diseñado para simular una
# situación real que puede aparecer en el examen o en el trabajo diario
# como administrador de sistemas Linux.
#
# Al finalizar, genera el archivo /root/LAB_BLOQUE1_EJERCICIOS.txt con la
# guía completa de ejercicios ordenados por nivel: Básico, Intermedio,
# Avanzado y Troubleshooting. Se recomienda leer esa guía antes de empezar
# a practicar y ejecutar cada ejercicio sin mirar la solución primero.
#
# REQUISITOS: Rocky Linux 9, acceso a internet, ejecutar como root.
# TIEMPO ESTIMADO DE PRÁCTICA: 4 a 6 horas para completar todos los niveles.
# =============================================================================



set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

banner() {
    echo -e "\n${BLUE}============================================================${NC}"
    echo -e "${BLUE}  $1${NC}"
    echo -e "${BLUE}============================================================${NC}\n"
}

ok() { echo -e "${GREEN}[OK]${NC} $1"; }
info() { echo -e "${CYAN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }

# =============================================================================
# VERIFICACIONES PREVIAS Y BACKUP
# =============================================================================
banner "Verificando entorno y creando backups"

if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}[ERROR] Este script debe ejecutarse como root${NC}"
    exit 1
fi

if ! grep -q "Rocky Linux" /etc/os-release; then
    warn "Este script fue diseñado para Rocky Linux 9. Continuar bajo tu propio riesgo."
fi

# Crear directorio de backups
BACKUP_DIR="/root/lab_backups_bloque1_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$BACKUP_DIR"

# Backup de archivos importantes que podrían modificarse
for file in /etc/passwd /etc/shadow /etc/group /etc/sudoers /etc/fstab; do
    if [ -f "$file" ]; then
        cp "$file" "$BACKUP_DIR/" 2>/dev/null || true
        info "Resguardado: $file → $BACKUP_DIR/"
    fi
done

ok "Ejecutando como root en Rocky Linux"
ok "Backups guardados en $BACKUP_DIR"

# =============================================================================
# INSTALACIÓN DE PAQUETES NECESARIOS
# =============================================================================
banner "Instalando paquetes necesarios"

dnf install -y acl vim tar gzip bzip2 xz tree httpd \
    policycoreutils-python-utils curl wget git vsftpd \
    setroubleshoot setools-console 2>/dev/null

ok "Paquetes instalados"

# =============================================================================
# CREACIÓN DE USUARIOS Y GRUPOS (LIMPIEZA PREVIA)
# =============================================================================
banner "Preparando usuarios y grupos del laboratorio"

# Eliminar usuarios del bloque anterior si existen (para empezar limpio)
for user in juan maria carlos deploy auditor appd tempuser_lab; do
    if id "$user" &>/dev/null; then
        userdel -r "$user" 2>/dev/null || warn "No se pudo eliminar $user completamente"
    fi
done

# Eliminar grupos del bloque anterior
for grp in developers auditores contabilidad ti; do
    if getent group "$grp" &>/dev/null; then
        groupdel "$grp" 2>/dev/null || warn "No se pudo eliminar grupo $grp"
    fi
done

# Crear usuarios nuevos
for user in juan maria carlos deploy auditor appd; do
    useradd -m "$user"
    echo "${user}:Lab2024!" | chpasswd
    ok "Usuario $user creado"
done

# Crear grupos
for grp in developers auditores contabilidad ti; do
    groupadd "$grp"
    ok "Grupo $grp creado"
done

# Configurar membresías
usermod -aG developers juan
usermod -aG developers deploy
usermod -aG auditores auditor
usermod -aG contabilidad maria
usermod -aG ti carlos

ok "Membresías de grupos configuradas"

# =============================================================================
# CREACIÓN DE ESTRUCTURA DE DIRECTORIOS
# =============================================================================
banner "Creando estructura de directorios para prácticas"

mkdir -p /lab/bloque1/{filesystem,permisos,permisos_especiales,acls,links,compresion,paquetes,vim}
mkdir -p /var/log/lab/{httpd,app,database}
mkdir -p /opt/app/{config,bin,logs,data}
mkdir -p /data/{produccion,backups,compartido}
mkdir -p /proyectos/{dev,docs,releases}
mkdir -p /srv/{compartido,web,ftp}
mkdir -p /tmp/lab_practicas

ok "Estructura de directorios creada"

# =============================================================================
# BLOQUE 1.1 — NAVEGACIÓN FILESYSTEM (VERSIÓN MEJORADA)
# =============================================================================
banner "Bloque 1.1 — Navegación Filesystem"

# Archivos .conf con diferentes fechas
for i in $(seq 1 20); do
    cat > /etc/lab_service_${i}.conf << EOF
# Configuración del servicio lab_service_${i}
SERVICE_NAME=lab_service_${i}
PORT=$((8000 + i))
LOG_LEVEL=$([ $((i % 3)) -eq 0 ] && echo "debug" || echo "info")
MAX_CONNECTIONS=$((100 * i))
TIMEOUT=$((30 + i))
EOF
    # Fechas aleatorias para algunos archivos (entre 1 y 30 días atrás)
    if [ $((i % 4)) -eq 0 ]; then
        touch -d "$((RANDOM % 30 + 1)) days ago" /etc/lab_service_${i}.conf
    fi
done

# Logs con diferentes tamaños y formatos
info "Generando logs de práctica con diferentes tamaños..."

# Log de autenticación (formato estándar)
for i in $(seq 1 10000); do
    USER="user_$((RANDOM % 50))"
    IP="192.168.1.$((RANDOM % 254))"
    PORT=$((RANDOM % 60000 + 1024))
    echo "$(date '+%b %d %H:%M:%S') server01 sshd[$$]: Accepted password for $USER from $IP port $PORT ssh2" >> /var/log/lab/auth_practice.log
done

# Log de aplicación (formato JSON para práctica avanzada)
for i in $(seq 1 5000); do
    echo "{\"timestamp\":\"$(date -Iseconds)\",\"level\":\"$([ $((RANDOM % 10)) -eq 0 ] && echo "ERROR" || echo "INFO")\",\"service\":\"api-gateway\",\"request_id\":\"$(cat /proc/sys/kernel/random/uuid 2>/dev/null || echo $RANDOM$RANDOM)\",\"method\":\"$([ $((RANDOM % 2)) -eq 0 ] && echo "GET" || echo "POST")\",\"path\":\"/api/v$((RANDOM % 3))/resource/$((RANDOM % 1000))\",\"status\":$([ $((RANDOM % 10)) -eq 0 ] && echo "500" || echo "200\"),\"response_time_ms\":$((RANDOM % 1000))}" >> /var/log/lab/app_json.log
done

# Log grande (>50MB para ejercicios avanzados)
for i in $(seq 1 100000); do
    echo "$(date '+%Y-%m-%d %H:%M:%S') [worker-$((RANDOM % 50))] Procesando lote $i - registro $RANDOM para generar volumen" >> /var/log/lab/app_large.log
done

# Archivos con inodos específicos para práctica
echo "Archivo 1 para práctica de inodos" > /var/log/lab/inode_practice_1.txt
echo "Archivo 2 para práctica de inodos" > /var/log/lab/inode_practice_2.txt
echo "Archivo 3 para práctica de inodos" > /var/log/lab/inode_practice_3.txt

# Archivo huérfano (propietario eliminado)
useradd -u 9999 tempuser_orphan 2>/dev/null || true
echo "Este archivo pertenece a un usuario que ya no existe en el sistema" > /var/log/lab/orphan_file.txt
chown 9999:9999 /var/log/lab/orphan_file.txt 2>/dev/null || true
userdel tempuser_orphan 2>/dev/null || true

# Archivo con permisos especiales para find (oculto)
echo "Archivo oculto para práctica de find" > /var/log/lab/.hidden_practice.txt

ok "Escenarios de navegación filesystem mejorados listos"

# =============================================================================
# BLOQUE 1.2 — PERMISOS ESTÁNDAR (VERSIÓN MEJORADA)
# =============================================================================
banner "Bloque 1.2 — Permisos estándar"

# --- BÁSICO: Archivos con permisos incorrectos ---
# Archivo con permisos 777 que debería ser 644
echo "Confidencial: Estrategia de ventas Q1 2025" > /tmp/estrategia_ventas.txt
chmod 777 /tmp/estrategia_ventas.txt

# Archivo con permisos 644 que debería ser 755 (ejecutable)
echo '#!/bin/bash' > /opt/app/backup_script.sh
echo 'echo "Realizando backup..."' >> /opt/app/backup_script.sh
chmod 644 /opt/app/backup_script.sh

# Archivo con propietario incorrecto
echo "Configuración de la aplicación" > /opt/app/app.conf
chown root:root /opt/app/app.conf  # Debería ser deploy:developers

# --- INTERMEDIO: Configuraciones umask y permisos por defecto ---
mkdir -p /home/juan/workspace
touch /home/juan/workspace/{proyecto.py,README.md,config.ini}
chown -R juan:juan /home/juan/workspace

# Directorio con permisos 777 que debería ser 750
mkdir -p /data/compartido
echo "Datos compartidos del equipo" > /data/compartido/team_data.txt
chmod 777 /data/compartido
chmod 666 /data/compartido/team_data.txt

# --- AVANZADO: Permisos para servicios específicos ---
mkdir -p /opt/app/config
echo "DB_PASSWORD=supersecret123" > /opt/app/config/db.conf
echo "API_KEY=abc123def456" >> /opt/app/config/db.conf
chown root:appd /opt/app/config /opt/app/config/db.conf
chmod 750 /opt/app/config          # Solo root y grupo appd pueden entrar
chmod 640 /opt/app/config/db.conf  # appd (grupo) puede leer, otros no

# --- TROUBLESHOOTING: Servicios que fallan por permisos ---
# httpd no puede leer su archivo
mkdir -p /var/www/html/lab
echo "<h1>Laboratorio LFCS/RHCSA</h1><p>Página de práctica con problemas de permisos</p>" > /var/www/html/lab/index.html
chmod 600 /var/www/html/lab/index.html  # Demasiado restrictivo
chown root:root /var/www/html/lab/index.html

# Aplicación no puede escribir logs
mkdir -p /opt/app/logs
touch /opt/app/logs/application.log
chmod 444 /opt/app/logs/application.log  # Solo lectura, la app necesita escribir
chown appd:developers /opt/app/logs/application.log

ok "Escenarios de permisos estándar mejorados listos"

# =============================================================================
# BLOQUE 1.3 — PERMISOS ESPECIALES (VERSIÓN MEJORADA)
# =============================================================================
banner "Bloque 1.3 — Permisos especiales (SUID/SGID/Sticky)"

# --- BÁSICO: Sticky bit faltante ---
mkdir -p /var/tmp/compartido_publico
chmod 777 /var/tmp/compartido_publico  # Sin sticky bit - problema de seguridad

# Crear archivos de diferentes usuarios
su - juan -c "echo 'Archivo de Juan' > /var/tmp/compartido_publico/juan_doc.txt" 2>/dev/null || \
    (echo "Archivo de juan" > /var/tmp/compartido_publico/juan_doc.txt && chown juan /var/tmp/compartido_publico/juan_doc.txt)

su - maria -c "echo 'Archivo de Maria' > /var/tmp/compartido_publico/maria_doc.txt" 2>/dev/null || \
    (echo "Archivo de maria" > /var/tmp/compartido_publico/maria_doc.txt && chown maria /var/tmp/compartido_publico/maria_doc.txt)

su - carlos -c "echo 'Archivo de Carlos' > /var/tmp/compartido_publico/carlos_doc.txt" 2>/dev/null || \
    (echo "Archivo de carlos" > /var/tmp/compartido_publico/carlos_doc.txt && chown carlos /var/tmp/compartido_publico/carlos_doc.txt)

# --- INTERMEDIO: SGID para herencia de grupo ---
mkdir -p /proyectos/colaboracion
chown root:developers /proyectos/colaboracion
chmod 770 /proyectos/colaboracion  # Sin SGID - los archivos no heredan el grupo

# Crear estructura para probar SGID
mkdir -p /proyectos/colaboracion/{documentos,scripts,datos}
touch /proyectos/colaboracion/documentos/README.md
touch /proyectos/colaboracion/scripts/deploy.sh
touch /proyectos/colaboracion/datos/clientes.csv

# --- AVANZADO: Binarios con SUID innecesario ---
# Crear binarios "peligrosos" para auditoría
cp /usr/bin/cat /usr/local/bin/cat_viewer
chmod u+s /usr/local/bin/cat_viewer

cp /usr/bin/less /usr/local/bin/less_viewer
chmod u+s /usr/local/bin/less_viewer

cp /usr/bin/find /usr/local/bin/find_lab
chmod u+s /usr/local/bin/find_lab

cp /usr/bin/vim /usr/local/bin/vim_lab
chmod u+s /usr/local/bin/vim_lab

# --- TROUBLESHOOTING: Permisos especiales causando problemas ---
# SUID en binario que no debería tenerlo (riesgo de seguridad)
cp /usr/bin/cp /usr/local/bin/cp_lab
chmod u+s /usr/local/bin/cp_lab

# Sticky bit en directorio donde no debería estar
mkdir -p /tmp/no_sticky_needed
chmod 1777 /tmp/no_sticky_needed  # No debería tener sticky bit

ok "Escenarios de permisos especiales mejorados listos"

# =============================================================================
# BLOQUE 1.4 — ACLs (VERSIÓN MEJORADA)
# =============================================================================
banner "Bloque 1.4 — ACLs"

# --- BÁSICO: Archivos con ACLs para práctica ---
mkdir -p /data/reportes
echo "Reporte financiero 2024 - Confidencial" > /data/reportes/financiero.txt
echo "Reporte de ventas 2024 - Departamental" > /data/reportes/ventas.txt
echo "Reporte RRHH 2024 - Restringido" > /data/reportes/rrhh.txt

chown root:contabilidad /data/reportes
chmod 770 /data/reportes
chown maria:contabilidad /data/reportes/financiero.txt
chown carlos:ti /data/reportes/ventas.txt
chown root:rrhh /data/reportes/rrhh.txt

# --- INTERMEDIO: ACLs por defecto en directorios ---
mkdir -p /proyectos/compartido
chown root:developers /proyectos/compartido
chmod 770 /proyectos/compartido

# Configurar ACL por defecto (pero con problemas para troubleshooting)
setfacl -m d:u:auditor:r /proyectos/compartido 2>/dev/null || true
setfacl -m d:g:auditores:rx /proyectos/compartido 2>/dev/null || true

# --- AVANZADO: ACLs complejas para escenarios empresariales ---
mkdir -p /data/empresa/{finanzas,rrhh,it,ventas}

# Finanzas: solo contabilidad rw, auditorías r
chown root:contabilidad /data/empresa/finanzas
chmod 770 /data/empresa/finanzas
setfacl -m g:auditores:rx /data/empresa/finanzas 2>/dev/null || true

# RRHH: solo rrhh rw, nadie más (ni siquiera root en runtime)
chown root:rrhh /data/empresa/rrhh
chmod 770 /data/empresa/rrhh

# IT: desarrolladores rw, operaciones r, auditorías r
chown root:sistemas /data/empresa/it
chmod 770 /data/empresa/it
setfacl -m g:desarrolladores:rwx /data/empresa/it 2>/dev/null || true
setfacl -m g:operaciones:rx /data/empresa/it 2>/dev/null || true
setfacl -m g:auditores:r /data/empresa/it 2>/dev/null || true

# --- TROUBLESHOOTING: Problemas con ACLs ---
# Caso 1: Usuario con ACL pero mask lo restringe
mkdir -p /datos/privado
echo "Información altamente confidencial" > /datos/privado/secreto.txt
chown root:ti /datos/privado /datos/privado/secreto.txt
chmod 750 /datos/privado
chmod 640 /datos/privado/secreto.txt

# Dar permisos a carlos (está en ti) pero con mask restrictiva
setfacl -m u:carlos:rwx /datos/privado/secreto.txt 2>/dev/null || true
setfacl -m m::r /datos/privado/secreto.txt 2>/dev/null || true  # Esto limita los permisos efectivos

# Caso 2: Directorio padre sin permiso de ejecución
mkdir -p /opt/restricted/app
echo "Configuración de aplicación" > /opt/restricted/app/config.conf
chmod 750 /opt/restricted       # Grupo puede entrar
chmod 700 /opt/restricted/app    # Nadie más que root puede entrar a app
setfacl -m u:deploy:rwx /opt/restricted/app/config.conf 2>/dev/null || true  # No podrá llegar

ok "Escenarios de ACLs mejorados listos"

# =============================================================================
# BLOQUE 1.5 — LINKS (VERSIÓN MEJORADA)
# =============================================================================
banner "Bloque 1.5 — Links"

# --- BÁSICO: Links simbólicos válidos e inválidos ---
# Archivo origen
mkdir -p /etc/app/config
echo "# Configuración principal" > /etc/app/config/app.conf
echo "MODE=production" >> /etc/app/config/app.conf
echo "PORT=8080" >> /etc/app/config/app.conf

# Links válidos
ln -sf /etc/app/config/app.conf /opt/app.conf.current 2>/dev/null || true
ln -sf /etc/app/config /opt/app_config_dir 2>/dev/null || true

# --- INTERMEDIO: Hard links y sus limitaciones ---
echo "Contenido para hard link practice" > /tmp/original.txt
ln /tmp/original.txt /tmp/hardlink_backup.txt 2>/dev/null || true

# Crear archivo en otro filesystem para demostrar limitación
mkdir -p /tmp/otro_fs 2>/dev/null || true
mount --bind /tmp /tmp/otro_fs 2>/dev/null || true
echo "Archivo en otro punto de montaje" > /tmp/otro_fs/archivo_origen.txt
# Intentar hard link a través de filesystem (fallará - para demostración)

# --- AVANZADO: Links rotos y cadenas de links ---
# Links rotos
ln -sf /etc/nonexistent/config.conf /etc/broken_link1.conf 2>/dev/null || true
ln -sf /var/log/nonexistent/access.log /var/log/broken_link.log 2>/dev/null || true
ln -sf /opt/missing/bin/script.sh /usr/local/bin/broken_script 2>/dev/null || true

# Cadena de links (link que apunta a otro link)
ln -sf /opt/app.conf.current /opt/app.conf.link1 2>/dev/null || true
ln -sf /opt/app.conf.link1 /opt/app.conf.link2 2>/dev/null || true
ln -sf /opt/app.conf.link2 /opt/app.conf.link3 2>/dev/null || true

# --- TROUBLESHOOTING: Servicio falla por link roto ---
mkdir -p /opt/application/{config,bin}
echo "#!/bin/bash" > /opt/application/bin/start.sh
echo "echo 'Iniciando aplicación...'" >> /opt/application/bin/start.sh
echo "source /opt/application/config/settings.conf" >> /opt/application/bin/start.sh
chmod 755 /opt/application/bin/start.sh

# Crear link roto que el script intenta usar
ln -sf /opt/application/config/settings.conf.real /opt/application/config/settings.conf 2>/dev/null || true
# El archivo real está en otro lugar
echo "APP_ENV=production" > /opt/application/config/settings.conf.real
echo "DB_HOST=localhost" >> /opt/application/config/settings.conf.real

ok "Escenarios de links mejorados listos"

# =============================================================================
# BLOQUE 1.6 — COMPRESIÓN (VERSIÓN MEJORADA)
# =============================================================================
banner "Bloque 1.6 — Compresión"

# --- BÁSICO: Archivos para comprimir ---
mkdir -p /lab/compresion/{documentos,logs,backups}

# Documentos de diferentes tamaños
for i in $(seq 1 10); do
    dd if=/dev/urandom of=/lab/compresion/documentos/archivo_${i}.bin bs=1M count=$i 2>/dev/null || \
        fallocate -l ${i}M /lab/compresion/documentos/archivo_${i}.bin 2>/dev/null || \
        for j in $(seq 1 $((i * 1000))); do echo "Contenido aleatorio $RANDOM" >> /lab/compresion/documentos/archivo_${i}.txt; done
done

# Logs con diferentes patrones (buenos para compresión)
for i in $(seq 1 1000); do
    echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] Procesando lote $i con ID=$(uuidgen 2>/dev/null || echo $RANDOM)" >> /lab/compresion/logs/app.log
    echo "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] Fallo en la operación $i" >> /lab/compresion/logs/error.log
done

# --- INTERMEDIO: Archivos para comparar algoritmos ---
# Crear archivos con diferentes tipos de contenido
dd if=/dev/zero of=/lab/compresion/zeros.dat bs=1M count=5 2>/dev/null || \
    fallocate -l 5M /lab/compresion/zeros.dat

dd if=/dev/urandom of=/lab/compresion/random.dat bs=1M count=5 2>/dev/null || \
    for i in $(seq 1 5000); do echo $RANDOM >> /lab/compresion/random.txt; done

# Archivo con patrones repetitivos (alta compresión)
for i in $(seq 1 10000); do
    echo "Patrón repetitivo número $((i % 10)) para probar compresión" >> /lab/compresion/repetitivo.log
done

# --- AVANZADO: Backups incrementales y excludes ---
mkdir -p /lab/compresion/datos_para_backup/{config,data,temp,logs,backups}

# Archivos de configuración (incluir en backup)
for i in $(seq 1 5); do
    cat > /lab/compresion/datos_para_backup/config/servicio_${i}.conf << EOF
# Servicio $i
PORT=$((8000 + i))
MAX_CONNECTIONS=$((100 * i))
LOG_LEVEL=info
EOF
done

# Datos (incluir)
for i in $(seq 1 10); do
    echo "Registro de datos $i: $(date)" >> /lab/compresion/datos_para_backup/data/data_$i.log
done

# Archivos temporales (excluir del backup)
touch /lab/compresion/datos_para_backup/temp/temp_1.tmp
touch /lab/compresion/datos_para_backup/temp/temp_2.tmp
touch /lab/compresion/datos_para_backup/logs/debug.log
touch /lab/compresion/datos_para_backup/backups/backup_antiguo.tar.gz

# --- TROUBLESHOOTING: Backup corrupto ---
# Crear un archivo tar.gz y luego corromperlo
tar czf /tmp/backup_corrupto.tar.gz /etc/hostname /etc/hosts 2>/dev/null || true
# Corromper el archivo (sobrescribir parte con datos aleatorios)
dd if=/dev/urandom of=/tmp/backup_corrupto.tar.gz bs=1 count=100 seek=500 conv=notrunc 2>/dev/null || \
    echo "corrupción" >> /tmp/backup_corrupto.tar.gz

ok "Escenarios de compresión mejorados listos"

# =============================================================================
# BLOQUE 1.7 — GESTIÓN DE PAQUETES (VERSIÓN MEJORADA)
# =============================================================================
banner "Bloque 1.7 — Gestión de paquetes"

# Instalar algunos paquetes para práctica
dnf install -y vsftpd lftp telnet wget curl 2>/dev/null || true

# --- INTERMEDIO: Módulos y grupos ---
# Nota: Esto es informativo, no modifica el sistema

# --- AVANZADO: Repositorio local (simulado) ---
mkdir -p /var/www/html/repo-local
echo "Simulación de repositorio local" > /var/www/html/repo-local/README

# --- TROUBLESHOOTING: Modificar archivo para rpm -V ---
if rpm -q httpd &>/dev/null; then
    # Backup del original
    cp /etc/httpd/conf/httpd.conf /etc/httpd/conf/httpd.conf.original 2>/dev/null || true
    # Modificar archivo
    echo "# LÍNEA MODIFICADA INTENCIONALMENTE PARA PRÁCTICA RPM -V $(date)" >> /etc/httpd/conf/httpd.conf
    ok "Archivo de httpd modificado para práctica de verificación"
fi

# Crear conflicto de dependencia simulado
touch /var/lib/rpm-state/conflicto-simulado 2>/dev/null || true

ok "Escenarios de gestión de paquetes mejorados listos"

# =============================================================================
# BLOQUE 1.8 — VIM (VERSIÓN MEJORADA)
# =============================================================================
banner "Bloque 1.8 — Vim"

# --- BÁSICO: Archivo con muchas líneas para navegación ---
for i in $(seq 1 150); do
    echo "Línea $i: Este es un archivo de práctica para aprender a navegar en vim.
Podemos buscar texto, reemplazar, movernos rápidamente, etc.
La fecha de este registro es $(date '+%Y-%m-%d %H:%M:%S').
El número aleatorio de hoy es $RANDOM.
---" >> /tmp/vim_practice_long.txt
done

# --- INTERMEDIO: Archivo con múltiples ocurrencias para búsqueda/reemplazo ---
cat > /tmp/vim_practice_replace.txt << 'EOF'
# Archivo de configuración para práctica de búsqueda y reemplazo en vim

server_name = oldserver01
server_ip = 192.168.1.100
server_port = 8080
oldserver01_admin = admin@oldserver01.com

[database]
db_server = oldserver01
db_name = olddb
db_user = olduser
db_password = oldpass123

[logging]
log_server = oldserver01
log_level = INFO

[backup]
backup_server = oldserver01
backup_path = /backup/oldserver01

# Nota: Reemplazar todas las ocurrencias de 'oldserver01' por 'newserver01'
# pero solo en las líneas que no sean comentarios
EOF

# --- AVANZADO: Múltiples archivos para edición simultánea ---
cat > /tmp/vim_practice_file1.txt << 'EOF'
Archivo 1 - Configuración de producción
IP: 10.0.0.10
Hostname: prod-server-01
Ambiente: PRODUCCION
Puertos: 80,443,22
EOF

cat > /tmp/vim_practice_file2.txt << 'EOF'
Archivo 2 - Configuración de staging
IP: 10.0.0.20
Hostname: staging-server-01
Ambiente: STAGING
Puertos: 8080,8443,22
EOF

cat > /tmp/vim_practice_file3.txt << 'EOF'
Archivo 3 - Configuración de desarrollo
IP: 10.0.0.30
Hostname: dev-server-01
Ambiente: DESARROLLO
Puertos: 3000,5000,22
EOF

# --- TROUBLESHOOTING: Archivo de sistema para editar sin romper ---
cat > /tmp/vim_practice_critical.txt << 'EOF'
# ESTE ES UN ARCHIVO SIMULADO DE SISTEMA
# En la práctica real, podrías tener que editar /etc/fstab, /etc/sudoers, etc.
# Debes tener cuidado de no romper la sintaxis

# /etc/fstab simulado
/dev/mapper/rl-root     /                       xfs     defaults        0 0
/dev/mapper/rl-swap     none                    swap    defaults        0 0
/dev/sda1               /boot                   xfs     defaults        0 0

# Este archivo tiene una línea crítica. Si la modificas incorrectamente,
# el sistema podría no arrancar.

# Punto de montaje de datos IMPORTANTE
/dev/sdb1               /data                   xfs     defaults        0 0

# NO MODIFICAR LAS LÍNEAS ANTERIORES SIN COMPRENDER LAS CONSECUENCIAS
EOF

ok "Escenarios de Vim mejorados listos"

