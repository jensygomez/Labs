echo ""
echo -e "${GREEN}================================================================${NC}"
echo -e "${GREEN}  LABORATORIO BLOQUE 1 CONFIGURADO EXITOSAMENTE${NC}"
echo -e "${GREEN}================================================================${NC}"
echo ""
echo -e "  Guía de ejercicios guardada en: ${CYAN}/root/LAB_BLOQUE1_EJERCICIOS.txt${NC}"
echo ""
echo -e "  Usuarios creados (contraseña: ${YELLOW}Lab2024!${NC}):"
echo -e "    juan, maria, carlos, deploy, auditor, appd"
echo ""
echo -e "  Grupos creados:"
echo -e "    developers, auditores, contabilidad, ti"
echo ""
echo -e "  Logs de práctica en: ${CYAN}/var/log/lab/${NC}"
echo -e "  Archivos de lab en:  ${CYAN}/lab/bloque1/${NC}"
echo ""
echo -e "  Para ver los ejercicios:"
echo -e "    ${CYAN}cat /root/LAB_BLOQUE1_EJERCICIOS.txt${NC}"
echo ""
echo -e "${GREEN}================================================================${NC}"