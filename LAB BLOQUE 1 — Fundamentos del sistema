#!/bin/bash
# =============================================================================
# LAB BLOQUE 1 — Fundamentos del sistema
# Preparación para LFCS + RHCSA
# Rocky Linux 9 — Ejecutar como root
# =============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

banner() {
    echo -e "\n${BLUE}============================================================${NC}"
    echo -e "${BLUE}  $1${NC}"
    echo -e "${BLUE}============================================================${NC}\n"
}

ok() { echo -e "${GREEN}[OK]${NC} $1"; }
info() { echo -e "${CYAN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }

# =============================================================================
# VERIFICACIONES PREVIAS
# =============================================================================
banner "Verificando entorno"

if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}[ERROR] Este script debe ejecutarse como root${NC}"
    exit 1
fi

if ! grep -q "Rocky Linux" /etc/os-release; then
    warn "Este script fue diseñado para Rocky Linux 9. Continuar bajo tu propio riesgo."
fi

ok "Ejecutando como root en Rocky Linux"

# =============================================================================
# INSTALACIÓN DE PAQUETES NECESARIOS
# =============================================================================
banner "Instalando paquetes necesarios"

dnf install -y acl vim tar gzip bzip2 xz tree httpd \
    policycoreutils-python-utils curl wget git 2>/dev/null

ok "Paquetes instalados"

# =============================================================================
# CREACIÓN DE USUARIOS Y GRUPOS
# =============================================================================
banner "Creando usuarios y grupos del laboratorio"

for user in juan maria carlos deploy auditor appd; do
    if ! id "$user" &>/dev/null; then
        useradd -m "$user"
        echo "${user}:Lab2024!" | chpasswd
        ok "Usuario $user creado"
    else
        info "Usuario $user ya existe"
    fi
done

for grp in developers auditores contabilidad ti; do
    if ! getent group "$grp" &>/dev/null; then
        groupadd "$grp"
        ok "Grupo $grp creado"
    fi
done

usermod -aG developers juan
usermod -aG developers deploy
usermod -aG auditores auditor
usermod -aG contabilidad maria
usermod -aG ti carlos

ok "Membresías de grupos configuradas"

# =============================================================================
# BLOQUE 1.1 — NAVEGACIÓN FILESYSTEM
# =============================================================================
banner "Bloque 1.1 — Navegación Filesystem"

# Estructura de directorios
mkdir -p /lab/bloque1/{filesystem,permisos,permisos_especiales,acls,links,compresion,paquetes}
mkdir -p /var/log/lab
mkdir -p /opt/app
mkdir -p /data
mkdir -p /proyectos/dev
mkdir -p /srv/compartido

# Archivos .conf de distintas fechas para practicar find
for i in $(seq 1 10); do
    cat > /etc/lab_service_${i}.conf << EOF
# Configuración del servicio lab_service_${i}
# Generado para práctica LFCS/RHCSA
SERVICE_NAME=lab_service_${i}
PORT=$((8000 + i))
LOG_LEVEL=info
MAX_CONNECTIONS=100
TIMEOUT=30
EOF
done

# Archivo .conf modificado hace más de 7 días (para ejercicio find -mtime)
touch -d "10 days ago" /etc/lab_service_old.conf

# Logs con contenido real y tamaños variados
info "Generando logs de práctica..."

# Log pequeño (~2MB)
for i in $(seq 1 5000); do
    echo "$(date '+%b %d %H:%M:%S') server01 sshd[$$]: Accepted publickey for root from 192.168.1.$((RANDOM % 254 + 1)) port $((RANDOM % 60000 + 1024)) ssh2" >> /var/log/lab/auth_practice.log
done

# Log mediano (~12MB) — mayor de 10MB para el ejercicio
for i in $(seq 1 60000); do
    echo "$(date '+%Y-%m-%dT%H:%M:%S') INFO  [worker-$((RANDOM % 20))] RequestID=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || echo $RANDOM$RANDOM) method=GET path=/api/v1/resource/$((RANDOM % 1000)) status=$((RANDOM % 2 == 0 ? 200 : 404)) latency=$((RANDOM % 500))ms user=user_$((RANDOM % 100))" >> /var/log/lab/app_large.log
done

# Log de sistema simulado
for i in $(seq 1 3000); do
    SERVICES=("kernel" "systemd" "NetworkManager" "sshd" "crond" "auditd")
    SVC=${SERVICES[$((RANDOM % 6))]}
    echo "$(date '+%b %d %H:%M:%S') server01 ${SVC}[$$]: Sample log entry number ${i} for practice" >> /var/log/lab/syslog_practice.log
done

ok "Logs generados en /var/log/lab/"

# Archivo con inode para practicar stat
echo "Archivo para practicar stat e inode" > /var/log/lab/stat_practice.txt

# Archivo huérfano (propietario eliminado) — para troubleshooting
useradd -u 9999 tempuser_lab 2>/dev/null || true
echo "Archivo de usuario temporal" > /var/log/lab/orphan_file.txt
chown 9999:9999 /var/log/lab/orphan_file.txt 2>/dev/null || true
userdel tempuser_lab 2>/dev/null || true

ok "Escenarios de navegación filesystem listos"

# =============================================================================
# BLOQUE 1.2 — PERMISOS ESTÁNDAR
# =============================================================================
banner "Bloque 1.2 — Permisos estándar"

# Archivos básicos para chmod/chown
touch /tmp/reporte.txt
touch /opt/app/config.txt
touch /opt/app/run.sh
echo "Contenido del reporte de ventas Q4 2024" > /tmp/reporte.txt
echo "#!/bin/bash\necho 'App iniciada'" > /opt/app/run.sh

# Permisos incorrectos a propósito — el alumno debe corregirlos
chmod 777 /tmp/reporte.txt          # Debería ser 644
chmod 777 /opt/app/config.txt       # Debería ser 640
chmod 644 /opt/app/run.sh           # Debería ser 755
chown root:root /opt/app/config.txt # Debería ser deploy:developers

# Directorio /data con permisos a configurar
mkdir -p /data/produccion
echo "datos sensibles de producción" > /data/produccion/db_backup.sql
echo "reporte financiero 2024" > /data/produccion/finance_report.csv
chmod 777 /data/produccion            # Incorrecto — el alumno debe configurar 750

# Directorio para ejercicio de umask
mkdir -p /home/juan/workspace
touch /home/juan/workspace/proyecto.py
touch /home/juan/workspace/README.md
chown -R juan:juan /home/juan/workspace

# TROUBLESHOOTING: httpd no puede leer su archivo
mkdir -p /var/www/html
echo "<h1>Servidor Web Lab</h1><p>Rocky Linux 9 - Práctica LFCS/RHCSA</p>" > /var/www/html/index.html
chmod 640 /var/www/html/index.html   # httpd no puede leer (falta permiso de others)
chown root:root /var/www/html/index.html

ok "Escenarios de permisos estándar listos"

# =============================================================================
# BLOQUE 1.3 — PERMISOS ESPECIALES (SUID/SGID/STICKY)
# =============================================================================
banner "Bloque 1.3 — Permisos especiales"

# Directorio compartido SIN sticky bit (problema a corregir)
mkdir -p /var/tmp/compartido_lab
chmod 777 /var/tmp/compartido_lab    # Sin sticky — cualquiera puede borrar archivos de otros

# Crear archivos de distintos usuarios en el directorio compartido
su - juan -c "echo 'Archivo privado de Juan' > /var/tmp/compartido_lab/juan_file.txt" 2>/dev/null || \
    echo "Archivo de juan" > /var/tmp/compartido_lab/juan_file.txt && chown juan /var/tmp/compartido_lab/juan_file.txt

su - maria -c "echo 'Archivo privado de Maria' > /var/tmp/compartido_lab/maria_file.txt" 2>/dev/null || \
    echo "Archivo de maria" > /var/tmp/compartido_lab/maria_file.txt && chown maria /var/tmp/compartido_lab/maria_file.txt

# Directorio para SGID (herencia de grupo)
mkdir -p /proyectos/dev
chown root:developers /proyectos/dev
chmod 770 /proyectos/dev              # Sin SGID — archivos nuevos no heredan grupo

# Binario con SUID falso para auditoria (no peligroso)
cp /usr/bin/cat /usr/local/bin/cat_lab
chmod u+s /usr/local/bin/cat_lab     # SUID innecesario — el alumno debe encontrarlo y quitarlo

# Otro binario SUID para la auditoría
cp /usr/bin/ls /usr/local/bin/ls_lab
chmod u+s /usr/local/bin/ls_lab

ok "Escenarios de permisos especiales listos"

# =============================================================================
# BLOQUE 1.4 — ACLs
# =============================================================================
banner "Bloque 1.4 — ACLs"

# Asegurarse que el filesystem soporta ACLs
mkdir -p /opt/reporte
echo "Reporte de ventas enero 2024: $45,230 USD" > /opt/reporte.csv
echo "Reporte de ventas febrero 2024: $52,100 USD" >> /opt/reporte.csv
echo "Reporte de ventas marzo 2024: $48,750 USD" >> /opt/reporte.csv
chown root:contabilidad /opt/reporte.csv
chmod 640 /opt/reporte.csv

# Directorio para ACLs por defecto
mkdir -p /proyectos/docs
chown root:developers /proyectos/docs
chmod 770 /proyectos/docs
echo "Documento de arquitectura v1.0" > /proyectos/docs/arquitectura.md
echo "Manual de despliegue" > /proyectos/docs/deploy_guide.md

# /data/contabilidad con estructura para ACLs complejas
mkdir -p /data/contabilidad
echo "Balance general 2024" > /data/contabilidad/balance.xlsx
echo "Nómina diciembre 2024" > /data/contabilidad/nomina_dic.csv
echo "Presupuesto 2025" > /data/contabilidad/presupuesto_2025.xlsx
chown root:contabilidad /data/contabilidad
chmod 770 /data/contabilidad
chown maria:contabilidad /data/contabilidad/balance.xlsx
chown maria:contabilidad /data/contabilidad/nomina_dic.csv
chown maria:contabilidad /data/contabilidad/presupuesto_2025.xlsx

# TROUBLESHOOTING ACL: carlos tiene rwx en ACL pero no puede acceder
# El directorio padre no tiene permiso de execute para others
mkdir -p /datos/privado
echo "Datos confidenciales" > /datos/privado/secreto.txt
chown root:ti /datos
chmod 750 /datos                      # carlos está en ti pero /datos no tiene x para others
chown root:ti /datos/privado
chmod 770 /datos/privado
setfacl -m u:carlos:rwx /datos/privado/secreto.txt 2>/dev/null || true
# El problema: carlos no puede llegar a /datos/privado porque /datos tiene chmod 750
# y carlos no es root ni está en ti... espera, está en ti. Ajustemos el troubleshooting:
# El problema real: la ACL mask está restringiendo los permisos efectivos
setfacl -m m::r /datos/privado/secreto.txt 2>/dev/null || true   # mask solo lectura, bloquea escritura aunque ACL diga rwx

ok "Escenarios de ACLs listos"

# =============================================================================
# BLOQUE 1.5 — LINKS
# =============================================================================
banner "Bloque 1.5 — Links"

# Archivo origen para links
mkdir -p /etc/httpd/conf
echo "# Apache HTTP Server configuration
ServerRoot /etc/httpd
Listen 80
ServerName lab.example.com
DocumentRoot /var/www/html
ErrorLog /var/log/httpd/error_log
CustomLog /var/log/httpd/access_log combined" > /etc/httpd/conf/httpd.conf

# Links rotos para encontrar
ln -sf /etc/nonexistent_file.conf /etc/broken_link1.conf 2>/dev/null || true
ln -sf /var/log/nonexistent.log /var/log/broken_link.log 2>/dev/null || true
ln -sf /opt/missing_app/config /opt/broken_config 2>/dev/null || true

# Link simbólico válido para referencia
ln -sf /etc/httpd/conf/httpd.conf /opt/httpd_config_link 2>/dev/null || true

# TROUBLESHOOTING: Servicio falla por link roto
mkdir -p /opt/myapp/
echo "PORT=8080
DB_HOST=localhost
DB_PORT=5432" > /opt/myapp/app.conf.real
ln -sf /opt/myapp/config/app.conf /opt/myapp/app.conf 2>/dev/null || true
# El link apunta a /opt/myapp/config/app.conf que no existe

ok "Escenarios de links listos"

# =============================================================================
# BLOQUE 1.6 — COMPRESIÓN
# =============================================================================
banner "Bloque 1.6 — Compresión"

# Crear contenido para comprimir
mkdir -p /lab/para_comprimir/configs
mkdir -p /lab/para_comprimir/logs
mkdir -p /lab/para_comprimir/scripts

# Copiar archivos reales para comprimir
cp /etc/*.conf /lab/para_comprimir/configs/ 2>/dev/null | head -20 || true
cp /var/log/lab/syslog_practice.log /lab/para_comprimir/logs/ 2>/dev/null || true

for i in $(seq 1 5); do
    cat > /lab/para_comprimir/scripts/backup_${i}.sh << EOF
#!/bin/bash
# Script de backup número ${i}
DATE=\$(date +%Y%m%d)
tar czf /tmp/backup_\${DATE}_${i}.tar.gz /etc/
echo "Backup ${i} completado: \$(date)"
EOF
done

# Archivo temporal (para practicar exclude)
touch /lab/para_comprimir/configs/temporal.tmp
touch /lab/para_comprimir/logs/debug.tmp

# Crear un tar.gz con algunos archivos "corruptos" para el ejercicio de troubleshooting
tar czf /tmp/backup_completo.tar.gz /lab/para_comprimir/ 2>/dev/null || true
tar czf /tmp/httpd_config_backup.tar.gz /etc/httpd/ 2>/dev/null || true

ok "Escenarios de compresión listos"

# =============================================================================
# BLOQUE 1.7 — GESTIÓN DE PAQUETES
# =============================================================================
banner "Bloque 1.7 — Gestión de paquetes"

# Instalar algunos paquetes para practicar verificación
dnf install -y vsftpd 2>/dev/null || true

# Modificar un archivo de httpd para que rpm -V lo detecte como modificado
if rpm -q httpd &>/dev/null; then
    echo "# Línea modificada para práctica rpm -V" >> /etc/httpd/conf/httpd.conf
    ok "Archivo de httpd modificado para práctica de rpm -V"
fi

ok "Escenarios de gestión de paquetes listos"

# =============================================================================
# BLOQUE 1.8 — VIM (archivos para editar)
# =============================================================================
banner "Bloque 1.8 — Vim"

# Archivo con múltiples ocurrencias de Listen para reemplazar
cat > /etc/httpd/conf/httpd_vim_practice.conf << 'EOF'
# Apache configuration for practice
Listen 80
Listen 443
Listen 8080
ServerName server01.lab.local
Listen 9090
DocumentRoot /var/www/html
# Listen comentado: #Listen 8443
Listen 3000
ErrorLog /var/log/httpd/error_log
CustomLog /var/log/httpd/access_log combined
Listen 5000
EOF

# Archivo largo de 100 líneas para practicar navegación en vim
for i in $(seq 1 100); do
    echo "Línea ${i}: $(date '+%Y-%m-%d %H:%M:%S') — Registro del sistema número ${i} — servidor server01" >> /tmp/archivo_100_lineas.txt
done

# Dos archivos para practicar apertura simultánea en vim
echo "Configuración del servidor A - producción" > /tmp/config_servidor_a.txt
echo "IP: 192.168.1.10" >> /tmp/config_servidor_a.txt
echo "Puerto: 8080" >> /tmp/config_servidor_a.txt
echo "DB: postgres://localhost/proddb" >> /tmp/config_servidor_a.txt

echo "Configuración del servidor B - staging" > /tmp/config_servidor_b.txt
echo "IP: 192.168.1.20" >> /tmp/config_servidor_b.txt
echo "Puerto: 8081" >> /tmp/config_servidor_b.txt
echo "DB: postgres://localhost/stagingdb" >> /tmp/config_servidor_b.txt

ok "Archivos para práctica de Vim listos"

# =============================================================================
# RESUMEN FINAL — GUÍA DE EJERCICIOS
# =============================================================================
banner "LAB BLOQUE 1 LISTO — Guía de ejercicios"

cat > /root/LAB_BLOQUE1_EJERCICIOS.txt << 'GUIA'
================================================================
 GUÍA DE EJERCICIOS — BLOQUE 1
 LFCS + RHCSA — Rocky Linux 9
================================================================

--- NAVEGACIÓN FILESYSTEM ---

BÁSICO:
  1. Lista /etc mostrando permisos, propietario y fecha de modificación
  2. Encuentra archivos .conf en /etc modificados en los últimos 7 días
     Guarda el resultado en /tmp/recientes.txt

INTERMEDIO:
  3. Encuentra archivos .log en /var/log mayores de 10MB
     Muestra cuántas líneas tiene cada uno
  4. Muestra el inode, propietario y fecha de acceso de /var/log/lab/stat_practice.txt

AVANZADO:
  5. Encuentra en /etc archivos mayores de 100 bytes, extensión .conf
     (sin distinguir mayúsculas) y que pertenezcan a root

TROUBLESHOOTING:
  6. Hay un archivo en /var/log/lab/ cuyo propietario ya no existe en el sistema
     Encuéntralo y cámbialo al usuario root

